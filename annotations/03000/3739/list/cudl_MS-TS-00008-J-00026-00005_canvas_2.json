      "modified": "2025-04-01T21:44:21.924608+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-J-00026-00005/canvas/2",
          "type": "Canvas",
