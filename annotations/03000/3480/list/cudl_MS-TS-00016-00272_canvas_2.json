          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0628\u0627\u0633\u0645\u0627\u0626\u0643\u0645 \u062a\u0630\u0643\u0631\u0647 \u062f\u064a\u0648\u0627\u0646\u064a\u0629 \u0641\u0644\u0645\u0627 \u0628\u0644\u063a\u0646\u064a \u0627\u0644\u062e\u0628\u0631 \u0645\u0636\u064a\u062a \u0627\u0644\u0649 \u062f\u0627\u0631\u0629 \u0648\u062d\u0644\u0641\u062a \u0644\u0647</li>\n<li>\u0645\u0627 \u0643\u0627\u0646 \u0642\u0635\u062f\u064a \u0627\u0644\u0627 \u0644\u0627 \u064a\u0646\u0639\u0645\u0644 \u0634\u064a \u0627\u0644\u0627 \u0628\u0631\u0627\u064a \u0627\u0644\u0640\u05d6\u05e7\u05e0\u05d9\u05dd \u0627\u0644\u0645\u0634\u0647\u0648\u0631\u064a\u0646 \u0648\u062a\u0631\u064a\u062f \u062a\u0639\u0644\u0645 \u0635\u062d\u062a \u0642\u0648\u0644\u0647 \u0642\u0635\u062f\u064a \u0627\u0644\u0627 \u0644\u0627 \u064a\u0646\u0639\u0645\u0644 \u0634\u064a \u0627\u0644\u0627 \u0628\u0631\u0627\u0649 \u0627\u0644\u0640\u05d6\u05e7\u05e0\u05d9\u05dd \u0627\u0644\u0645\u0634\u0647\u0648\u0631\u064a\u0646 \u0648\u062a\u0631\u064a\u062f \u062a\u0639\u0644\u0645 \u0635\u062d\u062a \u0642\u0648\u0644\u0647</li>\n<li>\u0627\u0646\u0641\u062f \u0627\u0644\u0627\u0646 \u0645\u0646 \u063a\u064a\u0631 \u062e\u0637 \u0643\u0630 \u0645\u0627 \u062a\u0631\u064a\u062f\u0648 \u0642\u0627\u0644 \u0648\u062d\u0642 \u0645\u0627 \u064a\u0631\u062c\u0639 \u064a\u0627\u062e\u0630 \u0645\u0646 \u0627\u0644\u0645\u0648\u0646\u0629 \u062d\u0628\u0629 \u0627\u0646\u0627</li>\n<li>\u0627\u0643\u0644\u0649 \u0645\u0646 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0639\u0634\u0631\u064a\u0646 \u0628\u062f\u0648 \u064a\u062f\u0641\u0639\u0648 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u0648 \u064a\u062f\u0641\u0639\u0648\u0647 \u0644\u0644\u0640\u05e7\u05d5\u05e4\u05d4 \u0644\u0647 \u0642\u0644\u062a \u05dc\u05d7\u05d9\u05d9\u05dd</li>\n<li>\u0627\u0641\u0639\u0644 \u0631\u0627\u0626\u064a\u0643 \u062b\u0645 \u0627\u0628\u062a\u062f\u064a \u0645\u0646 \u0630\u0644\u0643 \u0627\u0644\u0648\u0642\u062a \u0636\u0631\u0628 \u0641\u064a\u064a \u0639\u0646\u062f \u0643\u0644 \u063a\u0641\u0644\u0627\u0646 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0648\u064a\u0641\u0633\u062f</li>\n<li>\u0639\u0644\u0649 \u0642\u0644\u0648\u0628 \u0627\u0644\u0646\u0627\u0633 \u0627\u0644\u0649 \u0627\u0646 \u062b\u0628\u062a \u0641\u064a \u0642\u0644\u0628 \u0627\u0644\u0634\u0648\u0641\u0638 \u0648\u0627\u0644\u0641\u0644\u064a\u0644\u064a\u0645 \u0627\u0646\u0646\u064a \u05e2\u05d5\u05d1\u05d3 \u05e2\u05d1 \u05d6\u05e8\u05d4 \u0648\u0635\u0627\u0631\u0648</li>\n<li>\u064a\u062a\u0645\u0646\u0627\u0648 \u0644\u064a \u0639\u062b\u0631\u0629 \u0641\u0641\u064a \u063a\u0635\u0648\u0646 \u0627\u0644\u062d\u0627\u0644 \u062c\u0627\u0648 \u05d4 \u05e9\u05d1\u05d5\u05d9\u05d9\u05dd \u0648\u0639\u0644\u064a\u0647\u0645 \u05d7 \u062f\u0646 \u0639\u062f\u0645\u0646\u0627 \u0645\u0646 \u064a\u062c\u0628\u064a\u0647\u0627</li>\n<li>\u0648\u0642\u0641\u062a \u0641\u064a\u0647\u0627 \u0627\u0646\u0627 \u0648\u0627\u0644\u062d\u0632\u0627\u0646\u064a\u0646 \u0648\u0627\u0644\u0641\u0631\u0646\u0627\u0633 \u0648\u062c\u0628\u064a\u0646\u0627\u0647\u0627 \u0641\u0643\u0644\u0627 \u0648\u0627\u062d\u062f \u0645\u0646 \u0627\u0644\u0630\u064a \u0627\u0635\u0644\u062d\u062a \u0628\u064a\u0646\u0647</li>\n<li>\u0648\u0628\u064a\u0646\u0647\u0645 \u064a\u0642\u0627\u0644 \u0644\u0647 \u0628\u0646 \u0627\u0644\u062a\u0644\u0627\u063a \u0648\u0643\u0627\u0646 \u064a\u0634\u062a\u0645\u0647 \u05d1\u05e4\u05e8\u05d4\u05e1\u05d9\u05d0 \u064a\u0627\u062e\u0630 \u0639\u0631\u0636\u064a \u0648\u0642\u0627\u0644 \u0644\u0645\u0627 \u0637\u0644\u0628</li>\n<li>\u0627\u062d\u062f \u0627\u0644\u063a\u0631\u0628\u0627 \u062f\u064a\u0646\u0627\u0631 \u0627\u0630 \u0644\u0645 \u064a\u0645\u0643\u0646\u0647 \u0627\u0644\u0649 \u062c\u0644\u0648\u0633 \u0627\u0644\u0649 \u0627\u0646 \u062a\u0639\u0645\u0644 \u0644\u0647 \u0641\u0633\u064a\u0642\u0629</li>\n<li>\u0627\u0646 \u064a\u062f\u0641\u0639 \u0645\u0646 \u0627\u0644\u0647 \u062f\u0646\u0627\u0646\u064a\u0631 \u0627\u0644\u0630\u064a \u0627\u0633\u062a\u0641\u0636\u0644 \u0645\u0646 \u0627\u0644\u0641\u0633\u064a\u0642\u0629 \u062f\u064a\u0646\u0627\u0631 \u0641\u0635\u0639\u0628 \u0639\u0644\u0649</li>\n<li>\u062a\u062f\u0631\u062a \u0639\u0646 \u0630\u0644\u0643 \u0648\u062f\u0639\u0648\u062a \u0639\u0644\u0649 \u0631\u0648\u062d\u064a \u0648\u0642\u0644\u062a \u0628\u0627\u0644\u0647 \u0627\u0643\u0648\u0646 \u0627\u0646 \u0643\u0627\u0646 \u0645\u0627 \u0642\u064a\u0644 \u0639\u0646\u0649 \u0635\u062d\u064a\u062d \u0648\u0627\u0645\u0627</li>\n<li>\u0645\u0646 \u0642\u0627\u0644 \u0639\u0646\u064a \u0644\u064a\u062a\u0644\u0645 \u0639\u0631\u0636\u064a \u0647\u0648 \u0645\u062d\u0631\u0648\u0645 \u0645\u0627 \u0627\u062d\u062a\u0627\u062c \u0627\u062d\u0631\u0645 \u0641\u0635\u0639\u0628 \u0639\u0644\u064a\u0647 \u0648\u0645\u0636\u0649 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a</li>\n<li>\u0627\u0633\u062a\u0639\u062f\u0627 \u0648\u0647\u0630\u0627 \u0627\u0644\u0640\u05e7\u05e6\u05d9\u05df \u0643\u0627\u0646 \u062d\u0627\u0636\u0631\u0629 \u0627\u0630 \u0645\u0646\u0639\u0647 \u0645\u0627 \u0627\u062d\u062a\u0627\u062c \u0627\u0634\u0631\u062d\u0647\u0627 \u0641\u0644\u0645\u0627 \u0637\u0644\u0639</li>\n<li>\u0644\u0645\u0635\u0631 \u0627\u062e\u0630 \u0628\u0646 \u0627\u0644\u062a\u0644\u0627\u062c \u05d5\u05d1\u05df \u05d0\u05dc\u05d9\u05e9\u05e2 \u0639\u0646 \u0645\u0627 \u0633\u0645\u0639\u062a \u0627\u0648\u0642\u0641\u0647\u0645 \u0644\u0644\u0641\u0627\u0635\u0644 \u0642\u0627\u0644\u0648 \u0641\u064a\u064a \u0645\u0627 \u0639\u0631\u0641\u0647</li>\n<li>\u0627\u0644\u0644\u0647 \u0641\u0646\u0641\u062f \u0643\u062a\u0627\u0628 \u0644\u0644\u0633\u0644 \u05e8\u05e4\u05d9 \u0648\u0643\u062a\u0628 \u0644\u0644\u0642\u0627\u0635\u064a \u0648\u0643\u062a\u0628 \u0644\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0627\u0644\u0642\u0627\u0633\u0645 \u0648\u0644\u0644\u0641\u0642\u064a\u0629</li>\n<li>\u05d1\u05df \u05e2\u05d5\u05e3 \u0648\u0644\u0644\u0641\u0642\u064a\u0629 \u05d1\u05df \u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646\u064a \u05d5\u05dc\u05d1\u05df \u05d0\u05dc\u05d9\u05e9\u05e2 \u0648\u0627\u0628\u064a \u0627\u0644\u0631\u0636\u0627 \u0648\u0628\u0646 \u0627\u0644\u0628\u063a\u0630\u0627\u062f\u064a \u0648\u0628\u0646 \u064a\u0642\u0641\u0648</li>\n<li>\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0636\u0648\u0629 \u0627\u0644\u0649 \u0627\u0646 \u064a\u0643\u0645\u0644\u0648\u0647\u0627 \u0648\u0644\u0645\u0627 \u062e\u0631\u062c \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0645\u0646 \u0627\u0644 \u0647 \u0644\u0644 \u0639\u0644\u064a</li>\n<li>\u0635\u0647\u0631 \u0627\u0644\u0642\u0627\u0635\u064a \u064a\u0639\u064a\u062f \u0627\u0644\u0627\u0645\u064a\u0631 \u0644\u0627 \u0645</li>\n<li>\u0644\u0647 \u0648\u0644\u063a\u064a\u0631\u0647 \u05d4 \u0630\u0646 \u0648\u0646\u0641\u062f\u0648 \u0627\u0644\u0640\u05d2\u05d3\u05d5\u05dc\u05d9\u05dd \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u062a\u0647\u062f\u062f\u0648 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0648\u0642\u0648\u0641</li>\n<li>\u0644\u0644\u0633\u0644\u0637\u0627\u0646 \u0627\u0646 \u0647\u0627\u0648\u0644\u0627\u064a \u0627\u0635\u062d\u0627\u0628 \u0632\u0648\u0637\u0627 \u0627\u0644 \u062a\u0633\u0645\u0627 \u0628\u0627\u0644\u0645\u0642\u062a\u062f\u0631 \u0648\u0628\u0642\u064a\u0648 \u0627\u0644\u0646\u0627\u0633 \u0645\u062a\u062d\u0631\u0642\u064a\u0646</li>\n<li>\u0644\u0627 \u064a\u0642\u062f\u0631\u0648 \u0639\u0644\u064a \u062d\u064a\u0644\u0629 \u0645\u0646 \u0627\u0644\u0643\u0648\u0641 \u0648\u0643\u062a\u0628\u0648 \u0631\u0642\u0627\u0639 \u05d0\u05dc\u05d4\u05d9\u05dd \u064a\u0648\u062f\u0639 \u0645\u0627 \u0639\u0644\u0645\u062a \u0628\u0647\u0627 \u0648\u0627\u0631\u0627\u0647\u0645</li>\n<li>\u064a\u0627\u062e\u0630\u0648 \u0639\u0644\u064a\u0647\u0627 \u062a\u0648\u0642\u064a\u0639 \u0639\u0644\u0649 \u064a\u062f\u064a \u0646\u0627\u0633 \u0641\u0627\u0644\u0630\u064a \u0627\u0644\u0643\u0648\u0641 \u0648\u0643\u062a\u0628\u0648 \u0631\u0642\u0627\u0639 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d9\u05d5\u05d3\u05e2 \u0645\u0627 \u0639\u0644\u0645\u062a \u0628\u0647\u0627 \u0648\u0627\u0631\u0627\u0647\u0645 \u064a\u0627\u062e\u0630\u0648 \u0639\u0644\u064a\u0647\u0627 \u062a\u0648\u0642\u064a\u0639 \u0639\u0644\u0649 \u064a\u062f\u064a \u0646\u0627\u0633 \u0641\u0627\u0644\u0630\u064a \u0639\u0644\u0645\u062a \u0628\u0647 \u0627\u0646\u0647\u064a\u062a \u0639\u0646\u0647 \u0644\u0627\u0646 \u0643\u0627\u0646 \u0627\u062c\u062a\u0645\u0639 \u0628\u064a</li>\n<li>\u05d1\u05df \u05d0\u05dc\u05d9\u05e9\u05e2 \u0648\u0635\u0647\u0631\u0629 \u0627\u0644\u0643\u0647\u0646 \u0648\u0642\u0631\u0631\u0648 \u0645\u0639\u0649 \u0627\u0646 \u064a\u0646\u0641\u062f\u0648 \u0643\u062a\u0628 \u064a\u0639\u0644\u0645\u0648 \u0631\u0628 \u0648\u064a\u0639\u0644\u0645\u0648 \u0627\u0644\u0645\u0648\u0641\u0642 \u0645\u0627</li>\n<li>\u0627\u062a\u0641\u0642 \u0641\u064a \u0639\u0642\u062f \u0627\u0644\u0634\u0631\u0643\u0629 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646 \u05e8 \u05d0\u05dc\u05e2\u05d6\u05e8 \u0641\u0628\u0637\u0644\u062a \u0643\u0644 \u0639\u0645\u0644 \u0648\u0643\u0633\u0631\u062a \u0642\u0644\u0648\u0628</li>\n<li>\u0645\u0646 \u0643\u0627\u0646\u0648 \u0627\u0631\u0627\u062f\u0648 \u064a\u0642\u0641\u0648 \u0627\u0644\u0628\u0647 \u0644\u0644\u0640\u05e9\u05dc\u05d5\u05dd \u0641\u0628\u0639\u062f \u0645\u0636\u0649 \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0645\u0636\u064a \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0648\u0627\u0645 \u0633\u0644\u0637\u0646</li>\n<li>\u0645 \u0641\u0637\u0644\u0628 \u0645\u0646\u064a \u0643\u062a\u0628 \u062d\u062c\u0629 \u0641\u0643\u062a\u0628\u062a\u0647\u0627 \u0627\u0646\u0646\u064a \u0644\u0627 \u0627\u062a\u0639\u0636 \u0627\u0644\u0649 \u062e\u062f\u0645\u0629 \u0627\u0644\u0627 \u0628\u0627\u0645\u0631</li></ol>\n",
