    {
      "etag": "\"d93ca9e7f8aead449feaa41c204599a5\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/fdbafa61-b203-4989-9c00-14650e9e7d5c/",
      "type": "Annotation",
      "created": "2026-10-29T19:50:24.890406+00:00",
      "modified": "2026-10-29T19:50:24.890417+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-OR-01080-J-00142/canvas/1",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/3981/iiif/manifest/"
