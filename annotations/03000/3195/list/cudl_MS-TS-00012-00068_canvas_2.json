      "body": [
        {
          "type": "TextualBody",
          "label": "Verso.",
          "value": "\n<ol><li>\u0645\u0627 \u063a\u064a\u0647</li>\n<li>\u0643\u062a\u0628 \u0644\u0647 \u0643\u062a\u0627\u0628 \u0646\u062c\u064a\u062f \u062c\u0648\u0627\u0628\u0647 \u062a\u0645\u0633\u0643</li>\n<li>\u0641\u064a\u0647 \u0648\u0648\u0642\u0641 \u0628\u064a\u0647 \u0627\u0644\u0644\u0647 \u0648\u0639\u0644\u0649</li>\n<li>\u0633\u064a\u064a\u062f\u0646\u0627 \u0627\u0646 \u064a\u062a\u0642\u0636\u0627 \u0645\u0646 \u0633\u064a\u064a\u062f\u0646\u0627 \u0627\u0644\u0646\u062c\u064a\u062f \u0641\u0627\u0630\u0627 \u0635\u062d \u0644\u0647 \u0627\u0646 \u0645\u0627 \u0643\u062a\u0628\u062a</li>\n<li>\u0644\u0647 \u0642\u0637 \u0641\u064a \u062d\u0642\u0647 \u0643\u062a\u0627\u0628 \u062a\u0628\u0631\u0649 \u0633\u0627\u062d\u062a\u0649 \u0645\u0646 \u0647\u0627\u0644\u0649 \u0627\u0644\u0630\u064a \u0637\u0644\u0639\u0648 \u064a\u062d\u062c\u0648</li>\n<li>\u0641\u0627\u0646 \u0644\u0627 \u0628\u062f \u0645\u0627 \u064a\u0642\u0639 \u0645\u0646\u0647\u0645 \u0643\u062a\u0627\u0628\u062d\u062f\u064a\u062a \u0648\u0631\u0628\u0645\u0627 \u0631\u0641\u0627\u0639\u0647 \u0648\u0642\u062f \u062d\u0644\u0641</li>\n<li>\u0635\u0627\u062d\u0628 \u0627\u0644\u062f\u064a\u0648\u0627\u0646 \u0627\u0646 \u0633\u0645\u0639 \u0627\u0646 \u0627\u062d\u062f \u062a\u0643\u0644\u0645 \u0641\u064a\u0647 \u0644\u0627 \u0643\u0627\u062a\u0628 \u0627\u0644\u0645\u0644\u0643</li>\n<li>\u0641\u0627 \u0648\u0631\u0628\u0645\u0627 \u0645\u0627 \u062a\u0646\u062a\u062c\u0647 \u0627\u0644 \u0631\u062d\u0644\u0648</li>\n<li>\u0635\u0628\u0631\u0648 \u0627\u0644\u0649 \u0627\u0646 \u064a\u062a\u0648\u0644\u0627 \u0631\u0626\u064a\u0633 \u0643\u0627\u0646 \u064a\u0648\u0644\u0649 \u0645\u0646 \u064a\u0635\u0644\u062d \u0648\u0645\u0627 \u0643\u0627\u0646 \u0627\u062d\u062f</li>\n<li>\u064a\u0642\u062f\u0631 \u0648\u0644\u0627 \u064a\u0635\u063a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0645 \u0644\u0627 \u0634\u0643 \u0627\u0646 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0627\u0646 \u064a\u0643\u0627\u0641\u0648</li>\n<li>\u0627\u0644\u0646\u0627\u0633 \u0628\u0630\u0644\u0643 \u0627\u0644\u062e\u064a\u0631 \u0634\u0631 \u0648\u0644\u0627 \u0634\u0643 \u0627\u0646 \u0633\u0644\u064a\u0645\u0627\u0646 \u0628\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0646\u0635\u0631</li>\n<li>\u0639\u0631\u0641 \u0628\u0646 \u0645\u0636\u064a\u0637\u0628\u0647 \u0627\u0644\u0630\u064a \u0648\u0627\u0644\u0630\u0629 \u0645\u0646 \u062e\u0648\u0627\u0635 \u0627\u0635\u062d\u0627\u0628\u0643 \u0643\u0627\u0646 \u0648\u062d\u0644 \u0641\u064a \u0634\u0631\u0627 \u0645\u0636\u064a\u0637\u0628\u0629 \u0627\u0644\u0630\u064a \u0648\u0627\u0644\u0630\u0629 \u0645\u0646 \u062e\u0648\u0627\u0635 \u0627\u0635\u062d\u0627\u0628\u0643 \u0643\u0627\u0646 \u0648\u062d\u0644 \u0641\u064a \u0634\u0631\u0627</li>\n<li>\u0645\u0648\u0636\u0639 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627\u0644\u0643 \u0648\u0627\u0633\u062a\u0642\u0644\u062a \u0639\u0644\u064a\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0648\u0628\u0642\u064a \u0645\u0643\u0628\u064a \u0648\u064a\u062c\u064a</li>\n<li>\u064a\u0646\u0638\u0631\u062d \u0647\u0648 \u0648\u0632\u0648\u062c\u062a\u0647 \u0627\u0646\u0636\u0627\u0641 \u0627\u0644\u064a\u0627\u0644\u0649 \u0627\u0644\u0649 \u0627\u0646 \u0627\u0634\u062a\u0631\u064a\u062a \u0627\u0646\u0627 \u0627\u0644\u0645\u0643\u0627\u0646</li>\n<li>\u0648\u0628\u0642\u064a\u062a \u062a\u062d\u062a \u062f\u0631\u0643\u0629 \u0643\u0627\u0646 \u0642\u0628\u0627\u0644\u0647 \u0647\u0630\u0627 \u0627\u0646 \u0627\u0644\u0645\u062a\u063a\u0631\u0636\u064a\u0646 \u062c\u0627 \u062a\u0632\u0648\u062c</li>\n<li>\u0627\u0644\u0649 \u0627\u0646 \u0628\u0642\u064a \u0645\u0634\u062a\u063a\u0644 \u0628\u0646\u0627 \u062d\u0633\u0628 \u0641\u0627\u0644\u0644\u0647 \u064a\u0643\u0648\u0646 \u0647\u0633\u064a\u0628\u0647 \u0641\u0646\u0634\u062a\u0647\u064a \u0627\u0646</li></ol>\n",
