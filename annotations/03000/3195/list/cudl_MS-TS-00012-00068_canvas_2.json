5d9\u05d5\u05dc\u05d9 \u05de\u05df \u05d9\u05e6\u05dc\u05d7 \u05d5\u05de\u05d0 \u05db\u05d0\u05df \u05d0\u05d7\u05d3</li>\n<li>\u05d9\u05e7\u05d3\u05e8 . . . . \u05d5\u05dc\u05d0 \u05d9\u05e6\u05d2\u05e8 \u05e2\u05dc\u05d9 \u05d0\u05dc\u05de\u05de \u05dc\u05d0 \u05e9\u05da \u05d0\u05df \u05d4\u05d3\u05d0 \u05d0\u05dc\u05d6\u05de\u05d0\u05df \u05d9\u05db\u05d0\u05e4\u05d5</li>\n<li>\u05d0\u05dc\u05e0\u05d0\u05e1 \u05d1\u05d3\u05dc\u05da \u05d0\u05dc\u05db\u05d9\u05e8 \u05e9\u05e8 \u05d5\u05dc\u05d0 \u05e9\u05da \u05d0\u05df \u05e1\u05dc\u05d9\u05de\u05d0\u05df \u05d1\u05df \u05d0\u05dc\u05e9\u05d9\u05da \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8</li>\n<li>\u05e2\u05e8\u05e3 \u05d1\u05df \u05de\u05e6\u05d9\u05d8\u05d1\u05d4 \u05d0\u05dc\u05d3\u05d9 \u05d5\u05d0\u05dc\u05d3\u05d4 \u05de\u05df \u05db\u05d5\u05d0\u05e5 \u05d0\u05e6\u05d7\u05d0\u05d1\u05da \u05db\u05d0\u05df \u05d5\u05d7\u05dc \u05e4\u05d9 \u05e9\u05e8\u05d0</li>\n<li>\u05de\u05d5\u05e6\u05e2 \u05de\u05df \u05d2\u05d9\u05e8 \u05de\u05d0\u05dc\u05da \u05d5\u05d0\u05e1\u05ea\u05e7\u05dc\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d0\u05dc\u05e9\u05d4\u05d0\u05d3\u05d4 \u05d5\u05d1\u05e7\u05d9 \u05de\u05db\u05d1\u05d9 \u05d5\u05d9\u05d2\u05d9</li>\n<li>\u05d9\u05e0\u05d8\u05e8\u05d7 \u05d4\u05d5 \u05d5\u05d6\u05d5\u05d2\u05ea\u05d4 \u05d0\u05e0\u05e6\u05d0\u05e3 \u05d0\u05dc\u05d9\u05d0\u05dc\u05d9 \u05d0\u05dc\u05d9 \u05d0\u05df \u05d0\u05e9\u05ea\u05e8\u05d9\u05ea \u05d0\u05e0\u05d0 \u05d0\u05dc\u05de\u05db\u05d0\u05df</li>\n<li>\u05d5\u05d1\u05e7\u05d9\u05ea \u05ea\u05d7\u05ea \u05d3\u05e8\u05db\u05d4 \u05db\u05d0\u05df \u05e7\u05d1\u05d0\u05dc\u05d4 \u05d4\u05d3\u05d0 \u05d0\u05df \u05d0\u05dc\u05de\u05ea\u05d2\u05e8\u05e6\u05d9\u05df \u05d2\u05d0 \u05ea\u05d6\u05d5\u05d2</li>\n<li>\u05d0\u05dc\u05d9 \u05d0\u05df \u05d1\u05e7\u05d9 \u05de\u05e9\u05ea\u05d2\u05dc \u05d1\u05e0\u05d0 \u05d7\u05e1\u05d1 \u05e4\u05d0\u05dc\u05dc\u05d4 \u05d9\u05db\u05d5\u05df \u05d4\u05e1\u05d9\u05d1\u05d4 \u05e4\u05e0\u05e9\u05ea\u05d4\u0