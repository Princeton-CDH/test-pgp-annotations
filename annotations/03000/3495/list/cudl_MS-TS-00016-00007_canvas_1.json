      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u0644\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0627\u064a\u0627\u0645 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0643\u0627\u0646 \u0644\u0643 \u0648\u0645\u0639\u0643 \u0648\u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0645\u0648\u0631\u0643 \u0648\u0644\u064a\u0627 \u0648\u062d\u0627\u0641\u0638\u0627</li>\n<li>\u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u0642\u0631 \u05d4 \u0627\u064a\u0627\u0645 \u0643\u0644\u062a \u0645\u0646 \u0634\u0647\u0631 \u05d0\u05dc\u05d5\u05dc \u0639\u0631\u0641\u0646\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u064a\u0627\u0643 \u0628\u0631\u0643\u062a\u0647 \u0648\u0645\u0627 \u064a\u0644\u0649 \u0645\u0646 \u0628\u0639\u062f\u0647 \u0648\u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0639\u0627\u0641\u064a\u0629</li>\n<li>\u0644\u0645\u0648\u0644\u064a\u0647\u0645\u0627 \u0627\u0644\u062d\u0645\u062f \u0648\u0639\u0646 \u0634\u0648\u0642 \u0645\u062d\u0636 \u0644\u0637\u0644\u0639\u062a\u0643 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0643 \u0628\u0645\u0646\u0647 \u0648\u062c\u0648\u062f\u0647 \u0644\u0627\u0646\u0647 \u0648\u0644\u0649 \u0630\u0644\u0643 \u0648\u0627\u0644\u0642\u0627\u062f\u0631</li>\n<li>\u0639\u0644\u064a\u0647 \u0648\u0635\u0644\u062a \u0643\u062a\u0628\u0643 \u0645\u062a\u0636\u0645\u0646\u0647 \u0628\u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0634\u0643\u0631\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0630\u0627\u0644\u0643 \u0648\u0633\u0631\u0631\u062a \u0628\u0645\u0627 \u062a\u0636\u0645\u0646\u062a \u0645\u0646 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0633\u0644\u0627\u0645\u0629</li>\n<li>\u0628\u0646\u064a\u0643 \u0627\u0628\u0642\u0627\u0647\u0645 \u0627\u0644\u0644\u0647 \u0648\u0627\u0646\u0645\u0627\u0647\u0645 \u0648\u0642\u062f \u0648\u0635\u0644\u0648 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0631\u0627\u0643\u0628 \u0633\u0627\u0644\u0645\u0629 \u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0648\u0648\u0635\u0644\u062a \u0627\u0644\u063a \u0627\u0644\u0627\u0639\u062f \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a</li>\n<li>\u0641\u064a \u064a\u062f\u0627\u0646 \u0646\u0632\u0644\u0644\u064a \u0628\u0646 \u0645\u0648\u0644\u0649 \u0635\u0627\u0644\u062d \u0648\u0627\u0646\u0647\u0631\u0634 \u0645\u0646\u0647\u0627 \u0639\u062f\u0644 \u0628\u0639\u062b\u0647 \u0633\u0639\u0631 \u0643\u0630 \u0648\u0646\u0635\u0641 \u0627\u0644\u0640\u05e7\u05e0\u05d8 \u0648\u0628\u0639\u062b \u0627\u0644\u0640\u05de\u05d1\u05dc\u05d5 \u05dc \u0633\u0639\u0631 \u0627\u0644</li>\n<li>\u0645\u0639 \u0627\u0644\u0639\u062f\u0644\u064a\u0646 \u0627\u0644\u0627\u0648\u0643\u0631 \u0648\u0630\u0643\u0631\u062a \u0645\u0627 \u062f\u0641\u0639 \u0627\u0644\u064a\u0643 \u05de\u05e8\u05d3\u05d5\u05da \u0648\u0642\u062f \u0648\u0635\u0644 \u0627\u0644\u0639\u062f\u0644 \u0627\u0644\u0641\u0644\u0641\u0644 \u0648\u0627\u0644\u0639\u062f\u0644 \u0627\u0644\u0646\u064a\u0644 \u0633\u0627\u0644\u0645\u0629</li>\n<li>\u0627\u0644\u0641\u0644\u0641\u0644 \u0633\u0639\u0631 \u05e7\u05d9\u05d8 \u0627\u0644\u0642\u0646\u0637\u0627 \u0648\u0627\u0648\u0628\u064a\u0639 \u0627\u0644\u0646\u064a\u0644 \u0645\u0646 \u05e7\u05e7\u05e2 \u0627\u0644\u0640\u05e7\u05e0\u05d8 \u0627\u0644\u0649 \u05e2\u05d5 \u0648\u0627\u0643\u062b\u0631 \u062a\u0645\u0646\u0647 \u0641\u064a \u0627\u0644\u0633\u0648\u0642</li>\n<li>\u05d5 \u062f\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u062a\u0645\u0646 \u0627\u0644\u0627 \u062d\u0628\u0629 \u0648\u0647\u064a \u05db\u05d7 \u062f\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u062a\u0645\u0646 \u0627\u0644\u0627 \u062d\u0628\u0629 \u0644\u0648 \u0643\u0627\u0646 \u0628\u0647\u0627 \u0642\u0646\u0637</li>\n<li>\u0628\u0631\u0643\u0629 \u0648\u0630\u0643\u0631\u062a \u0645\u0637\u0644 \u0628\u0646 \u062e\u0641\u0627\u062c\u0629 \u0644\u0643 \u0641\u0627\u0646 \u0648\u0635\u0644\u062a \u0643\u062a\u0628\u064a \u0648\u0642\u062f \u0628\u0642\u0649 \u0639\u0646\u062f\u0643 \u0634\u064a \u0645\u0646\u0647 \u062a\u0642\u0628\u0636\u0647</li>\n<li>\u0627\u0644\u0633\u0642\u0637 \u064a\u0648\u062a\u0645 \u0627\u0644\u0639\u0644\u0627\u0648\u0629 \u0644\u0627\u0646 \u062a\u0639\u0628\u0643 \u0639\u0646\u062f\u064a \u0627\u0639\u0638\u0645 \u0645\u0646 \u0627\u0644\u0646\u0634\u0627\u0635\u0631 \u0648\u0627\u0645\u062b\u0627\u0644\u0647 \u0643\u0648\u0649</li>\n<li>\u0628\u0646 \u0627\u0644\u0634\u0648\u0627 \u0631\u0632\u0645\u0629 \u0645\u0646 \u062e\u0644\u0637\u062a\u064a \u0645\u0639\u0643 \u0641\u064a\u0647\u0627 \u062d\u0631\u064a\u0631 \u0648\u0644\u0627\u0633\u064a\u0646 \u0648\u0642\u0632\u062f\u064a\u0631 \u0648\u0627\u0646\u0637\u0627\u0639 \u0648\u0641\u064a\u0647\u0627 \u0645\u0646 \u062e\u0644\u0637\u0629</li>\n<li>\u0648\u0644\u0627\u0633\u064a\u0646 \u0648\u0627\u0648\u0633\u0642\u062a \u0627\u064a\u0636\u0627 \u0641\u064a \u0645\u0631\u0643\u0628 \u0628\u0646 \u062c\u0631\u0648\u0627 \u0631\u0632\u0645\u0629 \u0645\u0646 \u062e\u0644\u0637\u062a\u064a \u0645\u0639 \u0627\u0644\u0640\u05d7\u05e0\u05df \u0627\u062e\u064a \u0644\u0643 \u0641\u064a\u0647\u0627 \u062d\u0631\u064a\u0631</li>\n<li>\u0648\u062c\u0647\u062a \u0644\u0643 \u0641\u064a \u0645\u0631\u0643\u0628 \u0644\u0632\u0648\u0631\u064a\u0642 \u0631\u0632\u0645\u0629 \u0645\u062a\u0627\u0639 \u0648\u0639\u0645\u0627\u0626\u0645 \u0648\u0627\u0646\u0637\u0627\u0639 \u0648\u0647\u064a \u0645\u0646 \u062e\u0644\u0637\u062a\u064a \u0645\u0639\u0643 \u0648\u0644\u0645</li>\n<li>\u0627\u0628\u064a \u0627\u0644\u0628\u0634\u0631 \u0633\u0644\u0645\u0627\u0646 \u0628\u0646 \u062f\u0627\u0648\u062f \u0627\u0644\u0628\u0631\u0642\u064a \u0645\u0646 \u062e\u0644\u0637\u062a\u064a \u0645\u0639\u0647 \u0633\u0648\u0631\u0629 \u0648\u0628\u0627\u0639\u064a\u0627 \u0642\u0648\u062f\u0645 \u0648\u0642\u062f \u0630\u0643\u0631</li>\n<li>\u0627\u0646 \u0627\u0644\u0631\u062d\u0644 \u0627\u0644\u0630\u064a \u0648\u062c\u0647\u062a \u0644\u0643 \u0627\u0644\u0633\u0646\u0629 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u0627\u0644\u0641 \u05e9\u05e9\u05db\u05d7 \u0631\u0628\u0627\u0639\u064a \u062d\u0628\u0647 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u05d0\u05dc\u05e3 \u05e9\u05e9\u05db\u05d7 \u0631\u0628\u0627\u0639\u064a \u062d\u0628\u0647 \u062d\u0628\u0647 \u0648\u0646\u0635\u0641 \u0642\u064a\u0631</li>\n<li>\u062d\u0633\u0627\u0628 \u0648\u0635\u0648\u0644\u0647\u0627 \u0627\u0644\u064a\u0643 \u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u0643\u062a\u0628 \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u062c\u0645\u064a\u0639 \u0648\u064a\u062c\u0645\u0639 \u0639\u0644\u064a\u0646\u0627 \u0648\u0639\u0644\u064a\u0643 \u0641\u0627\u0630\u0627\u062a</li>\n<li>\u0627\u0644\u062c\u0645\u064a\u0639 \u062a\u0628\u064a\u0639 \u0628\u0627\u0644\u0642\u0635\u0645 \u0648\u0627\u0644\u0631\u0632\u0642 \u0648\u062a\u0634\u062a\u0631\u0649 \u0628\u0627\u0644\u062a\u0645\u0646 \u0645\u0627 \u064a\u0644\u0647\u0645\u0643 \u0627\u0644\u0644\u0647 \u0627\u0644\u064a\u0647 \u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u0648\u062c\u0647\u062a</li>\n<li>\u062a\u0648\u062e\u062f \u0644\u0646\u0627 \u062f\u0631\u0647\u0645 \u0648\u0642\u062f \u0628\u0642\u064a \u0644\u064a \u0639\u0646\u062f \u05de\u05e8\u05d3\u05d5\u05da \u05d8\u05d5 \u062f\u064a\u0646 \u0648\u0643\u0633\u0631 \u0648\u0642\u062f \u0643\u062a\u0628\u062a \u0627\u0644\u064a\u0647 \u0627\u0646 \u064a\u062f\u0641\u0639\u0647\u0627 \u0627\u0644\u064a\u0643</li>\n<li>\u0627\u0644\u0630\u064a \u0628\u0642\u064a \u0644\u064a \u0639\u0646\u062f\u0643 \u0648\u0627\u0644 \u05d9 \u062a\u0645\u0646 \u0627\u0644\u0643\u0644\u0629 \u0648\u062a\u0634\u062a\u0631\u064a \u0628\u0627\u0644\u062c\u0645\u064a\u0639 \u0645\u0627 \u064a\u0644\u0647\u0645\u0643 \u0627\u0644\u0644\u0647 \u0627\u0644\u064a\u0647</li>\n<li>\u05e1\u05dc\u05d9\u05de\u05d0\u05df \u05d1\u05df \u05e4\u05e8\u05d7 \u0641\u064a \u0634\u0631\u064a \u0632\u0639\u0641\u0631\u0627\u0646 \u0645\u0646 \u062c\u0648\u0645\u0644\u0647 \u0645\u0627 \u0644\u064a \u0639\u0646\u062f\u0647 \u0648\u064a\u0648\u062c\u0647\u0648 \u0627\u0644\u064a\u0643 \u0648\u0642\u062f</li>\n<li>\u0627\u0634\u062a\u0631\u0627 \u0644\u064a \u05dc\u05d2 \u0645\u0646 \u0648\u0646\u0635\u0641 \u0632\u0639\u0641\u0631\u0627\u0646 \u0633\u0639\u0631 \u05e4\u05d6 \u062f\u0631\u0647\u0645 \u0627\u0644\u0645\u0646 \u0648\u0642\u062f \u0634\u062f\u0647\u0627 \u0641\u064a \u0631\u0632\u0645\u0629</li>\n<li>\u0645\u0631\u0643\u0628 \u0628\u0646 \u0639\u0644\u0627\u0646 \u0627\u0630\u0627 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0628\u0633\u0644\u0627\u0645\u0629 \u062a\u0628\u064a\u0639 \u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646 \u0628\u0627\u0644\u0642\u0635\u0645 \u0648\u0627\u0644\u0631\u0632\u0642 \u0648\u062b</li>\n<li>\u0648\u0642\u0631\u0628 \u05db\u05d4 \u062f\u064a\u0646 \u0644\u064a\u0643\u0648\u0646 \u0627\u0644\u062c\u0645\u064a\u0639 \u0634\u0631\u0643\u0629 \u0628\u064a\u0646 \u0648\u0644\u0630\u064a \u0627\u0628\u064a \u0627\u0628\u0631\u0647\u064a\u0645 \u0648\u0628\u064a\u0646 \u0648\u0644\u0630\u0643 \u0627\u0628\u064a</li>\n<li>\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u064a\u062e\u0644\u0641\u0648 \u0627\u062c\u062f\u0627\u062f\u0647\u0645 \u0648\u062a\u0634\u062a\u0631\u0649 \u0645\u0627 \u064a\u0644\u0647\u0645\u0643 \u0627\u0644\u0644\u0647 \u0627\u0644\u064a\u0647 \u0648\u062a\u0643\u062a\u0628 \u0639\u0644\u064a\u0647</li>\n<li>\u0644 \u0630\u0627\u0644\u0643 \u0648\u0642\u062f \u0628\u0639\u062b \u0645\u0646 \u0627\u0644\u0642\u0648\u0627\u0631\u064a\u0631 \u0627\u0644\u0630\u064a \u0644\u0643 \u0639\u0646\u062f\u064a \u0648\u0627\u0644\u0630\u0629 \u0645\u0646 \u0637\u0627\u0644</li>\n<li>\u062d\u0631\u0641 \u0646\u0628\u064a\u0639 \u0627\u0644\u0628\u0642\u064a\u0629 \u0648\u0627\u0646\u0627 \u0646\u0634\u062a\u0631\u0649 \u0641\u064a \u0647\u0630\u0647</li></ol>\n",
