      "body": [
        {
          "type": "TextualBody",
          "label": "Right margin, diagonal lines written upside down.",
          "value": "<p>\u0648\u0641\u064a \u064a\u0648\u0645\u0646\u0627 \u0647\u0630\u0627 \u0639\u0646\u062f \u0628\u0644\u0648\u062c\u064a \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0649 \u0647\u0646\u0627 \u0648\u0647\u0648 \u05d9\u05d5\u05dd</p>\n<p>\u05d3 \u05d9\u05d0 \u05d1\u05e2\u05d5\u05de\u05e8 \u0627\u0648\u0635\u0644 \u0627\u0644\u0649 \u0643\u062a\u0627\u0628 \u0645\u0648\u0627\u0644\u0649 \u05e9\u05de \u05e6 \u0628\u0639\u062f \u0627\u0646\u0641\u0627\u062f\u064a \u0628\u0627\u0644\u062a\u0648\u0628\u064a\u0643</p>\n<p>\u0644\u0645\u0646 \u0643\u0627\u0646 \u0639\u0646\u062f\u0647 \u0641\u0642\u0631\u0627\u062a\u0647 \u0648\u0634\u0643\u0631\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u062d\u0633\u0646 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u0639\u0627\u0641\u064a\u0629</p>\n<p>\u0641\u0627\u0645\u0627 \u0627\u0644\u0634\u0648\u0642 \u0641\u0639\u0646\u062f\u064a \u0627\u0636\u0639\u0627\u0641 \u0645\u0627 \u0639\u0646\u062f \u0643\u0644 \u0633\u0626\u064a\u062f \u0645\u0646\u0643\u0645 \u0644\u0627\u0646\u064a \u0627\u0634\u062a\u0627\u0642</p>\n<p>\u0644\u0643\u0644 \u0627\u062d\u062f \u0634\u0648\u0642\u0627 \u0628\u0645\u0641\u0631\u062f\u0629 \u0648\u0627\u0645\u0646\u0627 \u064a\u0634\u062a\u0627\u0642 \u0643\u0644 \u0645\u0648\u0644\u0627 \u0634\u0648\u0642 \u0627\u0648\u062d\u062f</p>\n<p>\u0648\u0627\u0645\u0627 \u0627\u0644\u0628\u0642\u064a\u0627\u0631 \u0641\u0644\u0642\u062f \u0634\u0647\u062f \u0627\u0644\u0644\u0647 \u0627\u0637\u0637\u0631\u0628</p>",
