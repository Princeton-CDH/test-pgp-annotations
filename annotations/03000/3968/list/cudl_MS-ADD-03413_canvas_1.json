          "value": "<p>\u0627\u0644\u0630\u064a \u0627\u0633\u062a\u0642\u0631 \u05d1\u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u0628\u064a\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0627\u0644\u0645\u0646\u0627 \u0648\u0628\u064a\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0627\u0644\u0641\u0635\u0644 \u05d1\u05d3\u05e8\u05da \u05e4\u05e9\u05e8\u05d4 \u0628\u0639\u062f \u0642\u0637\u0639 \u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u0635\u0627\u0626\u0645 \u0648\u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0646 \u064a\u0633\u0644\u0645 \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u0627 \u062f\u0646\u0646 \u0644\u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644 \u062e\u0645\u0633\u0629 \u0648\u062e\u0645\u0633\u064a\u0646 \u062f\u064a\u0646 \u0645\u0646\u0647\u0627 \u062e\u0645\u0633\u0629 \u0648\u062b\u0644\u062b\u064a\u0646 \u062f\u064a\u0646 \u0645\u0639\u062c\u0644\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u062f\u064a\u0646 \u0645\u0627\u062c\u0644\u0629 \u0627\u0644\u0649 \u0646\u0635\u0641 \u062e\u0633\u0644\u0648 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u062a\u064a \u0647\u064a \u0633\u0646\u0629 \u0627\u062a\u064a \u0648\u0643\u0630\u0644\u0643 \u0642\u0628\u0644 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u0627 \u062f\u0646\u0646 \u0627\u0646 \u064a\u062f\u0641\u0639 \u0644\u0647 \u0627\u0644\u0639\u0634\u0631\u0629 \u0630\u0646\u0627 \u0627\u0644\u0630\u0647\u0628 \u0627\u0644\u0645\u0643\u0633\u0648\u0631 \u0648\u062f\u064a\u0646\u0627\u0631 \u0630\u0647\u0628 \u0639\u064a\u0646 \u0635\u062d\u064a\u062d \u0628\u0639\u062f \u0627\u0646 \u064a\u0642\u0628\u0644 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u062d\u0631\u0645 \u0628\u0627\u0633\u0645 \u0643\u0644 \u05d1\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc \u0641\u064a \u0630\u0644\u0643 \u0628\u0627\u0646\u0647 \u0645\u0627 \u0642\u0628\u0636 \u0645\u0646 \u062a\u0645\u0646 \u0647\u0630\u062