          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0648\u0639\u0627\u0641\u064a\u0647 \u0648\u0643\u0630\u0644\u0643 \u0633\u062a\u0643 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u062a\u0642\u0631\u064a\u0647\u0627 \u0633\u0644\u0627\u0645\u064a \u0648\u0644\u0627 \u062a\u0627\u0645\u0644 \u0639\u0644\u0649</li>\n<li>\u0635\u064a\u0627\u0645 \u0644\u0627\u0646\u0647 \u064a\u0635\u0631\u0647\u0627 \u0648\u0627\u0644\u0645\u062d\u062a\u0648\u0645 \u0644\u0627 \u0628\u062f \u0645\u0646\u0647 \u0648\u0627\u0644\u0644\u0647 \u064a\u0642\u0636\u064a \u0628\u0627\u0644\u062e\u064a\u0631\u0629 \u0648\u0644\u0627 \u062a\u063a\u0641\u0644</li>\n<li>\u062f \u0639\u0644\u0649 \u0628\u0627\u0644\u062e\u064a\u0631\u0629 \u0648\u0644\u0627 \u062a\u063a\u0641\u0644 \u05d3 \u0639\u0644\u0649 \u0627\u0644\u0631\u0621\u064a\u0633 \u0648\u062a\u0634\u0643\u0648 \u062d\u0627\u0644\u0647\u0627 \u0648\u062a\u0639\u0631\u0641\u0648\u0647 \u0627\u0646\u0643\u0645 \u0645\u0627\u0631\u064a\u0646 \u062a\u0643\u062a\u0628\u0648\u0627 \u05d3</li>\n<li>\u0627\u0646\u0641\u0633\u0643\u0645 \u0627\u0648 \u0639\u0644\u0649 \u0644\u0633\u0627\u0646\u064a \u0648\u062a\u0634\u0627\u0648\u0631\u0648\u0627 \u0641\u064a\u0647\u0627 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0638\u0627\u0647\u0631 \u0627\u0639</li>\n<li></li></ol>\n",
