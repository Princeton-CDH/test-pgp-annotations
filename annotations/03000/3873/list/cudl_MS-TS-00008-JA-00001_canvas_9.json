      "body": [
        {
          "type": "TextualBody",
          "label": "margin",
          "value": "<p>\u0627\u0628\u0648 \u05d9\u05e6\u05d7\u05e7 \u0648\u0627\u0644 \u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0634\u0645\u0627\u0631 \u0627\u0641\u0636\u0644 \u0627\u0644 \u0633\u0644\u0627\u0645 \u0648\u062a\u0639\u0631\u0641 \u0627\u0644</p>\n<p>\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644 \u0628\u0646 \u0633\u0644\u0645\u0627\u0646 \u0627\u0646\u0646\u064a \u0645\u0631\u062a \u0627\u0644\u0649 \u0639\u0646\u062f \u064a\u062d\u0646\u0627 \u0627\u0646\u0627 \u0648\u0627\u0644\u0634\u064a\u0643</p>\n<p>\u0627\u0628\u0648 \u0633\u0647\u0644 \u0648\u062f\u0641\u0639\u062a \u0644\u0647 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0644\u0645 \u064a\u0639\u064a\u062f \u0639\u0644\u0649 \u062c\u0648\u0627\u0628 \u0648\u0627\u0646\u0627 \u0627\u0644\u0649 \u0627\u0633\u0627\u0639\u0629 \u0627\u062a\u0630\u0643\u0631 \u0627\u0644\u064a\u0647 \u062d\u062f \u0627\u0628\u0635\u0631 \u0627\u064a\u0634 \u064a\u0642\u0648\u0644 \u0641\u0627\u0646 \u0627\u062e\u0630\u062a \u0645\u0646\u0647 \u0634\u0626\u064a \u0627\u0646\u0627 \u0627\u0646\u0641\u062f\u0647 \u0644\u0647 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0643\u0627\u0646 \u0628\u0646 \u0639\u0644\u0649 \u0641\u064a</p>",
