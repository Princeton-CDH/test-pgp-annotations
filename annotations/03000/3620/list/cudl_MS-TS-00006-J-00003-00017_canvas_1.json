      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p>(1-5) I inform you, after the blessings [of greeti]ngs and kissing your hand, that I sent you with \u1e62\u0101f\u012b the completed [...]. I met with Mr. Solomon who said that several meetings took place between you and your uncle</p>\n<p>(6-9) and that your uncle was obliged to swear that his daughter will not leave (the house) the rest of the holiday. The elder, Ab\u016b \u02bfAl\u012b. and Joseph, the maternal uncle of her mother, told you: &ldquo;If you still desire your wife, then come and accept what he tells you.&rdquo; Now, my brother</p>\n<p>&nbsp;</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
