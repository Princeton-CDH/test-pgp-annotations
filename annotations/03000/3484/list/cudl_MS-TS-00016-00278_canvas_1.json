      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "<p>\u062d\u0631\u0636 \u0641\u064a \u0627\u0644\u0639\u062c\u0644\u0629 \u0648\u0627\u0644 \u0633\u0631\u0639\u0629 \u0648\u0627\u0644\u0627\u0634\u0641\u0627\u0642 \u0639\u0644\u0649 \u0642\u0644\u0628\u0643 \u0648\u0627\u0644\u062e\u0634\u064a\u0629 \u0645\u0646 \u062d\u0635\u0648\u0644 \u0627\u0644\u0627\u062c\u0644</p>\n<p>\u0644\u0627\u062d\u062f \u0645\u0646\u0627 \u0648\u0647\u0648 \u063a\u0627\u0626\u0628 \u0639\u0646 \u0635\u0627\u062d\u0628\u0647 \u0648\u0627\u0645\u0627 \u0645\u0627 \u062a\u0642\u0627\u0633\u064a\u0647 \u0631\u0648\u062d\u0649 \u0641\u064a \u0627\u0644\u063a\u0630\u0627 \u0648\u0643\u0648\u0646\u064a \u0627\u0646</p>\n<p>\u0627\u062d\u062a\u0641\u0644\u062a \u0648\u0627\u0635\u0644\u062d\u062a \u0634\u064a \u0639\u0644\u0649 \u0646\u0627\u0631 \u0645\u0627 \u064a\u062d\u0635\u0644 \u0645\u0646 \u0627\u0644\u062a\u0639\u0628 \u0648\u0627\u0644\u0645\u0634\u0642\u0629 \u0648\u0639\u0646\u062f \u0645\u0627 \u064a\u062a\u0635\u0648\u0631</p>\n<p>\u0642\u062f\u0627\u0645\u064a \u0648\u0627\u0631\u064a\u062f \u0627\u0646 \u0627\u0645\u0631 \u064a\u062f\u064a \u0641\u064a\u0647 \u0627\u0641\u0643\u0631 \u0641\u064a\u0643 \u0648\u0641\u064a \u0634\u0642\u0627\u0643 \u0648\u0641\u064a \u0648\u062d\u062f\u062b\u0643 \u0648\u0648\u062d\u062f\u0647</p>\n<p>\u0643\u0644 \u0645\u0646\u0627 \u0627\u0644\u0644\u0647 \u064a\u0639\u0644\u0645 \u0643\u064a\u0641 \u0627\u0643\u0644 \u0648\u0643\u064a\u0641 \u0627\u0634\u0631\u0628 \u0648\u0643\u064a\u0641 \u0627\u0646\u0627\u0645 \u0648\u0643\u0648\u0646\u064a \u0646\u0633\u0627\u0647\u0631 \u0631\u0648\u062d\u064a</p>\n<p>\u0644\u0648\u0642\u062a \u0643\u062b\u064a\u0631 \u0632\u0627\u0626\u062f \u0645\u0646 \u0627\u0644\u0644\u064a\u0644 \u0648\u0645\u0627 \u064a\u062a\u0641\u0642</p>",
