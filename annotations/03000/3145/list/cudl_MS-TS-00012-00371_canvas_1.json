      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, upside down",
          "value": "<ol>\n<li><span lang=\"he\">\u05d0\u05dc\u05d9 \u05e1\u05d9\u05d3\u05d9 \u05d5\u05de\u05d5\u05dc\u05d0\u05d9 \u05d0\u05d1\u05d9 \u05d0\u05dc\u05e4\u05e6\u05dc \u05de\u05d1\u05d5\u05e8\u05da' \u05d1\u05d9\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc \u05e0'\u05e2' &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05de\u05df \u05e6\u05e0\u05d9\u05e2\u05ea\u05d4 \u05e2\u05d8[\u05d0 \u05d1\u05df \u05d6\u05db\u05e8\u05d9]&nbsp; &nbsp; \u05e0'\u05e2'</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05dc\u05d4 \u05d5\u05dc\u05d9\u05d4 \u05d5\u05d7\u05d0\u05e4\u05e6\u05d4 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05d9\u05e6\u05dc \u05d1'\u05e8'\u05db'\u05d4' &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05d0\u05dc\u05d9 \u05de\u05e6\u05e8 \u05d0[\u05df \u05e9\u05d0 \u05d0\u05dc\u05dc\u05d4</span></li>\n</ol>",
