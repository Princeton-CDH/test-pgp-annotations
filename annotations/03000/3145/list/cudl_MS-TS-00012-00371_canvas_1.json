      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso, address",
          "value": "<p>\u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d5\u05e8\u05d1\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05dc\u05e4\u05e6\u05dc \u05de\u05d1\u05d5\u05e8\u05da \u05d1\u05d9\"\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc \u05e0\"\u05e2; \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05de\u05d2\u05d9\u05e0\u05d5 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5. \u05d9\u05d2\u05d9\u05e2; \u05d1\u05e8\u05db\u05d4. \u05de\u05e9\u05d5\u05dc\u05d9\u05d9\u05ea\u05d5 \u05e2\u05b7\u05d8\u05d0 \u05d1\u05df \u05d6\u05db\u05e8\u05d9 \u05e0\"\u05e2. \u05dc\u05e4\u05e1\u05d8\u05d0\u05d8, \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05d0\u05dc. ....</p>",
          "format": "text/html"
        }
