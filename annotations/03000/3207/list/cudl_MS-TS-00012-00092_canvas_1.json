          "label": "Recto",
          "value": "\n<ol><li>\u05e2\u05dc \u05e9\u05de\u05da</li>\n<li>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u064a\u0627 \u0634\u064a\u0643\u064a \u0648\u0631\u064a\u0633\u064a \u0648\u062c\u0644\u064a\u0644\u064a \u0641\u064a \u0627\u0644\u062e\u064a\u0631 \u0628\u0642\u0627\u0643 \u0648\u0639\u0644\u0627 \u0627\u0631\u062a\u0642\u0627\u0643 \u0648\u0644\u0642\u0627\u0643 \u0627\u0644\u062e\u064a\u0631 \u0637\u0648\u0644\u0645\u0627 \u0627\u0628\u0642\u0627\u0643 \u0643\u062a\u0627\u0628\u064a</li>\n<li>\u064a\u0627 \u0634\u064a\u0643\u064a \u0645\u0646 \u0627\u0644\u0642\u064a\u0631\u0648\u0627\u0646 \u0644\u064a \u0645\u0646 \u05d0\u05d1 \u05d9\u05d4\u05e4\u05da \u05dc\u05e9\u05e9\u05d5\u05df \u05d5\u05dc\u05e9\u05de\u05d7\u05d4 \u05dc\u05db\u05dc \u05e2\u05de\u05d5 \u05d9\u05e9 \u05d5\u05d0\u05e0\u05d5 \u05d1\u05db\u05dc\u05dc \u0648\u0627\u0644\u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0629 \u0648\u0646\u0639\u0645\u0647 \u0648\u0627\u0644\u062d\u0645\u062f</li>\n<li>\u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0643 \u0645\u0636\u0645\u0646 \u0633\u0644\u0627\u0645\u062a\u0643 \u0641\u0633\u0631\u0631\u062a \u0628\u0647 \u0648\u0627\u0628\u0647\u062c\u062a \u0644\u0644\u0648\u0642\u0648\u0641 \u0639\u0644\u064a\u0647 \u0648\u062d\u0645\u062f\u062a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0639\u0644\u0649 \u0645\u0627 \u062a\u0641\u0635\u0644</li>\n<li>\u0628\u0647 \u0645\u0646 \u062d\u0633\u0646 \u0643 \u0627\u0631\u062c\u0648 \u062f\u0648\u0627\u0645 \u0630\u0644\u0643 \u0648\u0648\u0641\u0627\u0647 \u0648\u0634\u0642 \u0639\u0644\u0649 \u064a\u0627 \u0633\u064a\u062f\u064a \u0627\u0630 \u0644\u0645 \u062a\u062e\u0644\u0641\u0646\u064a \u062d\u0627\u062c\u0629 \u0645\u0646 \u062d\u0648\u0627\u0626\u062c \u0627\u0644\u0635\u0628\u064a\u0627\u0646</li>\n<li>\u0648\u0627\u0647\u0644 \u0627\u0644\u062f\u0627\u0631 \u0644\u0627\u0646\u064a \u0627\u0633\u0631 \u0627\u0644\u0646\u0627\u0633 \u0628\u0645\u0627 \u064a\u0633\u0646\u062d \u0645\u0646 \u062d\u0627\u062c\u0627\u062a\u0643 \u0648\u0642\u062f \u0627\u062c\u062a\u0645\u0639\u062a \u0628\u0627\u0643\u064a\u0646\u0627 \u0627\u0628\u064a \u0627\u0633\u062d\u0642 \u0627\u0628\u0631\u0647\u064a\u0645</li>\n<li>\u0628\u0646 \u064a\u0645\u0627\u0646 \u0627\u064a\u062f\u0647 \u0627\u0644\u0644\u0647 \u0641\u064a \u062e\u0628\u0631 \u0627\u0644\u0642\u0645\u062d \u0627\u0644\u0630\u064a \u0627\u0634\u062a\u0631\u0649 \u0644\u0643 \u0628\u0627\u0644\u0645\u0647\u062f\u064a\u0629 \u0648\u0627\u0639\u062a\u0630\u0631 \u0628\u0648\u062c\u0647 \u0648\u0627\u0646\u0627 \u0646\u0646\u0638\u0631 \u0645\u0627 \u0628\u0642\u064a \u0644\u0643</li>\n<li>\u0639\u0646\u062f\u0647 \u0645\u0646 \u062f\u0631\u0627 \u0641\u0646\u0639\u0645\u0644 \u0639\u0644\u0649 \u0648\u0635\u0648\u0644\u0647\u0645 \u0627\u0644\u064a\u0647\u0645 \u0648\u0647\u0630\u0627 \u0645\u062d\u0633\u0648\u0628 \u0639\u0644\u0649 \u0627\u0628\u064a \u0632\u0643\u0631\u064a\u0627 \u0648\u0644\u0630\u0643 \u0627\u0630 \u0644\u0645 \u064a\u0639\u0631\u0641\u0646\u064a</li>\n<li>\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0644\u0627\u0646 \u0644\u0648 \u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u0647\u0630\u0627 \u0627\u0644\u0639\u0644\u0645 \u0643\u0627\u0646 \u064a\u0635\u0644 \u0627\u0644\u0649 \u0645\u0627 \u064a\u0634\u062a\u0647\u064a \u0648\u0642\u062f \u0643\u0627\u0646 \u062c\u0627\u0648 \u0639\u0644\u064a\u0647 \u0645\u0631\u0636 \u0636\u0639\u0628 \u0648\u0646\u0642\u0647 \u0645\u0646\u0647</li>\n<li>\u0627\u0644 \u062f \u0627\u0644\u0630\u064a \u0645\u0646 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0628 \u0648\u0647\u0648 \u0641\u064a \u0627\u0641\u0635\u0644 \u0646\u0639\u0645\u0647 \u064a\u0637\u0644\u0639 \u0627\u0644\u0649 \u0627\u0644\u0633\u0648\u0642 \u0643\u0644 \u064a\u0648\u0645 \u0648\u0642\u062f \u0643\u0627\u0646 \u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0631\u0628</li>\n<li>\u0646\u0638 \u0631\u062d\u0645 \u0648\u0633\u0627\u0626\u0631 \u0634\u064a\u0648\u0643 \u0647 \u0641\u064a \u0648\u0642\u062a \u0645\u0631\u0636\u0647 \u0641\u064a \u0633\u0627\u0626\u0631 \u0627\u0644\u0627\u064a\u0627\u0645 \u0648\u0627\u0644\u0633\u0628\u0648\u062a \u0641\u0644\u0627 \u062a\u0639\u0645\u0644 \u0641\u064a \u0646\u0641\u0633\u0643</li>\n<li>\u0645\u0646\u0647 \u0634\u064a \u0644\u0627\u0646\u0647 \u0648\u0644\u0627 \u062a\u0634\u063a\u0644 \u0633\u0631\u0643 \u0645\u0646 \u062c\u0647\u0629 \u0627\u0644\u062d\u0627\u0646\u0648\u062a \u0627\u0644\u0630\u064a \u0643\u0646\u062a \u0645\u0637\u0644\u0648\u0628 \u0628\u0647</li>\n<li>\u0641\u0627\u0646\u0647 \u0627\u0648\u0633\u0642\u0637 \u0627\u0644\u0643\u0647\u0646 \u0648\u062a\u0627\u062e\u0631\u0647 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0641\u0627\u0646\u0647 \u0644\u0645 \u064a\u0646\u0641\u062f \u0627\u0644\u0649 \u0634\u064a \u0641\u064a \u0647\u0630\u0647 \u0627\u0644</li>\n<li>\u0633\u0646\u0629 \u0641\u0642\u062f \u064a\u0643\u0627\u0628 \u0644\u0627\u0646 \u0627\u0643\u062b\u0631 \u0627\u0644\u0645\u0631\u0627\u0643\u0628 \u0627\u0644\u062a\u0627\u062a\u062a \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0641\u0627\u062d\u0628 \u064a\u0627\u062e\u064a \u0645\u0639\u0648\u0646\u062a\u0643 \u062d\u0633\u0628</li>\n<li>\u0628\u0647 \u0644\u0639\u0644\u0629 \u0644\u0627 \u064a\u062d\u0648\u062c\u0646\u064a \u0627\u0644\u0649 \u0630\u0644\u0643 \u0628\u0644 \u064a\u0639\u0645\u0644 \u0639\u0644\u064a \u062a\u0648\u062c\u064a\u0647 \u0631\u062d\u0644\u064a \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629</li>\n<li>\u0627 \u0627 \u0644\u0646\u0641\u0633\u0647 \u0645\u0627 \u0627\u0631\u0627 \u0648\u062c\u0647 \u0627\u0644\u0633\u0646\u0629 \u0634\u064a \u0645\u0646\u0647 \u0646\u0633\u0644\u0641\u0629</li>\n<li>\u0628\u0627\u0646\u0647 \u0634\u0627 \u0633\u0628\u062d\u0627\u0646\u0647 \u0641\u0627\u0646 \u0647\u0648\u0628 \u0634 \u0641\u062a\u0648\u062c\u0647 \u0627\u0644\u064a\u0647</li>\n<li>\u0627\u0639\u0632\u0647 \u0627\u0644\u0644\u0647 \u0648\u062d\u0645\u064a\u062a\u0643 \u0627\u0644\u0630\u064a \u0648</li>\n<li>\u0627\u0646\u0627 \u0646\u0646\u062a\u0641\u0639 \u0628\u0643 \u0643\u062b\u064a\u0631 \u0648\u0627\u0631\u062c\u0648 \u0627\u0646\u0647 \u0644\u0627 \u064a\u062d\u0648\u062c\u0646\u0627 \u0627\u0644\u0649 \u0634\u064a \u0645\u0646 \u0627\u0644</li></ol>\n",
