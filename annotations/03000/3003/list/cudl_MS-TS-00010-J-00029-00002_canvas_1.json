      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0645\u0639 \u0639\u0644\u064a\u064a \u0648\u0639\u0646\u062f\u064a \u05e6\u05d0\u05e0\u05da \u05d4\u05d5\u05ea\u05d5 \u05da \u05d5 \u0633\u0644\u0627\u0645\u0647 \u0645\u0646 \u0639\u0646\u062f\u0643 \u0648\u0634 \u0627\u0644\u0644\u0647 \u0627\u0644\u0649 \u0630\u0644\u0643 \u0643\u062b\u064a\u0631\u0627 \u0648\u0648\u0642\u0641\u062a \u0639\u0644\u0649 \u0627\u0644\u0648\u0643\u0627\u0644\u0629 \u0627\u0644\u0630\u064a \u0627\u0646\u0646\u064a \u064a\u0631\u0627 \u0648\u0645\u0635\u0631 \u0636\u0627 \u0644\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u0649 \u0627\u0644\u064a\u0647 \u0641\u064a \u0627\u0644 \u0645\u0627 \u062a\u0633\u0648\u0649 \u0647\u064a \u0645\u0641\u0633\u0648\u062f\u0629 \u0648\u0642\u0627\u0644 \u0627\u0646\u0627 \u0645\u0627 \u0627\u0631\u064a\u062f \u0627\u0645\u0636\u0649 \u0628\u0647\u0627 \u0627\u0644\u0649 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0630\u0627 \u05d9 \u0641\u0645\u0636\u064a\u062a \u0648\u0642\u0627\u0644 \u0644\u064a \u0647\u064a \u0645\u0641\u0633\u0648\u062f\u0629 \u0627\u064a\u0636\u0627 \u0648\u0645\u0627 \u062a\u0633\u0648\u0627 \u0634\u064a \u0648\u0644\u0627 \u064a\u0642\u0628\u0644\u0647\u0627 \u0627\u0644\u0627 \u0628\u062d\u064a\u062b \u062a\u0643\u0648\u0646 \u0628\u0627\u0645 \u0627\u0644\u0634\u0631\u0648\u0637 \u064a\u064a\u0643\u0648\u0646 \u0641\u064a\u0647\u0627 \u05db \u0639 \u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0630\u064a \u0635\u0648 \u064a\u062f\u0647 \u0641\u0644 \u0641\u0647 \u064a\u062c\u0645\u0646\u064a \u062c\u0645 \u0639\u0638\u064a\u0645 \u0643\u064a\u0641 \u0627\u0646\u0641\u0633\u0643 \u0627\u0644 \u0648\u0642\u062f \u0643\u0646\u062a \u064a\u0627 \u0648\u0627\u0644\u0630\u062a\u064a \u062a\u0627\u0633\u0631\u062a \u0639\u0644\u064a\u0643 \u0627\u0646 \u0644\u0627 \u062a\u0645\u0636\u0649 \u0627\u0644\u0627 \u05df \u0635\u062d \u0641\u0627\u064a \u0634\u064a \u0627\u062d\u0648\u062c\u0643 \u0627\u0644\u0649 \u063a\u