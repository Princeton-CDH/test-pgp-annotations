          "value": "<p>\u05e9\u05d5\u05dc\u05d9\u05dd \u0627\u062d\u0648\u0627\u0644\u0647\u0627 \u0641\u0645\u0646\u0639\u062a\u0647\u0627 \u0645\u0646\u062f \u0627\u0644\u0642\u062f\u0645\u0629 \u0648\u0627\u062d\u0645\u0645\u0627 \u0642\u062f \u0627\u0644</p>\n<p>\u0639\u0646\u0647\u0627 \u0644\u0648\u0644\u0627 \u0627\u0644\u0643\u0645\u0644\u0629 \u0627\u0642\u062a\u0631\u062a \u062f\u0644\u0644 \u0639\u0644\u0649 \u0645\u0639\u0631\u0641\u062a\u0647\u0627</p>",
          "format": "text/html"
        }
