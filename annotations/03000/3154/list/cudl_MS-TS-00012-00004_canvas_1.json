          "value": "\n<ol><li>\u0627\u0644\u0647\u0627</li>\n<li>\u0645\u0646 \u0627\u062d\u0633\u0627\u0646\u0647\u0627 \u0648\u0646\u0635\u0647 \u0645\u0646 \u05de \u05d4\u05d0 \u0648\u0634\u0631\u062d \u0644\u0647\u0645 \u0645</li>\n<li>\u05d1\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc \u0641\u064a \u062d\u0642 \u0645\u0627\u0644\u0643 \u0631\u0642\u0647\u0645 \u0645\u0646 \u0627\u0644\u0643\u0631\u0627\u0645\u0629 \u0648\u0627\u0644o\u0647\u062a\u0645\u0627\u0645 \u0639\u0644\u0649 \u0643\u0644 \u0648\u062c\u0647 \u0648\u0648\u062c\u0647</li>\n<li>\u0648\u0627\u062a\u0633\u0639 \u0645\u0639\u0647\u0645 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0628\u0627\u0628 \u0627\u062a\u0633\u0627\u0639 \u0643\u062b\u064a\u0631 \u0648\u062c\u0627\u0628 \u0641\u064a \u0630\u0644\u0643 \u0645\u0646 \u0627\u0644\u0646\u0635</li>\n<li>\u0627\u0644\u0634\u0631\u064a\u0641 \u0645\u0646 \u0627\u0642\u0648\u0627\u0644 \u05e8\u05d1\u05d5\u05ea\u05d9\u05e0\u05d5 \u0639\u0644\u064a\u0647\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0627 \u0641\u064a\u0647 \u0643\u0641\u0627\u0621\u0629 \u0641\u0644\u0645\u0627 \u0643\u0627\u0646 \u0641\u064a</li>\n<li>\u0627\u0644\u0633\u0628\u062a \u0627\u0644\u062b\u0627\u0646\u064a \u0639\u0648\u0648\u0644 \u0642\u0631\u0627\u0647 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0646\u0635 \u0627\u0644\u0634\u0631\u064a\u0641 \u0645\u0646 \u0627\u0642\u0648\u0627\u0644 \u05e8\u05d1\u05d5\u05ea\u05d9\u05e0\u05d5 \u0639\u0644\u064a\u0647\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0627 \u0641\u064a\u0647 \u0643\u0641\u0627\u0621\u0629 \u0641\u0644\u0645\u0627 \u0643\u0627\u0646 \u0641\u064a \u0627\u0644\u0633\u0628\u062a \u0627\u0644\u062b\u0627\u0646\u064a \u0639\u0648\u0648\u0644 \u0642\u0631\u0627\u0629 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0648\u0627\u0635\u0644 \u0645\u0646 \u062c\u0644\u0627\u0644\u0647\u0627 \u0644\u0627</li>\n<li>\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0644\u0627\u0