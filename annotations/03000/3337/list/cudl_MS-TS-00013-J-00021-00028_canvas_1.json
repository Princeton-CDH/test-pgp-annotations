          "value": "<p>\u0644\u064a \u0643\u062a\u0627\u0628\u0643 \u0628\u0645\u0627 \u0627\u0641\u0639\u0644 \u0648\u0627\u0646\u062a \u062a\u0639\u0644\u0645 \u0627\u0646 \u0627\u0644\u0637\u0631\u064a\u0642 \u0645\u0627 \u0628\u0642\u064a \u0644\u0647\u0627 \u063a\u064a\u0631 \u064a\u0633\u064a\u0631 \u0648\u062a\u0646\u0642\u0637\u0639 \u0648\u064a\u0628\u0642\u0627 \u0630\u0627\u0643 \u0639\u0646\u062f\u064a \u0648\u0627\u0646 \u0648\u0635\u0644\u0646\u064a \u0643\u062a\u0627\u0628\u0643 \u062d\u0627\u0644\u0627</p>\n<p>\u0627\u062e\u0631\u062c \u0628\u0647 \u0627\u0644\u0649 \u0635\u0647\u0631\u0643 \u0627\u0644\u0649 \u0642\u0644\u064a\u0648\u0628 \u0648\u0627\u062c\u064a \u0627\u0644\u0649 \u0639\u0646\u062f\u0643 \u0627\u0639\u0644\u0645\u062a\u0647 \u0630\u0644\u0643 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0645 \u0643\u0627\u062a\u0628 \u0647\u0630\u0647 \u0627\u0644\u0627\u062d\u0631\u0641 \u064a\u062e\u0635\u0643 \u0628\u0627\u0644\u0633\u0644\u0645</p>",
