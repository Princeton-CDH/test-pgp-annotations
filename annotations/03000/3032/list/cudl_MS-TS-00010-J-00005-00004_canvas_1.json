      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0627\u0646</li>\n<li>\u062d\u0631\u0645 \u0639\u0644\u064a</li>\n<li>\u0643\u0644 \u0647\u0630\u0647 \u0627\u0644\u0627\u0645\u0648\u0631 \u0635\u0627\u0628\u0631</li>\n<li>\u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627 \u0627\u0646 \u064a\u0633\u0647\u0644 \u0628\u0627\u0644\u0641\u0631\u062c \u0648\u0644\u0645\u0627 \u0627\u0646 \u0643\u0627\u0646 \u0642\u0628\u0644 \u0627\u0644\u0641\u0633\u062d \u0642\u0627\u0644\u0648</li>\n<li>\u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u05d6\u05db\u05d5\u05e8\u05d9\u05dd \u05dc\u05d8\u05d5\u05d1\u05d4 \u05e0\u05e9\u05d9\u05e8 \u05e2\u05dc\u05d9\u05da \u0628\u0627\u0646 \u062a\u0643\u0648\u0646 \u062a\u062a\u0642\u062f\u0645 \u0643\u0646\u064a\u0633\u0629 \u0627\u0644\u0639\u0631\u0627\u0642\u064a\u064a\u0646 \u0627\u0644\u064a \u0627\u0646 \u064a\u0641\u0631\u062c \u0627\u0644\u0644\u0647 \u0648\u062a\u062c\u0645\u0639 \u0634\u0645\u0644\u0646\u0627 \u0648\u0627\u0646\u0627 \u0627\u0642\u0648\u0644 \u0645\u0627 \u0627\u0641\u0639\u0644 \u0641\u0644\u0645\u0627 \u0627\u062c\u0628\u062a \u0639\u0644\u064a\u0643 \u0628\u0627\u0646 \u062a\u0643\u0648\u0646 \u062a\u062a\u0642\u062f\u0645</li>\n<li>\u0643\u0646\u064a\u0633\u0629 \u0627\u0644\u0639\u0631\u0627\u0642\u064a\u064a\u0646 \u0627\u0644\u0649 \u0627\u0646 \u064a\u0641\u0631\u062c \u0627\u0644\u0644\u0647 \u0648\u062a\u062c\u0645\u0639 \u0634\u0645\u0644\u0646\u0627 \u0648\u0627\u0646\u0627 \u0627\u0642\u0648\u0644 \u0645\u0627</li>\n<li>\u0627\u0641\u0639\u0644 \u0641\u0644\u0645\u0627 \u0627\u062c\u0628\u062a \u0627\u0644\u0649 \u0630\u0644\u0643 \u0627\u0646 \u0645\u0646 \u0644\u0647 \u0627\u0644\u0642\u0648\u0644 \u064a\u0634\u0631\u0637 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0627\u0646\u0647 \u0644\u0627</li>\n<li>\u064a\u0630\u0643\u0631 \u0627\u062d\u062f \u0648\u0644\u0627 \u064a\u062a\u0633\u0645\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0627\u062d\u062f \u0648\u0644\u0627 \u064a\u062e\u0631\u062c \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0643\u0646\u064a\u0633\u0629 \u0628\u0642\u064a\u064a\u0629</li>\n<li>\u0639\u0645\u0631\u0629 \u0641\u0644\u0645 \u0627\u062c\u064a\u0628 \u0627\u0644\u0649 \u0634\u064a \u0645\u0646 \u062c\u0645\u064a\u0639 \u0645\u0627 \u0630\u0648\u0643\u0631 \u0648\u0628\u0642\u064a\u062a \u0639\u0644\u0649 \u062d\u0627\u0644\u0649 \u0648\u0641\u064a \u0627\u0644\u062c\u0648\u0645\u0639\u0629</li>\n<li>\u0627\u0644\u0645\u0627\u0636\u064a\u064a\u0629 \u062c\u0627\u062b\u0646\u064a \u0645\u0631\u0629 \u062a\u0648\u0639\u0631\u0641 \u0628\u0632\u0648\u062c\u0647 \u0627\u0628\u0648 \u0634\u0647\u0648\u0627\u0646 \u0630\u0643\u0631\u062a \u0627\u0646 \u0644\u0647\u0627\u0639\u0646\u062f \u05ea\u05d7\u05ea</li>\n<li>\u05d9\u05d3 \u05d0\u05d3\u05d5\u05e0\u05d9\u05e0\u05d5 \u062f\u0627\u0631 \u0648\u0627\u0646 \u0642\u062f \u0643\u062a\u0628\u062a \u0639\u064a\u062f\u0647 \u0643\u062a\u0628 \u0648\u0645\u0627 \u062c\u0627\u0647\u0627 \u062c\u0648\u0627\u0628 \u0648\u0627\u0646 \u0628\u0631\u0643\u0627\u062a \u05d9\u05d6\u05db\u05e8</li>\n<li>\u05d1\u05de\u05e2\u05e9\u05d9\u05d5 \u064a\u0642\u0648\u0644 \u0644\u0647\u0627 \u0641\u064a \u0633\u0648\u0642 \u0627\u0644\u0642\u0648\u0637\u0646 \u0643\u064a\u0641 \u0631\u0627\u064a\u062a\u064a \u0627\u0646\u0641\u062f \u0627\u0644\u064a\u0643</li>\n<li>\u0644\u0627 \u062a\u0637\u0645\u0639\u0649 \u0646\u0641\u0633\u064a\u0643 \u0645\u0646\u0647\u0648 \u0628\u0634\u064a \u0641\u0645\u0627 \u064a\u0639\u0637\u0649 \u0627\u062d\u062f \u0644</li>\n<li>\u0627\u0644\u0627\u0645\u0631\u0627\u0629 \u0648\u062d\u062f\u0647\u0627 \u0627\u0644\u0627</li></ol>\n",
