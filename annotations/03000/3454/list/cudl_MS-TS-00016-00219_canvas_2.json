        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0647\u0631\u0648\u0646 \u0633\u062a \u0628\u0642\u0627 \u0643\u0627\u0648\u062a \u0627\u0645 \u0641\u0636\u0627\u0621\u0644 \u0641\u0635\u0627\u0621\u0644</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0634\u062a \u0627\u0644\u0646\u0627\u0633 \u0633\u062a \u0627\u0644\u0643\u0644 \u0627\u0645 \u0627\u0628\u0648 \u0633\u0639\u062f</li>\n<li>\u0627\u0644\u062d\u0627\u0646 \u0627\u0645 \u0627\u0628\u0648 \u0645\u0646\u0635\u0648\u0631 \u0627\u0628\u0648 \u0645\u0646\u0635\u0648\u0631 \u0627\u0628\u0648</li>\n<li>\u0627\u0644\u062d\u0628\u0631 \u0648\u0627\u0644\u062d\u0628\u0631 \u0627\u0628\u0648 \u0633\u0639\u062f \u0627\u0642\u0631\u0627\u0646 \u05de</li>\n<li>\u0627\u0645 \u0628\u0642\u0627 \u062f\u0644\u0627\u0644 \u0628\u0642\u0627 \u0633\u062a \u062d\u062f\u0642 \u0627\u0628\u0648 \u0633\u0639\u062f</li>\n<li>\u0641\u0643\u0631 \u062a\u0646\u0627 \u063a\u0627\u0631\u064a\u0629 \u0627\u0628\u0648 \u0633\u0639\u062f \u0628\u063a\u062f\u0627\u062f\u064a</li>\n<li>\u0627\u0644\u0639\u063a\u064a\u0631 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0645\u0641\u0643\u0631 \u0627\u0644\u0644\u0628\u0627\u0646 \u0627\u062e\u062a\u0647\u0627</li>\n<li>\u0627\u0645\u0647\u0627</li></ol>\n",
