      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0627\u0644 \u0628\u0647\u0630\u0647 \u0627\u0644</li>\n<li>\u0647\u0627 \u05d5\u05d0\u05ea\u05d4 \u0645 \u062a \u0628\u0642\u0648\u0627\u0646\u0647</li>\n<li>\u062d\u0648\u0627\u0626\u062c\u0643 \u0627\u0644\u0644\u0647 \u0645\u0646\u0627</li>\n<li>\u0645 \u0648\u0647\u0630\u0627 \u0630\u0647 \u064a\u0635\u0644</li>\n<li>\u0644\u0647 \u0627 \u0648\u064a\u0642\u0648\u0644 \u0644\u0647 \u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0648\u0645\u0627 \u0639 \u0644\u0627 \u0627\u0646</li>\n<li>\u0645\u0646 \u0627\u0644\u0644\u0647</li>\n<li>\u0648\u0627\u0644\u0641\u0636\u0629 \u0648\u0635\u0644\u062a \u0628\u0647 \u0648\u0627\u0644\u0645\u064a\u0639\u0629 \u0642\u062f \u0633\u064a\u0631\u0646\u0627 \u0644\u0643 \u05dc \u0627\u0648\u0627\u0642 \u0645\u0646</li>\n<li>\u0627\u0644 \u0648\u0641\u064a\u0647\u0627 \u0639\u0628\u062f\u0627\u0646\u0647\u0627 \u062f\u0644\u064a\u0644 \u062c\u0648\u062f\u062a\u0647\u0627 \u0641\u0644\u0627</li>\n<li>\u0627\u0646 \u0642\u0627\u0644 \u0627 \u0645\u0627 \u064a\u062e\u0644\u0649 \u0641\u064a\u0647 \u0633\u0648\u0627 \u0627\u0631\u0628\u0639 \u062f\u0631\u0627\u0647\u0645 \u0647</li>\n<li>\u0644\u0648\u062a\u0643 \u0645\u0646 \u064a\u062e\u0628\u0631 \u0627\u0644\u0639\u0642\u0627\u0642\u064a\u0631 \u0627\u0646\u0647 \u0645\u0627 \u0644\u0647 \u0642\u064a\u0645\u0629 \u0648\u0627\u0646\u0647 \u062e\u064a\u0631 \u0645\u0646 \u0627\u0631\u0628\u0639</li>\n<li>\u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0642\u062f \u063a\u0641 \u0648\u0638\u0647\u0631 \u0644\u0648\u0646\u0647 \u0639\u0644\u0649 \u0627\u0644\u063a\u0641\u0627\u0641 \u0641\u064a\u0643\u0648\u0646 \u0642\u0644\u0628\u0643 \u0628\u0647 \u0627\u0644\u0644\u0647</li>\n<li>\u0645\u0645\u0627 \u0647 \u0627\u0647\u0644 \u0627\u0644\u062e\u0628\u0631\u0629 \u0648\u0627\u0644\u0637\u062d\u0627\u0646\u064a\u0646 \u0645\u0646\u0639\u0648\u0646\u0627 \u0627\u0646 \u0646\u0639\u0645\u0644 \u0628\u0647 \u062b</li>\n<li>\u0639\u0644\u0649 \u0648\u0647\u0648 \u0639\u0627\u0644 \u063a\u0627\u064a\u0629 \u0628\u0644 \u0645\u0646 \u0639\u062c\u0644\u062a\u0646\u0627 \u0645\u0627 \u0639\u0631\u0641\u0646\u0627 \u0639\u0646 \u064a\u0642\u064a\u0646 \u0643\u0645 \u0643\u0627\u0646 \u0648\u0632\u0646\u0647</li>\n<li>\u0641\u064a \u0627\u0644\u063a\u0631\u0627\u0631 \u0628\u0644 \u0646\u0642\u0648\u0644 \u0627\u0646 \u0643\u0627\u0646 \u0648\u0632\u0646\u0647 \u0645\u0627\u0626\u062a\u064a\u0646 \u062f\u0631\u0647\u0645 \u0648\u0639\u064a\u0627\u0631 \u0627\u0644\u0640\u05d1\u05e8\u05e0\u05d9\u05d4 \u0641\u064a \u0648\u0631\u0642\u0647</li>\n<li>\u0645\u0631\u0645\u064a \u0641\u064a \u0648\u0632\u0646\u0647 \u0641\u064a \u0627\u0644\u063a\u0631\u0627\u0631 \u0628\u0644 \u0646\u0642\u0648\u0644 \u0627\u0646 \u0643\u0627\u0646 \u0648\u0632\u0646\u0647 \u0645\u0627\u064a\u062a\u064a\u0646 \u062f\u0631\u0647\u0645 \u0648\u0639\u064a\u0627\u0631 \u0627\u0644\u0640\u05d1\u05e8\u05e0\u05d9\u05d4 \u0641\u064a \u0648\u0631\u0642\u0647 \u0645\u0631\u0645\u064a \u0641\u064a \u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646 \u0648\u064a\u0627 \u0627\u062e\u064a \u0639\u064a\u0631 \u0627\u0644\u0640\u05d1\u05e8\u05e0\u05d9\u05d4 \u0648\u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646 \u0648\u0627\u0633\u0642\u0637 \u0639\u064a\u0627\u0631 \u0627\u0644\u0640\u05d1\u05e8\u05e0\u05d9\u05d4</li>\n<li>\u0648\u062a\u0628\u064a\u0646 \u0644\u0643 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0632\u0639\u0641\u0631\u0627\u0646 \u0648\u0642\u062f \u0627\u062c\u062a\u0645\u0639\u062a \u0628\u0627\u0628\u0648 \u0633\u0639\u062f \u0648\u0628\u0639\u0645\u0643 \u0628\u064a\u0627\u0646 \u0648\u0642\u0627\u0644\u0648 \u0627\u0646\u0647\u0645</li>\n<li>\u064a\u062e\u0631\u062c\u0648 \u0648\u0627\u0646\u0627 \u0639\u064a\u0646\u064a \u0631\u0645\u062f\u0629 \u0648\u0627\u0633\u062d\u0642 \u0627\u064a\u0636\u0627 \u0641\u0627\u0646 \u0631\u0627\u064a\u062a \u0627\u0646 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u062e\u0631\u0648\u062c \u062e\u0631\u062c