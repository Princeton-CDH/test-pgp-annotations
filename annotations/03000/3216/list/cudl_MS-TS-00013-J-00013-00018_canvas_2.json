      "body": [
        {
          "type": "TextualBody",
          "label": "Verso.",
          "value": "\n<ol><li>\u0633\u064a\u0631\u0629 \u0644\u0647 \u0646\u062d\u0627\u0644\u064a\u0646 \u0642\u0634\u0627\u0637\u0629</li>\n<li>\u0645\u0639 \u0628\u0646 \u062d\u0627\u062c\u0629 \u0648\u0642\u0641\u0629 \u0641\u064a\u0647\u0627</li>\n<li>\u0646\u0635\u0641 \u0648\u064a\u0628\u0647 \u062e\u0631\u0627\u0648\u064a\u0629 \u0645\u063a\u0631\u0628\u0644\u0629</li>\n<li>\u0631\u0628\u0639 \u0644\u0647\u0627 \u0646\u0635\u0641 \u0648\u064a\u0628\u0629 \u062e\u0631\u0627\u0648\u064a\u0629 \u0645\u062c\u0631\u0628\u0644\u0629 \u0631\u0628\u0639 \u0644\u0647\u0627 \u0648\u0631\u0628\u0639 \u0644\u0634\u064a\u0643 \u0645\u0639\u0627\u0646\u064a</li>\n<li>\u0648\u0647\u064a \u0628\u0644\u0627 \u062b\u0645\u0646 \u062a\u0641\u0636\u0644\u0643\u0645 \u0639\u0644\u064a\u0646\u0627</li>\n<li>\u0648\u0632\u0627\u062f \u0639\u0644\u064a\u0646\u0627 \u0643\u0644 \u0645\u0646\u0627 \u0633\u062a\u064a\u0646 \u062f\u064a\u0646\u0627\u0631</li>\n<li>\u0648\u0633\u0644\u0645\u0646\u0627 \u0644\u0647 \u0648\u0641\u0631\u062d\u062a \u063a\u0627\u064a\u0629 \u0645\u0627</li>\n<li>\u064a\u0643\u0648\u0646 \u0648\u0627\u0646\u0627 \u062f\u0627\u062e\u0644 \u0645\u0627 \u0639\u0627\u0642\u0646\u064a \u0633\u0648\u0627</li>\n<li>\u0627\u0644\u0630\u064a \u0644\u0646\u0627 \u0628\u0631\u0627 \u0627\u0644\u0639\u0627\u0642\u0628\u0629 \u0644\u0647\u0627</li>\n<li>\u062a\u062a\u062e\u0644\u0635 \u0648\u062a\u062a\u0643\u0644 \u0648\u064a\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u0644\u0647</li>\n<li>\u0643\u0644 \u062e\u064a\u0631 \u0648\u0644\u0631\u0633\u0642 \u064a\u062d\u062a \u0627\u0644\u0627\u0646\u0633\u0627\u0646</li>\n<li>\u0643\u0645\u0627 \u064a\u062d\u062a \u0627\u0644\u062c\u0644\u0644 \u0641\u062a\u062d\u0631\u0636 \u062a\u062a\u062e\u0644\u0635</li>\n<li>\u062a\u062a\u062e\u0644\u0635 \u0645\u0646 \u0643\u0644 \u0628\u062f \u0648\u0645</li>\n<li>\u0648\u0633\u0627\u0644\u0649 \u0639\u0646 \u0627\u0648\u0644\u0627\u062f \u062e\u0627\u0644\u0649 \u0648\u0639\u0646 \u0627\u0644\u062c\u0644\u0644 \u0641\u062a\u062d\u0631\u0635 \u062a\u062a\u062e\u0644\u0635 \u062a\u062a\u062e\u0644\u0635 \u0645\u0646 \u0643\u0644 \u0628\u062f \u0648\u0645 \u0648\u0633\u0627\u0644\u064a \u0639\u0646 \u0627\u0648\u0644\u0627\u062f \u0643\u0627\u0644\u064a \u0648\u0639\u0646 \u0627\u0628\u0648\u0647</li>\n<li>\u0646\u062c\u0645 \u0648\u0639\u0646 \u0627\u0628\u0648 \u0627\u0644\u0645\u0639\u0627\u0644\u064a \u0648\u0627\u0628\u0648 \u0627\u0644\u0641\u0643\u0631</li></ol>\n\n<p>\u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u062c\u0648\u0627\u0628 \u0647\u0627\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628</p>\n<p>\u062a\u0633\u064a\u0631\u0629 \u0644\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0648\u0644\u0648 \u0634\u0631\u062d\u062a \u0644\u0647\u0627 \u0645\u0627 \u0639\u0644\u0627</p>\n<p>\u0642\u0644\u0628\u064a \u0645\u0646 \u062e\u0644\u0627\u0635\u064a \u0645\u0646 \u0627\u0644\u0631\u064a\u0641 \u0644\u0645\u0627 \u064a\u0633\u0639\u0647 \u0643\u062a\u0627\u0628 \u0648\u0633\u0644\u0627\u0645</p>",
          "format": "text/html"
        }
      ],
