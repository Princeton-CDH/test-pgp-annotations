        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u064a\u0627\u062e\u064a \u0628\u0642\u0627\u0643 \u0648\u0627\u0639\u0632\u0643 \u0648\u0627\u062e\u0631\u0645\u0643 \u0648\u0627\u062a\u0645 \u0646\u0639\u0645\u062a\u0647 \u0639\u0644\u064a\u0643 \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 \u0645\u0646 \u0627\u0644</li>\n<li>\u0642\u064a\u0631\u0648\u0627\u0646 \u0627\u0648\u0644 \u064a\u0648\u0645 \u0645\u0646 \u0643\u0633\u0644\u064a\u0628 \u0648\u0627\u0646\u0627 \u0645\u0634\u062a\u0649 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0629 \u0648\u0639\u0627\u0641\u064a\u0629 \u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0639\u0644\u0649</li>\n<li>\u0630\u0644\u0643 \u0648\u0627\u062e\u064a \u0643\u062a\u0628\u062a \u0627\u0644\u064a\u0643\u0645 \u0643\u062a\u0627\u0628 \u0645\u0639 \u0627\u0628\u0646 \u0627\u0628\u0648 \u0628\u0648\u0631\u062f\u0627 \u0648\u0639\u0631\u0641\u062a\u0643 \u0641\u064a\u0647 \u062c\u0645\u064a\u0639</li>\n<li>\u0627\u0644\u0627\u0633\u0639\u0627\u0631 \u0643\u0644\u0647\u0627 \u0648\u0644\u0627 \u062a\u0643\u0644\u0649 \u0646\u0641\u0633\u0643 \u0645\u0646 \u0627\u0644\u0633\u0642\u0637 \u0644\u0627\u0646\u0647 \u0632\u0627\u062f \u0639\u0646\u062f\u0646\u0627 \u0648\u0627\u0644\u0646\u064a\u0644 \u0627\u0644</li>\n<li>\u0639\u0648\u0627\u0646\u064a \u0644\u0627 \u062a\u0634\u062a\u0631\u0649 \u0645\u0646\u0647 \u0627\u0644\u0627 \u0645\u0627 \u0643\u0627\u0646 \u062c\u064a\u062f \u0631\u0641\u064a\u0639 \u0644\u0627\u0646 \u0627\u0644\u062f\u0648\u0646 \u0645\u0627 \u064a\u0633\u0648\u0627 \u0634\u064a</li>\n<li>\u0648\u0645\u0627 \u062a\u0631\u064a\u062f \u0639\u0644\u0645\u0647 \u0645\u0646 \u0627\u0633\u0639\u0627\u0631 \u0633\u0642\u0644\u064a\u0629 \u0627\u0644 \u0646\u0647\u0627 \u0646\u0627\u0641\u0642\u0629 \u0627\u0644\u0641\u0644\u0641\u0644 \u05e7\u05e0 \u0631\u0628\u0627\u0639\u064a \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0648\u0627\u0644</li>\n<li>\u0627\u0644\u0627\u0632\u0648\u0631\u062f \u0627\u0644\u0637\u064a\u0628 \u063a\u064a\u0628 \u0645\u0646\u0647 \u05db \u0645\u0646 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0627\u0644\u062f\u0648\u0646 \u0631\u062e\u064a\u0635 \u063a\u064a\u0628 \u0645\u0646\u0647</li>\n<li>\u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u0648\u063a\u064a\u0628 \u0642\u0637\u0639\u0629 \u0635\u0628\u0631 \u0648\u0642\u0637\u0639\u0629 \u0648\u0634\u0642 \u0648\u062d\u0644\u062a\u064a\u062a \u0648\u0633\u0646\u0629 \u0648\u0646\u0635\u0641 \u0642\u0646\u0638\u0627\u0631</li>\n<li>\u05d5\u05d9 \u0627\u0631\u0637\u0627\u0644 \u062a\u0648\u062a\u064a\u0627 \u062e\u0635\u0631\u0627 \u0648\u0631\u0628\u0639 \u0642\u0646\u0638\u0627\u0631 \u062a\u0646\u0643\u0627\u0631 \u0648\u0643\u0648\u0644\u0646\u062c\u0627\u0646 \u063a\u064a\u0628 \u0645\u0646\u0647</li>\n<li>\u0627\u0644\u062d\u0646\u0629 \u0628\u062f\u064a\u0646\u0631 \u0627\u0644\u0645\u0646 \u0648\u0643\u0627\u0646 \u062a\u062c\u064a\u0628 \u0645\u0646\u0647 \u05dc \u0645\u0646 \u0648\u0642\u0631\u0641\u0629 \u0645\u0628\u064a\u0648\u0639\u0629 \u0627\u0644\u062d\u0645\u0631\u0629 \u062a\u0633\u0646\u0627</li>\n<li>\u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u062a\u062c\u064a\u0628 \u0645\u0627 \u0627\u0645\u0643\u0646\u0643 \u0645\u0646\u0647\u0627 \u0648\u0627\u0644\u0643\u0627\u0641\u0648\u0631 \u05d9 \u0631\u0628\u0627\u0639\u064a\u0629 \u0627\u0644\u0648\u0642\u064a\u0629</li>\n<li>\u0631\u0628\u0627\u0639\u064a\u0629 \u0627\u0644\u0645\u0646 \u0627\u0644\u0646\u0634\u0627\u062f\u0631 \u0645\u0646\u064a\u0646 \u0628\u062f\u064a\u0646\u0631 \u0627\u0644\u0642\u0627\u0642\u0644\u0629 \u0628\u062f\u064a\u0646\u0631 \u05d5\u05e8</li>\n<li>\u05d1\u05e2</li>\n<li>\u0628\u062f\u064a\u0646\u0631 \u0648\u0631\u0628\u0639 \u0627\u0644\u0645\u0646 \u0627\u0644\u062f\u0627\u0631\u0643\u0633\u0627 \u05e0 \u0631\u0628\u0627\u0639\u064a\u0629 \u0627\u0644\u0645\u0646 \u0627\u0644\u0637\u0631\u0627\u0634\u064a\u0631</li>\n<li>\u05d4 \u05d2 \u062f\u0646\u0627\u0646\u064a\u0631 \u0627\u0644\u0645\u0646 \u0648\u062c\u064a\u0628 \u0644\u064a \u05db \u0631\u0637\u0644 \u0632\u0648\u0641\u0629 \u0627\u0644\u0643\u0648\u0644\u0627\u0646 \u05d2 \u0627\u0631\u0637\u0627\u0644 \u0628\u062f\u064a\u0646\u0631 \u0627\u0644</li>\n<li>\u0631\u0628\u0627\u0639\u064a \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0627\u0644\u0634\u064a\u0627\u0646 \u05d3 \u0627\u0631\u0637\u0627\u0644 \u0628\u062f\u064a\u0646\u0631 \u0648\u0627\u0644\u062a\u0631\u0628\u062f \u063a\u064a\u0628 \u0645\u0646\u0647</li>\n<li>\u0634\u062f\u0629 \u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0643\u0627\u0646 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u0648\u0643\u062a\u0628\u062a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0627 \u0635\u063a\u0646\u0629 \u0648\u0627\u0633\u0639\u0627\u0631 \u0627\u0644</li>\n<li>\u062d\u0631\u064a\u0631 \u0627\u0644\u062c\u064a\u0632\u064a \u0628\u062f\u064a\u0646\u0631\u064a\u0646 \u0627\u0644\u0631\u0637\u0644 \u0648\u0639\u0633\u0649 \u062a\u0634\u062a\u0631\u064a \u0644\u064a \u0631\u062f\u0627 \u0644\u0637\u064a\u0641 \u0644\u0635\u0628\u064a \u0648\u0646\u0635\u0641</li>\n<li>\u0644\u0627 \u064a\u0643\u0648\u0646 \u0628\u062f \u0645\u0646\u0647 \u0648\u0646\u0639\u0627\u0644 \u0644\u0637\u064a\u0641 \u0648\u0644\u0627 \u064a\u0643\u0648\u0646 \u0645\u063a\u064a\u0643 \u0627\u0644\u0627 \u0644\u0633\u0642\u0644\u064a\u0629 \u0648\u0627\u0646 \u0644\u0645 \u062a\u0634\u062a\u0647\u064a \u0648\u062c\u0647 \u0644\u064a \u0627\u0646\u0627</li>\n<li>\u0644\u0633\u0642\u0644\u064a\u0629 \u0648\u0644\u0627 \u062a\u062c\u064a\u0628 \u0644\u064a \u0628\u062f\u0631\u0627\u0647\u0645\u064a \u0627\u0644\u0627 \u0627\u0633\u0642\u0627\u0637 \u0645\u062c\u064a\u0643 \u0627\u0644\u0627 \u0644\u0633\u0642\u0644\u064a\u0629 \u0648\u0627\u0646 \u0644\u0645 \u062a\u0634\u062a\u0647\u064a \u0648\u062c\u0647 \u0644\u064a \u0627\u0646