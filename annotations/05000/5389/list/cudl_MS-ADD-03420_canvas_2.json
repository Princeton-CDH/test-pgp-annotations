    {
      "etag": "\"ac1a42c4db9a28fa21583f71faccb5d2\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/f8013de2-0f7b-4d62-9437-07b77c85ecc7/",
      "type": "Annotation",
      "created": "2026-03-14T14:37:56.308666+00:00",
      "modified": "2026-03-14T14:37:56.308674+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/8/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-ADD-03420/canvas/2",
          "type": "Canvas",
          "partOf": {
