    {
      "etag": "\"2b59ad67202153989c5781c74d71fcd6\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/77258086-e4f3-495a-82d3-58e81f28598a/",
      "type": "Annotation",
      "created": "2025-03-18T13:53:15.546063+00:00",
      "modified": "2025-03-18T13:53:15.546079+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00028-00009/canvas/2",
          "type": "Canvas",
          "partOf": {
