      "body": [
        {
          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>\u0644\u0627\u062c\u0644 \u0627\u0646\u0642\u0637\u0627\u0639 \u0643\u062a\u0628\u0643\u0645 \u0639\u0646\u064a \u0648\u0627\u0646\u0627 \u0641\u064a \u0628\u0644\u062f \u063a\u0631\u0628\u0647 \u0648\u0645\u0627 \u0627\u0639\u0631\u0641 \u0627\u062d\u062f \u0648\u0639\u0644\u0649 \u0628\u0644\u062f \u063a\u0631\u0628\u0629 \u0648\u0645\u0627</li>\n<li>\u0627\u0639\u0631\u0641 \u0627\u062d\u062f \u0648\u0639\u0644\u0649 \u0627\u0646 \u0627\u0647\u0644\u0647\u0627 \u0643\u0644\u0647\u0645 \u064a\u0628\u063a\u0644\u0648\u0646\u064a \u0645\u0627</li>\n<li>\u062e\u0644\u0627 \u0635\u062f\u064a\u0642\u0643 \u0648\u0647\u064a\u0628 \u0627\u0644\u062d\u0632\u0646 \u0628\u0627\u0646\u0647 \u0646\u0633\u0644\u0645 \u0639\u0644\u064a\u0647 \u0645\u0627</li>\n<li>\u064a\u0631\u0636\u0627 \u064a\u0631\u062f \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0646\u0627 \u0627\u0633\u0627\u0644\u0643 \u0627\u0646 \u0643\u062a\u0628\u062a \u0643\u062a\u0627\u0628</li>\n<li>\u0627\u0643\u062a\u0628 \u0641\u064a \u062f\u0631\u062c\u0629 \u0627\u0644\u064a\u0647 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643</li>\n<li>\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0628\u0646\u062a\u0643 \u062a\u0642\u0631\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0628\u0646\u0647\u0627</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u0628\u0631\u0643\u0627\u062a \u064a\u062e\u0635\u0643 \u0628\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u064a\u062e\u0635 \u0643\u0648\u0644\u062a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0627\u0644\u0628\u0634\u0631 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0645\u0627 \u062c\u0639\u0644\u0646\u064a \u0627\u0646\u0641\u062a \u0627\u0644\u064a\u0643 \u0641\u064a \u0642\u0635\u0627 \u0627\u0644 \u0644\u0627\u0646\u0643</li>\n<li>\u0627\u0644\u0627 \u0642\u0644\u062a \u0644\u0627 \u062a\u062e\u0631\u062c \u0645\u0646 \u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0648\u0627\u0646\u0627 \u0645\u0634\u062a\u0649</li>\n<li>\u0639\u0644\u0649 \u0643\u0644 \u062d\u0627\u0644 \u0641\u062a\u062a\u0641\u0636\u0644 \u062a\u0631\u0633\u0644\u0647\u0645 \u0648\u0627\u0646\u062a \u062a\u0643\u0633\u0649 \u0627\u0644</li>\n<li>\u063a\u0631\u0628\u0629 \u0641\u0636\u0644\u0627 \u0639\u0646 \u0627\u0644\u0648\u062f\u064a\u0639\u0627 \u0639\u0646\u062f\u0643 \u05d5\u05e9\u05dc\u05d5\u05dd</li></ol>\n",
