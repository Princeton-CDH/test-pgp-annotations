          "label": "Recto - right margin",
          "value": "<ol>\n<li>&nbsp;\u05d0\u05dc\u05dc\u05d4</li>\n<li>\n<p>&hellip;</p>\n</li>\n<li>\n<p>&hellip;</p>\n</li>\n<li>\n<p>\u05d5\u05e1\u05e2\u05e8</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05e7\u05de\u05d7</p>\n</li>\n<li>\n<p>\u05e2\u05e0\u05d3\u05e0\u05d0</p>\n</li>\n<li>\n<p>\u05d5 \u05d5\u05d9\u05d1\u05d0\u05ea</p>\n</li>\n<li>\n<p>\u05d1\u05d3\u05d9\u05e0\u05e8</p>\n</li>\n<li>\n<p>\u05d5\u05d0\u05dc\u05e6\u05e8\u05e3</p>\n</li>\n<li>\n<p>\u05de\u05d2</p>\n</li>\n<li>\n<p>\u05e7\u05e8\u05d0\u05ea</p>\n</li>\n<li>\n<p>\u05e2\u05dc\u05d9\u05da</p>\n</li>\n<li>\n<p>\u05d0\u05e4\u05e6\u05dc</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05e1\u05dc\u05d0\u05dd</p>\n</li>\n<li>\n<p>\u05d5\u05de\u05d5\u05dc\u05d0\u05d9</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05e9\u05d9\u05da</p>\n</li>\n<li>\n<p>\u05e1\u05dc\u05de\u05d4</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05dc\u05d4</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05e1\u05dc\u05d0\u05dd</p>\n</li>\n<li>\n<p>\u05d5\u05e1\u05d9\u05d3\u05d9 \u05db\u05d0\u05dc\u05d9</p>\n</li>\n<li>\n<p>\u05e1\u05dc\u05de\u05d4</p>\n</li>\n<li>\n<p>\u05d0\u05dc\u05dc\u05d4</p>\n</li>\n<li>\n<p>\u05d0\u05df \u05db\u05d0\u05df</p>\n</li>\n</ol>\n<p>&nbsp;</p>",
