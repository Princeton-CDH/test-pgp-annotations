        {
          "type": "TextualBody",
          "label": "verso, bottom margin",
          "value": "<p dir=\"rtl\">\u05e2\u05d5\u05ea\u05e7 \u05d4\u05de\u05db\u05ea\u05d1 \u05d4\u05e9\u05e0\u05d9 //\u05e9\u05db\u05ea\u05d1\u05ea\u05d9\u05d5\\\\ \u05d1\u05ea\u05d5\u05d3\u05d4 \u05dc\u05e9\u05d9\u05da' \u05d0\u05d1\u05e8\u05d4\u05dd \u05d6\u05e7\u05df \u05d4\u05e7\u05d4\u05dc\u05d5\u05ea \u05e0\u05d8' [\u05e8\u05d7'].</p>\n<p></p>",
          "format": "text/html"
        }
      ],
