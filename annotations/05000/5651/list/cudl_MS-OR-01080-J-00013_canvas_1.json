      "body": [
        {
          "type": "TextualBody",
          "label": "recto - top margin",
          "value": "\n<ol><li>\u0648\u0627\u0644\u0645\u0643\u062b\u0631\u0629</li>\n<li>\u0648\u0632\u0646\u062a\u0647 \u0627\u0646\u062a</li>\n<li>\u0648\u062d\u0633\u0628\u062a\u0647 \u05db\u05d4</li>\n<li>\u0641\u062a\u0627\u0645\u0644 \u062d\u0633\u0628\u0647</li>\n<li>\u0648\u062a\u0643\u062a\u0628 \u0627\u0644\u064a\u0647</li>\n<li>\u0628\u0635\u062d\u062a \u0630\u0644\u0643</li>\n<li>\u0648\u0643\u0630\u0644\u0643 \u062d\u0644\u0641</li>\n<li>\u0627\u0646\u0647 \u0644\u0627 \u064a\u062e\u0630</li>\n<li>\u0627\u0644\u0642\u0631\u0641\u0629 \u0648\u0627\u0644</li>\n<li>\u0641\u0644\u0641\u0644 \u0648\u062a\u0645\u0631</li>\n<li>\u0647\u0646\u0630\u064a \u0627\u0648 \u064a\u0632\u0646</li>\n<li>\u062a\u0645\u0646\u0647\u0645 \u0641\u062a\u0643\u062a\u0628</li>\n<li>\u0645\u0628\u0644\u063a \u062a\u0645\u0646\u0647</li>\n<li>\u0648\u062a\u0639\u0631\u0641\u0647 \u0644\u0645\u0646</li>\n<li>\u064a\u062f\u0641\u0639 \u062b\u0645\u0646</li>\n<li>\u0627\u0644\u062c\u0645\u064a\u0639</li>\n<li>\u0648\u0642\u062f \u0642\u0627\u0644 \u0644\u0643</li>\n<li>\u05d9\u05d5\u05e1\u05e3 \u05d1\u05df \u05e2\u05dc\u05d9</li>\n<li>\u0627\u0644\u0643\u0647\u0646 \u0627\u0646</li>\n<li>\u0639\u0631\u0636 \u0639\u0644\u064a\u0643</li>\n<li>\u062b\u0645\u0646 \u0647\u0630\u064a \u0627\u0644</li>\n<li>\u062d\u0648\u064a\u062c \u0641\u0627\u0628\u064a\u062a</li>\n<li>\u0627\u0646 \u062a\u062e\u0630\u0647</li>\n<li>\u0645\u0646\u0647 \u0645\u0646</li>\n<li>\u062d\u0633\u0627\u0628 \u0643\u0627\u0646</li>\n<li>\u0628\u064a\u0646\u0647\u0645 \u0641\u0644\u0627</li>\n<li>\u064a\u0643\u0627\u0646 \u0628\u062f \u0645\u0646</li>\n<li>\u0627\u0646 \u062a\u0643\u062a\u0628</li>\n<li>\u0643\u0645 \u062a\u0645\u0646\u0647 \u0644\u0647</li>\n<li>\u0648\u0644\u0645\u0646 \u064a\u062f\u0641\u0639\u0647</li></ol>\n",
