      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627\u0644\u062b\u0645\u0646 \u063a\u0641\u062f \u0648\u0635\u062d \u0648\u0632\u0646 \u0627\u0644\u062c\u0648\u0646\u064a\u0629 \u0627\u0644\u0627\u062e\u0631\u0627 \u0628\u0647\u0627\u0631\u064a\u0646 \u063a\u064a\u0631 \u0633\u0628\u0639\u0629 \u0627\u0631\u0637\u0627\u0644 \u0633\u0639\u0631 \u0647 \u05de \u0627\u0644\u062b\u0645\u0646 \u05d8 \u05e4 \u062f\u064a\u0646 \u0648\u0644\u0647 \u0645\u0646 \u062a\u0633\u0644\u064a\u0645 \u064a\u0627\u0642\u0648\u062a \u0627\u064a\u0636\u0627 \u0639\u0648\u0636 \u0639\u0646 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0645\u062a\u0642\u0627\u0644 \u0627\u0644\u0628\u0627\u0642\u064a \u0639\u0646\u062f\u0647 \u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u062f\u0627\u0644\u0643 \u062c\u0645\u0644\u0629 \u0645\u0627\u0644\u0629 \u0633\u062a \u0645\u0627\u0629 \u062e\u0645\u0633\u0629 \u0648\u062b\u0645\u0627\u0646\u064a\u0646 \u062f\u064a\u0646 \u063a\u064a\u0631 \u0633\u062f\u0633 \u0639\u0644\u064a\u0647 \u0627\u0644\u0639\u0634\u0648\u0631 \u0639\u0646 \u0627\u0644\u0641\u0644\u0641\u0644 \u05e7 \u05d4 \u05e0 \u062f\u064a\u0646 \u0648\u062b\u0644\u062b \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u0648\u0642\u064a\u0645\u0629 \u0627\u0639 \u0648\u0627\u0644\u062d\u0645\u0627\u0644 \u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u0648\u0635\u0644\u0629 \u0627\u0644\u062c\u0648\u0646\u064a\u062a\u064a\u0646\u0644\u0627\u0644\u0631 \u05e6\u05d4 \u0627\u0639 \u0648\u0627\u0644\u062d\u0645\u0627\u0644 \u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u0648\u0635\u0644\u0629 \u0627\u0644\u062c\u0648\u0646\u064a\u062a\u064a\u0646\u0644\u0627\u0644\u0631 \u0635\u0629 \u05d2 \u0627\u0628\u0647\u0631\u0629 \u0648\u0637\u0627 \u0639\u0634\u0631 \u062f\u064a\u0646 \u0648\u0646\u0635\u0641 \u0645\u0646 \u0627\u064a\u064a \u0627\u0644\u0627 \u064a\u0627\u0631 \u0627\u0644\u0631\u0628\u0627\u0646 \u05d1 \u0628\u0644\u063a \u05d7 \u0639 \u0648\u0644\u064a \u0648\u0642\u062f\u0631 \u0639\u0644\u064a\u064a\u0642\u062f\u0631\u0648 \u0639\u0644\u064a\u0647 \u0648\u0642\u062f \u0641\u064a\u0634\u062a\u0631 \u0645\u0646 \u0639\u0646\u062f\u064a \u0639\u0645 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u063a\u0627\u0644\u0628 \u0627\u0644\u0631\u0628\u0627\u0646 \u0648\u0628\u0627\u0644\u0644\u0647 \u0644\u0642\u062f \u0627\u0647\u062f\u064a\u062a \u0644\u0647 \u0645\u0646 \u0639\u0646\u062f\u064a \u0647\u062f\u064a\u064a\u0629 \u062f\u0641\u0639\u062a\u064a\u0646 \u0639\u0644\u0627 \u062d\u0645\u0644 \u0647\u0627\u0630\u0627 \u0627\u0644\u0635\u0641\u0631 \u0648\u062d\u0641\u0636\u0629 \u0644\u0627 \u063a\u064a\u0631 \u0644\u0627\u0646 \u0645\u0627 \u0647\u0648 \u0648\u062e\u064a\u0644\u064a \u0648\u0644\u0627 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0647 \u0645\u0639\u0627\u0645\u0644\u0629 \u0644\u0627\u0646 \u0627\u0644\u0631\u0637\u0627\u0626\u0644 \u0635\u062f\u0627\u0639 \u0648\u0639\u0644\u064a\u0647 \u062e\u0631\u062c \u0627\u0644\u0641\u0631\u0636\u0629 \u0639\u0646 \u0627\u0644\u0635\u0641\u0631 \u05d3 \u062f\u0646 \u0648\u0646\u0635\u0641 \u0648\u0627\u0644\u0646\u0648\u0644 \u0641\u0642\u062f \u0633\u0627\u0644\u062a \u0627\u0644\u0634\u064a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0646\u064a\u0644\u064a \u0628\u0647 \u0648\u062c\u0639\u0644\u062a\u0647 \u0628\u0627\u0633\u0645\u0649 \u0648\u0627\u0644\u0630\u064a \u0627\u0647\u062f\u064a\u062a \u0645\u062b\u0644 \u0627\u0644\u0646\u0648\u0644</p>",
