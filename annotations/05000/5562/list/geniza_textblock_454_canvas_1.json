      "body": [
        {
          "type": "TextualBody",
          "label": "Recto - right margin",
          "value": "\n<ol><li>\u0644\u064a \u0639\u0644\u064a\u0647 \u0641\u064a \u0635\u0631\u0641\u0647\u0627</li>\n<li>\u0644\u0627\u0646 \u0633\u0627\u0644\u062a\u0647 \u0635\u0631\u0641\u0647\u0627 \u0644\u064a</li>\n<li>\u0648\u0642\u062a \u0648\u0635\u0648\u0644\u0647 \u0648\u0643\u0630\u0644\u0643</li>\n<li>\u0645\u0639 \u05e8 \u05de\u05e6\u05dc\u05d9\u05d7 \u05ea\u05e9</li>\n<li>\u0648\u0633\u0627\u0644\u062a\u0647 \u0627\u064a\u0636\u0627 \u064a\u0635\u0631\u0641\u0647\u0627</li>\n<li>\u0644\u064a \u0641\u0627\u062d\u0628 \u062a\u0648\u0643\u062f \u0644\u064a \u0639\u0644\u064a\u0647</li>\n<li>\u0641\u064a \u0635\u0631\u0641\u0647\u0627 \u0648\u0642\u062f \u0633\u0627\u0644\u062a\u0643</li>\n<li>\u062a\u0634\u062a\u0631\u0649 \u0644\u064a \u0639\u0644\u0627\u0648\u0629 \u0641\u064a\u0647\u0627</li>\n<li>\u05e7 \u062e\u0648\u0632</li>\n<li>\u0644\u064a \u0628\u062a\u0645\u0646\u0647\u0627 \u0648\u0645\u0627</li>\n<li>\u0643\u0627\u0646\u062a \u0644\u0643 \u0645\u0646 \u062d\u0627\u062c\u0629</li></ol>\n",
          "format": "text/html"
        }
