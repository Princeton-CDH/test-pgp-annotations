      "dc:source": "https://geniza.princeton.edu/sources/64/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/243f4cf7-3195-4a59-8ca4-d5f8b828ad8e/manifest/canvas/55c6891b-b9c1-442e-8720-666f89d66936",
