      "id": "https://test-geniza.cdh.princeton.edu/annotations/b07c3b1a-44a9-44d8-a216-74a561603cbe/",
      "type": "Annotation",
      "created": "2025-06-05T22:21:31.085548+00:00",
      "modified": "2026-01-26T18:05:58.304669+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1120/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/5498/iiif/textblock/30311/canvas/1/",
          "type": "Canvas",
          "partOf": {
