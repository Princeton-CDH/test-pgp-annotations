        {
          "type": "TextualBody",
          "label": "recto, margins",
          "value": "\n<ol><li>\u0642\u0644\u0629 \u0627\u0644\u0645\u0631\u0648\u0629</li>\n<li>\u0648\u0642\u0644\u0629 \u0627\u0644\u0627\u0646\u0635\u0627\u0641\u0641\u064a</li>\n<li></li>\n<li>\u0643\u0644 \u0648\u0642\u062a \u0648\u0646\u062c\u0632\u0627\u0644\u0637\u0644\u0628</li>\n<li>\u0648\u062a\u0639\u0644\u0645\u0647\u0627\u0646</li>\n<li>\u0644\u064a\u0633 \u0644\u064a \u0648\u062c\u0647</li>\n<li>\u0644\u0644\u063a\u0627\u0644\u064a\u0629 \u0627\u0644\u0627\u0645\u0646</li>\n<li>\u0639\u0646\u062f\u0647\u0641\u0644\u0627</li>\n<li>\u064a\u062d\u0648\u062c\u0646\u064a\u0627\u0644\u064a</li>\n<li>\u0636\u062f\u0627\u0639</li>\n<li>\u0648\u0627\u0648\u0642\u0641\u0647 \u0639\u0644\u064a\u0643\u062a\u0627\u0628\u064a</li>\n<li>\u0648\u0627\u0648\u0645\u0627\u0647\u0639\u0644\u064a\u0629</li>\n<li>\u0648\u0642\u0648\u0644 \u0644\u0647\u0644\u0648</li>\n<li>\u0643\u0627\u0646 \u062a\u0645\u0633\u0639\u0647</li>\n<li>\u0645\u0627 \u0637\u0644\u0628\u0647</li>\n<li>\u0641\u062a\u062e\u062a\u0635\u0639\u0646\u064a</li>\n<li>\u0627\u0646\u062a\u0648\u0648\u0644\u062f\u0643</li>\n<li>\u0648\u0627\u0647\u0644\u0643\u0628\u0627\u0641\u0636\u0644</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li></li></ol>\n",
