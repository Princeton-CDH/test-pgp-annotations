      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, margin",
          "value": "\n<ol><li>\u0648\u0633\u0628\u0639\u0647</li>\n<li>\u0648\u0646\u0635\u0641 \u0648\u0631\u0628\u0639</li>\n<li>\u0631\u0633\u0645 \u0627\u0646\u0641\u0627\u062f\u0647 \u0644\u0627\u062e\u064a\u0643</li>\n<li>\u0645\u0628\u0634\u0631 \u0627\u0631\u0628\u0639\u064a\u0646</li>\n<li>\u062f\u064a\u0646\u0627\u0631\u0627 \u0648\u0627\u0646\u0641\u062f\u062a</li>\n<li>\u0644\u0647 \u0641\u064a \u0645\u0631\u0643\u0628 \u0627\u0644\u0645\u0642\u062f\u0645 \u0639\u0644\u0649 \u064a\u062f</li>\n<li>\u0627\u0644\u0646\u0627\u062e\u0630\u0629 \u062c\u0648\u0647\u0631 \u0627\u0644</li>\n<li>\u0645\u0642\u062f\u0645\u064a \u0643\u062a\u0628 \u0627\u0644\u0644\u0647</li>\n<li>\u0633\u0644\u0627\u0645\u062a\u0647 \u0636\u0631\u0629 \u0641\u064a\u0647\u0627</li>\n<li>\u0643\u062a\u0646 \u0627\u0644\u0627 \u05d1 \u0627\u0644\u0642\u064a\u0645\u0629 \u0648\u062b\u0644\u062b\u064a\u0646 \u062f\u064a\u0646\u0627\u0631 \u0648\u0641\u064a \u0627\u0644\u0636\u0631\u0629 \u0641\u064a\u0647\u0627 \u0643\u062a\u0646 \u0627\u0644\u0627 \u0628</li>\n\n<p> </p>\n\n<li>\u0627\u0644\u0642\u064a\u0645\u0629</li>\n<li>\u0648\u062b\u0644\u062b\u064a\u0646 \u062f\u064a\u0646\u0627\u0631</li>\n<li>\u0648\u0641\u064a \u0627\u0644\u0636\u0631\u0629 \u062e\u0645\u0633\u0629</li>\n<li>\u0639\u0634\u0631 \u062f\u064a\u0646\u0627\u0631\u0627 \u0645\u0644\u0643\u064a\u0629</li>\n<li>\u0635\u062d \u0645\u0627 \u0639\u0644\u064a\u0647 \u0645\u0627\u0626\u062a\u064a</li>\n<li>\u0648\u0633\u062a\u064a\u0646 \u062f\u064a\u0646\u0627\u0631\u0627</li>\n<li>\u0648\u0646\u0635\u0641 \u0648\u0631\u0628\u0639</li>\n<li>\u0628\u0642\u0649 \u0639\u0644\u064a\u0647 \u0646\u0635\u0641</li>\n<li>\u0648\u0631\u0628\u0639 \u0633\u0648\u0645\u062d</li>\n<li>\u0628\u0630\u0644\u0643 \u0641\u064a\u0642\u0628\u0636</li>\n<li>\u0630\u0644\u0643 \u0645\u0646\u0647 \u0639\u0646\u062f</li>\n<li>\u0648\u0635\u0648\u0644\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li></ol>\n",
