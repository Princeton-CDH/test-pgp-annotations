      "body": [
        {
          "type": "TextualBody",
          "label": "Margin",
          "value": "<p>\u0628\u0627\u0646 \u0644\u0627 \u064a\u062f\u0648\u0642\u0647 \u0648\u0645\u0639 \u0630\u0644\u0643 \u0644\u0645 \u0646\u0635\u0637\u0631 \u0644\u0643 \u0630\u0644\u0643 \u0627\u0644\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0645\u0627 \u062d\u0643\u064a\u062a\u0647 \u0644\u0643 \u0627\u0648\u0644\u0627 \u0645\u062b\u0644 \u0645\u0627 \u064a\u062c\u064a\u0646\u064a \u0644\u0627 \u0644\u0636\u0631\u0648\u0631\u0629 \u062a\u0627\u062e\u0631 \u0630\u0644\u0643 \u0648\u062a\u0631</p>\n<p>\u0648\u0647\u064a \u0642\u0635\u0629 \u0645\u0648\u0633\u0649 \u0628\u0646 \u0627\u0644\u063a\u0646\u064a\u0628\u0629 \u064a\u0639\u0631\u0641 \u0628\u0627\u0628\u0646 \u0648\u0627\u0641\u064a \u0645\u0639 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u05e9\u05e4\u05dc\u05d5\u05d3\u05d9 \u0648\u0627\u062e\u0648\u0629 \u05d9\u05de\u05d7 \u05e9\u05de\u05d5 \u0635\u0627\u0642 \u062e\u0627\u0637\u0631\u0649 \u0627\u0644\u0627\u0646 \u0639\u0646 \u062a\u0636\u0637\u064a\u0631\u0647\u0627 \u0648\u0627\u0646 \u064a\u062d\u062a\u0646\u064a \u0648\u0628\u0639\u0636\u0643 \u064a\u0633\u064a\u0631 \u0633\u0627\u0639\u0649 \u0627\u0644\u0649 \u0639\u062c\u0628\u0643 \u0628\u0643\u062a\u0627\u0628 \u0628\u0645\u0627 \u064a\u062d\u062a\u0646\u064a \u0648\u0628\u0639\u0636\u0643 \u064a\u0633\u064a\u0631 \u0633\u0627\u0639\u064a \u0627\u0644\u0649 \u0639\u062c\u0628\u0643 \u0628\u0643\u062a\u0627\u0628 \u0628\u0645\u0627 \u062c\u0631\u0627 \u0648\u0642\u062a \u0643\u062a\u0628 \u0644\u0633\u064a\u062f\u0646\u0627 \u0639\u0628</p>",
