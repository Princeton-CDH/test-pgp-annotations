          "value": "<p>\u0648\u0645 \u0628 \u0648\u062e\u0631\u0643\u0645 \u05d5 \u0645\u0646 \u0627\u062d\u062f \u0634\u064a \u0641\u062a\u0639\u0644\u0645\u0646\u064a \u0648\u0643\u062a\u0628\u0643 \u05e1 \u062c\u0645\u064a\u0639 \u0627\u062e\u0628\u0627\u0631\u0643 \u0648\u0645\u0627 \u0627\u0646\u062a \u0641\u064a\u0647 \u0641\u0642\u0644\u0628\u064a \u0639\u0644\u0649 \u0627\u0644\u0627 \u0644\u0647 \u0644\u0627 \u062a\u062a\u0648\u0627\u0646\u0627 \u0641\u064a \u0643\u062a\u0628\u0643 \u0633\u0631\u0639\u0629 \u0641\u064a\u0634\u0647\u062f \u0627\u0644\u0644\u0647 \u062d\u064a\u062b \u0637\u0644\u0639\u062a \u0627\u0644\u0649 \u0645\u0635\u0631 \u0648\u0644\u0645 \u0627\u062c\u062a\u0645\u0639 \u0645\u0639\u0643 \u063a\u064a\u0631 \u05d1 \u0648\u0644\u0627 \u0642\u0644\u062a \u0627\u0644\u0627 \u0627\u0646\u0643 \u062a\u0643\u0648\u0646 \u0639\u0646\u062f\u064a \u0627\u0644\u0644\u064a\u0644 \u0648\u0627\u0644\u0646\u0647\u0627\u0631 \u0648\u0646\u062f\u0645\u062a \u062d\u064a\u062b \u062e\u0631\u062c\u062a \u0645\u0646 \u0645\u0635\u0631 \u0648\u0645\u0627 \u0627\u0642\u0645\u062a \u0641\u064a \u0645\u0646 \u0631\u0648\u064a\u062a\u0643 \u0648\u0645\u0627 \u0643\u0627\u0646\u062a \u0627\u062c\u062a\u0645\u0639\u062a \u0628\u0643 \u0648\u0627\u0646\u0627 \u0647 \u0627 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u0635\u062f\u0642\u0627 \u0648\u0645\u0646 \u0633\u0627\u0644 \u0639\u0646\u0627 \u0627\u0644\u0633\u0644\u0627\u0645 \u0627\u0644\u062c\u0632\u064a\u0644 \u0647\u0627 \u0627\u0644\u0633\u0644\u0627\u0645 \u0627\u0644\u062c\u0632\u064a\u0644 \u0648\u0627\u0628\u0648 \u0633\u0644\u064a\u0645\u0627\u0646 \u062f\u0627\u0648\u062f \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0644\u0634\u064a\u0643 \u0627\u0646 \u062a\u062e\u0635\u0647 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0628\u0648 \u0627\u0633\u062d\u0642 \u0628\u0646 \u0627\u0644\u062a\u0648\u0632\u064a \u0627\u0644\u0633\u0644\u0627\u0645 \u0645\u0648\u0644\u0621\u0