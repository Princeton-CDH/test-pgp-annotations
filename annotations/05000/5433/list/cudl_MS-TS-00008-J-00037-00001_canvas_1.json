      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u062a\u0630\u0643\u0631\u0647 \u0645\u0628\u0627\u0631\u0643\u0629 \u05dc\u05de\u05e6\u05de\u05d5\u05df \u0628\u0646 \u062d\u0633\u0646 \u062a\u0630\u0643\u0631\u0647 \u0645\u0628\u0627\u0631\u0643\u0629 \u05dc\u05de\u05e6\u05de\u05d5\u05df \u0628\u0646 \u0627\u0644\u062d\u0633\u0646 \u0635\u062d\u0628\u0647 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0645\u0648\u0644\u0627\u064a \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0627\u0644\u062f\u0645\u064a\u0627\u0637\u064a \u0643\u062a\u0628 \u0627\u0644\u0644\u0647 \u0633\u0644\u0627\u0645\u062a\u0647 \u0627\u0644\u0645\u0646\u0641\u062f \u062e\u0627\u0635\u0629 \u0645\u0646 \u0627\u0644\u0631\u0627\u0648\u0646\u062f \u062b\u0645\u0627\u0646\u064a\u0629 \u0627\u0645\u0646\u0627 \u0648\u0645\u0646 \u0627\u0644\u0645\u0627\u0645\u064a\u0631\u0627\u0646 \u0646\u0635\u0641 \u0645\u0646 \u064a\u0628\u0627\u0639 \u0627\u0644\u062c\u0645\u064a\u0639 \u0645\u0639 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0630\u0627 \u0646\u0635 \u062b\u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u0633\u0644\u0645 \u0645\u0646\u0647 \u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0645\u0648\u0644\u0627\u064a \u05e0\u05ea\u05df \u05d4\u05d7\u05d1\u05e8 \u05e0\u05d6\u05e8 \u05d4\u05d7\u05d1\u05d9\u05e8\u05d9\u05dd \u062b\u0644\u0627\u062b\u0629 \u0645\u062a\u0627\u0642\u064a\u0644 \u0645\u0635\u0631\u064a\u0629 \u0648\u0644\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0645\u0648\u0644\u0627\u064a \u05d7\u05dc\u05e4\u05d5\u05df \u05d4\u05dc\u05d5\u05d9 \u05d1\u05df \u05de\u05e0\u05e9\u05d4 \u05d4\u05d7\u05d6\u05df \u05d1\u05df \u0627\u0644\u0642\u0637\u0627\u0626\u0641 \u0645\u062a\u0642\u0627\u0644\u064a\u0646 \u0645\u0635\u0631\u0626\u064a\u0629 \u0635\u062d \u0647 \u0627\u0644\u0628\u0627\u0642\u064a \u064a\u0634\u062a\u0631\u0627 \u0628\u0647 \u0641\u0636\u0629 \u062d\u062c\u0631 \u0628\u064a\u0636\u0627 \u0646\u0635\u064a\u0641\u0629 \u0648\u0644\u062d\u0642 \u0627\u064a\u0636\u0627 \u062e\u0645\u0633\u0629 \u0627\u0645\u0646\u0627 \u0648\u0646\u0635\u0641 \u062c\u0632\u0644 \u0635\u0648\u0644\u0649 \u064a\u0636\u0627\u0641 \u062b\u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0639 \u0645\u0648\u0636\u0639 \u0648\u0627\u062d\u062f \u0648\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0630\u064a \u0644\u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0627\u062c\u0644 \u0645\u0648\u0644\u0627\u064a \u0648\u0645\u0627\u0644\u0643\u064a \u05de\u05e6\u05dc\u05d9\u05d7 \u05d4\u05db\u05d4\u05df \u05e8\u05d0\u05e9 \u05d9\u05e9\u05d9\u05d1\u05ea \u05d2\u05d0\u05d5\u05df \u05d9\u05e2\u05e7\u05d1 \u0645\u0646 \u0630\u0644\u0643 \u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u0645\u0646 \u0648\u0627\u062d\u062f \u0639\u0648\u062f \u062a\u0642\u064a\u0644 \u0645\u0639\u0645\u0648\u0644 \u0627\u0634\u0628\u0627\u0647 \u0648\u0643\u0644\u062b\u0648\u0646 \u0648\u0642\u0627\u0642\u0644\u064a \u0648\u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u0645\u0646 \u0648\u0627\u062d\u062f \u0642\u0631\u0646\u0641\u0644 \u0648\u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u0645\u0646 \u0648\u0627\u062d\u062f \u0628\u0633\u0628\u0627\u0633\u0629 \u0648\u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u062e\u0645\u0633\u0629 \u0627\u0645\u0646\u0627 \u062c\u0648\u0632\u0629 \u0648\u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u0645\u0627\u0626\u0629 \u0643\u0627\u0628 \u0634\u0627\u062a \u0635\u064a\u0646\u064a \u0648\u062e\u0631\u064a\u0637\u0629 \u0641\u064a\u0647\u0627 \u0645\u0646\u062f\u064a\u0644\u064a\u0646 \u0644\u0627\u0644\u0633 \u0639\u0645\u0644 \u0643\u0648\u0644\u0645 \u0648\u0627\u062d\u062f \u062d\u0627\u0634\u064a\u064a\u062a\u0647 \u062d\u0645\u0631\u0627 \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u062d\u0627\u0634\u064a\u064a\u062a\u0647 \u0632\u0631\u0642\u0627 \u0648\u0634\u062a \u0641\u064a\u0647 \u062f\u0633\u062a \u0627\u0642\u062