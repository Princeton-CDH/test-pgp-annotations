        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u05e2\u05d5\u05e0\u05da \u064a\u0627 \u05e8\u05d1 \u05d1\u05e2\u05d6\u05e8\u05ea\u05da \u05e8\u05d9\u05d1\u05d5\u05e0\u05d9 \u05e0\u05d5\u05e1\u05d7 \u05d6\u05d4 \u05d1\u05e8\u05d0\u05e9\u05d9\u05ea\u05d5 \u05e9\u05dc \u05db\u05dc \u05e2\u05de\u05d5\u05d3 \u05d7\u05d3\u05e9 \u05d1\u05de\u05db\u05ea\u05d1 \u05d5\u05d1\u05e1\u05d9\u05d5\u05de\u05d5 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05e1\u05d2\u05e0\u05d5\u05df \u05de\u05db\u05ea\u05d1\u05d9\u05d5 \u05e9\u05dc \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8 \u05d1\u05df \u05d0\u05d1\u05e8\u05d0\u05d4\u05d9\u05dd \u05e8\u05d0\u05d5 \u05d2\u05dd \u05d1\u05de\u05db\u05ea\u05d1\u05d9\u05d5 \u05d4\u05d0\u05d7\u05e8\u05d9\u05dd</li>\n\n\n<li>\u05e9\u05de\u05d5\u05ea \u05e9\u05dc \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05d1\u05dc\u05d5\u05d7 \u05d4\u05e9\u05e0\u05d4 \u05d4\u05de\u05d5\u05e1\u05dc\u05de\u05d9 \u062c\u0645\u0627\u062f\u0627 \u0627\u0644\u0627\u0648\u0644\u0627 \u062c\u0645\u0627\u062f\u0627 \u0627\u0644\u0627\u062d\u0631\u0627 \u05e8\u05d2\u05d1 \u05d2\u05d9\u05dc\u05e4\u05dc\u05d9\u05d9\u05e9\u05e8 \u05de\u05d3\u05d5\u05d1\u05e8 \u05db\u05d0\u05df \u05db\u05db\u05dc \u05d4\u05e0\u05e8\u05d0\u05d4 \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05de\u05e1\u05d9\u05dd \u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05e2\u05e0\u05d9\u05e0\u05d9 \u05d2\u05d6\u05e8\u05d5\u05ea \u05db\u05e1\u05d1\u05e8\u05ea \u05d2\u05d9\u05dc\u05e4\u05dc\u05d9\u05d9\u05e9\u05e8 \u05e9\u05dd \u05e9\u05d4\u05e8\u05d9 \u05d9\u05e9 \u05dc\u05d6\u05db\u05d5\u05e8 \u05e9\u05d4\u05e0\u05de\u05e2\u05df \u05d0\u05d1\u05d5 \u05d2\u05d9\u05dc\u05e4\u05dc\u05d9\u05d9\u05e9\u05e8 \u05e9\u05dd \u05e9\u05d4\u05e8\u05d9 \u05d9\u05e9 \u05dc\u05d6\u05db\u05d5\u05e8 \u05e9\u05d4\u05e0\u05de\u05e2\u05df \u0627\u0628\u0648 \u0627\u0633\u062d\u0627\u0642 \u05e9\u05d9\u05de\u05e9 \u05db\u05e0\u05d0\u05d9\u05d1 \u05d5\u05e2\u05e1\u05e7 \u05d1\u05d7\u05db\u05d9\u05e8\u05ea \u05de\u05e1\u05d9\u05dd \u05d3\u05e8\u05da \u05e9\u05d2\u05e8\u05d4</li>\n\n\n<li>\u05e9\u05e0\u05d9 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05e8\u05d1\u05d9\u05e2 \u05d4\u05dd \u05e8\u05d1\u05d9\u05e2 \u05d0\u05dc\u05d0\u05d5\u05dc \u05d5\u05e8\u05d1\u05d9\u05e2 \u0627\u0644\u0627\u0627\u062d\u0631 \u05d4\u05e7\u05d5\u05d3\u05de\u05d9\u05dd \u0644\u062c\u0645\u0627\u062f\u0627 \u05d2\u05d9\u05dc\u05e4\u05dc\u05d9\u05d9\u05e9\u05e8</li>\n\n\n<li>\u0631\u064a\u062d\u0627\u0646 \u05d0\u05d7\u05d3 \u05de\u05e2\u05d1\u05d3\u05d9 \u05d4\u05db\u05dc\u05d9\u05e4\u05d4 \u05e9\u05e2\u05e1\u05e7 \u05d1\u05de\u05e1\u05d7\u05e8 \u05e9\u05dc \u05d7\u05e6\u05e8 \u05d4\u05de\u05dc\u05db\u05d5\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05db\u05d4 \u05e8\u05d1\u05d4 \u05e2\u05d3 \u05db\u05d9 \u05d4\u05d9\u05d4 \u05d1\u05db\u05d5\u05d7\u05d5 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e6\u05d5\u05d5\u05d9\u05dd \u05de\u05dc\u05db\u05d5\u05ea\u05d9\u05d9\u05dd \u05d2\u05dd \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9\u05d5 \u05e9\u05dc \u05e1\u05d5\u05d7\u05e8 \u05e4\u05e8\u05d8\u05d9 \u05db\u05d0\u05d1\u05d5 \u05de\u05d5\u05e1\u05d9 \u0647\u0631\u0648\u0646 \u05e1\u05d5\u05d7\u05e8 \u05e4\u05e8\u05d8\u05d9 \u05db\u05d0\u05d1\u05d5 \u05de\u05d5\u05e1\u05d9 \u05d4\u05e8\u05d5\u05df \u05d5\u05d2\u05dd \u05d1\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05d7\u05e1\u05d5\u05ea \u05d1\u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d9\u05d4 \u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d0 \u05e2\u05de \u05d5\u05dc\u05d4\u05dc\u05df \u05e9\u05d5\u05e8\u05d4 \u05d5\u05d0\u05d9\u05dc\u05da</li>\n\n\n<li>\u05db\u05dc\u05e4\u05d4 \u05d5\u05de\u05e9\u05e7\u05d4 \u05d8\u05e8\u05d7\u05d4 \u05d5\u05e7\u05d5\u05e9\u05d9 \u05d2\u05d9\u05dc\u05e4\u05dc\u05d9\u05d9\u05e9\u05e8 \u05ea\u05e8\u05d2\u05de\u05d5 \u05d0\u05d3\u05de\u05d5\u05de\u05d9\u05ea \u05d5\u05e4\u05e1\u05d5\u05dc\u05ea \u05d0\u05da \u05d6\u05d4\u05d5 \u05de\u05e9\u05e4\u05d8 \u05e0\u05d9\u05de\u05d5\u05e1\u05d9\u05df \u05e9\u05d2\u05d5\u05e8 \u05dc\u05de\u05d3\u05d9 \u05d1\u05de\u05db\u05ea\u05d1\u05d9 \u05e1\u05d5\u05d7\u05e8\u05d9\u05dd \u05d1\u05de\u05d5\u05d1\u05df \u05d0\u05dd \u05dc\u05d0 \u05e7\u05e9\u05d4 \u05dc\u05da \u05db\u05db\u05dc \u05e9\u05d4\u05e6\u05dc\u05d7\u05ea\u05d9 \u05dc\u05d4\u05d1\u05d9\u05df \u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05dd \u05db\u05d3\u05dc\u05e7\u05de\u05df \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8 \u05e9\u05dc\u05d7 \u05dc\u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05e7 \u05e1\u05d5\u05d2 \u05de\u05e1\u05d5\u05d9\u05dd \u05d1\u05d0\u05d1\u05d4 \u05e9\u05dc \u05de\u05e9\u05d9 \u05e2\u05dc \u05de\u05e0\u05ea \u05e9\u05d9\u05de\u05db\u05e8\u05e0\u05d5 \u05e2\u05d1\u05d5\u05e8\u05d5 \u05db\u05e0\u05e8\u05d0\u05d4 \u05e9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05de\u05e9\u05d9 \u05e9\u05e7\u05e9\u05d4 \u05dc\u05de\u05db\u05d5\u05e8 \u05db\u05d9 \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8 \u05de\u05e9\u05d0\u05d9\u05e8 \u05d1\u05d9\u05d3\u05d9\u05d5 \u05d1\u05e8\u05e8\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea \u05d0\u05dd \u05dc\u05d0 \u05d9\u05e6\u05dc\u05d9\u05d7 \u05dc\u05de\u05db\u05d5\u05e8 \u05de\u05d5\u05e8\u05d4 \u05dc\u05d5 \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8 \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05d1\u05d9\u05d3\u05d9\u05d5 \u05d0\u05ea \u05e2\u05e9\u05e8\u05ea \u05d4\u05d3\u05d9\u05e0\u05d0\u05e8\u05d9\u05dd \u05e9\u05d4\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d2\u05d1\u05d5\u05ea \u05de\u05e2\u05e1\u05e7\u05d4 \u05d0\u05d7\u05e8\u05ea \u05e9\u05dc \u05de\u05db\u05d9\u05e8\u05ea \u05db\u05e1\u05e3 \u05d5\u05ea\u05de\u05d5\u05e8\u05ea\u05dd \u05dc\u05e8\u05db\u05d5\u05e9 \u05dc\u05de\u05e2\u05e0\u05d5 \u05e9\u05e7 \u05e9\u05dc \u05d1\u05d3\u05d9 \u05de\u05e9\u05d9 \u05ea\u05de\u05d5\u05e8\u05ea \u05d1\u05d3\u05d9 \u05de\u05e9\u05d9 \u05d0\u05dc\u05d5 \u05de\u05ea\u05db\u05d5\u05d5\u05df \u05d0\u05d1\u05d5 \u05e0\u05e6\u05e8 \u05dc\u05e8\u05db\u05d5\u05e9 \u062d\u064a\u0637\u0629</li>\n\n\n<li>\u0627\u0644\u0642\u0627\u0636\u064a \u0627\u0644\u0645\u0643\u064a\u0646 \u0645\u0643\u064a\u0646 \u0627\u0644\u0630\u0648\u0644\u0629 \u0627\u0628\u0648 \u0637\u0627\u0644\u0628 \u0628\u0646 \u062d\u062f\u064a\u062f \u05de\u05d5\u05e0\u05d4 \u05dc\u05e7\u05d0\u05e6\u05d9 \u05e9\u05dc \u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d9\u05d4 \u05d1\u05e9\u05e0\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05e8\u05d3 \u05e0\u05d6\u05d0\u05e8 \u05e0\u05e4\u05d8\u05e8 \u05d1\u05e9\u05e0\u05ea \u05e8\u05d0\u05d5 \u05d0\u05d1\u05df \u05de\u05d9\u05e1\u05e8 \u05e2\u05de \u0633\u0627\u0644\u0645 \u05e2\u05de \u05d4\u05d5\u05d0 \u05d4\u05d9\u05d4 \u05d1\u05df \u05dc\u05de\u05e9\u05e4\u05d7\u05ea \u05e7\u05d0\u05e6\u05d9\u05dd \u05e9\u05e0\u05e9\u05d0\u05d5 \u05ea\u05d0\u05e8\u05d9\u05dd \u05e9\u05db\u05dc\u05dc\u05d5 \u05d0\u05ea \u05d4\u05e8\u05db\u05d9\u05d1 \u05de\u05db\u05d9\u05df \u05e2\u05dc \u05de\u05d0\u05d1\u05e7 \u05d6\u05d4 \u05e0\u05d2\u05d3 \u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05de\u05e1\u05d9\u05dd \u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05de\u05db\u05ea\u05d1 \u05e2\u05de</li>\n\n<p>\u05e9\u05d5\u05dc\u05d9\u05d9\u05dd \u05d9\u05de\u05e0\u05d9\u05d9\u05dd</p>\n\n<li>\u05d4\u05d4\u05e4\u05dc\u05d2\u05d4 \u05d4\u05d9\u05ea\u05d4 \u05ea\u05dc\u05d5\u05d9\u05d4 \u05d1\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e8\u05d5\u05d7\u05d5\u05ea \u05d1\u05e2\u05d5\u05e0\u05ea \u05d4\u05d4\u05e4\u05dc\u05d2\u05d4 \u05e7\u05e8\u05d9 \u05d1\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e7\u05d9\u05e5 \u05d4\u05e8\u05d5\u05d7\u05d5\u05ea \u05e0\u05e9\u05d1\u05d5 \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05de\u05e2\u05e8\u05d1 \u05dc\u05de\u05d6\u05e8\u05d7 \u05db\u05da \u05e9\u05d4\u05d9\u05d4 \u05e0\u05d5\u05d7 \u05dc\u05d4\u05e4\u05dc\u05d9\u05d2 \u05de\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4 \u05d0\u05d5 \u05de\u05df \u05d4\u05de\u05d2\u05e8\u05d1 \u05d0\u05dc \u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d9\u05d4 \u05d0\u05d1\u05dc \u05de\u05d0\u05d5\u05ea\u05d4 \u05e1\u05d9\u05d1\u05d4 \u05d4\u05d9\u05d4 \u05e7\u05e9\u05d4 \u05dc\u05e6\u05d0\u05ea \u05de\u05df \u05d4\u05e0\u05de\u05dc \u05d5\u05d4\u05d0\u05e0\u05d9\u05d5\u05ea \u05d4\u05e4\u05dc\u05d9\u05d2\u05d5 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e6\u05e4\u05d5\u05e0\u05d4 \u05d0\u05d5 \u05d1\u05db\u05d9\u05d5\u05d5\u05df \u05e6\u05e4\u05d5\u05df \u05de\u05d6\u05e8\u05d7 \u05d1\u05d8\u05e8\u05dd \u05d9\u05db\u05dc\u05d5 \u05dc\u05e4\u05e0\u05d5\u05ea \u05de\u05e2\u05e8\u05d1\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e8\u05d5\u05d7\u05d5\u05ea \u05d4\u05d9\u05d4 \u05e0\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e2\u05d5\u05e0\u05ea \u05d4\u05d0\u05d1\u05d9\u05d1 \u05d0\u05d5 \u05d4\u05e1\u05ea\u05d9\u05d5 \u05d0\u05dc\u05d0 \u05e9\u05d0\u05d6 \u05d4\u05d9\u05ea\u05d4 \u05e6\u05e4\u05d5\u05d9\u05d4 \u05e1\u05db\u05e0\u05d4 \u05d1\u05e9\u05dc \u05e1\u05e2\u05e8\u05d5\u05ea \u05d5\u05e9\u05de\u05d9\u05dd \u05de\u05e2\u05d5\u05e0\u05e0\u05d9\u05dd \u05de\u05e9\u05d5\u05dd \u05db\u05da \u05d4\u05de\u05ea\u05d9\u05e0\u05d5 \u05d4\u05d0\u05e0\u05d9\u05d5\u05ea \u05e2\u05d3 \u05e9\u05d4\u05d9\u05d9\u05ea\u05d4 \u05e8\u05d5\u05d7 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d5\u05d0\u05d6 \u05d4\u05e4\u05dc\u05d9\u05d2\u05d5 \u05de\u05d9\u05d3 \u05d4\u05e0\u05d5\u05e1\u05e2\u05d9\u05dd \u05e0\u05d0\u05dc\u05e6\u05d5 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05e2\u05dc \u05d4\u05d0\u05e0\u05d9\u05d9\u05d4 \u05e9\u05db\u05df \u05dc\u05d0 \u05d4\u05d9\u05ea\u05d4 \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05ea\u05db\u05e0\u05df \u05d1\u05de\u05d3\u05d5\u05d9\u05e7 \u05d0\u05ea \u05d6\u05de\u05df \u05d4\u05d4\u05e4\u05dc\u05d2\u05d4 \u05e2\u05dc \u05ea\u05e0\u05d0\u05d9 \u05d4\u05e9\u05d9\u05d8 \u05d1\u05e0\u05de\u05dc \u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d9\u05d4 \u05e8\u05d0\u05d5 \u05dc\u05d9\u05d9\u05df \u05d5\u05e0\u05e6\u05d9\u05d4 \u05e2\u05de \u05d5\u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d0 \u05e2\u05de \u05d5\u05e2\u05de \u05e2\u05d1</li></ol>\n",
