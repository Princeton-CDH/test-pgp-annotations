      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0645\u0627 \u0643\u062a\u0628 \u0644\u0647 \u0648\u0643\u062a\u0628\u064a \u062a\u0635\u0644 \u0644\u0644\u0643\u0647\u0646 \u0627\u0644\u0631\u0645\u0644\u0649</li>\n<li>\u0635\u0628\u0627\u0631\u0629 \u0648\u0635\u0644\u062a \u0644\u0645\u064a\u0645\u0648\u0646 \u0639\u0645\u0644\u062a \u0639\u0644\u064a\u0647 \u062e\u0631\u0642\u0629</li>\n<li>\u0648\u0627\u0646\u0641\u062f\u062a\u0647\u0627 \u0627\u0644\u064a\u0647 \u0645\u0639 \u062d\u0627\u0645\u0644 \u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627</li>\n<li>\u062a\u062f\u0641\u0639\u0647 \u0627 \u0641\u0636\u0647 \u0641\u064a \u0627\u0644\u062c\u0645\u064a\u0639</li></ol>\n",
