      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0633\u0639\u0627\u062f\u062a\u0643 \u0645\u0646 \u0633\u0647\u0631\u062c\u062a \u0639\u0646</li>\n<li>\u062d\u0627\u0644 \u0627\u0633\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0641\u0631\u062c \u0648\u0627\u0646\u0627 \u0645\u0647\u0646\u064a \u0644\u0643 \u0628\u0627\u0644\u0639\u064a\u062f \u0627\u0644\u0645\u0633\u0648\u062a \u0627\u0633\u0644 \u0627\u0644\u0644\u0647</li>\n<li>\u064a\u0639\u064a\u062f\u0647 \u0639\u0644\u064a\u0643 \u0634\u0636\u064a\u0645 \u0631\u0628\u0648\u062a \u0645\u0627 \u0643\u0645\u064a \u0639\u0646\u0643 \u064a\u0627\u0645\u0648\u0644\u0626\u064a</li>\n<li>\u062e\u064a\u0631 \u0648\u0643\u0646\u062a \u0641\u0627\u0631\u0642\u062a \u0645\u0648\u0644\u0626\u064a \u0639\u0644\u0649 \u0627\u0646 \u0627\u0646\u0641\u062f \u0644\u0647 \u0627\u0644\u062f\u0646\u0646 \u0648</li>\n<li>\u0644\u0627 \u0628\u0633\u0628\u0628 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0642\u064a\u0644\u062a \u062e\u0635 \u0627\u0644\u0646\u0627\u0633 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0644\u0645\u0648\u0644\u0627\u064a</li>\n<li>\u0636\u0631\u0629 \u0635\u062d\u0628\u062a \u0633\u064a\u062f\u064a \u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u0648\u0644\u062f \u05de\u05e0\u05e9\u05d4 \u0639\u062f\u062f\u0647\u0627 \u05dc\u05d3 \u062f\u064a\u0646</li>\n<li>\u0648\u0632\u0646\u0647\u0627 \u05dc \u062f\u064a\u0646 \u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u064a\u0643\u062a\u0628 \u0633\u0644\u0627\u0645\u062a\u0647\u0627</li>\n<li>\u05de \u062f\u064a\u0646 \u0647\u064a \u0639\u0646\u062f\u0647 \u0648\u0642\u0631 \u0643\u0627\u0646</li>\n<li>\u0644 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0627\u0644\u0649 \u0627\u0644\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u062a\u062a\u0633\u0644\u0645\u0647\u0627 \u0639\u0646\u0647 \u062d\u0631\u0636\u0643 \u0627\u0644\u0644\u0647</li>\n<li>\u0648\u0627\u0631\u064a\u062f \u0645\u0646\u0643 \u064a\u0627\u0645\u0648\u0644\u0626\u064a \u062d\u0631\u0636\u0643 \u0627\u0644\u0644\u0647 \u0627\u0646\u0641\u062f\u062a \u0644\u0643 \u0645\u0639 \u0645\u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u064a \u0647\u0627\u0630\u064a</li>\n<li>\u05d6 \u062f\u0646\u0646 \u0647\u064a \u0644\u0645\u062d\u0628\u0648\u0628 \u0628\u0646 \u062d\u0628\u0627\u0646 \u0645\u0646 \u0633\u0641\u0627\u0642\u0636 \u0648\u0627\u0646\u0641\u062f\u0647\u0627 \u0644\u064a \u0648\u0633\u0627\u0644\u0646\u064a</li>\n<li>\u0627\u0634\u062a\u0631\u0649 \u0644\u0647 \u0628\u062f\u064a\u0646\u0631\u064a\u0646 \u0646\u0631\u062f \u0627\u062d\u0645\u0631 \u0648\u062f\u064a\u0646\u0631\u064a\u0646 \u0643\u0627\u0641\u0648\u0631 \u0648\u062f\u064a\u0646 \u062a\u0646\u0643\u0627\u0631</li>\n<li>\u0648\u062f\u064a\u0646 \u0639\u0648\u062f \u0648\u062f\u064a\u0646 \u0642\u0631\u0646\u0641\u0644 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a\u0647\u0627 \u0645\u0639 \u0645\u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 \u0648\u0627\u0646\u062a</li>\n<li>\u062a\u0639\u0644\u0645 \u0627\u0646\u0647 \u0636\u0639\u0644\u0648\u0643 \u0648\u0648\u0627\u062c\u0628 \u0627\u0644\u062d\u0642 \u0648\u0642\u0628\u0636\u064a \u0627\u0644\u062d\u0627\u062c\u0629</li>\n<li>\u062a\u0637\u0648\u0644 \u0631\u0648\u062d\u0643 \u062a\u0634\u062a\u0631\u0649 \u0644\u0647 \u0647\u0627\u0630\u064a \u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0641\u0627\u0646 \u0627</li>\n<li>\u0627\u0645\u062a\u0646\u0639\u062a \u0645\u0646 \u0630\u0644\u0643 \u0641\u0642\u062f \u0648\u0633\u0627\u0644\u062a\u0647 \u064a\u0634\u062a\u0631\u0649 \u0644\u0647 \u0647\u0627\u0630\u064a \u0627\u0644</li>\n<li>\u062d\u0648\u0627\u0626\u062c \u0648\u064a\u0628\u064a\u0639\u0647\u0627 \u0644\u0647 \u062a\u062a\u0641\u0635\u0644 \u062a\u062a\u062e\u0644\u0641 \u0628\u062d\u0645\u0644\u0647\u0627 \u0644\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629</li>\n<li>\u0627\u0644\u062d\u0627\u062c\u0629 \u0648\u0627\u0646\u0627 \u0631\u0627\u062c\u0628 \u0644\u062d\u0636\u0631\u062a\u0643 \u0641\u064a \u0627\u0646 \u062a\u0639\u064a\u0646\u0647 \u0648\u0644\u0627 \u062a\u0643\u0648\u0646</li>\n<li>\u0641\u0633\u0627\u0639\u062a \u0648\u0635\u0648\u0644 \u0643\u062a\u0627\u0628\u064a \u062a\u0642\u0628\u0636 \u0645\u0646\u0647 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0630\u064a \u0644\u0643 \u0648\u062a\u062a</li>\n<li>\u0627\u0644\u0632 \u062f\u0646\u0646 \u0648\u0632\u0646\u0647\u0627 \u0646 \u062f\u0646\u0646\u064a \u063a\u064a\u0631 \u05d6 \u0642\u064a \u0627\u0639\u0644\u0645\u062a \u0644\u0645\u0648\u0644\u0626\u064a</li>\n<li>\u0644\u0627 \u062a\u062a\u0639\u0628 \u0644\u0643\u062b\u0631\u0629 \u0627\u0634\u063a\u0627\u0644\u0643 \u0641\u0627\u0646\u0627 \u0627\u0633\u0627\u0644\u0643 \u0627\u0644\u062f\u0646\u0646 \u064a\u062a\u0641\u0642 \u0634\u0631\u0627</li>\n<li>\u062d\u0648\u0627\u0626\u062c \u0648\u062a\u062a\u062e\u0644\u0641 \u0627\u0646\u062a \u0628\u062d\u0645\u0644\u0647\u0627 \u0648\u0643\u0630\u0644\u0643 \u0627\u0644\u062d\u0631\u064a\u0631 \u0627\u0644\u0630\u064a \u0643\u0646\u062a \u0627\u0646\u0641\u062f\u062a\u0647</li>\n<li>\u0645\u0646 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u062a\u0628\u064a\u0639\u0629 \u0648\u062a\u062b\u0628\u062a \u0644\u064a \u062a\u0645\u0646\u0647 \u0648\u062a\u0648\u062e\u062f</li>\n<li>\u0628\u0646 \u0628\u0647\u0644\u0648\u0644 \u0645\u0627 \u064a\u062a\u0628\u0642\u0627 \u0639\u0646\u062f\u064a \u0645\u0646 \u0627\u0644</li></ol>\n",
