      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, right margin:",
          "value": "\n<ol><li>\u0648\u062b\u0645 \u0627\u0646 \u0627\u0644\u0631\u0626\u064a\u0633 \u0644\u0645\u0627 \u0637\u0627\u0644\u0628\u062a\u0647 \u0628\u0645\u0627 \u0641\u064a \u0627\u0644\u0643\u062a\u0648\u0628\u0629 \u064a\u0646\u062a\u0647\u0631\u0646\u064a \u0648\u064a\u0642\u0648\u0644 \u0644\u064a</li>\n<li>\u0627\u064a\u0634 \u0631\u0627\u0626\u0643 \u0646\u0627\u062e\u0630 \u0631\u062d\u0644 \u0627\u0644\u0646\u0627\u0633 \u0646\u062f\u0641\u0639\u0647 \u0644\u0643 \u0648\u0643\u0627\u0646 \u0642\u0644\u0628\u064a \u0645\u0638\u0645\u0627\u0646 \u062d\u064a\u062b</li>\n<li>\u0643\u0627\u0646 \u0627\u0644\u0645\u0627\u0644 \u0645\u0648\u062f\u0648\u0639 \u0641\u0644\u0645\u0627 \u0643\u0627\u0646 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062c\u0645\u0639\u0629 \u05d9\u05d5\u05dd \u05e2\u05e8\u05d5\u05d1\u05ea \u05e2\u05e6\u05e8\u05ea \u0627\u0642\u062a\u0633\u0645\u0648 \u0627\u0644\u0645\u0627\u0644 \u0648\u0644\u0645</li>\n<li>\u0627\u0639\u0644\u0645 \u0641\u0627\u062d\u062a\u0631\u0642\u0648 \u0627\u0644\u064a\u062a\u0648\u0645\u064a\u0645 \u0648\u0639\u0628\u062f\u062a\u0647 \u0639\u0644\u0649 \u062e\u0631\u0648\u062c\u0647\u0645 \u0628\u0644\u0627 \u0634\u064a \u062d\u0636\u0631\u062a\u0647 \u0645\u062e\u0635\u0648\u0635\u0629 \u0628\u0627\u062c\u0644 \u0627\u0644\u0633\u0644\u0645</li></ol>\n",
