          "value": "<p>\u0627\u0644\u0633\u0641\u0631 \u0628\u064a\u0648\u0645\u064a\u0646 \u063a\u0631\u064a\u0628 \u0639\u0644\u0649 \u064a\u062f\u0647 \u0648\u0639\u0644\u0649 \u0644\u0635\u0627\u062d\u0628 \u0630\u0647\u0644\u0643 \u0641\u064a\u0647 \u0644\u0634\u064a\u0643 \u0628\u0644\u0627\u0644 \u0628\u0646 \u063a\u0631\u064a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u062c\u0644 \u0627\u0644\u0630\u064a \u0628\u0627\u0639 \u0627\u0644\u0640\u05d3\u05e8\u05db\u05d9 \u0627\u0634\u062a\u0631\u0627\u0647 \u0645\u0646\u0647 \u0644\u0646\u0641\u0633\u0647 \u0648\u0644\u064a\u0633 \u064a\u0642\u062f\u0631 \u0627\u062d\u062f \u064a\u0637\u0644\u0628 \u0634\u064a \u064a\u0637\u0644\u0628\u0647 \u0627\u0644\u0645\u0627\u0644\u0643 \u0628\u0644\u0627\u0644 \u0641\u0644\u0648 \u0648\u0635\u0644\u062a \u0645\u0637\u0627\u064a\u0627 \u0627\u0628\u0646 \u0627\u0644\u0633\u062f\u0627\u0633\u064a \u0628\u0634\u064a \u0645\u0646\u0647 \u0644\u0627\u0646\u0641\u062f\u062a \u0644\u0647 \u0630\u0644\u0643 \u0641\u0644\u0627 \u064a\u0639\u062a\u0642\u062f \u0627\u0646\u064a \u063a\u0641\u0644\u062a \u0639\u0646 \u062d\u0627\u062c\u062a\u0647 \u0648\u0645\u0627 \u064a\u0639\u0648\u062f \u0628\u0645\u0635\u0644\u062d\u062a\u0647 \u0648\u0628\u0644\u0644\u0647 \u0644\u0642\u062f \u0643\u0627\u0646 \u0647\u0627\u0630\u0629 \u0627\u0644\u0633\u0646\u0629 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0644\u0628\u0637\u0647 \u0639\u0635\u064a\u0645\u0629 \u0627\u0644\u0628\u0644\u062f \u0644\u0628\u0637\u0647 \u0639\u0635\u064a\u0645\u0647 \u0628\u0644\u063a\u062a \u0627\u0644\u0645\u062a\u0627\u0642\u064a\u0644 \u0627\u0644\u0645\u0635\u0631\u064a\u064a\u0629 \u0627\u0644\u0633\u0641\u0631 \u0628\u064a\u0648\u0645\u064a\u0646 \u063a\u0631\u064a\u0628 \u0639\u0644\u0649 \u064a\u062f\u0647 \u0648\u0639\u0644\u0649 \u0644\u0635\u062d\u0627\u0628 \u0630\u0647\u0644\u0643 \u0641\u064a\u0647 \u0644\u0634\u064a\u0643 \u0628\u0644\u0627\u0644 \u0628\u0648 \u063a\u0631\u064a\u0631 \u0639\u064