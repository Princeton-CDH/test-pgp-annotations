      "body": [
        {
          "type": "TextualBody",
          "label": "verso, address",
          "value": "<ol>\n<li>\n<p>(To) his excellency, my lord, the illustrious Sheikh Abu \u02bel-\u1e24asan</p>\n</li>\n<li>\n<p>\u02bfAll\u0101n b. \u1e24ass\u016bn&mdash;may he rest in Eden!&mdash;</p>\n</li>\n<li>\n<p>may God make his honored position permanent!</p>\n</li>\n<li>\n<p>(From) His servant,</p>\n</li>\n<li>\n<p>Bund\u0101r b. al-\u1e24asan b.</p>\n</li>\n<li>\n<p>Bund\u0101r, may he rest in Eden!</p>\n</li>\n</ol>\n<p>&nbsp;</p>",
          "format": "text/html"
        }
