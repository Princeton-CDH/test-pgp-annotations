    {
      "etag": "\"c4c49540276e7bcd83a726ecb89e4ddb\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/81b5affa-6260-4ced-8d87-7ceaaec21ddb/",
      "type": "Annotation",
