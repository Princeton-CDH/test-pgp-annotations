        {
          "type": "TextualBody",
          "label": "Right Margin",
          "value": "<p>\u0648\u062a\u0645 \u0627\u0642\u0644\u0639\u0646\u0627 \u0645\u0646 \u0633\u0648\u0627\u0643\u0646 \u0648\u0643\u0644\u064a\u0646\u0627 \u0627\u0644\u0645\u0631\u0643\u0628 \u0641\u064a\u0647\u0627 \u0648\u063a\u064a\u0646\u0627 \u0630\u0647\u0644\u0643 \u0628\u0627\u0644 \u0633\u062a\u0631 \u0648\u0627\u0644 \u0633\u0644\u0627\u0645\u0629 \u0648\u0628\u0642\u064a\u0646\u0627 \u05d4 \u0627\u064a\u0627\u0645 \u0641\u0648\u0635\u0644\u062a \u0627\u0644\u063a\u0644\u064a\u0628\u0629 \u0627\u0644\u062a\u064a \u0627\u0643\u062a\u0631\u0627\u0648 \u0627\u0644 \u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u0641\u064a \u0633\u0648\u0627\u0643\u0646 \u0641\u0633\u0627\u0644\u0627\u0647\u0645 \u0639\u0646 \u0627\u0644\u0645\u0631\u0643\u0628 \u0641\u0642\u0627\u0644\u0648 \u0645\u0627 \u0631\u0627\u064a\u0646\u0627\u0647 \u0641\u0628\u0642\u0649 \u0627\u0644\u0646\u0627\u0633 \u0641\u0627\u0632\u0639\u064a\u0646 \u0639\u0644\u064a\u0647 \u0627\u0644\u0649 \u0627\u0646 \u0648\u0635\u0644 \u0627\u0628\u0646 \u0627\u0644 \u0642\u0637\u0627\u0646</p>",
