      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, margin",
          "value": "<ol><li>\u0641\u0639\u0644\u062a \u0645\u062a\u0637\u0648\u0644\u0627 \u0645\u062c\u0645\u0644\u0627 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u064a\u062e\u062a\u0635 \u0639\u0645\u0627\u062f\u064a \u0627\u0644\u0645\u0639\u0636\u0645 \u0645\u0646 \u0633\u0644\u0627\u0645\u064a \u0627\u0644\u0627\u0628\u0631 \u0627\u0644\u0627\u062e\u0631\u0645 \u062d\u0633\u0628</li>\n<li>\u062a\u0639\u0638\u064a\u0645\u064a \u0644\u0642\u062f\u0631\u0629 \u0648\u062a\u0631\u0641\u064a\u0639\u064a \u0644\u0644\u0633\u0646\u064a \u062e\u0637\u0631\u0647 \u0648\u062a\u0628\u0644\u063a\u0647 \u0627\u0644\u0631\u0628 \u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u062c\u0627\u0648\u0646 \u0627\u0644\u0627\u0639\u0638\u0645 \u0627\u0644\u0627\u0641\u0636\u0644 \u0645\u0648\u0644\u0627\u064a \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0629</li>\n<li>\u0648\u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u0627\u062c\u0644 \u05e8 \u05de\u05d0\u05d9\u05e8 \u0627\u0628\u0646\u0647 \u05d5\u05e8 \u05de\u05d0\u05d9\u05e8 \u05d1\u05df \u05d0\u05db\u05d9\u05d4 \u0648\u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0627\u062c\u0644 \u05e8 \u05d9\u05e2\u05e7\u05d1 \u0639\u0645\u062f\u064a \u0627\u0639\u0632 \u0627\u0644\u0644\u0647 \u062c\u0645\u064a\u0639\u0647\u0645 \u0648\u0643\u0644 \u0645\u0646 \u064a\u062a\u0631\u062f\u062f</li>\n<li>\u0639\u0644\u064a\u0643 \u0645\u0646 \u0627\u0644\u0627\u0643\u0648\u0627\u0646 \u0627\u0639\u0632\u0647\u0645 \u0627\u0644\u0644\u0647 \u0648\u0627\u062e\u064a \u0645\u0644\u062a\u0632\u0645 \u0628\u0631\u0643 \u064a\u0642\u0631\u0627 \u0639\u0644\u064a\u0643 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0645 \u0648\u0645\u0639\u0627\u062f \u0627\u0644\u0633\u0644\u0645 \u0648\u0645\u062e\u0631\u0631\u0629</li>\n<li>\u0648\u0645\u062c\u062f\u062f\u0647 \u0639\u0644\u0649 \u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u0644\u0645\u0646\u0639\u0645 \u0648\u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0644\u0649 \u0648\u0628\u0631\u0643\u0627\u062a\u0647 \u0644\u062f\u064a\u0629</li>\n<li>\u062a\u062a\u0648\u0627\u0644\u064a \u05e2\u05d1</li></ol>\n<p> </p>",
