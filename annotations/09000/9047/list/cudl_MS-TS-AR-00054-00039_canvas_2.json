      "body": [
        {
          "type": "TextualBody",
          "label": "verso, left",
          "value": "<ol><li>\u0627\u0644\u0649 \u062d\u0627\u0644\u0647\u0627 \u062a\u0648\u0645 \u0645\u0646 \u0627\u0648\u0644</li>\n<li>\u0627\u0644\u062f\u062e\u0648\u0644 \u064a\u0642\u0635\u062f \u0627\u0644\u0645\u063a\u0627\u0644\u0637\u0629</li>\n<li>\u0641\u064a \u0643\u062a\u0628 \u0627\u0644\u062c\u0645\u064a\u0639 \u0648\u064a\u0642\u0627\u0644</li>\n<li>\u0627\u0646 \u0645\u0627 \u0648\u0635\u0644 \u0645\u0639\u0649 \u0643\u062a\u0627\u0628</li>\n<li>\u0628\u0644 \u0647\u064a \u062a\u0635\u0644 \u0645\u0639 \u063a\u064a\u0631\u0649</li>\n<li>\u062d\u062a\u0649 \u0643\u062a\u0628 \u05d9\u05d5\u05e1\u05e3 \u0648\u062e\u0644\u0641</li>\n<li>\u0648\u0627\u0644\u062c\u0645\u064a\u0639 \u0648\u0643\u062a\u0627\u0628 \u05e8 \u05d9\u05e2\u05e7\u05d1</li>\n<li>\u0627\u064a\u0636\u0627 \u0639\u0646 \u0627\u0645\u0631\u0647 \u0627\u0646 \u0643\u0627\u0646</li>\n<li>\u062b\u0645 \u0634\u0639\u062a \u062c\u0645\u064a\u0639\u0647\u0645</li></ol>\n<p>\u0648\u0627\u064a\u0636\u0627</p>",
          "format": "text/html"
        }
      ],
