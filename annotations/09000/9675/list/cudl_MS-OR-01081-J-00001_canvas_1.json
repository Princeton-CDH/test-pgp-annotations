      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, margin:",
          "value": "\n<ol><li>\u0645\u0646\u0635\u0648\u0631 \u0648\u0627\u062e\u0648\u064a\u0629</li>\n<li>\u0648\u062e\u0648\u0627\u062a\u0649</li>\n<li>\u0648\u0627\u0644\u0635\u0628\u064a\u0627\u0646</li>\n<li>\u0648\u062c\u0645\u064a\u0639 \u0627\u0635\u062d\u0627\u0628\u0646\u0627</li>\n<li>\u0648\u0627\u0644\u0639\u062b\u064a\u0642</li>\n<li>\u0648\u0645\u062d\u0627\u0633\u0646</li>\n<li>\u0643\u062a\u0628\u062a \u05db\u05d1 \u05d0\u05d9\u05d9\u05e8</li>\n<li>\u0648\u0627\u0644\u062e\u062c\u0627\u0631</li>\n<li></li></ol>\n",
