          "label": "",
          "value": "<p>\u0627\u0644 \u0645\u0628\u0647\u062c \u0627\u0644 \u0645\u0648\u0646\u0633 \u0627\u0644 \u0645\u062a\u0644\u063a \u0648\u0627\u0645\u0627 \u0645\u0627 \u0627\u0646\u0627 \u0641\u064a\u0647 \u0645\u0646 \u0634\u0643\u0631\u0643 \u0648\u062a\u0637\u064a\u064a\u0628 \u0630\u0643\u0631\u0643 \u0648\u0646\u0634\u0631 \u0645\u0648\u0627\u0647\u0628\u0643 \u0648\u0645\u0627\u062b\u0631\u0643 \u0648\u0648\u0635\u0641 \u0641\u0636\u0627\u0626\u0644\u0643 \u0648\u0645\u0641\u0627\u0643\u0631\u0643 \u0641\u0628\u062d\u064a\u062b \u0644\u0627 \u064a\u062d\u0645\u0644\u0647 \u0643\u062a\u0627\u0628 \u0648\u0644\u0627 \u064a\u062d\u0648\u064a\u0647 \u0643\u0637\u0627\u0628 \u0627\u0633\u0644 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u0647\u0646\u064a\u0646\u064a \u0628\u0644\u0645 \u0641\u0635\u064a\u0644\u0629 \u0645\u0646\u0643 \u0648\u0627\u0644 \u0645\u0648\u0647\u0628\u0629 \u0627\u0644 \u0633\u0646\u064a\u0629 \u0641\u064a\u0643 \u0628\u0645\u0646\u0647 \u0648\u0627\u0645\u0627 \u0627\u0644 \u0627\u0633\u062a\u064a\u062d\u0627\u0634 \u0627\u0644\u0649 \u0645\u062c\u0627\u0644\u0633\u062a\u0643 \u0648\u0645\u0641\u0627\u0648\u0636\u062a\u0643 \u0648\u0627\u0644\u0649 \u0627\u0644\u062a\u0634\u0641\u0649 \u0645\u0646 \u0645\u062d\u0627\u0636\u0631\u062a\u0643 \u0641\u0628\u062d\u064a\u062b \u0644\u0627 \u064a\u0639\u062f\u0644 \u0628\u0647 \u0627\u0646\u0633 \u062d\u0627\u0634\u0627\u0647 \u0648\u0644\u0627 \u064a\u062a\u0634\u0641\u0649 \u0645\u0646\u0647 \u0633\u0648\u0627\u0647 \u0648\u0627\u0644\u0644\u0647 \u064a\u0642\u0631\u0628 \u0630\u0644\u0643 \u0644\u064a \u0648\u064a\u0639\u064a\u062f \u0627\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644 \u0639\u0648\u0627\u0626\u062f \u0645\u0646\u0647 \u0628\u062d\u0648\u0644\u0647 \u0648\u0641\u0636\u0644\u0647 \u0648\u0627\u0644 \u0627\u0645\u062a\u0646\u0627\u0646 \u0627\u0644 \u062c\u0633\u064a\u0645 \u0641\u064a \u0645\u0631\u0627\u062c\u0639\u062a\u0649 \u0628\u0627\u062d\u0648\u0627\u0644\u0643 \u0627\u062c\u0631\u0627\u0647\u0627 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0631\u0636\u0627\u0643 \u0648\u0630\u0647\u0628\u0643 \u0641\u064a \u062d\u0631\u0643\u062a\u0643 \u0643\u0627\u0631 \u0627\u0644\u0644\u0647 \u0644\u0643 \u0641\u064a \u0637\u0639\u0646\u0643 \u0648\u0645\u0642\u0627\u0645\u0643 \u0648\u0633\u0641\u0631\u0643 \u0627\u0631\u0643\u0643 \u0628\u0645\u0646\u0647 \u0648\u0637\u0648\u0644\u0647 \u0648\u0627\u0642\u0631\u0627\u0643 \u064a\u0627\u0633\u064a\u062f\u064a \u0648\u0639\u0645\u0627\u062f\u064a \u0633\u0644\u0627\u0645\u0627 \u062d\u0633\u0628 \u0634\u0648\u0642\u0649 \u0644\u0643 \u0648\u0627\u0633\u062a\u0637\u0647\u0627\u0631\u064a \u0628\u0643 \u0648\u0627\u0644 \u0633\u0644\u0645 \u0627\u0644 \u062c\u0632\u064a\u0644 \u0627\u0644 \u0645\u0631\u062f\u062f \u0627\u0644 \u0627\u0644 \u062d\u0641\u064a\u0644 \u0634\u0648\u0642\u064a \u0644\u0643 \u0648\u0627\u0633\u062a\u0637\u0647\u0627\u0631\u064a \u0628\u0643 \u0648\u0627\u0644 \u0633\u0644\u0645 \u0627\u0644 \u062c\u0632\u064a\u0644 \u0627\u0644 \u0645\u0631\u062f\u062f \u0627\u0644 \u0627\u0644 \u062d\u0641\u064a\u0644 \u0639\u0644\u064a\u0643 \u064a\u0627\u0633\u064a\u062f\u064a \u0648\u0639\u0645\u0627\u062f\u064a \u0648\u0631\u062d\u0645\u0647</p>",
