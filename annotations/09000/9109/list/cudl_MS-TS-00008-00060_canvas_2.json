          "label": "Verso",
          "value": "\n<ol><li>\u0641\u064a\u0646\u0639\u0645 \u0628\u0642\u0628\u0636 \u0630\u0644\u0643 \u0645\u0646 \u0627\u0644\u0631\u0633\u0648\u0644 \u0648\u064a\u0639\u0631\u0641\u0646\u064a \u0628\u0648\u0635\u0648\u0644 \u062c\u0645\u064a\u0639 \u0630\u0644\u0643</li>\n<li>\u0648\u0627\u064a\u0636\u0627 \u0627\u0644\u062d\u0631\u064a\u0631 \u0627\u0644\u0627\u0633\u0648\u062f \u0644\u0645 \u064a\u0639\u0631\u0641\u0646\u064a \u0628\u0648\u0635\u0648\u0644\u0647 \u0648\u0635\u062d\u0628\u0647 \u0627\u0644\u0634\u064a\u0643</li>\n<li>\u0632\u0643\u0631\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0630\u064a \u062a\u0642\u0641 \u0639\u0644\u064a\u0647\u0645 \u0648\u0637\u064a\u0647\u0627 \u0645\u0633\u0644\u0629 \u0633\u0627\u0644 \u0641\u064a\u0647\u0627</li>\n<li>\u05e6\u05d3\u05d9\u05e7 \u0644\u0627\u0646 \u062a\u0627\u062e\u0630 \u0644\u0647 \u0627\u0644\u062c\u0648\u0627\u0628 \u0648\u0644\u064a\u0647\u0627 \u0648\u063a\u064a\u0631 \u0630\u0644\u0643 \u0641\u0642\u062f</li>\n<li>\u062a\u0642\u0644 \u0639\u0644\u064a\u064a \u0627\u0644\u0643\u0647\u0646 \u0627\u0644\u0640\u05e1\u05e7\u05dc\u05d9 \u0648\u062d\u0634\u0645\u0646\u064a \u0639\u0644\u0649 \u064a\u062f\u064a \u0627\u0644\u0646\u0627\u0633 \u0641\u064a \u0633\u0648\u0642</li>\n<li>\u0627\u0644\u0635\u0631\u0641 \u0648\u0633\u0627\u0644 \u0641\u064a \u0627\u0646 \u064a\u062e\u0644\u0635 \u0645\u0646 \u0627\u0644\u0630\u0647\u0628 \u0627\u0644\u0630\u064a \u0644\u0647 \u062a\u0645\u0646 \u0627\u0644\u062d\u0631\u064a\u0631</li>\n<li>\u0641\u062a\u0646\u0639\u0645 \u0628\u0643\u062a\u0627\u0628 \u0633\u0631\u0639\u0629 \u0645\u0646 \u0627\u0628\u0646 \u0627\u0644\u0627\u0645\u0634\u0627\u0637\u0649 \u0627\u0646\u0643 \u0642\u062f</li>\n<li>\u0633\u0644\u0645\u062a\u0647 \u0644\u0647 \u0627\u0644\u0630\u0647\u0628 \u0627\u0648 \u0627\u0646\u0643 \u0641\u064a\u0647 \u0628\u0642\u064a\u062a\u0647 \u064a\u0628</li></ol>\n",
