    {
      "etag": "\"6b8f4545322abc4d5c3b7e58ae233864\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/2ada69fd-b689-4a56-a875-a12884594dd2/",
      "type": "Annotation",
      "created": "2025-11-10T23:31:37.035117+00:00",
      "modified": "2025-11-10T23:31:37.035123+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-J-00018-00002/canvas/1",
          "type": "Canvas",
          "partOf": {
