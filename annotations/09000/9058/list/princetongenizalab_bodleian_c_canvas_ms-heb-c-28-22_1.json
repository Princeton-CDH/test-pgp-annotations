      "body": [
        {
          "type": "TextualBody",
          "label": "Right Margin",
          "value": "<p>\u0633\u0641\u0631 \u0627\u0644\u0647\u0646\u062f \u0644\u0627\u0646 \u062c\u0627\u0648 \u0627\u0644\u0635\u0628\u064a\u0627\u0646 \u0645\u0646 \u0644\u0645 \u064a\u0633\u0627\u0641\u0631 \u0642\u0637 \u0648\u0644\u0627 \u064a\u0639\u0631\u0641 \u0644\u0627 \u064a\u0628\u064a\u0639 \u0648\u0644\u0627 \u064a\u0634\u062a\u0631\u064a \u0635\u0627\u0631\u062a \u0627\u0644\u0645\u0627\u0626\u0629 \u0645\u0639\u0647\u0645 \u0645\u0627\u0626\u062a\u0627\u0646 \u0648\u0627\u0642\u0644 \u0645\u0646 \u0641\u064a\u0647\u0645 \u0645\u062e\u0627\u0631\u0645 \u0628\u0646 \u0627\u0644\u0633\u0644\u0645\u064a \u0648\u0627\u0645\u0627 \u0645\u0633\u0644\u0645 \u063a\u0627\u062a \u05e7 \u05e7\u05e7\u05e0 \u0639\u0631\u0641\u062a \u062d\u0636\u0631\u062a\u0647 \u0630\u0644\u0643 \u0648\u0644\u0639\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639 \u064a\u062c\u0639\u0644 \u0627\u0644\u0639\u0627\u0642\u0628\u0629 \u0627\u0644\u0649 \u062e\u064a\u0631 \u0648\u064a\u0639\u0648\u0648\u0636 \u0628\u0631\u062d\u0645\u062a\u0647 \u0642\u0631\u0627\u062a \u0639\u0644\u0649 \u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0633\u0627\u0645\u064a\u0629 \u0627\u0641\u0636\u0644 \u0633\u0644\u0627\u0645 \u0648\u0633\u064a\u064a\u062f\u0646\u0627 \u0627\u062d\u064a\u0627\u0647 \u0627\u0644\u0644\u0647 \u064a\u062e\u0635\u0643 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u062e\u064a\u0643 \u064a\u062e\u0635\u0643 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0643\u0630\u0644\u0643 \u0627\u062e\u064a\u0643 \u0627\u0644\u0627\u062e\u0631 \u0648\u0647\u0645\u0627 \u0648\u0627\u0648\u0644\u0627\u062f\u0647\u0645 \u064a\u062e\u0635\u0648\u0643 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0647\u0645\u0627 \u0639\u0644\u0649 \u062c\u0645\u0644\u0629 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u0639\u0627\u0641\u064a\u0629 \u0648\u0628\u0631\u0648\u0643 \u0627\u0644\u0644\u0647 \u062b\u0639 \u064a\u0643\u062a\u0628 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u064a\u062c\u0645\u0639 \u0634\u0645\u0644\u0643 \u0628\u0647\u0645 \u0648\u0643\u0630\u0644\u0643 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0648\u062d\u0634 \u0633\u0628\u0627\u0639 \u064a\u062e\u0635\u0643 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0642\u0631\u064a \u0645\u0648\u0644\u0626\u064a</p>",
