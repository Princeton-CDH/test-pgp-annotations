      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u064a\u0627 \u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0643 \u0648\u0631\u062f\u0646\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646 \u0639\u0646\u062f \u0645\u0631\u0646\u0627 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d1\u05df \u05d2\u05d9\u05d0\u05ea \u0645\u0648\u0644\u0626\u064a \u0648\u0645\u0639\u0638\u0645\u0643 \u0627\u0639\u0632\u0643\u0645\u0627 \u0627\u0644\u0644\u0647 \u0641\u0631\u0627\u064a\u062a \u062a\u0637\u064a\u064a\u0631\u0647 \u0627\u0644\u064a\u0643 \u0644\u062a\u0627\u0646\u0633 \u0628\u0647 \u0648\u0639\u0633\u0649 \u0627\u0646\u0633\u0646\u0627 \u0628\u0643 \u0627\u0644\u0644\u0647 \u0648\u0642\u062f \u062a\u0642\u062f\u0645 \u0643\u062a\u0627\u0628\u064a \u0634\u0627\u062e\u0631\u0627 \u0639\u0644\u0649 \u0645\u0627 \u0627\u0648\u0644\u064a\u062a\u0647 \u0641\u064a \u062c\u0627\u0646\u0628 \u0627\u0644\u0634\u0628\u0648\u064a\u0629 \u064a\u0639\u0633\u064a \u062a\u0632\u0639\u062c \u0627\u0644\u064a\u0646\u0627 \u0648\u0627\u0644\u062f\u0647\u0627 \u0641\u0627\u0646 \u0627\u0645\u0631\u0647\u0627 \u0642\u0631\u0628 \u0645\u0631\u0627\u0645\u0647\u0627 \u0644\u0627\u0646 \u0644\u0646\u0627 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0646\u062d\u0646 \u0646\u0632\u0646 \u0639\u0634\u0631\u0629 \u0645\u062a\u0627\u0642\u064a\u0644 \u0648\u0627\u0644\u062b \u0631 \u05da \u0627\u0644\u062c\u0632 \u0627\u0631\u0633\u0644 \u0628\u0627\u0631\u0628\u0639\u0629 \u0627\u0648 \u0646\u062d\u0648\u0647 \u0648\u0627\u0644\u0645\u062a\u0634\u0627\u0644 \u0627\u0644\u0630\u064a \u062a\u0641\u0636\u0644\u062a \u0627\u0646\u062a \u0628\u0647 \u0648\u0646\u0646\u062a\u0638\u0631 \u0645\u0646 \u05de \u05d0 \u05dc \u05e7 \u05d4 \u0633\u062a\u0629 \u0641\u0627\u0646 \u0633\u0627\u0642 \u0645\u0646 \u0627\u0644\u064a\u0633\u0627\u0646\u0629 \u0639\u0634\u0631\u0629 \u0641\u0642\u062f \u0643\u0645\u0644 \u0627\u0644\u0627\u0645\u0631 \u0648\u0639\u0633\u0649 \u0627\u0646 \u0646\u062e\u0631\u062c \u0627\u0628\u0646\u062a\u0647 \u0642\u0628\u0644 \u0627\u0644\u0639\u064a\u062f \u0641\u0627\u0646 \u0627\u0644 \u05de \u05e8 \u05e9 \u05e2 \u05ea \u0642\u062f \u062a\u0639\u0642\u0628\u062a \u0627\u0644\u0631\u0627\u064a \u0641\u064a \u0627\u0628\u0627\u062d\u062a\u0647\u0627 \u0644\u0646\u0627 \u0641\u064a \u0627\u0644\u0627\u0633\u0628\u0627\u062a \u0648\u0627\u0644\u0627\u0639\u064a\u0627\u062f \u0648\u0627\u0646 \u0631\u0627\u0649 \u0627\u064a\u0636\u0627 \u0645\u0646 \u0627\u0644\u0631\u0627\u0649 \u0627\u0646 \u064a\u0631\u0633\u0644 \u0627\u0644\u064a\u0646\u0627 \u0645\u0627 \u062d\u0636\u0631 \u0648\u064a\u0645\u0636\u0649 \u0627\u0644\u0649 \u063a\u0631\u0646\u0627\u0638\u0647 \u0627\u0646 \u0639\u062c\u0632 \u0645\u0646 \u0644\u0628 \u0648\u062b\u0644\u062b\u064a\u0646 \u0634\u064a \u0641\u064a\u0641\u0639\u0644 \u0648\u0627\u0638\u0646 \u0627\u0644\u0635\u0648\u0627\u0628 \u0627\u0646 \u064a\u0633\u062a\u0639\u062c\u0644 \u062e\u0631\u0648\u062c\u0647\u0627 \u0648\u0627\u0644\u0644\u0647 \u064a\u062d\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0627\u0631\u0634\u062f \u0648\u0627\u062e\u0631 \u0627\u0644\u0627\u0645\u062f \u0645\u0639 \u0627\u0644 \u05de \u05e8 \u05e9 \u05e2 \u05ea \u0627\u0646\u0633\u0644\u0627\u0643 \u05ea\u05e9\u05e8\u05d9 \u0648\u0644\u064a\u0633\u062a \u062a\u0641\u062a\u0631\u0646\u0627 \u0633\u0627\u0639\u0629 \u0648\u0639\u0633\u0649 \u062a\u0639\u0644\u0645\u0646\u064a \u0628\u062d\u0627\u0644\u0643 \u0641\u064a \u062c\u0633\u0645\u0643 \u0648\u0641\u064a \u0646\u0641\u0633\u0643 \u0627\u0637\u0644\u0639\u0643 \u0627\u0644\u0644\u0647 \u0641\u064a \u0645\u0646\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u062c\u0644\u064a\u0644 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0627\u0635\u064a\u0644 \u05de\u05e8 \u05d5\u05e8\u05d1 \u05d7\u05dc\u05e4\u05d5\u05df \u05d4\u05dc\u05d5\u05d9 \u05e0\u05d8 \u05e8\u05d7 \u05d1\u05df \u05db\u05d1\u05d5\u05d3 \u05de\u05e8 \u05d5\u05e8\u05d1 \u05e0\u05ea\u05e0\u05d0\u05dc \u05d4\u05dc\u05d5\u05d9 \u064a\u0627 \u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0643 \u0648\u0631\u062f\u0646\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646 \u0639\u0646\u062f \u0645\u0631\u0646\u0627 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d1\u05df \u05d2\u05d9\u05d0\u05ea \u0645\u0648\u0644\u0626\u064a \u0648\u0645\u0639\u0638\u0645\u0643 \u0627\u0639\u0632\u0643\u0645\u0627 \u0627\u0644\u0644\u0647 \u0641\u0631\u0627\u064a\u062a \u062a\u0637\u064a\u064a\u0631\u0647 \u0627\u0644\u064a\u0643 \u0644\u062a\u0627\u0646\u0633 \u0628\u0647 \u0648\u0639\u0633\u0649 \u0627\u0646\u0633\u0646\u0627 \u0628\u0643 \u0627\u0644\u0644\u0647 \u0648\u0642\u062f \u062a\u0642\u062f\u0645 \u0643\u062a\u0627\u0628\u064a \u0634\u0627\u062e\u0631\u0627 \u0639\u0644\u0649 \u0645\u0627 \u0627\u0648\u0644\u064a\u062a\u0647 \u0641\u064a \u062c\u0627\u0646\u0628 \u0627\u0644\u0634\u0628\u0648\u064a\u0629 \u0648\u0639\u0633\u0649 \u062a\u0632\u0639\u062c \u0627\u0644\u064a\u0646\u0627 \u0648\u0627\u0644\u062f\u0647\u0627 \u0641\u0627\u0646 \u0627\u0645\u0631\u0647\u0627 \u0642\u0631\u0628 \u0645\u0631\u0627\u0645\u0647\u0627 \u0644\u0627\u0646 \u0644\u0646\u0627 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0646\u062d\u0648 \u0646\u062d\u0648 \u0639\u0634\u0631\u0629 \u0645\u062a\u0627\u0642\u064a\u0644 \u0648\u0627\u0644\u062a\u0631\u0643 \u0627\u0644\u062c\u0632 \u0627\u0631\u0633\u0644 \u0628\u0627\u0631\u0628\u0639\u0629 \u0627\u0648 \u0646\u062d\u0648\u0647 \u0648\u0627\u0644\u0645\u062a\u0642\u0627\u0644 \u0627\u0644\u0630\u064a \u062a\u0641\u0636\u0644\u062a \u0627\u0646\u062a \u0628\u0647 \u0648\u0646\u0646\u062a\u0638\u0631 \u0645\u0646 \u0645\u0627\u0644\u0642\u0629 \u0633\u062a\u0629 \u0641\u0627\u0646 \u0633\u0627\u0642 \u0645\u06