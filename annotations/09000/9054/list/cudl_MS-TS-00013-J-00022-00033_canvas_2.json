      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00022-00033/canvas/2",
          "type": "Canvas",
