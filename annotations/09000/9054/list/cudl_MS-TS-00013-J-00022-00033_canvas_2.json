    {
      "etag": "\"b3d1f0b7d1f6f888b26415cb80590f84\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/96341fa2-2583-405b-a8c0-1183a4651a2a/",
      "type": "Annotation",
      "created": "2025-11-07T01:12:32.016230+00:00",
