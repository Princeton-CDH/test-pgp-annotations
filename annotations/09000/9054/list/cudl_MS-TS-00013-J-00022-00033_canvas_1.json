      "type": "Annotation",
      "created": "2025-11-07T01:10:57.649122+00:00",
      "modified": "2025-11-07T01:10:57.649129+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00022-00033/canvas/1",
          "type": "Canvas",
