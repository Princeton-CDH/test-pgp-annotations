          "id": "https://figgy.princeton.edu/concern/scanned_resources/e80823f6-4a19-4644-8e59-2a9798b36014/manifest/canvas/e443c247-e0b2-432b-b44b-1e4690b69e8c",
          "type": "Canvas",
