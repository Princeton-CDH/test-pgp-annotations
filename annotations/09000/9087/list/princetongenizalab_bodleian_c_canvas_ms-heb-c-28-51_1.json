        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u062d\u0636\u0631\u0629 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0627\u0643\u0645\u0644 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u062f\u0627\u0645 \u0639\u0632\u0647 \u0645\u062a\u0644\u0632\u0645 \u0627\u062c\u0644\u0627\u0644\u0647 \u0648\u0646\u0627\u0634\u0631 \u0627\u062c\u0645\u0627\u0644\u0647 \u064a\u0639\u0642\u0648\u0628 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u0648\u0627\u0644\u0646\u0641\u0648\u0633 \u062a\u0633\u062a\u0647\u062f\u064a \u0627\u0646\u0628\u0627\u0647 \u0648\u0627\u0644\u0642\u0644\u0648\u0628 \u062a\u062a\u0645\u0646\u064a \u0642\u0631\u0628\u0647 \u0648\u0644\u0642\u0627\u0647 \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u0649 \u062d\u0636\u0631\u062a\u0647 \u0648\u0628\u0648\u062f\u064a \u0627\u0646 \u0627\u0643\u0648\u0646\u0647 \u0641\u0627\u062d\u0637\u064a \u0628\u0644\u0642\u0627\u0626\u0629 \u062f\u0648\u0646\u0647 \u0641\u0627\u0634\u0641\u064a \u062c\u0644\u0629 \u0627\u0644\u0634\u0648\u0642 \u0628\u0645\u062c\u0627\u0644\u0633\u062a\u0629 \u0627\u0644\u0645\u0639\u0633\u0648\u0644\u0629 \u0648\u0645\u0641\u0627\u0648\u0636\u062a\u0647 \u0627\u0644\u0645\u0627\u0645\u0648\u0644\u0629 \u0648\u0645\u0646\u062f \u0641\u0627\u0631\u0642\u062a\u0647 \u0644\u0627 \u0641\u0627\u0631\u0642\u0629 \u0627\u0644\u0639\u0632 \u0627\u0644\u0627\u0631\u0642\u064a \u0648\u0627\u0644\u062d\u0631\u0632 \u0627\u0644\u0627\u0648\u0642\u064a \u0627\u0639\u0644\u0644 \u0627\u0644\u0646\u0641\u0633 \u062c\u0639\u0644\u062a \u0641\u0630\u0627\u0647 \u0628\u0630\u0643\u0631\u0647 \u0627\u0644\u062c\u0645\u064a\u0644 \u0648\u0627\u0637\u064a\u0628 \u0627\u0644\u0627\u0631\u062c\u0627 \u0628\u0648\u0635\u0641 \u0633\u062e\u0648\u0629 \u0627\u0644\u0627\u062b\u064a\u0644 \u0648\u0641\u064a \u0639\u0644\u0645\u0647 \u062a\u0639\u0644\u0649 \u0627\u0646\u064a \u0627\u0639\u0638\u0645\u0647 \u0641\u064a \u0627\u0644\u0633\u0631 \u0643\u0645\u0627 \u0627\u0639\u0638\u0645\u0647 \u0641\u064a \u0627\u0644\u0639\u0644\u0627\u0646\u064a\u0629 \u0648\u0627\u0644\u062c\u0647\u0631 \u0648\u0627\u0646 \u0645\u0639\u0638\u0645 \u0632\u0645\u0627\u0646 \u0631\u0627\u062d\u062a\u064a \u0648\u0627\u0646 \u0643\u0627\u0646 \u0642\u0635\u064a\u0631\u0627 \u0627\u0646\u0645\u0627 \u0627\u0639\u0645\u0631\u0647 \u0628\u0646\u0634\u0631 \u0641\u0635\u0627\u0626\u0644\u0629 \u0648\u062c\u0645 \u0645\u0639\u0644\u0648\u0627\u062a\u0647 \u0648\u0634\u062a\u0649 \u0627\u062f\u0648\u0627\u062a\u0647 \u0648\u0642\u0627\u0647\u0627 \u0627\u0644\u0644\u0647 \u0627\u0641\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0648\u0631 \u0648\u0635\u0627\u0646 \u0645\u0627 \u0645\u0646\u062d\u0646\u064a \u0645\u0646 \u0635\u0641\u0648 \u0648\u0630\u0647 \u0645\u0646 \u0627\u0644\u062a\u063a\u064a\u0631 \u0648\u0627\u0644\u062e\u062f\u0648\u0631 \u0628\u0645\u0646\u0647 \u0648\u0644\u0645\u0627 \u0648\u0635\u0644 \u062b\u0627\u0644\u062b\u0646\u0627 \u0648\u062b\u0627\u0646\u064a \u0646\u0641\u0633\u064a \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0628\u0648 \u0627\u064a\u0648\u0628 \u0628\u0646 \u0633\u0647\u0644 \u0645\u0639\u0638\u0645 \u0642\u062f\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u064a\u0629 \u0648\u062c\u0628 \u0639\u0631\u0636\u0647 \u0628\u062e\u0627\u0647 \u0648 \u0645\u0627 \u0633\u062f\u062a \u0628\u0647 \u0627\u0644\u0631\u0641\u0627\u0642 \u0648\u0639\u0637\u0631\u062a \u0628\u0647 \u0627\u0644\u0627\u0641\u0627\u0642 \u0645\u0646 \u062c\u0645\u0627\u0644 \u0627\u062b\u0627\u0631\u0647 \u0648\u062c\u0644\u0627\u0644\u0647 \u0645\u0642\u062f\u0627\u0631\u0629 \u0627\u0646\u0637\u0642\u062a\u0647 \u0627\u0631\u064a\u062d\u064a\u0629 \u0627\u0644\u0634\u0648\u0642 \u0627\u0644\u0649 \u0644\u0642\u064a\u0627 \u0645\u0648\u0644\u0627\u064a \u0641\u0627\u0639\u0627\u062f \u0646\u062b\u0631\u0646\u0627 \u0645\u0646\u0638\u0648\u0645\u0627 \u0648\u0648\u0635\u0641 \u0628\u0639\u0636 \u062d\u0644\u0627\u0647 \u0645\u062d\u062f\u0648\u062f\u0627 \u0648\u0645\u0631\u0633\u0648\u0645\u0627 \u0641\u064a \u0627\u0644\u0642\u0637\u0639\u0629 \u0627\u0644\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u0646\u0627\u0637\u0642\u0629 \u0628\u062c\u0644\u0627\u0644\u0629 \u0648\u0633\u064a\u0627\u062f\u062a\u0647 \u0627\u0644\u0646\u0627\u0637\u0642\u0629 \u0628\u062c\u0644\u0627\u0644\u0647 \u0648\u0633\u064a\u0627\u062f\u062a\u0647 \u0648\u0645\u062c\u062f\u0647 \u0648\u0627\u0635\u0627\u0644\u062a\u0647 \u0648\u0645\u0639\u0631\u0628\u0629 \u0639\u0645\u0627 \u0641\u064a \u0646\u0641\u0633\u0647 \u0645\u0646 \u0627\u0644\u062a\u0634\u0648\u0642 \u0648\u0627\u0644\u0646\u0632\u0648\u0639 \u0627\u0646 \u064a\u062d\u0637\u064a \u0645\u0646 \u0648\u062f\u0647 \u0628\u0645\u062b\u0644 \u0645\u0627 \u062d\u0638\u064a\u0646\u0627 \u0648\u0644\u0639\u0645\u0631 \u0645\u0648\u0644\u0627\u064a \u0644\u0642\u062f \u0646\u0633\u0628 \u0639\u062f\u0648\u0644\u0647 \u0639\u0646 \u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0649 \u0647\u0646\u0627 \u062a\u0639\u0630\u064a\u0631\u0627 \u0648\u0627\u0644\u0644\u0647 \u064a\u0628\u0644\u063a\u0647 \u0627\u0645\u0644\u0647 \u0641\u064a \u0645\u0627 \u0646\u0648\u0627\u0647 \u0628\u0645\u0646\u0647 \u062c\u0631\u064a\u062a \u0645\u0639 \u0645\u0648\u0644\u0627\u064a \u0641\u064a \u062e\u0637\u0627\u0628\u064a \u0627\u0644\u0649 \u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0645\u062c\u0631\u064a \u0627\u0644\u0645\u0634\u0647\u0648\u0631 \u0628\u064a\u0646 \u0627\u0644\u0646\u0627\u0633 \u0648\u0644\u0648 \u0627\u0633\u0642\u0637\u062a \u0627\u0644\u0645\u0648\u0646\u0629 \u0644\u0643\u0627\u0646 \u0627\u0644\u064a\u0642 \u0628\u0646\u0627 \u0648\u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0643\u0627\u0646 \u0627\u0628\u0644\u063a \u0648\u0627\u0631\u062c\u0648 \u0627\u0646 \u0645\u0646 \u0646\u0641\u0633\u0647 \u0644\u064a \u0639\u0644\u0649 \u0630\u0644\u0643 \u062f\u0644\u0627\u0626\u0644 \u0648\u0645\u062e\u0627\u0626\u0644 \u0641\u0644\u0647 \u0627\u0644\u0641\u0635\u0644 \u0627\u0646 \u064a\u062d\u0633\u0646 \u0627\u0644\u062a\u0627\u0648\u064a\u0644 \u0641\u064a \u0643\u0644 \u0645\u0627 \u064a\u0631\u0627\u0647 \u0645\u0646\u0639\u0645\u0627 \u0648\u0627\u0644\u0631\u062c\u0628\u0629 \u0627\u0644\u064a\u0647 \u062f\u0627\u0645 \u0639\u0632\u0629 \u0641\u064a \u0627\u0644\u0627\u0639\u0644\u0627\u0645 \u0635\u0641\u0629 \u0627\u062d\u0648\u0627\u0644\u0647 \u0635\u062d\u0629 \u0630\u0644\u0643 \u0627\u0637\u0644\u0639 \u0627\u0644\u0644\u0647 \u0645\u0646\u0647 \u0639\u0644\u0649 \u0645\u0627 \u064a\u0633\u0631 \u0648\u0627\u0644\u0646\u0641\u0633 \u0648\u064a\u062f\u064a\u0645 \u0627\u0644\u0627\u0646\u0633 \u0628\u062d\u0648\u0644\u0647 \u0648\u0627\u0642\u0631\u0627 \u0639\u0644\u0649 \u0645\u0648\u0644\u0626\u064a \u0648\u0633\u064a\u062f\u064a \u0633\u0644\u0627\u0645\u0627 \u064a\u0642\u062a\u0636\u064a\u0647 \u0648\u062f\u064a \u0648\u064a\u0636\u0627\u0647\u064a\u0629 \u0627\u0639\u0638\u0627\u0645\u064a \u0648\u0634\u0648\u0642\u064a \u0648\u064a\u062e\u0635 \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0633\u0646\u064a\u0629 \u0645\u0646 \u0633\u0644\u0627\u0645 \u0627\u0628\u064a \u0627\u0633\u062d\u0642 \u0648\u0627\u062e\u064a\u0647 \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0633\u0646\u064a\u0629 \u0645\u0646 \u0633\u0644\u0627\u0645 \u0627\u0628\u064a \u0627\u0633\u062d\u0642 \u0648\u0627\u062e\u064a\u0629 \u0628\u0627\u0633\u0643\u0627\u0647 \u0648\u0627\u062d\u0641\u0627\u0647 \u0648\u0627\u0632\u0643\u0627\u0647 \u0648\u0644\u0647 \u0627\u0644\u0641\u0635\u0644 \u0627\u0646 \u064a\u0628\u0644\u063a \u0627\u0644\u062a\u0627\u062c\u0631\u064a\u0646 \u0627\u0644\u062c\u0644\u064a\u0644\u064a\u0646 \u0627\u0644\u0641\u0627\u0635\u0644\u064a\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0627 \u064a\u0639\u0642\u0648\u0628 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0627 \u0627\u0633\u062d\u0642 \u062b\u0645 \u0627\u0644\u0633\u0644\u0645 \u0627\u0644\u0645\u062c\u062f\u062f \u0627\u0644\u0645\u0643\u0631\u0631 \u0627\u0644\u0645\u062c\u062f\u062f \u0627\u0644\u0645\u0639\u0627\u062f \u0648\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647 \u0648\u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0644\u0649 \u05d4\u05d7\u05db\u05dd \u05d4\u05e0\u05d1\u05d5\u05df \u05de \u05d5\u05e8\u05d1 \u05d7\u05dc\u05e4\u05d5\u05df \u05d1\u05df \u05db\u05d1\u05d5\u05d3 \u05e8\u05d1\u05e0\u05d0 \u05e0\u05ea\u05d0\u05dc</p>",
