      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00019-00017/canvas/1",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/9119/iiif/manifest/"
          }
        },
        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=percent:1,1,98,98",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0639\u0648\u0646\u0643 \u064a\u0627\u0631\u0628</li>\n<li>\u0648\u0644\u0645 \u064a\u062a\u0641\u0642 \u0644\u0647 \u062f\u062e\u0648\u0644 \u0639\u0646\u062f \u0627\u062d\u062f \u0627\u0644\u0627 \u0639\u0646\u062f \u0627\u0644\u0640\u05d6\u05e7\u05df</li>\n<li>\u0641\u064a \u064a\u0648\u0645 \u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4 \u0642\u0628\u0644 \u0627\u0646 \u0648\u0642\u0639 \u0627\u0644\u0646\u0647\u064a \u062b\u0645</li>\n<li>\u0639\u0646\u062f \u0627\u0646\u0633\u0627\u0646 \u064a\u0639\u0631\u0641 \u0628\u0643\u0631\u0627\u0645 \u0627\u0644\u0634\u0645\u0627\u0639 \u0643\u0627\u0646 \u0648\u0635\u0644</li>\n<li>\u0645\u0639\u0647 \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u0648\u062f\u0641\u0639 \u0644\u0647 \u0627\u0644\u0642\u0648\u0644 \u0645\u0646 \u0647\u0646\u0627\u0643 \u0627\u0646\u0647</li>\n<li>\u064a\u0643\u0648\u0646 \u0639\u0646\u062f\u0647 \u0641\u0645\u0636\u064a \u064a\u0648\u0645 \u0648\u0635\u0648\u0644\u0647 \u0627\u0644\u064a\u0647 \u0633\u0627\u0639\u0629 \u0648\u0639\u0627\u062f</li>\n<li>\u062b\u0645 \u0628\u0639\u062f \u0645\u062f\u0629 \u0627\u062c\u062a\u0647\u062f \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0643\u0631\u0645 \u0628\u0646</li>\n<li>\u0645\u0637\u0631\u0648\u062d \u0641\u064a \u0645\u062c\u064a\u0629 \u0627\u0644\u064a\u0647 \u0648\u0631\u062c\u0628 \u0627\u0644\u064a\u0647 \u0648\u062a\u062d\u0627\u0645\u0644 \u0639\u0644\u064a\u0647</li>\n<li>\u0628\u0627\u0644\u062f\u064a\u0627\u0646 \u0648\u0628\u0631\u0633\u0648\u0644 \u0645\u0646 \u0648\u0627\u0644\u0649 \u0627\u0644\u0628\u0644\u062f \u0627\u0644\u0649 \u0627\u0646 \u0645\u0636\u0627 \u0627\u0644\u064a\u0647</li>\n<li>\u0644\u064a\u0644\u0647 \u0633\u0628\u062a \u0648\u0644\u0645 \u064a\u0643\u0646 \u0647\u0646\u0627\u0643 \u0627\u0644\u0627 \u0647\u0648 \u0648\u0627\u0644\u062f\u064a\u0627\u0646 \u0648\u0648\u0644\u062f</li>\n<li>\u0645 \u05d0\u05d1\u05e8\u05d4\u05dd \u0644\u064a\u0643\u0646\u0647 \u0643\u0627\u0646 \u0641\u064a \u0627\u0644\u0627\u0639\u064a\u0627\u062f \u0648\u0627\u0644\u0635\u0648\u0645 \u0648\u0627\u0643\u062b\u0631</li>\n<li>\u0627\u0644\u0633\u0628\u0648\u062a \u0639\u0646\u062f \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0640\u05de\u05e2\u05d5\u05dc\u05d4 \u0648\u0627\u0645\u0627 \u063a\u064a\u0631 \u0630\u0644\u0643</li>\n<li>\u0641\u0639\u0646\u062f \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u064a\u0642\u0639 \u0627\u0644\u062a\u062d\u062f\u062b \u0628\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li>\n<li>\u0648\u062d\u0643\u064a\u0645\u0627 \u0628\u0631\u0645\u0632\u0627 \u0648\u0645\u0627 \u0643\u062b\u0628\u062a \u0647\u0630\u064a\u0646 \u0627\u0644\u062d\u0631\u0641\u064a\u0646</li>\n<li>\u0627\u0644\u0627 \u0648\u0627\u0646\u0627 \u0641\u064a \u0627\u0644\u0628\u064a\u062a \u0644\u0627\u0632\u0645 \u0628\u0631\u0645\u062f \u0644\u062d\u0642\u0646\u064a \u0627\u0644\u0644\u0647</li>\n<li>\u0627\u0644\u0645\u0633\u0648\u0648\u0644 \u0641\u064a \u0627\u0644\u0634\u0641\u0627 \u0648\u0627\u0646\u0646\u064a \u0644\u0645\u062d\u062a\u0634\u0645 \u0645\u0646 \u0645\u0648\u0644\u0626\u064a</li>\n<li>\u0648\u0633\u064a\u064a\u062f\u064a \u0648\u0644\u062f \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0628\u064a \u0627\u0644\u0645\u0646\u0627 \u0646\u0639 \u0627\u062e\u0648\u0647\u0627</li>\n<li>\u0644\u0639\u0630\u0631 \u062a\u0639\u0644\u0645\u0647 \u0627\u0646 \u0627\u0644\u0649 \u0627\u0644\u0627\u0646 \u0644\u0645 \u064a\u062f\u062e\u0644 \u0644\u064a \u0627\u062d\u062f \u0628\u064a\u062a</li>\n<li>\u0648\u0627\u0646\u0646\u064a \u0644\u0645\u0627 \u0627\u0631\u062f\u062a \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u05d1\u05de\u05e8\u05e0\u05d5 \u05d5\u05e8\u05d1\u05e0\u05d5 \u05d9\u05d4\u05d5\u05d3\u05d4</li>\n<li>\u05d4\u05dc\u05d5\u05d9 \u0634\u0636 \u062d\u0645\u0644\u062a \u0639\u0634\u0627\u064a\u064a \u0644\u064a\u064a\u0644\u064a\u0627\u062a \u0648\u0645\u0636\u064a\u062a \u0628\u062a</li>\n<li>\u0639\u0646\u062f\u0647 \u0648\u0627\u064a\u0636\u0627 \u0627\u0646\u0646\u064a \u0642\u0635\u062f\u062a \u062d\u0633\u0645 \u0645\u0627\u062f\u0629 \u0645\u0646</li>\n<li>\u064a\u0637\u0644\u0628\u0647 \u0644\u0627\u0644\u0627 \u064a\u0642\u0627\u0644 \u0644\u0647 \u0642\u062f \u0643\u0646\u062a \u0639\u0646\u062f \u0641\u0644\u0627\u0646 \u0648\u0645\u0627 \u062c\u064a\u062a</li>\n<li>\u0639\u0646\u062f\u064a \u0648\u0627\u0646\u0627 \u0645\u062a\u0631\u0642\u0628 \u0648\u0635\u0648\u0644 \u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0645\u062d\u0631\u0648\u0633\u0629</li>\n<li>\u0639\u0644\u0649 \u0639\u062f\u062f \u0627\u0644\u0644\u062d\u0637\u0627\u062a \u0644\u0639\u0644 \u0627\u0646 \u064a\u0642\u0639 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639</li>\n<li>\u0628\u0647 \u0628\u062d\u0635\u0648\u0631\u0647\u0627 \u0648\u0642\u062f \u0639\u062c\u0628\u062a \u0645\u0646 \u0628\u0637\u0648\u0647\u0627 \u0648\u0627\u0646</li>\n<li>\u0647\u0630\u0627 \u0627\u0644\u0635\u062f\u0627\u0639 \u0642\u062f \u062d\u0627\u0646 \u0644\u0647 \u0627\u0646 \u064a\u0646\u0642\u0635\u064a \u0648\u0639\u0646\u062f</li></ol>\n",
          "format": "text/html"
        }
