    {
      "etag": "\"b444aa1b0fb9c5e2ce5fba1c4cc39710\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/3430b92f-1f50-4556-b8b7-b4c5cbf9a757/",
      "type": "Annotation",
      "created": "2026-10-29T19:52:54.284292+00:00",
      "modified": "2026-10-29T19:52:54.284301+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00019-00017/canvas/2",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/9119/iiif/manifest/"
          }
        },
        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=percent:1,1,98,98",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0648\u0645\u0627 \u0627\u0639\u0644\u0645 \u062a\u062d\u0642\u064a\u0642\u0647 \u0641\u0627\u0639\u0644\u0645\u0647\u0627 \u0628\u0647 \u0648\u0627\u062e\u0627\u0641</li>\n<li>\u0627\u0646 \u062a\u0628\u0637\u0648 \u062d\u0636\u0631\u062a\u0647 \u0648\u062a\u0639\u062f\u0645 \u0627\u0644\u062e\u0644\u064a\u063a \u0648\u062a\u0628\u0642\u0627 \u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0645\u0639\u0627\u0642\u0629 \u05d1\u05d0\u05dc\u05d0\u05e1\u05db\u05e0\u05d3\u05e8\u05d9\u05d4 \u0648\u0645\u0627 \u0639\u0646\u062f\u064a \u0627\u0646\u0647\u0627 \u062a\u0628\u0637\u0648 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0627\u0643\u062b\u0631 \u0645\u0646 \u0648\u062a\u0628\u0642\u0627</li>\n<li>\u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0645\u0639\u0627\u0642\u0629 \u0628\u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0648\u0645\u0627 \u0639\u0646\u062f\u0649</li>\n<li>\u0627\u0646\u0647\u0627 \u062a\u0628\u0637\u0648 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0627\u0643\u062b\u0631 \u0645\u0646 \u0630\u0644\u0643</li>\n<li>\u0648\u0627\u0645\u0627 \u0627\u0644\u064a\u062a\u064a\u0645 \u0641\u0644\u0627 \u062a\u0633\u0627\u0644 \u0645\u0627 \u0627\u0646\u0627 \u0641\u064a\u0647 \u0645\u0639\u0647</li>\n<li>\u0644\u0627\u0646 \u0648\u0635\u0644\u0647 \u0643\u062a\u0627\u0628 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0628\u064a \u0632\u0643\u0631\u064a</li>\n<li>\u064a\u0630\u0643\u0631 \u0644\u0647 \u0627\u0646 \u0645\u0627 \u0642\u0628\u0636 \u0627\u0644\u0627 \u062f\u0648\u0646 \u0627\u0644\u0633\u062a\u0629 \u0648\u062b\u0644\u062b\u064a\u0646</li>\n<li>\u062f\u064a\u0646\u0627 \u0648\u0647\u0648 \u064a\u0639\u0645\u0644 \u0628\u064a \u0645\u0627 \u0644\u0627 \u064a\u0639\u0645\u0644 \u0648\u0647\u0648 \u0645\u0639\u0630\u0648\u0631</li>\n<li>\u0644\u0627\u0646 \u0643\u0627\u0646 \u0628\u064a\u0646\u0646\u0627 \u0627\u064a\u0627\u0645 \u0642\u0644\u0627\u0626\u0644 \u05de\u05e6\u05ea \u0627\u0634\u0647\u0631</li>\n<li>\u0648\u0634\u064a\u0647 \u0645\u0627 \u062d\u0635\u0644 \u0648\u0627\u0646\u0627 \u0627\u0639\u0644\u0645 \u0627\u0646 \u0647\u0630\u0627 \u0645\u0646</li>\n<li>\u062c\u0645\u0644\u0629 \u0627\u0644\u0627\u0634\u064a\u0627 \u0627\u0644\u062a\u064a \u062a\u0648\u0644\u0645 \u0642\u0644\u0628\u0647\u0627 \u0644\u064a\u0643\u0646 \u0627\u0644</li>\n<li>\u0636\u0631\u0648\u0631\u0629 \u062a\u062d\u0648\u062c \u0627\u0644\u0649 \u0627\u0644\u0634\u0643\u0648\u064a \u0627\u0644\u0649 \u062d\u0636\u0631\u062a\u0647 \u0644\u0645\u0627</li>\n<li>\u0627\u0646\u0627 \u0641\u064a\u0647 \u0645\u0639\u0647 \u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0627\u062c\u0644\u0629 \u0645\u062e\u062f\u0648\u0645\u0629</li>\n<li>\u0628\u0627\u0641\u0636\u0644 \u0633\u0644\u0627\u0645 \u0648\u0627\u062e\u0631\u0645 \u062a\u062d\u064a\u0647 \u0648\u0627\u0644\u0645\u0627\u0645</li>\n<li>\u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0628\u0648 \u0639\u0644\u0649 \u0648\u0645\u0648\u0627\u0644\u064a\u064a \u0627\u0648\u0644\u0627\u062f\u0647</li>\n<li>\u0645\u062e\u062f\u0648\u0645\u064a\u0646 \u0639\u0646 \u0639\u0628\u062f\u0647\u0645 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0627\u062e\u0648\u0629 \u0639\u0628\u062f\u0647\u0627 \u064a\u062e\u062f\u0645\u0648\u0647\u0627 \u0628\u0627\u0641\u0636\u0644</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0628\u0627\u0633\u062d\u0642 \u0627\u0628\u0631\u0647\u064a\u0645</li>\n<li>\u05d1\u05df \u0634\u0628\u062a \u064a\u062e\u062f\u0645\u0647\u0627 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0646\u062c\u0645 \u062d\u0645\u0648\u0649 \u064a\u062e\u062f\u0645\u0647\u0627 \u0628\u0627\u0641\u0636\u0644</li>\n<li>\u0633\u0644\u0627\u0645 \u0648\u062e\u062f\u0645 \u062d\u0636\u0631\u062a\u0647 \u0644\u0627 \u064a\u062e\u0644\u064a\u0646\u064a \u0645\u0646\u0647\u0627</li>\n<li>\u0648\u062a\u0646\u0639\u0645 \u0628\u0628\u0633\u0637 \u0627\u0644\u0639\u0630\u0631 \u0639\u0644\u0645 \u0627\u0644\u0644\u0647</li>\n<li>\u0645\u0627 \u0643\u062b\u0628\u062a\u0647 \u0627\u0644\u0627 \u0648\u0627\u0644\u062e\u0631\u0642\u0629 \u0645\u0633\u0628\u0644\u0629</li>\n<li>\u0639\u0644\u0649 \u0639\u064a\u0646\u064a \u0648\u062d\u0633\u0628\u064a \u0627\u0644\u0644\u0647 \u0648\u0646\u0639\u0645</li>\n<li>\u0627\u0644\u0648\u062e\u064a\u0644 \u0639\u0627\u0634\u0631</li></ol>\n",
          "format": "text/html"
        }
