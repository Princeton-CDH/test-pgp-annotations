      "created": "2025-04-21T21:22:44.388459+00:00",
      "modified": "2025-04-21T21:22:44.388476+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-MOSSERI-IV-00037-00003/canvas/1",
          "type": "Canvas",
