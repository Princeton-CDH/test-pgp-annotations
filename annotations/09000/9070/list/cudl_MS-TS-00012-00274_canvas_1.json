      "body": [
        {
          "type": "TextualBody",
          "label": "recto, right margin",
          "value": "\n<ol><li>\u0645\u0646 \u0627\u0645\u0631 \u0627\u0644\u0639\u062f\u0648</li>\n<li>\u0648\u0633\u0645\u0639\u0646\u0627 \u0644\u0627\u0646 \u0627\u0644\u0628\u0646\u064a\u0627\u0646 \u0641\u064a</li>\n<li>\u062c\u0645\u064a\u0639 \u0628\u0631 \u0627\u0644\u0646\u0627\u0635\u0631 \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644</li>\n<li>\u0633\u0648\u0627\u062d\u0644 \u0648\u0627\u0644\u0628\u0644\u0627\u062f \u0627\u0644\u0630\u064a \u0639\u0644\u064a \u0627\u0644\u0628\u062d\u0631</li>\n<li>\u062c\u0645\u064a\u0639\u0647\u0627 \u0648\u062c\u0627\u0648 \u0627\u0644\u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u0645\u0631\u064a\u0629 \u0648\u0630\u0643\u0631\u0648</li>\n<li>\u0644\u0627\u0646 \u0627\u0644 \u0639\u0642\u0644\u0627 \u0641\u064a \u0627\u0644\u0645\u0631\u064a\u0629 \u0648\u0630\u0643\u0631\u0648 \u0627\u064a\u0636\u0627</li>\n<li>\u0644\u0627\u0646 \u0643\u0627\u0646\u062a \u0645\u0631\u0643\u0628\u064a\u0646 \u0645\u0639\u0627\u0648\u0644\u064a\u0646 \u0639\u0644\u0649</li>\n<li>\u0627\u0644\u0633\u0641\u0631 \u0644\u0645\u0627 \u0633\u0645\u0639 \u0644\u0647\u0630\u0647 \u0627\u0644\u0627\u062e\u0628\u0627\u0631</li>\n<li>\u062d\u0627\u0644\u062a \u0646\u064a\u062a\u0647\u0648\u0645 \u0639\u0646</li>\n<li>\u0644\u0627\u0646 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0633\u0641\u0631</li>\n<li>\u0647\u0627\u0630\u064a \u0627\u0644\u0627\u062e\u0628\u0627\u0631</li>\n<li>\u0647\u0627\u0630\u064a \u0627\u0644\u0644\u0647 \u064a\u062e\u064a\u0631 \u0627\u0646 \u064a\u062d\u0645\u0644</li>\n<li>\u0639\u0646 \u0627\u0646\u0633\u0627\u0646 \u0627\u0644\u0647\u0627\u0644\u0643 \u0648\u064a\u062e\u0627\u0637\u0631 \u0628\u0645\u0627\u0644\u0647</li>\n<li>\u0644\u0627\u0646 \u0627\u0644\u0627\u0635\u0648\u0644 \u062e\u064a\u0631</li>\n<li>\u0642\u0648\u0644\u0646\u0627 \u0644\u0627\u0646 \u05de</li>\n<li>\u05d5\u05e9\u05dc\u05d5\u05dd \u062e\u064a\u0631 \u0645\u0646</li>\n<li>\u0644\u0627\u0646 \u0645\u0627 \u062b\u0645</li>\n<li>\u0645\u0639\u0646\u0627 \u0645\u0646 \u0627\u0644</li>\n<li>\u0646 \u064a\u062e\u062d\u0637\u064a\u0637\u0647</li>\n<li>\u0641\u064a\u0647 \u0648\u064a \u0644\u0627\u0646 \u0627\u0644\u0630\u064a</li>\n<li>\u0645\u0639\u0646\u0627 \u062e\u064a\u0631 \u0645\u0646\u0647</li>\n<li>\u0648\u0644\u0639\u0644 \u0643\u0627\u0646 \u0641\u064a</li>\n<li>\u0628\u064a\u062f\u0647 \u0644</li>\n<li>\u0627\u0644\u0630\u064a \u0639\u0644\u0645</li>\n<li>\u0627\u0644\u0646\u0641\u0642\u0629</li>\n<li>\u0644\u0639\u0644 \u062a\u062a \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li></ol>\n",
