        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=pixel:47.53,950.6000366210938,3505.90359375,6768.429963378907",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0627\u0644\u0649 \u0627\u0644\u0645\u0631\u064a\u0629 \u0628\u0644 \u062c\u0627\u0648 \u0627\u0644\u0646\u0627\u0633 \u0645\u0646 \u062b\u0645 \u0648\u0644\u0645 \u064a\u0643\u0648\u0646 \u0639\u0646\u062f\u0647\u0645 \u0643\u0628\u0631 \u0645\u0646\u0647</li>\n<li>\u0648\u0646\u062d\u0646 \u064a\u0648\u0645 \u0627\u0646 \u0627\u0646\u0641\u062f\u0646\u0627 \u0627\u0644\u064a\u0643 \u0647\u0627\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0643\u062a\u0628\u0646\u0627 \u0643\u0648\u062a\u0628 \u0627\u0644\u0649 \u05d1\u05df \u05d1\u05e8\u05d5\u05da</li>\n<li>\u0628\u062c\u0645\u064a\u0639 \u0645\u0627 \u0627\u0645\u0631\u062a\u0646\u0627 \u0628\u0647 \u0645\u0646 \u0627\u062c\u0644 \u0633\u0644\u064a\u0645\u0627\u0646 \u0648\u063a\u064a\u0631\u0647 \u0648\u0642\u062f \u0643\u062a\u0628\u0646\u0627</li>\n<li>\u0646\u0633\u0643\u062a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0645\u0631\u064a\u0629 \u0644\u0627\u0646 \u062c\u0627\u0648 \u0627\u0644\u0646\u0627\u0633 \u0648\u0644\u0645 \u064a\u0630\u0643\u0631\u0648 \u0639\u0646\u0643 \u0634\u064a</li>\n<li>\u0648\u0644\u0645 \u0646\u0639\u0644\u0645 \u0644\u0643 \u062e\u0628\u0631 \u0627\u0646 \u0643\u0627\u0646 \u0627\u0646\u062a \u0645\u0642\u064a\u064a\u0645 \u0627\u0648 \u0645\u0644</li>\n<li>\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062d\u0633\u0646 \u062e\u0644\u0627\u0635\u0643 \u0648\u064a\u0643\u062a\u0648\u0628 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648</li>\n<li>\u0633\u064a\u062f\u0646\u0627 \u0645\u0639 \u0633\u0644\u064a\u0645\u0627\u0646 \u0644\u0639\u0644 \u062a\u0639\u0644\u0645 \u0627\u062e\u0628\u0627\u0631\u0647 \u0648\u062a\u0643\u0648\u0646 \u0635\u062d\u0628\u062a\u0647\u0627</li>\n<li>\u0645\u0639 \u0643\u062a\u0627\u0628\u0643 \u0644\u0627\u0646 \u0645\u0646 \u064a\u0648\u0645 \u0627\u0646 \u062e\u0631\u062c \u0639\u0646\u0627 \u0645\u0627 \u0639\u0631\u0641\u0646\u0627 \u0644\u0647 \u062e\u0628\u0631</li>\n<li>\u0627\u0644\u0627 \u0641\u064a \u0643\u062a\u0627\u0628 \u0645\u0648\u0644\u0626\u064a \u0648\u0627\u0645\u0627 \u0647\u0648 \u0645\u0646 \u0631\u0627\u064a\u0646\u0627 \u0644\u0647 \u062e\u0628\u0631 \u0648\u0627\u0633\u0639\u0627\u0631</li>\n<li>\u0628\u0644\u062f\u0646\u0627 \u0627\u0644\u064a\u0648\u0645 \u0644\u0643 \u0644\u0648 \u0641\u0644\u0641\u0644 \u0644\u0648 \u0637\u0631\u0637\u0631 \u064a \u0648\u0647\u0648 \u062e\u0627\u0633\u062f \u0643\u062b\u064a\u0631</li>\n<li>\u0646\u0634\u0627\u062f\u0631 \u0631\u0637\u0644 \u0648\u0646\u0635\u0641 \u0642\u0648\u0631\u0646\u0641\u0644 \u0643\u0645\u0627 \u062a\u0631\u0643 \u0645\u0648\u0644\u0627\u0646\u0627 \u0627\u0644</li>\n<li>\u0627\u0646\u062f\u0627\u0632 \u0639\u0644\u0649 \u062d\u0627\u0644\u0647\u0627 \u0648\u0642\u062f \u0648\u0642\u0641\u0646\u0627 \u0627\u0644\u0649 \u0627\u0628\u0646 \u062d\u0627\u0631\u062a</li>\n<li>\u0627\u0644\u0630\u064a \u0630\u0643\u0631\u062a \u0644\u0646\u0627 \u0645\u0646 \u0627\u0644\u062e\u0645\u0633\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0642\u0627\u0644 \u0644\u0646\u0627 \u0644\u0627\u0646 \u0643\u0627\u0646 \u0644\u064a \u0641\u064a</li>\n<li>\u0641\u0627\u0633 \u062b\u0648\u0644\u062a \u0642\u0646\u0637\u0627\u0631 \u0632\u0631\u064a\u0639\u0629 \u062d\u0646\u0629 \u0648\u0642\u062a \u0627\u0646 \u0645\u0636\u0627 \u05de\u05e0\u05e9\u05d4 \u0627\u0644\u0645\u0639\u0644\u0645</li>\n<li>\u0627\u0645\u0631\u062a\u0647 \u0627\u0646 \u064a\u0628\u064a\u0639\u0647\u0627 \u0648\u064a\u0642\u0628\u0636\u0643 \u0645\u0646\u0647 \u0627\u0644\u0630\u064a \u0644\u0643 \u0648\u0645\u0627 \u0646\u0639\u0631\u0641</li>\n<li>\u0627\u0646 \u0643\u0627\u0646 \u0627\u0644\u0627\u0645\u0631 \u0635\u062d\u064a\u062d \u0627\u0648 \u0644\u0627 \u0648\u0646\u062d\u0628 \u0645\u0646 \u0641\u0636\u0644\u0643 \u0627\u0646 \u062a\u0643\u0627\u062a\u0628\u0646\u0627</li></ol>\n",
          "format": "text/html"
        }
      ],
