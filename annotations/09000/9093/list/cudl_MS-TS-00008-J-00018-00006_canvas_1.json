        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "recto",
          "value": "\n<ol><li>\u0645\u0646 \u0639\u0628\u062f\u0647 \u0627\u0644 \u0642\u0627\u0626\u0644 \u0628\u0641\u0635\u0644\u0647 \u0627\u0633\u062d\u0642 \u0628\u0646 \u0634\u0628\u062a</li>\n<li>\u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u0644\u0645\u0646\u0639\u0645 \u0627\u0644\u0645\u0648\u0641\u0635\u0644 \u0627\u0644\u0645\u0648\u062c\u0645\u064a\u0644</li>\n<li>\u0627\u0644\u0645\u062d\u0633\u0646 \u0627\u0644\u0630\u064a \u0644\u0627 \u0627\u0646\u0633 \u0644\u064a \u062f\u0648\u0646\u0647 \u0648\u0644\u0627 \u0648\u062d\u0634\u0647 \u0645\u0639\u0647</li>\n<li>\u0648\u0645\u0646 \u0627\u0637\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0642\u0631\u0628 \u064a\u0648\u0645 \u0644\u0642\u0627\u0647 \u0643\u062a\u0627\u0628\u064a</li>\n<li>\u0627\u0644\u064a\u0643 \u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0628\u0639\u062f \u0627\u0646 \u0648\u0631\u062f\u0646\u064a \u0643\u062a\u0627\u0628\u0643 \u0627\u0644\u0643\u0631\u064a\u0645</li>\n<li>\u0627\u0644 \u0639\u0632\u064a\u0632 \u0627\u0644\u0630\u064a \u062a\u0641\u0635\u0644\u062a \u0648\u0627\u0628\u0647\u062c\u062a \u0648\u0627\u0646\u0633\u062a \u0627\u0645\u0627</li>\n<li>\u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0645\u0627 \u0646\u062d\u0646 \u0641\u064a\u0647 \u0645\u0646 \u0627\u0644\u0648\u062d\u0634\u0629 \u0648\u0627\u0644\u062a\u0634\u0627\u0648\u0648\u0642</li>\n<li>\u0627\u0644\u0649 \u062d\u0636\u0631\u062a \u0645\u0648\u0644\u0626\u064a \u0641\u0644\u064a\u0633 \u0627\u0642\u062f\u0631 \u0639\u0644\u0649 \u0648\u0635\u0641\u0647\u0627 \u0641\u0627\u0633\u0644</li>\n<li>\u0645\u0646 \u0627\u0644\u0630\u064a \u0648\u062d\u0634\u0646\u064a \u0639\u0646\u0643 \u0627\u0646 \u064a\u0642\u0631\u0628 \u0627\u0644\u0628\u0627\u0646\u0633 \u0628\u0643 \u0628\u0645\u0646\u0647</li>\n<li>\u0648\u0641\u0636\u0644\u0647 \u0648\u0631\u063a\u0628\u062a\u064a \u0627\u0644\u064a\u0643 \u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0627\u0646 \u062a\u0645\u0648\u0646 \u0639\u0644\u0649 \u0639\u0628\u062f\u0643</li>\n<li>\u0628\u062d\u0631\u0641\u064a\u0646 \u0643\u0631\u064a\u0645\u064a\u0646 \u0646\u062a\u0627\u0646\u0633 \u0628\u0647\u0627 \u0628\u0639\u0636 \u0627\u0644 \u0627\u0646\u0633 \u0648\u0643\u064a\u0641</li>\n<li>\u064a\u062a\u0627\u0646\u0633 \u0645\u0646 \u0641\u0627\u0631\u0642 \u0645\u062b\u0644 \u0645\u0648\u0644\u0627\u064a \u0642\u062f \u0641\u0627\u0631\u0642 \u0627\u0644\u062d\u064a\u0627\u0629</li>\n<li>\u0648\u0627\u0644 \u0646\u0648\u0631 \u0648\u0627\u0644 \u0639\u0642\u0644 \u0648\u0627\u0644 \u0639\u064a\u0634 \u0648\u0627\u0644 \u0627\u0646\u0633</li></ol>\n",
          "format": "text/html"
        }
