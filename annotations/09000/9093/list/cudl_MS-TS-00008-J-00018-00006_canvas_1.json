      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-J-00018-00006/canvas/1",
          "type": "Canvas",
