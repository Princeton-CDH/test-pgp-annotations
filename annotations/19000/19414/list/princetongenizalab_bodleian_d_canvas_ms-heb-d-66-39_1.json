      "body": [
        {
          "type": "TextualBody",
          "label": "Recto - right margin",
          "value": "\n<ol><li>\u0648\u0644\u0627 \u062a\u0639\u0631\u0641\u0647\u0627</li>\n<li>\u0628\u0634\u064a \u0645\u0646 \u0630\u0627 \u0648\u0627\u0645\u0627</li>\n<li>\u0627\u0646\u0627 \u062e\u0641\u062a \u0644\u0627\u0644\u0627</li>\n<li>\u062a\u062d\u062a\u0627\u062c \u0644\u0644\u0646\u0627\u0633</li>\n<li>\u0648\u0627\u062a\u0641\u0635\u0644 \u062a\u062d\u0638</li>\n<li>\u0627\u0644\u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u0639\u0646\u062f</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0639\u0644\u0649</li>\n<li>\u0627\u0648 \u0639\u0646\u062f \u0627\u0628\u0646</li>\n<li>\u0639\u0645\u062a\u0649 \u0648\u062a\u0631\u0633\u0644</li>\n<li>\u0644\u064a \u0627\u0644\u0641\u0627\u0635\u0644 \u0645\u0646</li>\n<li>\u062a\u0645\u0646\u0647\u0645 \u0648\u062a\u0631\u0633\u0644</li>\n<li>\u0627\u064a\u0636\u0627 \u0627\u0644\u0639\u0645\u0627\u0645\u0629</li>\n<li>\u0627\u0644\u0642\u0637\u0639\u0629</li>\n<li>\u0635\u062d\u0628\u0629 \u0627\u0644</li>\n<li>\u062e\u0644\u0641 \u0628\u0646</li>\n<li>\u0644\u0627\u0646 \u0642\u062f \u062d\u0635\u0644</li>\n<li>\u0645\u0646 \u064a\u0634\u062a\u0631\u064a\u0647\u0627</li>\n<li>\u0645\u0646\u064a \u0628\u0631\u0633\u0645\u0627\u0644</li>\n<li>\u0641\u0644\u0627 \u062a\u0639\u064a\u0642\u0647\u0627</li>\n<li>\u0639\u0646\u0649 \u0633\u0627\u0639\u0629</li>\n<li>\u0648\u0627\u062d\u062f\u0629 \u0648\u0644\u0627</li>\n<li>\u0627\u0644\u0641\u0627\u0635\u0644 \u0645\u0646</li>\n<li>\u062a\u0645\u0646</li></ol>\n",
