      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0644\u0628\u0639\u0636\u0647\u0645 \u0633\u0627\u0644\u062a \u0627\u0644\u0646\u062f\u0627 \u0647\u0644 \u0627\u0646\u062a\u0647\u0631 \u0641\u0642\u0627\u0644 \u0644\u0627 \u0648\u0644\u0643\u0646\u0646\u064a \u0639\u0628\u062f \u0644\u064a\u062d\u064a\u0627 \u0628\u0646 \u062e\u0627\u0644\u0630 \u0648\u0644\u064a\u0633 \u0628\u062a\u0645\u0646 \u0627\u0634\u062a\u0631\u0627\u0646\u064a \u0648\u0627\u0646\u0645\u0627 \u062a\u0648\u0627\u0631\u062a\u0646\u064a \u0639\u0646 \u0648\u0627\u0644\u0630 \u0628\u0639\u062f \u0648\u0627\u0644\u0630 \u0648\u0647\u0630\u0647 \u0628\u0639\u0636 \u0627\u0648\u0636\u0627\u0641 \u0627\u0644\u0633\u0626\u064a\u062f \u0627\u0644 \u0627\u062c\u0644 \u0627\u0644\u0645\u0648\u0644\u0627 \u0627\u0644\u0627\u0645\u062c\u062f \u062b\u0628\u062a \u0627\u0644\u0644\u0647 \u0645\u062c\u062f\u0629 \u0648\u0636\u0627\u0639\u0641 \u0633\u0639\u062f\u0647 \u0648\u062e\u0641\u0627\u0647 \u0643\u0644 \u0645\u062d\u062f\u0648\u0631 \u0648\u0642\u062f \u062a\u062d\u0645\u0644 \u0627\u0644\u062e\u0627\u062f\u0645 \u0645\u0646 \u062c\u0645\u0627\u0626\u0644 \u0627\u0644\u0645\u0648\u0644\u0627 \u0648\u062a\u0641\u0636\u0644\u0647 \u0648\u0627\u062d\u0633\u0627\u0646\u0647 \u0645\u0627 \u0644\u0648 \u0631\u0627\u0645 \u0634\u0631\u062d \u064a\u0633\u064a\u0631\u0647\u0627 \u0644\u0643\u0644 \u0639\u0646 \u062a\u0633\u0637\u064a\u0631\u0647\u0627 \u0648\u0643\u0627\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u062d\u0643\u064a\u0645 \u0627\u0644\u0645\u0630\u0647\u0628 \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u062a\u0648\u0641\u064a\u0642\u0647 \u0648\u062e\u0641\u0627\u0647 \u0645\u0627 \u064a\u062d\u0627\u062f\u0631\u0647 \u0642\u062f \u0627\u062c\u062a\u0645\u0639 \u0628\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u064a\u0648\u0645 \u0627\u0644\u0627\u062d\u062f \u0641\u064a \u0627\u0644 \u0645\u0637\u0628\u0643 \u0628\u062d\u0635\u0648\u0631 \u0627\u0644\u0645\u0648\u0644\u0627 \