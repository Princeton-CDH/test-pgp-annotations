      "type": "Annotation",
      "created": "2022-10-07T01:19:36.227886+00:00",
      "modified": "2026-01-26T18:06:20.203726+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/4/",
      "target": {
        "source": {
