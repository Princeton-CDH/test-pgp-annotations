      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u064a\u0647</li>\n<li>\u0641\u0627\u0646 \u0635 \u0645\u0646\u064a</li>\n<li>\u062f\u0645\u0648\u0639 \u0641\u064a \u0643\u0630\u0647 \u062d\u0627\u0631\u0629</li>\n<li>\u0644\u0647 \u0627\u0646 \u0639\u0646\u062f\u064a \u0645\u0646 \u0627\u0644</li>\n<li>\u0627\u062d\u0633\u0646 \u0627\u0635\u0641\u0629</li>\n<li>\u0627\u0644\u0644\u0647 \u064a\u062c\u0639\u0644\u0643 \u0641\u064a \u062d\u064a\u0632 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u064a\u062c\u0645\u0639 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643</li>\n<li>\u0639\u0644\u0649 \u0627\u0633\u0631 \u062d\u0627\u0644 \u0648\u064a\u0639\u0635\u062f\u0646\u064a \u0639\u0644\u0649 \u0627\u0630\u0627 \u0628\u0639\u0636 \u0645\u062e\u0627\u0641\u0627\u062a\u0643</li>\n<li>\u0644\u0627 \u064a\u0639\u062f\u0645\u0646\u064a \u0628\u0642\u0627\u0643 \u0648\u062a\u0641\u0636\u0644\u0643 \u0648\u062a\u062a\u0641\u0635\u0644 \u062a\u062e\u0635 \u0645\u0648\u0644\u0626\u064a</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0627\u0644\u0634\u0648\u0641\u0638 \u0646\u0639 \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0629</li>\n<li>\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u062c\u0644\u0647 \u0648\u062a\u0639\u0631\u0641\u0647 \u0634\u0648\u0642\u0649 \u0627\u0644\u064a\u0647</li>\n<li>\u0648\u0648\u062d\u0634\u062a\u064a \u0645\u0646\u0647 \u0648\u0643\u0630\u0644\u0643 \u0627\u0628\u0648 \u0633\u0644\u064a\u0645\u0627\u0646 \u062f\u0627\u0648\u062f \u062a\u062e\u0635\u0647</li>\n<li>\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u062a\u0639\u0631\u0641\u0647\u0645 \u0627\u0646\u064a \u0627\u0633\u062a\u0642\u0636\u064a\u062a \u0639\u0646</li>\n<li>\u0627\u0644\u0628\u0644\u0633\u0642\u064a\u0627\u062a \u0648\u0645\u0627 \u0648\u062c\u062f\u062a \u0645\u0646\u0647\u0645 \u0634\u064a \u0648\u0627\u0646\u0627 \u0645\u0627 \u0627\u062b\u0648\u0627\u0646\u0627</li>\n<li>\u0627\u0633\u062a\u0642\u0636\u064a \u0639\u0646\u0647\u0645 \u0648\u0627\u0634\u062a\u0631\u064a\u0647\u0645 \u0648\u0627\u0646\u0641\u062f\u0647\u0645 \u0644\u0647\u0645</li></ol>\n",
