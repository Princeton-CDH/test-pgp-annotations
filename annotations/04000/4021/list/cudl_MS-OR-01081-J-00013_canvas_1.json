    {
      "etag": "\"55548b7e69e930d65e7ea2fbe663f8c6\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/cc05d50e-045a-463d-bfd9-70fb1df85de0/",
      "type": "Annotation",
      "created": "2026-08-04T19:11:35.870384+00:00",
      "modified": "2026-08-04T19:11:35.870390+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1259/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-OR-01081-J-00013/canvas/1",
          "type": "Canvas",
