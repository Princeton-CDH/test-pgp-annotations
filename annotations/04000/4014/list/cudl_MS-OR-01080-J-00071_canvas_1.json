      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05e2\u05dc \u0634\u0645\u0643 \u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0643 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0643 \u0648\u062a\u0627\u0626\u064a\u062f\u0643 \u0648\u0639\u0646 \u0634\u0648\u0642 \u0627\u0644\u064a\u0643 \u062c\u0645\u0639 \u0627\u0644\u0644\u0647 \u0628\u064a\u0646\u0646\u0627 \u0639\u0644\u0649 \u0627\u0634\u0631 \u062d\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648\u062e\u0631\u0645\u0647 \u0627\u0646\u0647 \u0648\u0644\u0649 \u0630\u0644\u0643 \u0648\u0627\u0644\u0642\u0627\u062f\u0631 \u0639\u0644\u064a\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u0644\u0627 \u062a\u0633\u0627\u0644 \u0645\u0627 \u0648\u0635\u0644 \u0627\u0644\u0649 \u0642\u0644\u0628\u064a \u0645\u0646 \u062e\u0628\u0631 \u0648\u062c\u0639\u0643 \u0627\u0644\u0644\u0647 \u0648\u0644\u0648\u0644\u0627 \u0645\u0627 \u062a\u0639\u0644\u0645\u0647 \u0644\u0643\u0646\u062a \u0635\u062d\u0628\u062a \u0628\u064a\u062a \u062f\u0648\u0633\u0627 \u0648\u0642\u062f \u0630\u0643\u0631\u062a \u0627\u0646\u0647\u0645 \u062e\u0627\u0631\u062c\u064a\u0646 \u0648\u0644\u0627 \u0627\u062f\u0631\u0643\u0648\u062a\u0645 \u0627\u0633\u0644\u0627 \u0648\u0630\u0643\u0631\u062a \u0639\u0646 \u0627\u0644\u0634\u0631\u0649 \u0627\u0644\u0630\u064a \u062c\u0631\u0627 \u0639\u0644\u064a\u0643 \u0641\u0628\u0642\u064a\u062a \u0645\u062a\u062d\u064a\u064a\u0631\u0629 \u0648\u0644\u0627 \u064a\u062a\u0645 \u0644\u064a \u0627\u0646 \u0627\u0643\u0648\u0646 \u0641\u064a \u0628\u0644\u062f \u0648\u0627\u0646\u062a \u0641\u064a \u0627\u062e\u0631 \u0648\u0644\u0627 \u062a\u0633\u0627\u0644 \u0645\u0627 \u0627\u0642\u0633\u0649 \u0645\u0646 \u0627\u0644\u0630\u064a \u062a\u0639\u0631\u0641 \u0648\u0628\u0642\u064a\u0629 \u0633\u0644 \u0644\u064a \u0643\u0644 \u0627\u062f\u064a\u0629 \u0648\u0642\u0639\u062f \u0633\u064a\u062f\u064a \u0641\u064a \u0627\u0644\u062f\u0643\u0627\u0646 \u0648\u0642\u0627\u0644\u0647 \u0627\u0644\u0630\u064a \u062a\u0639\u0631\u0641 \u0648\u064a\u0637\u0644\u0628 \u0645\u0646\u0647 \u0645\u0627 \u0644\u0627 \u064a\u0642\u062f\u0631 \u0639\u0644\u064a\u0647 \u0648\u0647\u0648 \u0639\u0646\u062f\u064a \u0648\u0646\u0642\u0628 \u0639\u0644\u064a\u0646\u0627 \u0627\u0644\u0645\u0634\u0631\u0642\u0629 \u0648\u0627\u062e\u0630 \u0645\u0646\u064a \u0648\u064a\u0628\u062a\u064a\u0646 \u0627\u0644\u0642\u0645\u062d \u0645\u0646 \u0627\u0644\u0630\u064a \u0627\u0634\u062a\u0631\u064a\u062a \u0644\u0646\u0627 \u0644\u0627\u0646 \u0627\u0644\u0646\u0627\u0633 \u0627\u062d\u062a\u0631\u0642\u0648 \u0644 \u0648\u0628\u0644\u063a \u0627\u0644\u062a\u0644\u064a\u064a\u0633 \u0644 \u0648\u0627\u0644\u062f\u0648\u0631 \u064a\u0646\u062a\u0642\u0628 \u0639\u0644\u0649 \u0627\u0644\u0646\u0627\u0633 \u0648\u0627\u0646\u0627 \u0635\u064a\u0642\u0629 \u0627\u0644\u0635\u062f\u0631 \u0643\u0627\u0626\u0641\u0629 \u0648\u0642\u062f \u062a\u0628\u064a\u064a\u0646 \u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u062c\u0627\u0644\u0633 \u062e\u064a\u0627\u0646\u0647 \u0648\u0646\u062f\u0645\u062a \u0644\u064a\u0634 \u062a\u0631\u0643\u062a\u0647 \u0639\u0646\u062f\u064a \u0648\u0627\u0646\u0627 \u0648 \u0641\u064a \u0639\u0627\u0646\u0647 \u0644\u0627 \u064a\u0647\u0631\u0628 \u0648\u062c\u0648\u0627\u0631\u064a \u0643\u062b\u064a\u0631 \u0642\u062f \u0647\u0631\u0628\u0648 \u0645\u0639 \u0627\u0644\u0639\u0631\u0628 \u0641 \u0641\u0627\u0628\u0635\u0631 \u0627\u064a\u0634 \u062a\u0639\u0645\u0644 \u0627\u0639\u0632\u0645 \u0639\u0644\u064a\u0647 \u062a\u0643\u062a\u0628 \u0644\u064a \u0628\u0647 \u0648\u062e\u0631\u062c\u062a \u0627\u0645\u0631\u0627\u062a \u0643\u0627\u0644\u0649 \u0648\u0628\u0646\u062a\u0647\u0627 \u0648\u064a\u0647\u0648\u062f \u0643\u062b\u064a\u0631 \u0648\u0642\u0637\u0639 \u0639\u0644\u064a\u0647\u0645 \u0648\u0646\u062d\u0646 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u0644\u0643 \u0627\u0646 \u062e\u0631\u062c\u0646\u0627 \u0648\u0627\u0646 \u0642\u0639\u062f\u0646\u0627 \u0627\u0644\u0649 \u0634\u064a \u064a\u0631\u062d\u0645 \u0627\u0644\u0644\u0647 \u0648\u0630\u0643\u0631\u062a \u0627\u0646\u0643 \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u0633\u0643\u0631 \u0648\u0627\u0644\u0648\u0631\u062f \u0627\u0644\u0645\u0631\u0628\u0627 \u0641\u0644\u0627 \u0639\u062f\u0645\u062a \u0628\u0642\u0627\u0643 \u0648\u0645\u0627 \u0648\u0635\u0644 \u0644\u064a \u0634\u064a \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0645 \u0648\u0648\u0627\u0644\u0630\u064a \u064a\u062e\u0635\u0643 \u0628\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0648\u0644\u0639 \u062a\u0642\u0628\u0644 \u0627\u064a\u062f\u0643 \u0648\u0633\u0627\u0644\u0645\u0629 \u0648\u0633\u062a \u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u0648\u0631 \u064a\u0642\u0631\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0627 \u0627\u0633\u062a\u0637\u0631 \u0641\u064a \u062e\u0631\u0648\u062c\u0643 \u0645\u062b\u0644 \u0648\u0627\u0644\u0630\u064a \u0644\u0627\u0646 \u0645\u0627 \u0628\u0642\u0649 \u0644\u0647 \u062d\u0646\u064a\u0646 \u0648\u0644\u0627 \u0645\u0646 \u064a\u062c\u064a\u062a\u0647 \u0627\u0644\u0627 \u0627\u0644\u0647 \u0648\u0647\u0648\u0627 \u0643\u062b\u064a\u0631 \u0627\u0644\u062f\u0639\u0627 \u0644\u0643 \u0627\u0644\u0644\u0647 \u064a\u0633\u062a\u063a\u064a\u0628 \u0645\u0646\u0647 \u0628\u0631\u062d\u0645\u062a\u0647 \u0648\u064a\u062c\u0645\u0639 \u0628\u064a\u0646\u0646\u0627 \u0648\u0628\u064a\u0646\u0643 \u0648\u064a\u0639\u064a\u062f\u0643 \u0648\u0627\u0646\u0641\u0630 \u0635\u0627\u062d\u0628 \u0627\u0644\u0640\u05de\u05d8\u05e8\u05da \u0627\u0644\u0630\u064a\u0628\u0627\u063a \u064a\u0637\u0644\u0628\u0647 \u0648\u0648\u0643\u0644 \u0639\u0644\u0649 \u0648\u0627\u0644\u0630\u064a \u0648\u0627\u062f\u0639\u0627 \u0627\u0646 \u062a\u0645\u0646\u0647 \u05dc \u062f\u064a\u0646\u0627\u0631 \u062d\u062a\u0649 \u0627\u062e\u0630\u0647 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0628\u0648 \u0632\u0643\u0631\u064a \u0648\u0633\u0644\u0645\u0647 \u0644\u0627\u0628\u0646 \u0627\u0644\u0635\u0647\u064a\u0631 \u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u0642\u062f\u0631 \u064a\u0627\u062e\u0630 \u0645\u0639\u0647 \u062e\u0645\u0633\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0644\u0648\u0644\u0627 \u0627\u0644\u0631\u0626\u064a\u0633 \u0645\u0627\u0646 \u0642\u062f \u0627\u062e\u0630\u0647 \u0628\u0644\u0627 \u0634\u064a \u0648\u0642\u062f \u062a\u0633\u0644\u0645\u0647\u0627 \u0627\u0644\u062d\u0628\u0631 \u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644 \u0648\u0647\u0648\u0627 \u0645\u0637\u0627\u0644\u0628 \u0644\u0648\u0627\u0644\u0630\u064a \u0628\u0642\u064a\u0645\u062a\u0647 \u0641\u0627\u0633\u0644 \u0645\u0648\u0644\u0626\u064a \u0627\u0646 \u064a\u0643\u062a\u0628 \u064a\u0639\u0644\u0645\u0647 \u0627\u0646 \u0627\u0644\u0630\u064a \u0644\u0647 \u0639\u0644\u064a\u0647 \u062e\u0645\u0633\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0641\u0645\u0627 \u0627\u0644\u0633\u0642\u0627\u0644\u0628\u0647 \u064a\u0637\u0644\u0628\u0648 \u0637\u0644\u0628\u0647 \u0648\u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u062e\u0631\u062c \u062f\u0648\u0633\u0627 \u0648\u062c\u0645\u064a\u0639 \u0627\u0647\u0644\u0647 \u0645\u0639\u0647 \u0648\u0627\u0646 \u0627\u0644\u0648\u0632\u064a\u0631 \u0627\u0644\u064a\u0648\u0645 \u0627\u0628\u0646 \u0627\u0628\u0649 \u0639\u0644\u0649 \u05d1\u05df \u05d0\u05d8\u05e8\u05e9 \u0648\u0642\u062f \u0627\u0646\u0641\u0627 \u062c\u0645\u064a\u0639 \u0627\u0644\u0648\u0632\u0631\u0627 \u0644\u0645 \u064a\u0628\u0642 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0645\u0646\u0647\u0645 \u0627\u062d\u062f \u0648\u0646\u062d\u0646 \u062a\u062d\u062a \u0641\u062d\u062f \u0648\u0631\u0639\u0628 \u0627\u0644\u0640\u05ea\u05dc\u05d9\u05e1 \u0643\u0629 \u0648\u0627\u0644\u062e\u0628\u0632 \u0628\u0627\u0631\u0628\u0639\u0629 \u0648\u0646\u0635\u0641 \u0627\u0644\u0631\u0637\u0644 \u