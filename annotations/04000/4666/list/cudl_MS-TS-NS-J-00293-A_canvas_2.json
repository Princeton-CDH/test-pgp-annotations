      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05d1\u05dd \u05d2 \u0627\u0628\u0646 \u0632\u062c\u0644\u064a \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0627\u0645\u0631\u0627\u062a \u05d0\u05d1\u05e8\u05d4\u05dd \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0642\u0634\u0627\u0634\u064a \u0627\u0645\u0631\u0627\u062a \u0627\u0644\u062c\u0631 \u0630 \u062c\u0648\u0643\u0627\u0646\u064a \u0627\u0644\u062d\u0641\u0627\u0631 \u0627\u0645\u0631\u0627\u062a \u0627\u0644\u062a \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0627\u0628\u0646 \u0633\u0647\u0644\u0627\u0646 \u0645\u0633\u062a\u062c\u062f \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u064a\u062d\u064a\u064a \u0627\u0644\u0627\u0637\u0631\u0648\u0634 \u0627\u0644\u0630\u064a \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0643\u0627\u0646 \u064a\u062e\u062f\u0645 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u062f \u062d\u0645\u0627\u0644 \u0646\u0642\u064a\u0627 \u05dd \u062c\u0648\u0643\u0627\u0646\u0647 \u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645 \u062c\u0631\u064a\u062f\u0629 \u0627\u0644\u0643\u0633\u0648\u0629 \u0644\u0644\u0639\u0646\u064a\u064a\u0645 \u0633\u0646\u0629 \u0627\u062b\u0646\u0627 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u05d1\u05dd \u0627\u0628\u0648 \u0639\u0644\u064a \u0627\u0628\u0646 \u05d1\u05e8\u05d5\u05da \u0645 \u0645\u0642\u062f\u0631 \u0627\u0644\u0641\u0631\u0646\u0627\u0633 \u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u0648\u0631 \u0627\u0644\u0640\u05e9\u05d5\u05de\u05e8 \u0645 \u0634\u0642\u0629 \u0627\u0628\u0646 \u0637\u064a\u0628\u0648\u0633 \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u0627\u0645\u0631\u0627\u062a \u0627\u0644\u062d\u0644\u0628\u064a \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u0631\u062a\u0639\u0634 \u0647\u0644\u0627\u0644 \u0632\u0648\u062c \u0628\u0646\u062a \u0633\u062f\u0627\u0631\u0629 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u0647\u0627\u0644 \u062c\u0648\u0643\u0627\u0646 \u0628\u0645 \u0646\u0647\u064a\u0631 \u0627\u0628\u0646 \u0627\u0644\u0646\u0627\u0642\u062f \u05dd \u062c\u0648\u0643\u0627\u0646 \u0648\u062d\u0645\u0627\u062a\u0647 \u062d\u0645\u0627\u062a \u0646\u0647\u064a\u0631 \u0630 \u062c\u0648\u0643\u0627\u0646 \u0627\u0628\u0646 \u0627\u0644\u0646\u0627\u0642\u062f \u0627\u0628\u0648 \u0639\u0644\u064a \u0627\u0644\u062d\u0644\u0628\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0645 \u062e\u0644\u0641 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u0630 \u062c\u0648\u0643\u0627\u0646 \u062a\u062e\u062f\u0645 \u062c\u0648\u0643\u0627\u0646 \u0627\u0645 \u062e\u0644\u0641 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u0645 \u062c\u0648\u0643\u0627\u0646 \u062a\u062e\u062f\u0645 \u0627\u0644\u0631\u0628 \u0639\u0644\u064a \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0627\u0644\u0628\u0633\u062a\u0627\u0646\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u05d0\u05d1\u05e8\u05d4\u05dd \u0627\u0644\u062c\u0631 \u0630 \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u05d9\u05d5\u05e1\u05e3 \u0632\u0639\u0641\u0631\u0627\u0646 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0631\u0648\u0645\u064a \u0628\u0646\u062a \u0627\u0644\u0632\u0627\u0645\u064a\u0629 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0628\u0645 \u0627\u0645\u0631\u0627\u062a \u0628\u0634\u0631 \u0627\u0644\u0628\u0642\u0627\u0644 \u0630 \u062c\u0648\u0643\u0646\u064a\u0629 \u0643\u0643 \u0639\u0644\u064a \u0627\u0644\u0641\u0631\u0646\u0627\u0633 \u05d0\u05d1\u05e8\u05d4\u05dd \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u0646\u0635\u064a\u0631 \u0627\u0628\u0646 \u062d\u0641\u0627\u0636 \u05dd \u062c\u0648\u0643 \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0633\u0643\u0631\u064a \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u064a\u0647\u0648\u062f\u064a \u0627\u0644\u0631\u0642\u0627\u0636 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u0627\u0645\u0631\u0627\u062a \u0648\u0641\u0627 \u0627\u0628\u0646 \u0630 \u0627\u0644\u0646\u0627\u0642\u062f \u05d5\u05d0 \u064a\u0647\u0648\u062f\u064a \u062c\u0644\u0627\u0645 \u0639\u0644\u0648\u0646 \u05dd \u062c\u0648\u0643 \u0627\u0643\u0648 \u0646\u0642\u064a\u0627 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0645\u0631\u0627\u062a \u05d7\u05e1\u05d5\u05df \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0648\u0631\u0627\u0642 \u05d9 \u0630 \u062c\u0648\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u062d\u0633\u0646 \u0627\u0644\u0631\u062d\u0628\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0631\u0628\u064a \u0644\u0628\u062f \u05d9\u05d5\u05e1\u05e3 \u062e\u0627\u062f\u0645 \u062f\u0645\u0648\u0629 \u05dd \u062c\u0648\u0643\u0627\u0646 \u0639\u0644\u064a \u064a\u062f \u0627\u0646 \u0627\u0628\u0646 \u0627\u0644\u0641\u0627\u0639\u0648\u0633 \u0627\u0628\u0646 \u0627\u0644\u0628\u062c\u062f\u0627\u0630\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0639\u0644\u064a \u064a\u062f \u0627\u0628\u0646 \u0627\u0644\u0641\u0627\u0639\u0648\u0633 \u062e\u0644\u0641 \u0627\u0628\u0646 \u0646\u0627\u0635\u0631\u0629 \u05dd \u062c\u0648\u0643\u0627\u0646 \u05d9\u05d5\u05e1\u05e3 \u05e9\u05d5\u05de\u05e8 \u0627\u0644\u0645\u0633\u0644\u0643 \u05dd \u062c\u0648\u0643\u0627\u0646 \u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u062d\u0644\u0629 \u0633\u0646\u064a\u0648\u0646 \u0627\u0644\u0631\u0648\u0645\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0645\u0639\u0627\u0644\u064a \u062e\u0627\u062f\u0645 \u0645 \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0645\u062d\u0644\u0629 \u0648\u0627\u0628\u0646\u0647 \u0648\u0627\u0645\u0631\u0627\u062a\u0647 \u05de \u0627\u0644\u062d\u0645\u0627\u0648\u064a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627\u0644\u0640\u05de\u05e4\u05dc\u05d5\u05d2 \u0627\u0645\u0631\u0627\u062a \u0628\u0631\u062c\u0648\u062a \u05dd \u062c\u0648\u0643\u0627\u0646 \u0627