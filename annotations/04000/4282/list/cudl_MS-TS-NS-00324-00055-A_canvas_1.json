        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0645\u0627 \u062e\u0641\u0649 \u0639\u0646 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0627\u0644\u0643\u0631\u064a\u0645\u0629 \u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d9\u05d4\u05d9\u05d5 \u05dc\u05e9\u05de\u05d9\u05dd \u0645\u0627 \u0637\u0631\u0649 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062c\u0645\u0639\u0629 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0632\u062f \u0627\u0644\u0640\u05e8\u05e9\u05e2 \u0627\u0644\u0647\u062f\u0648\u0631 \u0627\u0644\u064a\u0647\u064a\u0631 \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u05d1\u05df \u05e7\u05d9\u05d9\u05d5\u05de\u05d0 \u05d4\u05e7\u05d1\u05d4 \u05d9\u05e7\u05d9\u05d9\u05dd \u05d1\u05d5 \u0645\u0627 \u0642\u0627\u0644\u0647 \u0627\u0644\u0640\u05de\u05e9\u05d5\u05e8\u05e8 \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u05ea\u05d1\u05d5\u05d0\u05d4\u05d5 \u05e9\u05d5\u05d0\u05d4 \u05dc\u05d0 \u05d9\u05d3\u05e2 \u05d5\u05e8\u05e9\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05d8\u05de\u05df \u05ea\u05dc\u05db\u05d3\u05d5 \u05d1\u05e9\u05d5\u05d0\u05d4 \u05d9\u05e4\u05dc \u0628\u0647 \u0645\u0645\u0627 \u062e\u0627\u0637\u0631 \u0628\u0627\u0644\u0645\u0647 \u0648\u0630\u0627\u0643 \u0648\u062a\u062a\u0645\u0647 \u0645\u0627 \u062a\u0641\u0648\u0647 \u0628\u0647 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u0648\u0645\u0627 \u0627\u0644\u0639\u062c\u0628 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0632\u062f \u0627\u0644\u064a\u0647\u064a\u0631 \u0648\u0627\u0644 \u0628\u0644 \u0645\u0646 \u0642\u0648\u0645 \u0634\u064a\u0648\u0643 \u0631\u0627\u0633\u0627 \u0644\u0627 \u064a\u0646\u0643\u0631\u0648 \u0639\u0644\u0649 \u0641\u0639\u0644 \u0630\u0644\u0643 \u0648\u0644\u0627 \u064a\u0642\u0628\u062d \u0644\u0647 \u0639\u0644\u064a\u0647 \u0628\u0644 \u064a\u062d\u0633\u0646\u0648 \u0647 \u0644\u0647 \u0644\u0647 \u0645\u0627 \u0641\u0639\u0644 \u0648\u064a\u0633\u0639 \u0641\u064a \u062e\u0644\u0627\u0635\u0647 \u0648\u0644\u0643\u0646 \u0628\u062d\u0645\u062f \u05d1\u05d5\u05e8\u0