      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0648\u0635\u0644\u0627\u062d \u062d\u0627\u0644 \u062a\u0641\u0635\u0644 \u0628\u0647 \u0647\u064a\u0644 \u0642\u064a\u0645\u0629 \u0627\u0644\u0644\u0647 \u062c\u0632\u0621\u0629 \u0627\u0644\u0645\u062d\u062f\u062b \u0627\u0644\u0630\u064a \u0644\u062d\u0636\u0631\u062a\u0647 \u0641\u0642\u062f \u0642\u0628\u0636\u0647 \u0627\u0644\u0634\u064a\u0643 \u062f\u0641\u0639 \u0644\u0643\u0644 \u0631\u062c\u0644 \u0631\u062d\u0644\u0647 \u0648\u0643\u062a\u0627\u0628\u0647 \u062a\u0635\u0644\u0643 \u0628 \u0645\u0627 \u0645\u0636\u0627 \u0644\u0643 \u0641\u064a \u0645\u0631\u0643\u0628 \u0646\u0628\u064a\u0631\u0648\u064a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0648 \u0648\u0644\u0627 \u0641\u0644\u0627 \u0639 \u0645\u0648\u0644\u0626\u064a \u0648\u062d\u0645\u0644\u062a\u0646\u064a \u0627\u0644\u062f\u0627\u0644\u0629 \u0639\u0644\u0649 \u062a\u0641\u0636\u0644\u0643 \u0648\u0627\u0646\u0641\u062f\u062a \u0639\u0644\u0649 \u064a\u062f \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0639\u0644\u0649 \u0628\u0646 \u0637\u0626\u064a\u0628 \u0648 \u0627\u0644\u0645\u0636\u0631\u0626\u064a\u0646 \u0641\u064a\u0647 \u062e\u064a\u0631 \u0648\u0630\u0644\u0643 \u0633\u062a\u0629 \u0627\u0645\u0646\u0627 \u062d\u0631\u064a\u0631 \u0637\u0626\u064a\u0628 \u0628\u064a\u0634\u0627\u0646\u064a \u0641\u064a \u062e\u0631\u064a\u0637\u0629 \u0645\u0634\u0645\u0639\u0629 \u0648\u0641\u0648\u0642 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u062e\u064a\u0634\u0629 \u0639\u0644\u064a\u0647\u0627 \u0645\u0643\u062a\u0648\u0628 \u05d0\u05d1\u05e8\u05d4\u05dd \u064a\u062c\u0648 \u062a\u0648\u062c\u064a\u0647 \u05d9\u05d5\u05e1\u05e3 \u05d1\u05df \u05d0\u05d1\u05e8\u05d4\u05dd \u0648\u0627\u064a\u0636\u0627 \u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u0636\u0631\u0629 \u0632\u0631\u0646\u064a\u0643 \u0627\u0635\u0641\u0631 \u0648\u0633\u0645\u0639\u062a \u0627\u0646 \u0627\u0644\u0632\u0631\u0646\u064a\u0643 \u0639\u0646\u062f\u0643\u0645 \u0645\u0637\u0644\u0648\u0628 \u0648\u062e\u0627\u0635\u0629 \u0627\u0635\u062d\u0627\u0628 \u0633\u064a\u0644\u0627\u0646 \u064a\u0637\u0644\u0628\u0648\u0647 \u0643\u062b\u064a\u0631 \u0648\u0642\u062f \u064a\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0627\u0644\u0648\u0632\u0646 \u0645\u0627\u0626\u0629 \u0648\u0633\u062a\u064a\u0646 \u0631\u0637\u0644 \u0628\u0635\u0631\u0641\u0647 \u0648\u0647\u0648 \u0632\u0631\u0646\u064a\u0643 \u0645\u0644\u064a\u062d \u062a\u062c\u062a\u0647\u062f \u0648 \u05dc\u05de\u05e2\u05df \u05e9\u05de\u05d5 \u05d4\u05d2\u05d3\u05d5\u05dc \u0648\u0627\u064a\u0636\u0627 \u0648\u0635\u0644\u0648 \u0641\u0636\u0644\u0643 \u0648\u0644\u0627 \u0641\u0644\u0627 \u0639\u062f\u0645\u062a \u0647\u0645\u062a\u0643 \u0627\u0644\u0634\u0631\u064a\u0641\u0629 \u0648\u0644\u0627 \u0632\u0644\u062a \u0645\u062a\u0641\u0636\u0644 \u0645\u0648\u0644\u0627\u064a \u0648\u062d\u0645\u0644\u062a\u0646\u064a \u0627\u0644\u062f\u0627\u0644\u0629 \u0639\u0644\u0649 \u062a\u0641\u0636\u0644\u0643 \u0648\u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0641\u064a \u0645\u0631\u0643\u0628 \u0639\u0644\u0649 \u064a\u062f \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0639\u0644\u0649 \u0628\u0646 \u0637\u0626\u064a\u0628 \u0627\u0644\u0645\u0635\u0631\u0649 \u0648\u0647\u0648 \u064a\u0647\u0648\u062f\u064a \u0627\u0644\u0645\u0635\u0631\u0626\u064a\u0646 \u0641\u064a\u0647 \u062e\u064a\u0631 \u0648\u0630\u0644\u0643 \u0633\u062a\u0629 \u0627\u0645\u0646\u0627 \u062d\u0631\u064a\u0631 \u0637\u064a\u064a\u0628 \u0628\u064a\u0634\u0627\u0646\u064a \u0641\u064a \u062e\u0631\u064a\u0637\u0629 \u0645\u0634\u0645\u0639\u0629 \u0648\u0641\u0648\u0642 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u062e\u064a\u0634\u0629 \u0639\u0644\u064a\u0647\u0627 \u0645\u0643\u062a\u0648\u0628 \u05d0\u05d1\u05e8\u05d4\u05dd \u064a\u062c\u0648 \u062a\u0648\u062c\u064a\u0647 \u05d9\u05d5\u05e1\u05e3 \u05d1\u05df \u05d0\u05d1\u05e8\u05d4\u05dd \u0648\u0627\u064a\u0636\u0627 \u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u0636\u0631\u0629 \u0632\u0631\u0646\u064a\u0643 \u0627\u0635\u0641\u0631 \u0648\u0633\u0645\u0639\u062a \u0627\u0646 \u0627\u0644\u0632\u0631\u0646\u064a\u0643 \u0639\u0646\u062f\u0643\u0645 \u0645\u0637\u0644\u0648\u0628 \u0648\u062e\u0627\u0635\u0629 \u0627\u0635\u062d\u0627\u0628 \u0633\u064a\u0644\u0627\u0646 \u064a\u0637\u0644\u0628\u0648\u0647 \u0643\u062b\u064a\u0631 \u0648\u0642\u062f \u064a\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0627\u0644\u0648\u0632\u0646 \u0645\u0627\u0626\u0629 \u0648\u0633\u062a\u064a\u0646 \u0631\u0637\u0644 \u0628\u0635\u0631\u0641\u0629 \u0648\u0647\u0648 \u0632\u0631\u0646\u064a\u0643 \u0645\u0644\u064a\u062d \u062a\u062c\u062a\u0647\u062f \u064a\u0627 \u0645\u0648\u0644\u0626\u064a \u0641\u064a \u0628\u064a\u0639 \u0627\u0644\u062c\u0645\u064a\u0639 \u0643\u0645\u0627 \u0639\u0648\u062f\u062a \u0645\u0646 \u062a\u0641\u0636\u0644\u0643 \u0628\u0645\u0627 \u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0648\u0631\u0632\u0642 \u0648\u062a\u0634\u062a\u0631\u0649 \u0644\u0639\u0628\u062f\u0643 \u0628\u0627\u0644\u0639\u0648\u0636 \u0642\u0644\u064a\u0644 \u062d\u062f\u064a\u062f \u0645\u0627 \u0627\u062a\u0641\u0642 \u0648\u0647\u064a\u0644 \u0648\u0627\u0646 \u0642\u062f\u0631\u062a \u0639\u0644\u0649 \u0642\u0644\u064a\u0644 \u062a\u0646\u0643\u0627\u0631 \u0627\u0648 \u0645\u0627 \u0631\u0627\u064a\u062a \u0641\u064a\u0647 \u0627\u0644\u0635\u0648\u0627\u0628 \u0641\u0627\u0644\u062d\u0627\u0635\u0631 \u064a\u0631\u0627 \u0645\u0627\u0644\u0627 \u064a\u0631\u0627 \u0627\u0644\u063a\u0627\u0626\u0628 \u0648\u062a\u0646\u0641\u062f\u0647 \u0644\u064a \u0641\u064a \u0627\u0648\u0644 \u0645\u0631\u0643\u0628 \u064a\u0633\u0627\u0641\u0631 \u0627\u0644\u0649 \u0639\u062f\u0646 \u0648\u0645\u0648\u0644\u0626\u064a \u0628\u0631\u064a \u0645\u0646 \u0627\u0644\u062e\u0637\u0631 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0644\u0645\u0648\u0644\u0626\u064a \u0648\u0635\u0648\u0644 \u0641\u064a\u0643\u0648\u0646 \u0635\u062d\u0628\u062a\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u064a\u0636\u0627 \u0627\u0646\u0641\u062f\u062a \u0628\u0645\u0632\u0629 \u0641\u064a\u0647\u0627 \u064a\u062f \u0631\u0637\u0644 \u0648\u0646\u0635\u0641 \u0635\u0641\u0631 \u0641\u064a\u0647 \u0627\u0628\u0631\u064a\u0642 \u05d2 \u0645\u0643\u0633\u0648\u0631 \u0648\u0637 \u0648\u062e\u0631\u0633\u0649 \u0645\u062e\u0633\u0648\u0631 \u0648\u063a\u064a\u0631 \u0630\u0644\u0643 \u062a\u0641\u0635\u0644 \u0648\u062a\u0646\u0639\u0645 \u0648\u062a\u0639\u0645\u0644 \u0644\u064a \u0645\u0646\u0647 \u0637\u0633\u062a \u0648\u0627\u0628\u0631\u064a\u0642 \u064a\u0643\u0648\u0646\u0648 \u0644\u0637\u0627\u0641 \u0633\u0627\u062f\u062c \u064a\u0643\u0648\u0646 \u0648\u0632\u0646\u0647\u0645 \u062e\u0627\u0644\u0635 \u0633\u062a\u0629 \u0627\u0631\u0637\u0627\u0644 \u0627\u0648 \u062e\u0645\u0633\u0629 \u0648\u0646\u0635\u0641 \u0632\u0627\u0626\u062f \u0642\u0644\u064a\u0644 \u0646\u0627\u0642\u0635 \u0642\u0644\u064a\u0644 \u0648\u062d\u0633\u0643\u0629 \u0644\u0637\u064a\u0641\u0629 \u0644\u0634\u0645\u0639\u0629 \u0644\u0637\u064a\u0641\u0629 \u064a\u0643\u0648\u0646 \u0648\u0632\u0646\u0647\u0627 \u062e\u0627\u0644\u0635 \u0645\u0646 \u0631\u0637\u0644\u064a\u0646 \u0627\u0644\u0649 \u0631\u0637\u0644\u064a\u0646 \u0648\u0646\u0635\u0641 \u062a\u0643\u0648\u0646 \u0633\u0627\u062f\u062c \u0639\u0645\u0644 \u0645\u0644\u064a\u062d \u0645\u0646 \u0645\u0627 \u064a\u0639\u062c\u0628 \u0645\u0648\u0644\u0626\u064a \u0648\u0627\u0644\u0628\u0627\u0642\u0649 \u0645\u0646 \u0627\u0644\u0635\u0641\u0631 \u064a\u0628\u064a\u0639\u0629 \u0648\u064a\u0636\u064a\u0641\u0629 \u0627\u0644\u0649 \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u0649 \u062d\u0635\u0631\u062a\u0643 \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0628