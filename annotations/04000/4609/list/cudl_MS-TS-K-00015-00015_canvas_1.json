      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05e9\u05dc\u05de\u05d4 \u05e1\u05d5\u05e4\u05e8 \u05d2 \u0645\u0639\u0627\u0644\u064a \u05d2 \u062c\u0627\u0631\u0629 \u0627\u0644\u0630\u0628\u0627\u062c \u05d1 \u062d\u0645\u0648\u0644\u0647 \u05d2 \u0645\u0639 \u0627\u0628\u0648 \u0643\u062b\u064a\u0631 \u05d3 \u0627\u0645 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1 \u05d0\u05d4\u05e8\u05df \u05d3 \u0636\u0631\u064a\u0631 \u0627\u0628\u0648 \u05d1 \u0633\u0639\u064a\u062f \u0648\u0627\u0646\u0636\u0627\u0641 \u05dc\u05e9\u05de\u05d9\u05e2\u05d4 \u05d0 \u05db\u05d2 \u05d5\u05dc\u05d1\u05e0\u05ea\u05d4 \u05d0 \u0648\u0644\u0645\u0639\u0644\u0627 \u0631\u062c\u064a\u0641 \u05d0 \u0648\u0644\u0627\u0645 \u0647\u0644\u0627\u0644\u0629 \u05d0 \u0648\u0644\u0633\u0628\u064a\u0639 \u0636\u0631\u064a\u0631 \u05d0 \u0648\u0644\u0627\u0628\u0646 \u0627\u0644\u0640\u05de\u05e8\u05d4\u05d8 \u05d2 \u0627\u0644\u0631\u0648\u0645 \u05dc\u05d0 \u0627\u0645 \u05d9\u05d5\u05e1\u05e3 \u05d1 \u062d\u0645\u0627\u0629 \u0627\u0644\u064a\u0647 \u0628 \u05de\u05e8\u05d3\u05db\u05d9 \u05d1 \u05d2 \u062b\u0644\u062b\u0629 \u0627\u064a\u062a\u0627\u0645 \u05d2 \u0632\u0639\u0641\u0631\u0627\u0646 \u05d5 \u0627\u0645 \u0639\u064a\u0646\u064a\u0646 \u05d2 \u0627\u064a\u062a\u0627\u0645 \u0627\u0644\u0641\u0631\u0627 \u05d3 \u05e9\u05de\u05e8\u05d9\u05d4 \u05d2 \u0627\u064a\u062a\u0627\u0645 \u0627\u0644\u0642\u0631\u0627 \u05d1 \u0627\u0645 \u0627\u0644\u062e\u064a\u0627\u0637 \u05d0 \u0645\u0628\u0627\u0631\u0643\u0629 \u05d2 \u0633\u062a\u0627\u0646 \u05d1 \u062d\u0645\u0627\u0629 \u0641\u0631\u0646\u0633 \u05d0 \u062c\u062f\u0629 \u05d1 \u05e8\u05d1\u05e7\u05d4 \u05d1 \u0627\u0645 \u0645\u062a\u062a\u064a\u0629 \u05d1 \u0643\u0646\u0627\u0646\u0647 \u05d0 \u0627\u0645\u0631\u0627\u0647 \u0627\u0644\u064a\u0647 \u05d1 \u0627\u0628\u0648 \u062e\u0644\u064a\u0641 \u05d3 \u0627\u0645\u0631\u0627\u0647 \u0627\u0644\u0645\u064a\u062a \u05d2 \u0645\u0641\u0644\u0648\u062c \u05d1 \u0627\u0644\u064a\u0647 \u05d1 \u0643\u0647\u0646 \u062e\u064a\u0627\u0637 \u05d2 \u0627\u0645\u0629 \u0648\u0633\u062a\u0629 \u05d2 \u062f\u064a\u0646\u064a \u05d0 \u0627\u0645\u0631\u0627\u0647 \u0627\u0644\u0634\u064a\u0643 \u05d0 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d2 \u0646\u0645\u0631 \u05d1 \u05d9\u05e2\u05e7\u05d1 \u05d0 \u05de\u05e9\u05d4 \u05d1 \u0627\u0644\u064a\u0647 \u05d2 \u0627\u0644\u064a\u0642\u064a\u0645 \u05d1 \u064a\u062a\u064a\u0645 \u05d0 \u0631\u0648\u0645\u064a \u05e2\u05d5 \u05d1 \u0648\u0627\u0646\u0636\u0627\u0641 \u0644\u0644\u0631\u0648\u0645 \u062b\u0644\u062b\u0629 \u0639\u0634\u0631\u0629 \u05e4\u05d8 \u0641\u0630\u0644\u0643 \u062e\u0645\u0633 \u0639\u0634\u0631\u0629 \u0641\u0638 \u0641\u0630\u0644\u0643 \u062e\u0645\u0633 \u0642\u0646\u0627\u0637\u0631\u0639\u062f\u062f\u0647\u0627 \u062e\u0645\u0633 \u0645\u0627\u0626\u0629 \u0631\u062c\u064a\u0641 \u0648\u0627\u0646\u0641\u0642 \u0641\u064a\u0647\u0645 \u0627\u064a\u0636\u0627 \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u0627\u0644\u0648\u0627\u062d\u062f \u0648\u0639\u0634\u0631\u064a\u0646 \u0645\u0646\u0647 \u062e\u0645\u0633\u0629 \u0642\u0646\u0627\u0638\u0631 \u0639\u062f\u062f\u0647\u0627 \u062e\u0645\u0633 \u0645\u0627\u0626\u0629 \u0633\u0628\u0639\u0629 \u0648\u0633\u062a\u064a\u0646 \u0627\u0644\u062d\u0632\u0646 \u0627\u0644\u0642\u0636\u0627\u0639\u064a \u05d5 \u0627\u0644\u0628\u0639\u0644\u0628\u0643\u064a \u05d4 \u0627\u0628\u0648 \u0645\u062e\u062a\u0627\u0631 \u05d8 \u0628\u0646 \u0627\u0644\u062e\u0631\u0632\u064a \u05d1 \u0628\u0646 \u0627\u0644\u0639\u0645\u0627\u0646\u064a \u05d3 \u0632\u0639\u0641\u0631\u0627\u0646 \u05d7 \u05d9\u05d5\u05e1\u05e3 \u0648\u0628\u0646 \u0627\u0644\u0645\u0646\u062c\u0645 \u05d7 \u0627\u0644\u0633\u0648\u0631\u0627\u0646\u064a \u05d4 \u05d1\u05df \u0627\u0644\u0627\u0637\u0631\u0648\u0634 \u05d7 \u0645\u0641\u0644\u0648\u062c\u0647 \u05d1 \u0627\u0628\u0648 \u062e\u0644\u064a\u0641 \u05d3 \u064a\u062a\u064a\u0645 \u05d0 \u0628\u0646 \u0627\u0644\u0645\u0628\u062b\u0644\u0627 \u05d0 \u05d9\u05d5\u05e1\u05e3 \u0648\u0628\u0646 \u0627\u0644\u0645\u0646\u062c\u0645 \u05d7 \u0627\u0644\u0633\u0648\u0631\u0627\u0646\u064a \u05d4 \u0628\u0646 \u0627\u0644\u0627\u0637\u0631\u0648\u0634 \u05d7 \u0645\u0641\u0644\u0648\u062c\u0647 \u05d1 \u0627\u0628\u0648 \u062e\u0644\u064a\u0641 \u05d3 \u064a\u062a\u064a\u0645 \u05d0 \u0628\u0646 \u0627\u0644\u0645\u0628\u062a\u0644\u0627 \u05d0 \u0645\u0628\u0627\u0631\u0643\u0629 \u05d3 \u05d2 \u0627\u0645 \u0641\u0631\u064a\u062c \u05d0 \u0633\u062a\u0627\u0646 \u05d1 \u05d0\u05d1\u05e8\u05d4\u05dd \u0635\u0648\u0631\u064a \u05d4 \u0633\u0628\u0627\u063a \u05d3 \u0643\u0646\u0627\u0646\u0647 \u05d0 \u0627\u0644\u062c\u0627\u0633\u0644\u0629 \u05d1 \u0627\u0645\u0631\u0627\u0629 \u0627\u0644\u0645\u064a\u062a \u05d3 \u062d\u0645\u0627\u0629 \u0627\u0644\u064a\u0647 \u05d1 \u0645\u0637\u0644\u0642\u0629 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u05d2 \u0627\u0645\u0631\u0627\u0647 \u0633\u0642\u0644\u064a \u05d3 \u05ea \u0648\u0635\u0647\u0631\u0629 \u05d5 \u0627\u0645 \u0627\u0644\u062e\u064a\u0627\u0637 \u05d1 \u0627\u064a\u062a\u0627\u0645 \u0627\u0644\u0642\u0631\u0627 \u05d1 \u062c\u0627\u0633\u0644\u0629 \u0627\u0644\u0631\u0648\u0645 \u05d2 \u05d9\u05d5\u05e1\u05e3 \u05d5 \u05e8 \u05d9\u05e2\u05e7\u05d1 \u05d2 \u05dc \u05d1 \u05db\u05d4\u05df \u0648\u0627\u0645\u0629 \u05d6 \u0645\u0639\u0631\u0641\u0629 \u0627\u0628\u0648 \u05d2 \u0627\u0644\u0645\u0646\u0627 \u0627\u0645 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d2 \u0627\u0645 \u0636\u0631\u064a\u0641\u0629 \u05d2 \u0627\u0645\u0631\u0627\u0629 \u0642\u0644\u0647\u0627\u0648\u064a \u05d2 \u0633\u0644\u0627\u0645\u0648\u0646 \u05d3 \u05d0\u05d4\u05e8\u05df \u0645\u0642\u062f\u0633\u064a \u05d1 \u064a\u062a\u064a\u0645 \u05d0 \u0646\u062b\u0646 \u05d1 \u05e8\u05d7\u05de\u05d9\u05dd \u05d2 \u0635\u0627\u0644\u062d \u05d3 \u0635\u062f\u0642\u0629 \u05d9 \u0627\u0644\u0645\u0644\u064a\u062c\u064a\u0629 \u05d1 \u0627\u0645\u0631\u0627\u0629 \u0627\u0644\u062d\u0631\u064a\u0631\u064a \u05d3 \u062d\u0645\u0627\u0629 \u0645\u0637\u0627\u0644\u0628\u064a \u05d1 \u0627\u0645\u0631\u0627\u0647 \u0627\u0644\u064a\u0647 \u05d2 \u0627\u0645\u0631\u0627\u0647 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d2 \u0643\u0647\u0646 \u05d1 \u0645\u0639\u0631\u0641\u0629 \u064a\u0637\u0627\u0644\u0628\u064a \u05d1 \u0627\u0645 \u0639\u064a\u0646\u064a\u0646 \u05d3 \u064a\u062a\u064a\u0645 \u05d0 \u0627\u0645 \u05d9\u05d5\u05e1\u05e3 \u05d2 \u0627\u0644\u064a\u0642\u064a\u0645 \u05d1 \u0628\u0646 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u05d1 \u0633\u0645\u064a\u062d \u05d1 \u0645\u0639\u0631\u0641\u0629 \u064a\u0637\u0627\u0644\u0628\u064a \u05d1 \u0627\u0645 \u0639\u064a\u0646\u064a\u0646 \u05d3 \u064a\u062a\u064a\u0645 \u0627 \u0627\u0645 \u05d9\u05d5\u05e1\u05e3 \u05d2 \u0627\u0644\u064a\u0642\u064a\u0645 \u05d1 \u0628\u0646 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u05d1 \u0633\u0645\u064a\u062d \u05d3 \u0648\u0647\u064a\u0628 \u0632\u062c\u0627\u062c \u05d2 \u0627\u0645 \u062e\u0644\u064a\u0641 \u05d2 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0648\u0635\u0647\u0631\u0629 \u05d2 \u0633\u0644\u064a\u0645\u0627\u0646 \u0648\u062d\u0645\u0627\u062a\u0647 \u05d2 \u0634\u0645\u064a\u0639\u0629 \u05d5 \u0627\u0645\u0631\u0627\u0629 \u0627\u0644\u0630\u0628\u0627\u062c \u05d2 \u062d\u0645\u0627\u062a\u0647\u0627 \u05d1 \u05e9\u05dc\u05de\u05d4 \u0627\u0644\u0633\u0648\u0641\u0631 \u05d2 \u05d1\u05df \u05d3\u05e0\u05d9\u05d0\u05dc \u05d7 \u0627\u0644\u064a\u0647 \u05d2 \u05d9\u05d5\u05e1\u05e3 \u0637\u0648\u0627\u0641 \u05d4 \u0645\u0637\u0644\u0642\u0629 \u0627\u0644\u062f\u0642\u064a \u05d1 \u0627\u0644\u0645\u0644\u064a\u062c\u064a \u05d5 \u0645\u062e\u0644\u0648\u0641 \u0636\u0631\u064a\u0631 \u05d1 \u0627\u064a\u062a\u0627\u0645 \u05d9\u05d5\u05e1\u05e3 \u05d7 \u0645\u0639\u0631\u0641\u0629 \u0627\u0632\u0647\u0631 \u05d7 \u0645\u0639\u0631\u0641\u0629 \u062f\u0645\u064a\u0627\u0637\u064a \u05d5 \u0627\u064a\u062a\u0627\u0645 \u0628\u0646 \u05d9\u05d7\u05d9\u05d4 \u0645\u0639\u0631\u0641\u0629 \u0627\u0632\u0647\u0631 \u05d7 \u0645\u0639\u0631\u0641\u0629 \u062f\u0645\u064a\u0627\u0637\u064a \u05d5 \u0627\u064a\u062a\u0627\u0645 \u0628\u0646 \u064a\u062d\u064a\u0629 \u05d2 \u0628\u0646\u062a \u0627\u0644\u062b\u0644\u064a\u062b \u05d1 \u0628\u0646\u062a \u0627\u0644\u063a\u0630\u064a \u0628\u064a\u062a \u0628\u0646 \u0633\u0639\u0627\u062f\u0629 \u0627\u0628\u0648 \u0643\u0644\u064a\u0641\u0629 \u05d5 \u0628\u0646 \u0627\u0644\u0640\u05de\u05e8\u05d4\u05d8 \u05d7 \u0635\u0628\u064a \u0627\u0644\u0627\u0646\u062f\u0644\u0633\u064a \u05d1 \u05e9\u05de\u05d7\u05d4 \u0628\u0646 \u0627\u0644\u0640\u05de\u05e8\u05d4\u05d8 \u05d3 \u0627\u0644\u0640\u05de\u05de\u05d7\u05d4 \u0641\u0631\u064a\u062c \u05d3 \u05d2 \u05d5\u05e8 \u0647\u0644\u0627\u0644 \u05d1 \u0634\u0645\u0631\u064a\u0629 \u0645\u0639\u0631\u0641\u0629 \u0628\u0646 \u0637\u064a\u0628\u0627\u0646 \u05d3 \u0627\u0645\u0631\u0627\u0647 \u05e4 \u05d3 \u05d3 \u0645\u0639\u0631\u0641\u0629 \u0627\u0632\u0647\u0631 \u05d7 \u0645\u0639 \u062f\u0645\u064a\u0627\u0637\u064a \u05d2 \u0628\u0646\u062a \u0627\u0644\u062b\u0644\u064a\u062b \u05d1 \u0627\u062e\u062a \u05d9\u05e6\u05d7\u05e7 \u05d1 \u0628\u0646\u062a \u0627\u0644\u063a\u0630\u064a \u05d1 \u0628\u0646 \u0633\u0639\u0627\u062f\u0629 \u05d3 \u05d9\u05d5\u05e1\u05e3 \u0637\u0648\u0627\u0641 \u05d3 \u0628\u0646 \u0645\u0631\u0647\u0637 \u0648\u0645\u0636\u0627\u0628 \u05d7 \u0628\u064a\u062a \u05d1\u05df \u064a\u062d\u064a\u0629 \u05d2 \u0628\u0631\u0643\u0627\u062a \u0632\u062c\u0627\u062c \u05d2 \u0633\u0645\u064a\u062d \u0643\u0647\u0646 \u05d3 \u0627\u0645\u0631\u0627\u0647 \u0639\u0648\u0627\u0636 \u05d3 \u0648\u0647\u064a\u0628 \u05d2 \u0627\u0644\u0642\u0644\u0647\u0627\u0648\u064a\u0629 \u05d2 \u0627\u0645 \u0636\u0631\u064a\u0641\u0629 \u05d2 \u0627\u0645 \u0627\u0644\u0641\u0642\u0627\u0639\u064a \u05d2 \u05e9\u05de\u05d7\u05d4 \u05d2 \u0628\u0646 \u0627\u0644\u0645\u0628\u062a\u0644\u0627 \u05d0 \u0647\u0644\u0627\u0644 \u05d1 \u0627\u0644\u062d\u0628\u0631 \u0628\u0646 \u05e8 \u05d9\u05d5\u05e1\u05e3 \u05d1\u05df \u0627\u0644\u0627\u0646\u062f\u0644\u0633\u064a \u05d1 \u0627\u064a\u062a\u0627\u0645 \u05d9\u05d5\u05e1\u05e3 \u05d4 \u0633\u0644\u0645\u0627\u0646 \u05d7 \u0628\u0646\u062a \u062d\u0633\u064a\u0643\u0629 \u05d3 \u0628\u064a\u062a \u0627\u0644\u062c\u0627\u0632\u0641\u064a\u0646\u064a \u05d7 \u0635\u062f\u0642\u0629 \u062e\u0627\u062f\u0645 \u05d9 \u0628\u0646 \u0646\u0641\u064a\u0639 \u0648\u0627\u062e\u062a\u0647 \u05d7 \u0645\u0639\u0631\u0641\u0629 \u0628\u0646 \u0637\u064a\u0628\u0627\u0646 \u05d3 \u0627\u0644\u062f\u0642\u064a \u0648\u062d\u0645\u0627\u062a\u0647 \u05d5 \u05d9\u05e6\u05d7\u05e7 \u0648\u0635\u0647\u0631\u0629 \u05d3 \u0627\u0644\u0645\u0639 \u05d3 \u0646\u0639\u064a\u0645 \u05d3 \u05e9\u05de\u05e2\u05d5\u05df \u05d3 \u05d9\u05e2\u05e7\u05d1 \u0635\u0628\u0627\u063a \u05d2 \u0627\u0628\u0648 \u062e\u0644\u064a\u0641\u0629 \u05d5 \u0646\u062d\u0648\u0645 \u05d1 \u0628\u0646 \u0627\u0644\u0639\u0646\u0627\u0646\u064a \u05d3 \u0627\u0645 \u0643\u062d\u0644\u0627 \u05d4 \u0628\u0646 \u0627\u0644\u062d\u0644\u0627\u0644 \u0627\u0645 \u0645\u0639\u0644\u0627 \u0648\u0635\u0647\u0631\u0647\u0627 \u05d9 \u05d5\u05d4 \u062e\u0644\u0627\u0633 \u05d2 \u0627\u0644\u0645\u0639\u0644\u0645\u0629 \u05d2 \u0627\u0645 \u062d\u0631\u0627\u0631\u0629 \u05d2 \u0627\u0644\u0636\u0631\u064a\u0631\u0629 \u05d4 \u0628\u0646 \u0627\u0644\u064a\u062a\u064a\u0645\u0629 \u0630 \u05d2 \u0635\u0647\u0631 \u05d9\u05d5\u05e1\u05e3 \u05d3 \u0645\u062e\u0644\u0648\u0641 \u05d1 \u0637\u0628\u0631\u0627\u0646\u064a \u0634\u0648\u0645\u0631 \u05d4 \u0627\u0645 \u0639\u0628\u064a\u062f \u05d2 \u0645\u0631\u0629 \u0630\u0628\u0627\u063a \u05d2 \u05d9 \u05e9\u05d5\u05de\u05e8 \u05d4 \u05d0\u05dd \u0639\u0628\u064a\u062f \u05d2 \u0645\u0631\u0629 \u0630\u0628\u0627\u063a \u05d2 \u05d9 \u05d9\u05e2\u05e7\u05d1 \u05d9 \u0627\u0628\u0648 \u0647\u0644\u0627\u0644</p>",
