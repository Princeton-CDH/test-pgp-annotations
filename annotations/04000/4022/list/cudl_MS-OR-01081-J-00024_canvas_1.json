          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u064a\u0627\u062e\u064a \u0648\u0627\u0644\u0639\u0632\u064a\u0632 \u0639\u0644\u0649 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u0639\u0632\u0643 \u0648\u0627\u062e\u0631\u0645\u0643 \u0648\u0643\u0627\u0646 \u0644\u0643 \u0648\u0644\u064a\u0627</li>\n<li>\u0641\u064a \u0641\u0647 \u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0643 \u0648\u0648\u0642\u0641\u062a \u0645\u0646\u0647 \u0639\u0644\u0649 \u0633\u0644\u0627\u0645\u062a\u0643\u0645 \u0627\u062c\u0645\u0639\u064a\u0646 \u0648\u0633\u0631\u0646\u064a \u0630\u0644\u0643 \u0648\u0643\u0627\u0646 \u0648\u0635\u0644</li>\n<li>\u0643\u062a\u0627\u0628 \u0627\u062e\u064a \u0627\u0628\u064a \u05d9\u05e6\u05d7\u05e7 \u0633\u0644\u0645\u0629 \u0627\u0644\u0644\u0647 \u064a\u0630\u0643\u0631 \u0645\u062c\u064a\u0643\u0645 \u0648\u0643\u0627\u0646 \u0642\u0644\u0628\u064a \u0628\u0643\u0645 \u0641\u064a \u063a\u0627\u064a\u0629 \u0645\u0627 \u064a\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u0634\u063a\u0644</li>\n<li>\u0627\u0644\u0630\u064a \u0633\u0647\u0644 \u0639\u0644\u064a\u0643\u0645 \u0648\u0644\u064a\u0633 \u0627\u062f\u0631\u064a \u0643\u064a\u0641 \u062d\u062a\u0649 \u0633\u0647\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u062e\u0631\u0648\u062c \u0627\u0630 \u0643\u0627\u0646 \u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644</li>\n<li>\u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0643\u0627\u0646 \u0645\u0642\u0627\u0645\u0643 \u0627\u0631\u062c\u0648 \u0639\u0627\u0642\u0628\u0629 \u062e\u064a\u0631 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u062a\u0630\u0643\u0631 \u0633\u0639\u0631 \u0627\u0644\u062d\u0631\u064a\u0631 \u05d5</li>\n<li>\u0628\u0627\u0644\u0642\u064a\u0631\u0648\u0627\u0646 \u0641\u0627\u0646 \u0643\u0627\u0646 \u0645\u0639\u0643\u0645 \u0645\u0646\u0647 \u0634\u064a \u0648\u062c\u0647\u062a \u0645\u0646\u0647 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0627\u0633\u0639\u0627\u0631</li>\n<li>\u062d\u0627\u0647\u0648 \u0639\u0644\u064a\u0643\u0645 \u0648\u0647\u0648 \u0647\u0646\u0627 \u0644\u064a\u0633 \u05d9 \u0627\u062e\u0627\u0644\u0627 \u0648\u0627\u0631\u062c\u0648 \u062d\u0635\u0644</li>\n<li>\u0648\u0627\u0644\u0644 \u0648\u0644\u0645 \u064a\u0628\u0627\u0639 \u0645\u0646 \u062d\u0631\u064a\u0631\u0643 \u0634\u064a \u0633\u0648\u0627 \u0627\u0644 \u0627\u0631\u0637\u0627\u0644 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u0641\u064a \u0648\u0636\u0637 \u062d\u0631\u064a\u0631\u0643\u0645</li>\n<li>\u0648\u0644\u0644\u0627\u0646 \u0645\u0627 \u0642\u0628\u0636\u062a\u0647\u0627 \u0648\u0644\u0648 \u062a\u0647\u064a\u0627 \u0644\u064a \u0628\u064a\u0639 \u0627\u0644\u0628\u0634\u0631\u064a \u0627\u0644\u0630\u064a \u0644\u0643 \u0644\u0628\u0639\u062a\u0647 \u0648\u0643\u0627\u0646 \u0642\u062f \u0635\u062f\u0631 \u0645\u0646\u064a \u0627\u0644\u064a\u0643\u0645 \u0628\u064a\u0639 \u0627\u0644\u0628\u0634\u0631\u064a \u0627\u0644\u0630\u064a \u0644\u0643 \u0644\u0628\u0639\u062a\u0629 \u0648\u0643\u0627\u0646 \u0642\u062f</li>\n<li>\u0635\u062f\u0631 \u0645\u0646\u064a \u0627\u0644\u064a\u0643\u0645 \u0643\u062a\u0628 \u0641\u064a \u0627\u0644\u0645\u0648\u0633\u0645 \u0644\u0643\u0645 \u0627\u062c\u0645\u0639\u064a\u0646 \u0648\u0644\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0633\u0639\u064a\u062f \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u062c\u0645\u0627\u0639\u0629</li>\n<li>\u0648\u0633\u0645\u0639\u062a \u0627\u0646\u0647\u0627 \u0636\u0627\u0639\u062a \u0641\u0644\u0627 \u0633\u0644\u0645 \u0627\u0644\u0644\u0647 \u0627\u0628\u0648 \u0627\u0644\u0627\u0632\u0647\u0631 \u0648\u0644\u0627 \u062c\u0644\u0627\u0645\u0629 \u0648\u0639\u0631\u0641\u062a \u0641\u064a \u0648\u0642\u062a \u0627\u0646 \u0639\u0637\u064a\u062a\u0647\u0645</li>\n<li>\u0627\u0646\u0647 \u064a\u0636\u064a\u0639\u0647\u0627 \u0627\u0644 \u0648\u0636\u0637\u0647\u0627 \u0634\u064a \u0644\u0627 \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0641\u0627\u0646\u064a \u062a\u0639\u0628\u062a \u0641\u064a \u0643\u062a\u0627\u0628\u0647\u0627 \u0648\u0636\u0627\u0639\u062a</li>\n<li>\u0636\u0627\u0639\u0629 \u0627\u0644\u0630\u064a \u0630\u0643\u0631\u062a \u0641\u064a\u0647\u0627 \u0628\u0646 \u0633\u063a\u0645\u0627\u0631 \u0648\u0627\u0646\u062a \u062a\u0635\u0644\u0648 \u062a\u0642\u064a\u0645\u0648 \u0644\u062e\u0631\u0648\u062c \u0627\u0644\u0645\u0648\u0633\u0645 \u0644\u0627\u0646</li>\n<li>\u0627\u0644\u0646\u0627\u0633 \u0627\u0639\u0627\u062f\u0648 \u0627\u0644\u0642\u0627\u0639\u0627\u062a \u0641\u064a\u062e\u0631\u062c\u0648 \u0648\u062a\u062a\u0641\u0631\u062c \u0648\u0643\u062f\u0627\u0645 \u0628\u0646 \u0633\u063a\u0645\u0627\u0631 \u062e\u0627\u0631\u062c \u0627\u064a\u0636\u0627 \u0648\u0627\u0644\u063a\u064a\u0627\u0631</li>\n<li>\u0627\u0644\u0630\u064a \u0630\u0643\u0631\u062a \u0639\u0646\u062f \u0648\u0635\u0648\u0644\u0643\u0645 \u062a\u0639\u0645\u0644\u0648 \u0645\u0627 \u062a\u0634\u062a\u0647\u064a\u0648 \u0648\u0644\u064a\u0633 \u0639\u0644\u064a\u0643\u0645 \u0634\u064a \u0648\u0627\u0644\u0627\u0645\u0648\u0631 \u0641\u064a \u062b\u0628\u062a \u0627\u0645\u0631</li>\n<li>\u0627\u0644\u0644\u0647 \u0648\u0634\u0642 \u0639\u0644\u0649 \u0627\u0630 \u0644\u0645 \u062a\u0630\u0643\u0631 \u0644\u064a \u0627\u064a\u0646 \u0627\u0646\u062a\u0647\u0627 \u0627\u062e\u064a \u0627\u0628\u064a \u05d9\u05e6\u05d7\u05e7 \u0633\u0644\u0645\u0629 \u0627\u0644\u0644\u0647 \u0641\u064a \u0645\u0627 \u0647\u0648 \u0641\u064a\u0647 \u0645\u0639</li>\n<li>\u0627\u0644\u0642\u0644\u064a\u0644 \u0627\u0644\u0630\u064a\u0646 \u0648\u0627\u0631\u062c\u0648 \u0627\u0644\u0644\u0647 \u064a\u0646\u0635\u0631 \u0627\u0644\u062d\u0642 \u0648\u0643\u0627\u0646 \u0647\u0646\u0627 \u0627\u0644\u0633\u0646\u0629 \u0648\u0643\u0645 \u0639\u0635\u064a\u0645 \u0634\u064a \u0645\u0627 \u0631\u0627\u064a\u062a\u0647 \u0645\u0630 \u062f\u062e\u0644\u062a</li>\n<li>\u0644\u0645\u0635\u0631 \u0648\u0645\u0631\u0636\u062a \u0644\u064a \u0627\u0644\u064a\u0648\u0645 \u05d3 \u0634\u0647\u0648\u0631 \u0628\u0627\u0644\u062d\u0645\u0627 \u0648\u0627\u0644\u0628\u0631\u0648\u062f\u0627 \u0643\u0627\u0646\u062a \u062a\u0627\u062e\u0630\u0646\u064a \u0644\u064a\u0644 \u0648\u0646\u0647\u0627\u0631</li>\n<li>\u0641\u0639\u0645\u0644 \u0627\u0644\u0644\u0647 \u0645\u0639\u0649 \u05dc\u05de\u05e2\u05df \u05e9\u05de\u05d5 \u0648\u0644\u064a\u0633 \u0628\u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0648\u0642\u062f \u062e\u0644\u0627\u062b\u0646\u064a \u0648\u0627\u0646\u0627 \u0641\u064a \u0643\u0644 \u0639\u0627\u0641\u064a\u0629 \u0644\u0644\u0647 \u0627\u0644</li>\n<li>\u062d\u0645\u062f \u0643\u062b\u064a\u0631\u0627 \u0648\u0642\u062f \u0632\u0627\u0644 \u0627\u0644\u0648\u0643\u0645 \u0648\u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0648\u062c\u0645\u064a\u0639 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0641\u064a \u0639\u0627\u0641\u064a\u0629 \u0648\u0644\u0642\u062f \u0633\u0631\u0646\u064a \u0645\u062c\u064a\u0643\u0645</li>\n<li>\u0644\u0627\u0646 \u0645\u0627 \u0647\u0646\u0627 \u0645\u0639 \u0645\u0646 \u064a\u062a\u0641\u0631\u062c \u0627\u0644\u0627\u0646\u0633\u0627\u0646 \u0642\u0631\u0627\u062a \u0639\u0644\u0649 \u062e\u0627\u0635\u0629 \u0627\u0646\u0641\u0633\u0643\u0645 \u0627\u0644\u0634\u0631\u064a\u0641\u0629 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0645 \u0648\u0635\u062f\u064a\u0642\u0643\u0645</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u05d9\u05e9\u05d5\u05e2\u05d4 \u0639\u0648\u0635\u0629 \u0627\u0644\u0644\u0647 \u062e\u064a\u0631 \u064a\u0628\u0644\u063a\u0643\u0645 \u0627\u062c\u0645\u0639\u064a\u0646 \u0627\u0644\u0633\u0644\u0645 \u05d5\u05e9\u05de\u05d7\u05d4 \u064a\u0628\u0644\u063a\u0643\u0645 \u0627\u0644\u0633\u0644\u0645</li></ol>\n",
