      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u062d\u0633\u0627\u0628 \u0641\u0633\u064a\u0642\u0629 \u062f\u0645\u0648\u0629</li>\n<li>\u0645\u0648\u0633\u0649 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0647</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u0645\u062c\u062f \u0627\u0644\u062f\u0645\u064a\u0631\u064a \u0647</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0628\u0646 \u0645\u0639\u0627\u0646\u064a \u0627</li>\n<li>\u05d9</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u0627 \u0627\u0644\u0635\u0628\u063a</li>\n<li>\u0647</li>\n<li>\u0644\u0634\u062e\u0635 \u0644\u0627 \u0639\u0646\u0639\u0644\u0645\u0647</li>\n<li>\u05d2</li>\n<li>\u0645\u0646 \u0645\u0646\u064a\u0629 \u062c\u0645\u0631</li>\n<li>\u0645</li>\n<li>\u0645\u0646 \u0628\u064a\u062a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0639\u0645\u0631\u0627\u0646 \u0627\u0644\u062a\u0644\u0645\u064a\u062f \u05d4\u05db\u05d4\u05df \u0634\u0635</li>\n<li>\u05db</li>\n<li>\u0645\u0646 \u0628\u064a\u062a \u0638\u0627\u0647\u0631 \u0627\u0644\u0646\u0642\u0627\u062f \u0639\u0644\u0649 \u064a\u062f \u0627\u0644\u062e\u0627\u062f\u0645</li>\n<li>\u05d2</li>\n<li>\u0645\u0646 \u0628\u064a\u062a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0631 \u0646\u0642\u0635 \u0648\u0646\u062d\u0627\u0633</li>\n<li>\u05d9</li>\n<li>\u0645\u0646 \u062c\u0647\u0629 \u0631\u0647\u062c \u0627\u0645 \u0633\u0644\u0627\u0645\u0629</li>\n<li>\u05d9</li>\n<li>\u0633\u062a \u0645\u0642\u0628\u0644 \u0642\u0631\u064a\u0628 \u0632\u0648\u062c\u0629 \u0627\u0644\u0627\u0633\u0639\u062f \u0627\u0644\u0637\u0628\u064a\u0628</li>\n<li>\u05dc\u05d8 \u0648\u0646\u0635\u0641 \u062a\u0633\u0644\u0645\u062a \u0645\u0646\u064a</li></ol>\n\n<p></p>\n<p>\u05db\u05ea\u05d5\u05d1 \u0645\u0646 \u05d4\u05e6\u05d3 \u0627\u0644\u0645\u0635\u0631\u0648\u0641</p>\n<p>\u0635\u0628\u0627\u0628 \u0644\u0644\u062e\u0646\u064a\u0633\u0629 \u0628\u064a\u062f \u0627\u0644\u062e\u0627\u062f\u0645 \u0644\u0644\u062e\u0637\u064a\u0628</p>\n<p>\u05d4</p>",
