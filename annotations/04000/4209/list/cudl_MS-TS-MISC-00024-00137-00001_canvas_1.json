46 \u0647\u0630\u0627 \u0627\u0644\u0640\u05e8\u05d5\u05e9\u05df \u0627\u0644\u0630\u064a \u0642\u062f \u0628\u0646\u0627 \u05de\u05e8 \u05d9\u05e4\u05ea \u05ea\u05e4\u05d0\u05e8\u05ea \u05d4\u05e7\u05d4\u05dc \u0627\u0639\u0631\u0641\u0647 \u0639\u062a\u064a\u0642 \u0648\u0643\u0645\u0627 \u0642\u062f \u062c\u062f\u062f\u0647 \u0633\u0639\u0629 \u0644\u0627\u0646\u0647 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0627\u0646 \u0643\u0627\u0646 \u062d\u0627\u0626\u0637 \u0642\u062f\u064a\u0645 \u0648\u0641\u064a\u0647 \u0647\u0630\u0647 \u0627\u0644\u0640\u05e8\u05d5\u05e9\u05df \u0648\u0647\u0648 \u0627\u0644\u0633\u0639\u0629 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0628\u0627\u0644 \u062d\u0627\u0626\u0637 \u062c\u062f\u064a\u062f \u0643\u0645\u0627 \u0643\u0627\u0646 \u0642\u062f\u064a\u0645 \u0648\u0627\u062e\u0631\u062c \u0627\u0644\u0640\u05e8\u05d5\u05e9\u05df \u0643\u0645\u0627 \u0643\u0627\u0646 \u0642\u062f\u064a\u0645 \u0648\u0645\u0627 \u0630\u0647\u0648\u0629 \u0642\u062f\u0645\u0646\u0627 \u0648\u062d\u062a\u0645\u0646\u0627 \u05dc\u05de\u05d4\u05e0\u05d9 \u05dc\u05d6\u05db\u05d5\u05ea \u0648\u0644\u0631\u0627\u064a\u0629 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05d9\u05e8 \u05e9\u05de\u05e2\u05d9\u05d4 \u05d4\u05d7 \u05e0\u05d1\u05ea \u05d5\u05d9\u05d0 \u05e0\u05d9\u05df \u05e9 \u05d2 \u05e0\u05e2 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05d9\u05e8 \u05d9\u05e9\u05d5\u05e2\u05d4 \u05e0\u05e2 \u05d1\u05e8 \u05d9\u05d5\u05e1\u05e3 \u062d\u0636\u0631 \u05de \u05d1\u05d9\u05e8 \u05d9\u05e9\u05d5\u05e2\u05d4 \u05e0\u05e2 \u05d1\u05e8 \u05d9\u05d5\u05e1\u05e3 \u05d7\u05e6\u05e8 \u05de \u05d0\u05dc\u05d9\u05d4 \u05d1\u05e8 \u05e8\u05d1 \u05de\u05e8\u05d3\u05db\u05d9 \u05e0\u05e2 \u0627\u0644\u0649 \u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u0648\u0642\u0627\u0644 \u0643\u0627\u0646 \u05de\u05d3 \u05d9\u05d0\u05d9\u05e8 \u05d4\u05e9\u05d5\u05e4\u05d8 \u05d6\u05db \u05dc\u05d1 \u0642\u062f \u0642\u0627\u0644 \u0644\u064a \u0645\u0646\u062f \u0639\u0634\u06