        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<ol>\n<li><span lang=\"he\">\u05db\u05ea\u05d0\u05d1\u05d9 \u05d0\u05dc\u05d9\u05da \u05d9\u05d0\u05e9\u05d9\u05db\u05d9 \u05d5\u05e8\u05d9\u05d9\u05e1\u05d9 \u05d5\u05d2\u05dc\u05d9\u05dc\u05d9 \u05d5\u05db\u05d1\u05d9\u05e8\u05d9 \u05d0\u05d8\u05d0&lt;\u05dc&gt; \u05d0\u05dc\u05dc\u05d4 \u05d1\u05e7\u05d0\u05da \u05d5\u05d0\u05d3\u05d0\u05dd \u05d2\u05e2\u05de\u05d0\u05da</span></li>\n<li><span lang=\"he\">\u05d5\u05ea\u05d5\u05dc\u05d0\u05da \u05d5\u05e8\u05e2\u05d0\u05da \u05d5\u05de\u05df \u05ea\u05d5\u05e4\u05d9\u05e7\u05d4 \u05dc\u05d0 \u05d0\u05db\u05dc\u05d0\u05da \u05e2\u05df \u05e1\u05dc\u05d0\u05de\u05d4 \u05d5\u05e9\u05d2\u05dc \u05e4\u05d9 \u05d0\u05dc\u05e7\u05dc\u05d1 \u05de\u05de\u05d0</span></li>\n<li><span lang=\"he\">\u05d5\u05e8\u05d3 \u05e2\u05dc\u05d9 \u05e7\u05dc\u05d1\u05d9 \u05de\u05df \u05e1\u05d0\u05e2\u05ea \u05d0\u05df \u05d5\u05e7\u05e4\u05ea \u05e2\u05dc\u05d9 \u05db\u05ea\u05d0\u05d1\u05da \u05d5\u05de\u05d0 \u05db\u05d0\u05df \u05e2\u05e0\u05d3\u05d9 \u05d0\u05dc\u05d0 \u05d0[\u05e8\u05d0]</span></li>\n<li><span lang=\"he\">\u05e2\u05e0\u05d3\u05da \u05d0\u05d2\u05dc \u05de\u05df \u05d4\u05d0\u05d3\u05d0 \u05d0\u05dc\u05d3\u05d9 \u05db\u05d0\u05ea\u05d1\u05ea\u05e0\u05d9 \u05d1\u05d4 \u05e1\u05de\u05e2\u05ea \u05e2\u05e0\u05d9 \u05db\u05dc\u05d0\u05dd \u05d0\u05dc\u05e1\u05d5\u05d9 \u05de\u05ea\u05dc</span></li>\n<li><span lang=\"he\">\u05d9\u05d5\u05e1\u05e3 \u05d5\u05d2\u05d9\u05e8\u05d4 \u05de\u05de\u05df \u05d1\u05dc\u05d2 \u05d0\u05dc\u05e7\u05d1\u05d9\u05d7 \u05d5\u05d0\u05e9\u05d2\u05dc \u05e7\u05dc\u05d1\u05da \u05d5\u05de\u05d0 \u05db\u05d0\u05df \u05e2\u05e0\u05d3\u05d9 \u05d0\u05df \u05ea\u05e7\u05d1\u05dc \u05db\u05dc\u05d0\u05dd</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05d2\u05d9\u05e8 \u05dc\u05d0\u05e0\u05da \u05ea\u05e2\u05dc\u05dd \u05d7\u05d0\u05dc\u05d9 \u05e7\u05d3\u05d9\u05dd \u05d5\u05d7\u05d3\u05d9\u05ea \u05d5\u05ea\u05e2\u05e8\u05e3 \u05d0\u05e6\u05dc\u05d9 \u05d5\u05de\u05d0 \u05d0\u05e0\u05d0 \u05de\u05de\u05df \u05d9\u05d2\u05e8\u05d9</span></li>\n<li><span lang=\"he\">\u05de\u05e0\u05d9 \u05de\u05d0 \u05d9\u05d5\u05d2\u05d1 \u05db\u05ea\u05d0\u05d1\u05da \u05d5\u05d0\u05de\u05d0 \u05e9\u05e8\u05d0 \u05d0\u05dc\u05e4\u05d5\u05d0\u05ea \u05e4\u05e7\u05d3 \u05d0\u05e9\u05ea\u05e8\u05d9\u05ea \u05de\u05e0\u05d4\u05d0 \u05e4\u05d9 \u05d8\u05d5\u05dc</span></li>\n<li><span lang=\"he\">\u05d4\u05d0\u05d3\u05d9 \u05d0\u05dc\u05de\u05d3\u05d4 \u05e0\u05d9\u05e3 \u05d5\u05ea\u05dc\u05ea\u05d9\u05df \u05e4\u05d5\u05d0 \u05d5\u05de\u05d0 \u05d4\u05d9 \u05e9\u05d9 \u05d0\u05df \u05ea\u05db\u05ea\u05dc\u05d8 \u05de\u05e2 \u05db\u05ea\u05d0\u05e0\u05da \u05d5\u05dc\u05da</span></li>\n<li><span lang=\"he\">\u05d7\u05e6\u05dc\u05ea \u05de\u05e0\u05d4\u05d0 \u05e4\u05d5\u05d0 \u05e4\u05d9 \u05d2\u05de\u05dc\u05d4 \u05d0\u05e2\u05d3\u05d0\u05dc \u05dc\u05de\u05d0 \u05d0\u05db\u05ea\u05dc\u05d8\u05ea \u05d5\u05de\u05e2 \u05d4\u05d0\u05d3'\u05d0 \u05dc\u05d5 \u05e2\u05dc\u05de\u05ea</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05df \u05d9\u05e7\u05e2 \u05e4\u05d9 \u05e7\u05dc\u05d1\u05df \u05de\u05df \u05d3\u05d0\u05dc\u05da \u05d0\u05de\u05e8 \u05dc\u05de\u05d0 \u05d0\u05e9\u05ea\u05e8\u05d9\u05ea\u05d4\u05d0 \u05d5\u05dc\u05d0 \u05d2\u05d5\u05d6\u05ea \u05d1\u05d4\u05d0 \u05de\u05df \u05de\u05d0\u05dc\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05db\u05e1\u05e8 \u05e7\u05dc\u05d9\u05dc \u05e0\u05e9\u05ea\u05e8\u05d9 \u05d1\u05d4 \u05e4\u05d5\u05d0 \u05d5\u05e4\u05d5\u05d0 \u05ea\u05e7\u05e2 \u05e6\u05d0\u05dc\u05d7\u05d4 \u05d0\u05dc\u05d0 \u05d5\u05e7\u05ea \u05e4\u05e8\u05d5\u05d2 \u05e4\u05d0\u05d3\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05dc\u05dd \u05ea\u05db\u05ea\u05d0\u05e8 \u05d3\u05d0\u05dc\u05da \u05d0\u05e0\u05d0 \u05e0\u05e7\u05d8\u05e2 \u05e9\u05e8\u05d0\u05d4\u05d0 \u05d1\u05d0\u05dc\u05db\u05d5\u05dc\u05d9\u05d0 \u05e4\u05ea\u05e2\u05dc\u05dd \u05d3'\u05d0\u05dc\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d0\u05de\u05d0 \u05de\u05d0 \u05d3'\u05db\u05e8\u05ea\u05d4 \u05de\u05df \u05d0\u05db\u05e8\u05d0\u05d2 \u05d0\u05dc\u05d7\u05e1\u05d0\u05d1 \u05d5\u05ea\u05d5\u05d2\u05d9\u05d4\u05d5 \u05d0\u05dc\u05d9\u05da \u05dc\u05ea\u05e2\u05dc\u05dd \u05e4\u05d0\u05e9 \u05db\u05e8\u05d2\u05ea</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05d3\u05e0\u05d0\u05e0\u05d9\u05e8 \u05e1\u05d0\u05e2\u05ea \u05d0\u05df \u05d5\u05e7\u05e4\u05ea \u05e2\u05dc\u05d9 \u05db\u05ea\u05d0\u05d1\u05da \u05d0\u05db\u05e8\u05d2\u05ea \u05d0\u05dc\u05d7\u05e1\u05d0\u05d1 \u05d5\u05d2\u05d4\u05ea \u05d0\u05dc\u05d9\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05e0\u05e1\u05db\u05ea\u05d4 \u05ea\u05e7\u05e3 \u05e2\u05dc\u05d9 [\u05e6]\u05d7\u05ea\u05d4 \u05d0\u05df \u05e9\u05d0 \u05d0\u05dc\u05dc\u05d4 \u05d5\u05d4\u05d5 \u05de\u05e2 \u05d3\u05e8\u05d2 \u05db\u05ea\u05d0\u05d1\u05d9 \u05d4\u05d0\u05d3'\u05d0 \u05de\u05e2 \u05d0\u05dc</span></li>\n<li><span lang=\"he\">&nbsp;\u05e6\u05d1\u05d9 \u05d9\u05e2\u05e7\u05d1 \u05ea\u05dd \u05d3'\u05db\u05e8\u05ea \u05d0\u05df \u05dc\u05d0 \u05ea\u05d5\u05d2\u05d4 \u05e0\u05e4\u05e7\u05d4 \u05d0\u05dc\u05d0 \u05d0\u05df \u05d9\u05e6\u05dc \u05d0\u05dc\u05d9\u05da \u05d0\u05dc\u05d7\u05e1\u05d0\u05d1</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05de\u05d0 \u05d1\u05e7\u05d9 \u05de\u05e2\u05d9 \u05e4\u05d9 \u05d9\u05d5\u05de\u05d9 \u05d4\u05d0\u05d3\u05d0 \u05e1\u05d5\u05d0 \u05d6 \u05d3\u05d2\u05d0\u05e0\u05d9\u05e8 \u05e8\u05d1\u05d0\u05e2\u05d9\u05d0 \u05d1\u05e2\u05e6\u05d4\u05d0 \u05e0\u05d0\u05e7\u05e6'\u05d0 \u05d5\u05d0\u05db\u05e8\u05d2\u05ea</span></li>\n<li><span lang=\"he\">&nbsp;\u05de\u05df \u05e2\u05e0\u05d3\u05d9 \u05d7' \u05d3\u05e0\u05d0\u05e0\u05d9\u05e8 \u05e2\u05d9\u05df \u05d3\u05e4\u05e2\u05ea\u05d4\u05d0 \u05dc\u05dc\u05d0\u05d5\u05d2\u05e8\u05d0 \u05e2\u05e8\u05e4\u05ea\u05da \u05d3'\u05d0\u05dc\u05da \u05d5\u05de\u05d0 \u05db\u05dc\u05d0\u05ea\u05e0\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05e0\u05e4\u05e1\u05d9 \u05d0\u05df \u05e0\u05db\u05ea\u05d1 \u05d0\u05dc\u05d9\u05da \u05d1\u05dc\u05d0 \u05e8\u05e1\u05d5\u05dc \u05dc\u05d0\u05df \u05d9\u05d8\u05d5\u05dc \u05ea\u05d0\u05db\u05e8 \u05d0\u05dc\u05e0\u05e4\u05e7\u05d4 \u05e2\u05e0\u05d9 \u05de\u05df \u05e2\u05e0\u05d3\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05e4\u05e8\u05d0\u05d9\u05ea \u05d0\u05df \u05e0\u05d5\u05d2\u05d4 \u05d0\u05dc\u05e6\u05d1\u05d9 \u05d9\u05e2\u05e7\u05d1 \u05d0\u05dc\u05d9\u05da \u05d9\u05d7\u05d5\u05ea\u05da \u05e4\u05d9 \u05ea\u05d5\u05d2\u05d9\u05d4 \u05d0\u05dc\u05db\u05e1\u05e8 \u05dc\u05d0 \u05d9\u05e0\u05e4\u05e1\u05d3</span></li>\n<li><span lang=\"he\">&nbsp;\u05e2\u05dc\u05d9 \u05d2\u05de\u05d9\u05e2 \u05de\u05d0 \u05e2\u05de\u05dc\u05ea\u05d4 \u05d5\u05d9\u05d2\u05d9 \u05d0\u05dc\u05d0\u05d2\u05d9\u05e8 \u05d9\u05d8\u05dc\u05d1 \u05de\u05e0\u05d9 \u05d3\u05d9\u05df \u05de\u05d0 \u05d9\u05d2\u05d3\u05d4 \u05e2\u05e0\u05d3\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05d9\u05de\u05d5\u05e8 \u05e2\u05e0\u05d3 \u05d2\u05d9\u05e8\u05d9 \u05d5\u05d9\u05e0\u05e4\u05e1\u05d3 \u05e2\u05dc\u05d9 \u05d0\u05dc\u05d0\u05de\u05e8 \u05d5\u05d4\u05d0\u05d3\u05d9 \u05e1\u05e0\u05d4 \u05de\u05d0 \u05d4\u05d9 \u05de\u05ea\u05dc \u05db\u05dc \u05e1\u05e0\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05d0\u05d2\u05d9\u05e8 \u05e2\u05d6\u05d9\u05df \u05d5\u05d1\u05dc\u05d2\u05e0\u05d9 \u05d0\u05df \u05d0\u05dc\u05e0\u05e4\u05e5' \u05d1\u05d1\u05d5\u05e6\u05d9\u05e8 \u05d3\u05d9\u05e0\u05e8\u05d9\u05df \u05d0\u05dc\u05e7' \u05e4\u05d5\u05d0 \u05d5\u05de\u05d0 \u05d9\u05d7\u05e6\u05dc</span></li>\n<li><span lang=\"he\">&nbsp;[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05d9\u05e8\u05d0\u05d4 \u05d0\u05e0\u05d4 \u05d9\u05e2\u05de\u05dc \u05e2\u05e0\u05d3\u05d4 \u05d0\u05dc\u05d0 \u05d1\u05d0\u05d8\u05dc \u05d5\u05de\u05d0 \u05d9\u05d0\u05de\u05df \u05d1\u05d4 \u05dc\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05d9\u05e4\u05e1\u05d3\u05d4 \u05d0\u05dc\u05d2\u05d9\u05d9\u05e8 \u05d8'\u05dc\u05d5\u05dd \u05d0\u05e2\u05e8\u05e4\u05ea\u05da \u05d3'\u05d0\u05dc\u05da \u05d5\u05d1\u05d0\u05dc\u05dc\u05d4 \u05d9\u05d0\u05e9\u05d9\u05db\u05d9 \u05d0\u05df \u05d0\u05dc\u05db\u05ea\u05d0\u05d1 \u05d1\u05d9\u05d3\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d0\u05e0\u05d0 \u05e0\u05db\u05ea\u05d1 \u05e4\u05d9\u05d4 \u05d5\u05de\u05d0 \u05e0\u05d8\u05d5\u05dc \u05dc\u05e8\u05d5\u05d7\u05d9 \u05de\u05de\u05d0 \u05d0\u05e9\u05d2\u05dc \u05e7\u05dc\u05d1\u05d9 \u05db\u05ea\u05d0\u05d1\u05da \u05de\u05df \u05d2\u05d9\u05e8 \u05e1\u05d1\u05d1</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05de\u05e2 \u05d4\u05d0\u05d3'\u05d4 \u05d0\u05dc\u05dc\u05d4 \u05d9\u05e2\u05dc\u05dd \u05d0\u05dc\u05dc[ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05d5\u05db\u05d9\u05e3 \u05d0\u05e0\u05d0 \u05dc\u05da \u05d5\u05d7\u05d5\u05d8\u05ea\u05d9 \u05d5\u05d0\u05d7\u05ea\u05e8\u05d0\u05d6\u05d9 \u05e2\u05dc\u05d9 \u05de\u05d0\u05dc\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05de\u05d0 \u05d4\u05d5 \u05e9\u05d9 \u05d0\u05df \u05d9\u05ea\u05e9\u05e2\u05e8\u05d4 \u05d4\u05d0\u05d3\u05d0 \u05e2\u05dc\u05d9 \u05e4\u05e8\u05e5' \u05d5\u05de\u05d0 \u05ea\u05d5\u05d2'\u05d1 \u05d0\u05dc[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05e1\u05dc\u05dd</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05d0\u05e0\u05e1\u05d0\u05df \u05de\u05d0\u05dc\u05d4 \u05dc\u05e6\u05d0\u05d7\u05d1\u05d4 \u05d9\u05e2\u05de\u05dc \u05e4\u05d9\u05d4 \u05d7\u05e1\u05d1 \u05de\u05d0 [ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05d5\u05d0\u05e0\u05d0 \u05d5\u05d4\u05d5&nbsp;</span></li>\n<li><span lang=\"he\">&nbsp;\u05e2\u05d0\u05dc\u05dd \u05de\u05d0 \u05e2\u05d0\u05de\u05dc\u05ea\u05d4 \u05e4\u05d9 \u05de\u05d0\u05dc\u05d4 \u05d4\u05d5 \u05d0\u05d8\u05dc\u05e2 \u05e2\u05dc\u05d9 [ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05de\u05d0 \u05e0\u05e9\u05e8\u05d7 \u05d0\u05db\u05ea\u05e8</span></li>\n<li><span lang=\"he\">&nbsp;\u05de\u05df \u05d4\u05d0\u05d3'\u05d0 \u05d5\u05e7\u05d3 \u05d5\u05e6\u05dc\u05ea \u05d0\u05dc\u05e7\u05e4\u05dc\u05d9\u05df \u05d5\u05d0\u05dc\u05d1\u05e8\u05e0\u05d9\u05d0 \u05d0\u05dc\u05dc\u05d4 [ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05d5\u05d0\u05e0\u05d0 \u05d0\u05e1\u05d0\u05dc \u05de\u05d5\u05dc\u05d0\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05df \u05d9\u05d5\u05d2\u05d4 \u05d0\u05dc\u05d9 \u05e8\u05d8\u05dc \u05ea\u05de\u05e8 \u05d4\u05e0\u05d3\u05d9 \u05d5\u05e8\u05d8\u05dc\u05d9\u05df \u05e2\u05e0\u05d0\u05d1 \u05d5\u05e8\u05d8\u05dc [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05e7\u05d3\u05d7 \u05e1\u05d1\u05e1\u05ea\u05d0\u05df \u05d0\u05dc\u05d3'\u05d9 \u05db\u05d0\u05df \u05de\u05e2\u05d9&nbsp;</span></li>\n<li><span lang=\"he\">&nbsp;\u05ea\u05dc\u05e4\u05d4</span></li>\n</ol>",
