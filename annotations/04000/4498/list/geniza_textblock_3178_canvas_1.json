      "body": [
        {
          "type": "TextualBody",
          "label": "Right Margin",
          "value": "\n<ol><li>\u0648\u0642\u062f \u0643\u0646\u062a \u0628\u0639\u062a \u0644\u0645\u0648\u0644\u0627\u064a \u0642\u0633\u064a\u0645 \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0646 \u0627\u0639\u062f\u0627\u0644 \u0639\u062f\u0644 \u0645\u0646\u0647\u0627 \u05d4 \u0648\u0631\u0628\u0639 \u0646\u0639\u062f\u0644\u064a\u0646 \u05d4</li>\n\n<p>\u0648\u0648\u0642\u064a\u0629 \u0628\u0634\u0631\u0637 \u0627\u0646 \u0627\u0644\u0639\u0634\u0631\u0629 \u05d8 \u0633\u0645\u0627\u062d\u0629 \u062b\u0644\u062a\u064a \u062f\u0646</p>\n\n<li>\u0628\u0646\u0642\u062f \u0646\u0635\u0641\u064a\u0646 \u0648\u0628\u0639\u062b \u0639\u062f\u0644\u0627\u0646 \u0627\u062e\u0631 \u0634\u0639\u0631 \u0633\u062a\u0629 \u0648\u0627\u0648\u0642\u064a\u0629 \u0628\u0646\u0642\u062f \u0627\u0646 \u063a\u064a\u0631 \u0644\u0644\u0640\u05de\u05db\u05e1 \u0648\u0647\u0648 \u062e\u064a\u0631</li>\n\n<p>\u0645\u0646 \u0628\u064a\u0639 \u05d4</p>\n\n<li>\u0639\u062f\u0644 \u0627\u0646 \u0627\u062e\u0631 \u0628\u0645\u0639\u0627\u0645\u0644\u0647 \u05d4 \u0648\u0648\u0642\u064a\u0647 \u0643\u0627\u0646 \u0639\u062f\u0644 \u0627\u0646 \u0644\u0637\u064a\u0641 \u0641\u062a\u062d\u062a\u0647 \u0641\u064a \u0627\u0644\u062d\u0644\u0642\u0629 \u0648\u0643\u0627\u0646 \u0641\u064a\u0647</li></ol>\n\n<p>\u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0646 \u0648\u062d\u0634</p>",
