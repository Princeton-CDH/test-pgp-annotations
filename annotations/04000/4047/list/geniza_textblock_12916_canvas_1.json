      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u062d\u0636\u0631\u0629</li>\n<li>\u0630 \u0628\u0631</li>\n<li>\u05d4 \u0627\u0644\u0645\u062d\u0628</li>\n<li>\u05d9\u05e2\u05e7\u05d5\u05d1 \u0648\u0641\u0642\u0629</li>\n<li>\u062a\u0639 \u0648\u064a\u0646\u0647\u064a \u0627\u0646</li>\n<li>\u062a \u0642\u062f \u0628\u0644\u063a\u0646\u064a \u0627\u0646\u0643</li>\n<li>\u0637\u0644\u0628\u062a \u062a\u062c\u064a \u0627\u0644\u064a\u0646\u0627</li>\n<li>\u0648\u0627\u0646\u062a \u0627\u0646\u0627 \u0627\u0637\u0644\u0628</li>\n<li>\u0627\u062c\u064a \u0627\u0644\u0649 \u062f\u0645\u064a\u0627\u0637 \u0644\u0645\u0646</li>\n<li>\u0633\u0645\u0639\u062a \u0627\u0646\u0643 \u063a\u0627\u064a\u0629</li>\n<li>\u0628\u0637\u0644\u062a \u0648\u0627\u0644\u0627\u0646 \u0642\u062f \u062c\u0628</li>\n<li>\u0644\u0643 \u0648\u0627\u062d\u062f \u0645\u0646 \u0645\u0646\u064a\u0629</li>\n<li>\u062f\u0631\u0643\u0633\u0648\u0633 \u0627\u0633\u0645\u0647 \u0628\u062f\u0631</li>\n<li>\u0627\u062f\u064a\u0646 \u0648\u0645\u0639\u0647 \u05d9\u05d5 \u0631\u0637\u0644</li>\n<li>\u0646\u064a\u0644 \u0641\u0647\u0648 \u062c\u062f\u062f \u0648\u0643\u0646\u0627</li>\n<li>\u0642\u062f \u0627\u0639\u0637\u064a\u0646\u0627\u0647\u0645 \u0641\u064a\u0647</li>\n<li>\u05e7\u05e1 \u0646\u0642\u0631\u0629 \u0627\u0644\u0642\u0646\u0638\u0627\u0631</li>\n<li>\u0648\u0645\u0627 \u062c\u0627\u0628\u0648\u0629 \u0627\u0644\u0627 \u0639\u0646\u062f\u0643</li>\n<li>\u0627\u0644\u0627 \u062d\u062a\u0649 \u062a\u0628\u0644\u063a\u0647</li>\n<li>\u0627\u0643\u062b\u0631 \u0627\u0644\u0644\u0647 \u0627\u0644\u0644\u0647</li>\n<li>\u0644\u0627 \u062a\u0632\u064a\u062f\u0647\u0645 \u0639\u0644\u064a\u0647 \u0641\u064a</li>\n<li>\u0627\u0643\u062b\u0631 \u0627\u0644\u0627 \u0645\u0627</li>\n<li>\u062a\u0646\u0642\u0635\u0647\u0645 \u0645\u0646 \u0643\u0644 \u0628\u062f</li></ol>\n",
          "format": "text/html"
        }
