          "value": "<p>\u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u0633\u062a\u0642\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0627\u0644\u0640\u05d7\u05ea\u05df \u0644\u0632\u0648\u062c\u062a\u0647 \u0633\u062a \u0627\u0644\u0646\u0635\u0631 \u05d1\u05ea \u05e0\u05ea\u05e0\u05d0\u05dc \u05d4\u05db\u05d4\u05df \u0627\u0646\u0647 \u0644\u0627 \u064a\u0628\u062f\u0644 \u0639\u0644\u064a\u0647\u0627 \u0634\u064a \u0645\u0646 \u0627\u0644\u0627\u0639\u064a\u0627\u062f \u0648\u0627\u0644 \u0645\u0648\u0643\u0627\u0626\u0644 \u0648\u0644\u0627 \u064a\u062f\u062e\u0644 \u062f\u0627\u0631\u0629 \u0634\u064a \u0645\u0645\u0627 \u064a\u062d\u0631\u0645\u0648\u0647 \u0637\u0627\u0626\u0641\u0629 \u0627\u0644\u0631\u0628\u0627\u0646\u064a\u0646 \u0648\u0627\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0642\u062f\u0645 \u0645\u062b\u0646\u0629 \u0648\u0627\u0646\u0647 \u0644\u0627 \u064a\u062a\u0632\u0648\u062c \u0639\u0644\u064a\u0647\u0627 \u0648\u0644\u0627 \u064a\u0628\u0642\u0649 \u063a\u0627\u0631\u064a\u0629 \u062a\u0643\u0631\u0647\u0647\u0627 \u0648\u0645\u062a\u0649 \u0641\u0639\u0644 \u0634\u064a \u0645\u0646 \u0630\u0644\u0643 \u0643\u0627\u0646 \u0639\u0644\u064a\u0647 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0645\u0648\u0643\u0631\u0647\u0627 \u0648\u0627\u0637\u0644\u0627\u0642 \u0648\u0627\u0644\u0646\u0627\u0645\u0646\u0648\u062a \u05d1\u05de\u05d0\u05db\u05dc \u05d5\u05de\u05e9\u05e7\u05d4 \u05d5\u05d8\u05e2\u05d5\u05ea \u05e9\u05de\u05d0 \u0648\u0627\u0646 \u064a\u0643\u0648\u0646 \u0633\u0631\u0646\u0647\u0627 \u0645\u0639 \u0648\u0627\u0644\u0630\u0629 \u0627\u0644\u0640\u05d7\u05ea\u05df \u0645\u0647\u0645\u0627 \u0647\u064a \u0637\u064a\u064a\u0628\u0629 \u0627\u0644\u0639\u064a\u0634 \u0648\u0627\u0646\u0647 \u0644\u0627 \u064a\u063a\u0644\u0642 \u0639\u0644\u064a\u0647\u0627 \u0628\u0627\u0628 \u0648\u0627\u0646\u0647 \u0644\u0627 \u064a\u0645\u0646\u0639\u0627\u0629 \u0632\u064a\u0627\u0631\u0629 \u0627\u0647\u0644\u0647\u0627 \u0648\u0627\u0646\u0647 \u0644\u0627 \u064a\u0628\u062f\u0644 \u0627\u0639\u064a\u0627\u062f \u0627\u0644\u0631\u0628\u0627\u0646\u064a\u0646 \u0648\u0643\u0627\u0646 \u0630\u0644\u0643 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0629 \u0627\u0644\u0627\u0631\u0628\u0639\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u0645\u0646 \u05e1\u05d9\u05d5\u05df \u0627\u062a\u0633\u062f \u0633 \u05e1\u05e2\u05d3\u05d9\u05d4 \u05d1\u05e8 \u05d0\u05d1\u05e8\u05d4\u05dd \u05e0\u05e2 \u05d9\u05d7\u05d6\u05e7\u05d0\u05dc \u05d1\u05e8 \u05e0\u05ea\u05df \u0646\u0628\u062a\u0648\u064a\u0627 \u0648\u0627\u0642\u0646\u064a \u0645\u0646 \u0627\u0644\u0634 \u05d0\u05d1\u05dc \u0633\u0639\u064a\u062f \u05e7\u05e0\u05d9\u05df \u05e9\u05dc\u05dd \u05d5\u05d1\u05d1\u05e8\u05d9\u05ea \u05d9\u05d3 \u05dc\u05d9\u05d3 \u05d5\u05d0\u05de\u05d5\u05e0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u0648\u0627\u0646\u0647 \u0644\u0627 \u064a\u062d\u0644\u0641 \u0639\u0644\u064a\u0647\u0627 \u064a\u0645\u064a\u0646 \u0644\u0627 \u062a\u0633\u0648\u062c \u0641\u064a \u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u0633\u062a\u0642\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0627\u0644\u0640\u05d7\u05ea\u05df \u0644\u0632\u0648\u062c\u062a\u0647 \u0633\u062a \u0627\u0644\u0646\u0635\u0631 \u05d1\u05ea \u05e0\u05ea\u05e0\u05d0\u05dc \u05d4\u05db\u05d4\u05df \u0627\u0646\u0647 \u0644\u0627 \u064a\u0628\u062f\u0644 \u0639\u0644\u064a\u0647\u0627 \u0634\u064a \u0645\u0646 \u0627\u0644\u0627\u0639\u064a\u0627\u062f \u0648\u0627\u0644 \u0645\u0648\u0627\u062e\u064a\u0644 \u0648\u0644\u0627 \u064a\u062f\u062e\u0644 \u062f\u0627\u0631\u0629 \u0634\u064a \u0645\u0645\u0627 \u064a\u062d\u0631\u0645\u0648\u0647 \u0637\u0627\u0626\u0641\u0629 \u0627\u0644\u0631\u0628\u0627\u0646\u064a\u0646 \u0648\u0627\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0642\u062f\u0645 \u0645\u062b\u0646\