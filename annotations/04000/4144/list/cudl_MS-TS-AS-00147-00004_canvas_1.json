          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u0644\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645</li>\n<li>\u0646\u0639\u0645\u0627\u0647 \u0648\u0645\u0646 \u062a\u0648\u0641\u064a\u0642\u0647 \u0644\u0627 \u0627\u0643\u0644\u0627\u0647 \u062a\u0642\u062f\u0645 \u0644\u064a \u0643\u062a\u0627\u0628\u0643</li>\n<li>\u0646\u0633\u0643\u062a\u064a\u0646 \u0630\u0643\u0631\u062a \u0641\u064a\u0647 \u0627\u0646\u0646\u064a \u0645\u0627 \u0643\u062a\u0628\u062a \u0644\u0643 \u0627\u0634 \u0635\u062d \u0644\u0643</li>\n<li>\u0648\u0627\u0634 \u0628\u0639\u062a\u0629 \u0644\u0643 \u0648\u0642\u0644\u062a \u0641\u064a \u0628\u0639\u0636 \u0643\u0644\u0627\u0645\u0643 \u0644\u0627 \u062a\u062d\u0648\u062c\u0646\u064a \u0644\u0644\u0640\u05de\u05d2\u05d9</li>\n<li>\u0648\u0644\u0627 \u0644\u0648\u062e\u064a\u0644 \u0648\u062d\u0627\u0634\u064a \u0627\u0646\u064a \u064a\u0627 \u0633\u064a\u062f\u064a \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0649 \u0627\u0644\u064a\u0648\u0645 \u0645\u0646</li>\n<li>\u0648\u0642\u062a \u0627\u0646\u062a \u0635\u0628\u062a \u0644\u0644\u062e\u0644\u0637\u0629 \u0645\u0639 \u0627\u0644\u0646\u0627\u0633 \u0627\u0646\u064a\u0641 \u0648\u0633\u062a\u064a\u0646 \u0633\u0646\u0629</li>\n<li>\u0645\u0627 \u0646\u0639\u0644\u0645 \u0627\u0646 \u0648\u0643\u0644 \u0639\u0644\u0649 \u0627\u062d\u062f\u0627 \u0648\u0643\u0627\u0644\u0647 \u0648\u0644\u0627 \u0642\u062f\u0645\u0646\u064a \u0644\u062f\u064a\u0627\u0646</li>\n<li>\u0648\u0644\u0627 \u0644\u0627\u062d\u062f \u0639\u0646\u062f\u064a \u0643\u0631\u0648\u0628\u0629 \u0641\u0636\u0629 \u0648\u0644\u0627 \u062f\u0642\u0629 \u0648\u0627\u0646\u062a \u062a\u0639\u0644\u0645</li>\n<li>\u062f\u0648\u0646 \u0627\u0644\u0646\u0627\u0633 \u0627\u0646 \u0643\u0627\u0646 \u064a\u0635\u0644\u0646\u064a \u0643\u0644 \u0633\u0646\u0629 \u0645\u0646 \u0627\u0644\u0634\u0627\u0645 \u0648\u0645\u0646 \u0645\u0635\u0631</li>\n<li>\u0646\u062d\u0648 \u0627\u0644\u0649 \u0627\u0644\u0627\u0641 \u062f\u064a\u0646\u0631 \u0641\u0639\u0631\u0641\u0646\u064a \u0645\u0646 \u0633\u0645\u0639\u062a \u0645\u0646 \u0627\u0644\u0646\u0627\u0633</li>\n<li>\u064a\u0642\u0648\u0644 \u0628\u0642\u064a \u0644\u064a \u0639\u0646\u062f\u0647 \u0642\u064a\u0631\u0637 \u0630\u0647\u0628 \u0648\u0647\u0630\u0647 \u0645\u0627 \u0627\u0642\u0648\u0644\u0647</li>\n<li>\u0627\u062f\u0639\u0627 \u0627\u0644\u0627 \u0645\u0639\u0631\u0648\u0641 \u0639\u0646\u0649 \u0648\u0627\u0646\u0627 \u0635\u0628\u064a \u0645\u0627 \u0627\u0644\u062a\u062d\u064a\u062b \u0648\u0647\u0630\u0627</li>\n<li>\u0634\u0631\u062d \u0645\u0627 \u0627\u0644\u0630\u064a \u0628\u0639\u062a\u0647 \u0644\u0643 \u0648\u062d\u0642 \u0645\u0627 \u0627\u0639\u062a\u0642\u062f\u0647 \u0627\u0646 \u0644\u0648\u0642\u062a\u0649</li>\n<li>\u0647\u0630\u0627 \u0645\u0627 \u0627\u062e\u0630\u062a \u0645\u0646 \u0627\u0644\u0644\u063a\u064a \u0644\u0627 \u062f\u064a\u0646\u0631 \u0648\u0644\u0627 \u062f\u0631\u0647\u0645 \u0644\u0627\u0646 \u0627\u0644\u0628</li>\n<li>\u0648\u0627\u0644\u0634\u0647\u0648\u062f \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u0644\u064a \u0639\u0644\u064a\u0647 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u062a\u0648\u0641\u064a\u0648 \u0644\u0643 \u0637\u0648\u0644 \u0627\u0644\u0628\u0642\u0627</li>\n<li>\u0648\u0645\u0639 \u0647\u0630\u0627 \u0627\u0638\u0646 \u0645\u0627 \u064a\u0636\u064a\u0639 \u0644\u064a \u0634\u064a \u0627\u0633\u062a\u0639\u0646\u062a \u0639\u0644\u064a\u0647 \u0628\u0643\u062a\u0627\u0628</li>\n<li>\u0628\u064a\u062a \u0627\u0644\u0645\u0627\u0644 \u064a\u0642\u0648\u0644 \u0644\u0647\u0645 \u0646\u0639\u0645 \u0644\u0647 \u0642\u0628\u0644\u064a \u0648\u0639\u0646\u062f\u064a \u0648\u0643\u0645 \u05d9 \u05d0</li>\n<li>\u0645\u0633\u0644\u0645\u064a\u0646 \u064a\u0643\u0641\u064a \u0645\u0646\u0647\u0645 \u064a\u062e\u0634\u0627 \u0627\u0646 \u064a\u0634\u0647\u062f\u0648 \u0639\u0644\u064a\u0647 \u064a\u0642\u0648\u0644 \u0644\u0647\u0645</li>\n<li>\u0627\u0646 \u0643\u0627\u0646 \u0644\u0647 \u0639\u0646\u062f\u064a \u0634\u064a \u064a\u0635\u0644 \u0627\u0644\u0649 \u0647\u0630\u0647 \u0627\u0646\u0627 \u0645\u0627 \u0646\u0641\u0633\u062f\u0643 \u0634\u064a</li>\n<li>\u0648\u0644\u0648\u0644\u0627 \u0627\u0644\u0648\u0642\u062a \u0648\u0635\u0639\u0648\u0628\u062a\u0647 \u0648\u0645\u0627 \u062c\u0631\u0649 \u0639\u0644\u064a\u0646\u0627 \u0641\u064a \u0645\u0627 \u0645\u0636\u0627 \u0648\u0627\u0644\u0627</li>\n<li>\u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0648\u062c\u0647 \u0644\u0643 \u0627\u0644\u0627 \u0645\u0646 \u0645\u0627\u0644\u0649 \u0648\u0630\u0643\u0631\u062a \u0644\u0643 \u0627\u0646 \u0627\u0644\u0628\u0631\u062f\u064a\u0629</li>\n<li>\u0630\u0643\u0631\u062a \u0648\u0627\u0644\u0646\u0635\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0645\u0644\u062d\u0641\u0629 \u0644\u0645 \u0646\u062c\u062f \u0645\u0646\u0647\u0627 \u0634\u064a \u0648\u0633\u0627\u0644\u062a</li>\n<li>\u062a\u0639\u0631\u0641\u0646\u064a \u0647\u0644 \u0631\u062f\u062a\u0647\u0645 \u0627\u0648 \u0644\u0627 \u0641\u0636\u0639\u0628 \u0639\u0644\u064a\u0643 \u062a</li>\n<li>\u0647\u0630\u0647</li>\n<li>\u0641\u0636\u0629 \u0648\u0632\u0646\u0647\u0627 \u05db\u05d7 \u0635\u062d \u0641\u064a\u0647\u0627 \u062f\u064a\u0646\u0631\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u062b\u0645\u0646 \u0648\u062d\u0643\u0631</li>\n<li>\u0648\u0648\u0632\u0646 \u0627\u0644\u062f\u0631\u0627\u0647\u0645 \u0627\u0644\u0648\u0631\u0642 \u05e7\u05de\u05d7 \u0648\u0646\u0635\u0641 \u0627\u0648\u0628\u064a\u0639\u062b \u0633\u0639\u0631 \u0644\u0647</li>\n<li>\u0628\u062f\u064a\u0646\u0631 \u0627\u0644\u062b\u0645\u0646 \u05d3 \u05e0 \u0648\u0631\u0628\u0639 \u0648\u0635\u062d \u0641\u064a \u0646</li>\n<li>\u0628\u0639\u062f \u0627\u0644\u0630\u064a \u0628 \u0627\u0644</li>\n<li>\u0637\u0641\u0644</li>\n<li>\u0648\u0641\u064a \u0643\u0627\u0646</li>\n<li>\u0628\u064a\u0646\u0646\u0627 \u05d2 \u062f\u0646\u0646 \u0648\u0631\u0628\u0639 \u0648\u062b\u0645\u0646 \u0641\u064a \u0644\u0647 \u0634</li>\n<li>\u0648\u0641\u064a \u0627\u0644\u0647\u0644\u064a\u0644\u063a \u062b\u0644\u062b \u062f\u064a\u0646\u0631 \u0641\u064a \u0627\u0644 \u0648\u0627\u0644</li>\n<li></li></ol>\n",
