      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627\u0628\u0648 \u0627\u0644 \u05d1 \u0627\u0648\u0644\u0627\u062f \u0627\u0628\u0648 \u064a\u0639\u0642\u0648\u0628 \u0627\u0645 \u0645\u0648\u0627\u0621 \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u062c\u0627 \u0627\u0644\u0644\u0627\u0644 \u05d0 \u0627\u0644\u0633\u062c\u0648\u0644\u062a \u05d1 \u0628\u0646 \u0627\u0644\u0631\u0628\u0627\u0637 \u05d1 \u0633\u0639\u064a\u062f \u0628 \u0627\u0644\u0634 \u0627\u0628\u0648 \u0627\u0644\u062a\u0629 \u0639\u0644\u064a \u0627\u0644\u0640\u05d7\u05de\u05d3\u05ea \u0627\u0644\u0634 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0627\u0644\u0645\u0633\u062a\u0639\u0645\u0644 \u0633\u0628\u0639 \u0627\u0628\u0648 \u0633\u0647\u0644 \u0627\u0644\u0635\u0628\u0627\u062c \u0627\u0644\u0634 \u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0635\u0628\u0627\u063a \u0627\u0628\u0648 \u0645 \u05d1\u05d5 \u0627\u0628\u0648 \u0627\u0644\u0645\u0643\u0627\u0631\u0645 \u0648\u0634\u0631\u064a\u0643\u0629 \u062b\u0645\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0645 \u0628\u0646 \u062c\u0627\u0632\u0644\u0627\u0644\u064a\u0629 \u0648\u0634\u0631\u064a\u0643\u0629 \u05d2 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0641\u0643\u0631 \u0648\u0634\u0631\u064a\u0643\u0629 \u05d7 \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u064a \u05d2 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0641\u0643\u0631 \u0648\u0634\u0631\u064a\u0643\u0647 \u05d7 \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u064a \u0627\u0644\u0640\u05de\u05d2\u05d9 \u0627\u0644\u0634\u0645\u0627\u0639 \u05d0 \u05d0 \u05d0\u05d1\u05d5 \u0627\u0644\u0648\u0641\u0627 \u05d1\u05df \u05e0\u05e2\u05de\u05d0\u05df \u05d0 \u05d1\u05df \u05e2\u05de\u05d0\u05e8 \u05d2 \u0627\u0628\u0648 \u0633\u0639\u062f \u0627\u0628\u0648 \u0646\u0635\u0631 \u0627\u0644\u0645\u0648\u0631\u062f \u0648\u0627\u0648\u0644\u0627\u062f\u0647 \u0631\u0628\u0627\u0639\u064a \u0645\u062e\u0627\u0631\u0645 \u