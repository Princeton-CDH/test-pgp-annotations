          "value": "<p>\u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u062c\u0644\u064a\u0644 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0647 \u0648\u062a\u0627\u0626\u064a\u062f\u0647 \u0648\u0646\u0639\u0645\u062a\u0647 \u0628\u0639\u062f \u0645\u062f\u0629 \u0637\u0648\u064a\u0644\u0629 \u0630\u0644\u0643 \u0641\u0639\u0646\u062f \u0648\u0635\u0648\u0644 \u0647 \u0648\u0648\u0642\u0641\u062a \u0648\u0633\u0631\u0646\u064a \u0645\u0639\u0631\u0641\u0629 \u062e\u0628\u0631\u0629 \u0648\u0633\u0644\u0627\u0645\u062a\u0647 \u0630\u0643\u0631 \u0645\u0648\u0644\u0627\u064a \u0628\u0627\u0646 \u0627 \u0644\u0647 \u0642\u0646\u0638\u0627\u0631 \u0632\u0628\u064a\u0628 \u0648\u0648\u064a\u0628\u0647 \u0627\u0631\u0632 \u0648\u0648\u064a\u0628\u0647 \u0633\u0645\u0633\u0645 \u0648\u0642\u062f \u0627\u062c \u062a \u064a\u0648\u0645 \u0643\u062a\u0627\u0628\u0649 \u0647\u0630\u0627 \u0627\u0644\u064a\u0647 \u0628\u0627\u0646 \u0627\u062d\u0635\u0644 \u0644\u0647 \u0627\u0644\u0632\u0628\u064a\u0628 \u0648\u064a\u0643\u0648\u0646 \u0635\u062d\u0628\u0647 \u0645\u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0649 \u0647\u0630\u0627 \u0641\u0644\u0645 \u0627\u062c\u062f \u0634\u064a \u064a\u0635\u0644\u062d \u0627\u0644\u0627 \u0645\u0642\u0627\u0631\u0628 \u0641\u0627\u0646\u0627 \u0628\u0645\u0634\u064a\u0629 \u0627\u0644\u0644\u0647 \u0627\u062d\u0631\u0636 \u0641\u064a \u062a\u062d\u0635\u064a\u0644\u0647 \u0648\u064a\u0643\u0648\u0646 \u0635\u062d\u0628\u0647 \u0645\u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0641\u0644\u0645 \u0627\u062c\u062f \u0634\u064a \u064a\u0635\u0644\u062d \u0627\u0644\u0627 \u0645\u0642\u0627\u0631\u0628 \u0641\u0627\u0646\u0627 \u0628\u0645\u0634\u064a\u0629 \u0627\u0644\u0644\u0647 \u0627\u062d\u0631\u0636 \u0641\u064a \u062a\u062d\u0635\u064a\u0644\u0647 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0627\u0633\u0628\u0648\u0639 \u0648\u0627\u0646\