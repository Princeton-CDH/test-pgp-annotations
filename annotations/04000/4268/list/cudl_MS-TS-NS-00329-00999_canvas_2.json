      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol><li>\u0641 \u0641\u064a\u0647</li>\n<li>\u0641\u0627\u0631\u0642\u0629 \u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0648\u0644\u0649 \u0648\u0627\u0644\u0644\u0647</li>\n<li>\u0627\u0644\u0639\u0638\u064a\u0645 \u0645\u0627 \u064a\u062d\u0633\u0646 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0627\u0648 \u064a\u0635\u0641 \u0628\u0639\u062f</li>\n<li>\u0645\u0627 \u064a\u062c\u062f\u0647 \u0645\u0646 \u0627\u0644\u0634\u0648\u0642 \u0648\u0627\u0644\u0648\u062d\u0634\u0629 \u0627\u0644\u0649 \u0645\u0644\u0627\u0632\u0645\u0629</li>\n<li>\u062e\u062f\u0645\u0629 \u0645\u0648\u0644\u0627\u0647 \u0641\u0627\u0644\u0644\u0647 \u062b\u0639 \u064a\u0642\u0631\u0628 \u062c\u0645\u0639 \u0634\u0645\u0644</li>\n<li>\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0628\u062e\u062f\u0645\u0647 \u0645\u0648\u0644\u0627\u0647 \u0648\u0627\u0645\u0627 \u0645\u0627 \u064a\u0631\u064a\u062f</li>\n<li>\u0627\u0644\u0645\u0648\u0644\u0649 \u0639\u0644\u0645\u0647 \u0645\u0646 \u062d\u0627\u0644 \u0645\u0645\u0644\u0648\u0643\u0647 \u0641\u0627\u0646\u0647 \u0642\u0627\u0633\u0649</li>\n<li>\u0634\u062f\u0629 \u0639\u0638\u064a\u0645\u0629 \u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642 \u0645\u0646 \u0645\u0631\u0636 \u0627\u0644\u0631\u0643\u0627\u0628</li>\n<li>\u0648\u0631\u0648\u0627\u0626\u062d \u0627\u0646 \u0643\u0631\u0647\u0629 \u062c\u062f\u0627 \u0648\u0627\u0646\u062a\u0647\u064a \u0628\u0647\u0645 \u0627\u0644\u062d\u0627\u0644</li>\n<li>\u0627\u0644\u0649 \u0627\u0646 \u0645\u0627\u062a \u0645\u0646\u0647\u0645 \u062b\u0644\u062b\u0629 \u0627\u0646\u0641\u0633 \u0648\u0627\u0644\u0645\u064a\u062a</li>\n<li>\u0627\u0644\u0627\u062e\u064a\u0631 \u0627\u0642\u0627\u0645 \u064a\u0648\u0645 \u0648\u0646\u0635\u0641 \u0627\u0644\u0649 \u0627\u0646 \u063a\u0627\u0641 \u0648\u0628\u0642\u0649</li>\n<li>\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0641\u064a \u0634\u062f\u0647 \u0645\u0646 \u0627\u0644\u0631\u0627\u0626\u062d\u0629 \u0627\u0644\u0630\u064a \u0646\u0641\u062d\u0647</li>\n<li>\u0645\u0646\u0647 \u0648\u0642\u0627\u0631\u0628 \u0627\u0644\u0647\u0644\u0627\u0643 \u0641\u0644\u0648\u0644\u0627 \u0627\u0648 \u0627\u0644\u0644\u0647 \u062a\u0639</li>\n<li>\u0644\u0637\u0641 \u0648\u0631\u062d\u0645 \u0628\u0641\u0636\u0644\u0647 \u0648\u0633\u0647\u0644 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0643\u0627\u0646</li>\n<li>\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0627\u0644\u0649 \u0627\u0643\u0645\u064a\u0645 \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629</li>\n<li>\u0645\u0645\u0633\u0649 \u0641\u0637\u0644\u0639 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0627\u0644\u0649 \u0627\u0644\u0628\u0644\u062f \u064a\u0633\u0628\u062a</li>\n<li>\u0641\u064a\u0647 \u0648\u0637\u0644\u0628 \u0645\u0646 \u0627\u0635\u062d\u0627\u0628 \u0644\u0647 \u0627\u0644</li>\n<li>\u0627\u0648 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u062e\u0631\u062c \u064a\u0648\u0645 \u0627\u0644\u0627\u062d\u062f \u0648\u0648\u0632\u0646 \u0639\u0634\u0631\u0629</li>\n<li>\u062f\u0631\u0627\u0647\u0645 \u0648\u0646\u0635\u0641 \u0628\u0639\u062f \u0627\u0646 \u062d\u0644\u0641 \u0627\u0646 \u0645\u0627 \u0645\u0639\u0647</li>\n<li>\u0633\u0648\u0649 \u0642\u0645\u0627\u0634\u0647 \u0648\u0630\u0643\u0631 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0633\u062d\u0627\u0642</li>\n<li>\u0628\u0646 \u0645\u0634\u0631\u0641 \u0627\u0646\u0647 \u0648\u0632\u0646 \u0645\u0643\u0633 \u0627\u0644\u0642\u0645\u0642\u064a\u0646 \u0648\u0642\u0635\u062f</li>\n<li>\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0641\u064a \u0627\u0646 \u064a\u0639\u0644\u0645 \u0645\u0648\u0644\u0627\u0647 \u0628\u0630\u0644\u0643 \u0648\u0627\u0646\u0639\u0627\u0642</li>\n<li>\u0627\u0644\u0645\u0631\u0643\u0628 \u0639\u0644\u0649 \u0627\u0643\u0645\u064a\u0645 \u062e\u0645\u0633\u0629 \u0627\u064a\u0627\u0645 \u062b\u0645</li>\n<li>\u0643\u062a\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0648\u0635\u0644 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0627\u0644\u0649 \u0642\u0648\u0636</li>\n<li>\u0641\u0631\u0627\u0649 \u0645\u0646 \u062a\u0641\u0635\u0644 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0634\u064a\u0626 \u0639\u0638\u064a\u0645 \u0634\u064a\u0626</li>\n<li>\u064a\u0639\u062c\u0632 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0639\u0646 \u0648\u0635\u0641 \u0628\u0639\u0636\u0647 \u0644\u0627\u0646\u0647\u0645</li>\n<li>\u062a\u0641\u0635\u0644\u0648\u0627 \u0648\u0627\u062e\u0630\u0648\u0627 \u0644\u0644\u0645\u0645\u0644\u0648\u0643 \u0637\u0628\u0642\u0629 \u0628\u0645\u063a\u0644\u0642\u0647\u0627</li>\n<li>\u0642\u0628\u0644 \u0648\u0635\u0648\u0644 \u0627\u0644\u0644\u0645\u0645\u0644\u0648\u0643 \u0648\u062a\u0641\u0635\u0644 \u0627\u0644\u0645\u0648\u0644\u0649 \u0627\u0644\u0634\u064a\u0643</li>\n<li>\u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u0645\u0627\u0644\u0643 \u0627\u0644\u062a\u0642\u0629 \u0627\u0628\u0648 \u0627\u0644\u0645\u0641\u0635\u0644 \u05d1\u05df \u05d7\u05e1\u05d5\u05df</li>\n<li>\u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0633\u0639\u0627\u062f\u062a\u0647 \u0648\u0627\u0642\u0627\u0645 \u062c\u0627\u0629</li></ol>\n<p>....</p>",
