      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05d1\u05e9\u05de\u05da \u05e8\u05d7 \u062b\u0628\u062a \u0627\u0644\u0641\u0633\u064a\u0642\u0629 \u0627\u0644\u0645\u0633\u0645\u0631 \u0631\u0628\u0627\u0639\u064a \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u064a\u0646 \u0627\u0644\u0628\u063a\u062f\u0627\u0630\u064a \u0631\u0628\u0627\u0639\u064a \u0628\u0646 \u0627\u0644\u0627\u0646\u062f\u0644\u0633\u064a \u0631\u0628\u0627\u0639\u064a \u05de \u0638\u0627\u0647\u0631 \u0627\u0644\u062d\u0644\u0628\u064a \u0631\u0628\u0627\u0639\u064a \u0633\u0644\u0627\u0645\u0647 \u0628\u0646 \u062d\u0633\u0646 \u0628\u0646 \u0643\u0643 \u05d1 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05df \u05e0\u05d7\u05d5\u05dd \u05d5 \u05d0\u05d1\u05d5 \u0628\u0634\u0631 \u05d4 \u0627\u0633\u0645\u0627\u0639\u064a\u0644 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u0627\u0646\u064a \u05d1 \u0627\u0644\u062d\u0644\u0628\u064a \u05d1 \u05d0\u05d1\u05e8\u05d4\u05dd \u0627\u0644\u0645\u0643\u0646\u0627\u0646\u064a \u05d1 \u0631\u0627\u0633 \u0627\u0644\u0643\u0644 \u05d1 \u0645\u0648\u0647\u0648\u0628 \u0627\u0644\u0632\u064a\u0627\u062a \u05d1 \u0647\u0644\u0627\u0644 \u062c\u0648\u0644\u0627\u0645 \u0627\u0628\u0648 \u05d9\u05d5\u05e1\u05e3 \u05d1 \u05de\u05e9\u05d4 \u0627\u0644\u0632\u062c\u0627\u062c \u05d0 \u0635\u0627\u0644\u062d \u0627\u0644\u062d\u0644\u0628\u064a \u0628\u0637 \u05d0\u05d1\u05e8\u05d4\u05dd \u0627\u0644\u062a\u0627\u0647\u0631\u062a\u064a \u05d4 \u05de\u05e9\u05d4 \u0627\u0644\u0636\u0631\u0641\u064a \u05d2 \u05d1\u05df \u05e2\u05d6\u05e8\u05d4 \u05d4 \u05d1\u05df \u0635\u0648\u062f\u064a\u0642 \u05d3 \u062f\u0627\u0648\u062f \u05d1 \u05d1\u05e8\u05d4\u05d5\u05df \u05d1\u05df \u05d3\u05d0\u05d5\u05d3 \u05d1 \u05dd \u0627\u0633\u0645\u0627\u0639\u064a\u0644 \u0628\u0646 \u05e1\u05d4\u05dc \u05d3 \u0633\u0644\u0627\u0645\u0647 \u0628\u0646 \u0633\u0647\u0644 \u05d4 \u0627\u0628\u0648 \u0639\u0644\u064a \u0627\u0628\u0646\u0647 \u0631\u0628\u0627\u0639\u064a \u0628\u0646 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d9\u05d5\u05e1\u05e3 \u0627\u0644\u0636\u0631\u0641\u064a \u0631\u0628\u0627\u0639\u064a \u0637\u064a\u064a\u0628 \u0627\u0644\u0635\u0628\u0627\u062c \u05d1 \u0633\u0639\u0627\u062f\u0629 \u0628\u0646 \u0627\u0644\u062f\u0642\u0627\u0642 \u05d4 \u0633\u0644\u0627\u0645\u0629 \u0628\u0646 \u0643\u062b\u064a\u0631 \u05d1 \u05de\u05e0\u05e6\u05d5\u05e8 \u05d1\u05df \u0646\u0648\u0645\u064a\u0631 \u05d1 \u05de\u05d1\u05d5\u05e8\u05da \u05d1\u05df \u05d5\u05d4\u05d9\u05d1 \u05d3 \u0647\u0631\u0648\u0646 \u05d1\u05df \u05e4\u05d5\u05d4\u05d9\u05d3 \u05d2 \u0633\u0644\u0627\u0645\u0629 \u0628\u0646 \u0645\u0633\u0627\u0641\u0631 \u05d2 \u0628\u0646\u064a \u0627\u0644\u0631\u062c\u0644 \u05d4 \u0631\u0641\u064a\u0642\u0647\u0645 \u05d1 \u0647\u0628\u0647 \u0628\u0646 \u0627\u0644 \u05d1 \u0628\u0646 \u0627\u0644\u0635\u0628\u0627\u063a \u05d1 \u0627\u0644\u0641\u064a\u0644\u0633\u0648\u0641 \u05d0 \u0628\u0646 \u0627\u0644\u062d\u0632\u0627\u0645 \u05d1 \u0634\u0648\u0639\u0629 \u0627\u0644\u0632\u064a\u0627\u062a \u05d0 \u05de \u0627\u0644\u062c\u0648\u0628\u0631\u0627\u0646\u064a \u05d1 \u05d1\u05df \u0643\u0648\u0634\u064a\u062a \u05d1 \u05d1\u05df \u05de\u05e0\u05d3\u05e8 \u05d2 \u0628\u0646 \u0627\u0628\u0648 \u0631\u063a\u064a\u0641 \u0628\u0646 \u0627\u0644\u0639\u0645 \u05d1 \u0628\u0646 \u0627\u0644\u0645\u0642\u062f\u0633\u064a \u05d9 \u0628\u0646 \u0627\u0644\u0641\u0635\u0644\u064a \u05d9\u05d2 \u0628\u0646 \u0627\u0644\u0642\u0635\u064a\u0631 \u05d1 \u0647\u0631\u0648\u0646 \u0627\u0644\u0628\u0642\u0627\u0644 \u05d1 \u0628\u0646 \u0627\u0644 \u05d1 \u0645\u0646\u0634\u0647 \u0628\u0646 \u0627\u0644\u062a\u0646\u064a\u0633\u064a\u0629 \u05d0 \u062e\u0644\u0641\u0627 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u05d1 \u062f\u0627\u0648\u062f \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u05d1 \u0627\u0628\u0648 \u0627\u0644\u0628 \u0627\u0644\u0632\u0628\u064a\u0628\u064a \u05d2 \u0635\u062f\u0642\u0629 \u05d0 \u0647\u0644\u0627\u0644 \u0627\u0644\u0648