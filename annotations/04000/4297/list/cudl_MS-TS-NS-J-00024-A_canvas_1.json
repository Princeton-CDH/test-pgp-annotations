          "label": "Recto, T-S NS J24a - main text",
          "value": "<p> </p>\n\n<ol><li>\u0627\u0644\u0649 \u0627\u0644\u0627\u0646 \u0627\u0644\u0649 \u0639\u0646\u062f\u0647 \u0627\u0646\u0634\u0631\u062d\u062a</li>\n<li>\u0639\u0646\u062f\u0647 \u0647\u0648\u0627 \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0640\u05de\u05de\u05d7\u05d4 \u05e8\u05d1\u05d9 \u05d7\u05d9\u05d9\u05d4 \u05e9\u05de \u05e6\u05d5\u05e8 \u05e9\u05de \u0635\u0648\u0631</li>\n<li>\u0639\u0627\u0641\u064a\u0629 \u0639\u0631\u0641\u062a\u0647 \u0630\u0644\u0643 \u0648\u0633\u0628\u0628 \u0647\u0630\u0647 \u0627\u0644\u0627\u062d\u0631\u0641 \u0627\u0646 \u0644\u0645\u0627</li>\n<li>\u0627\u0646 \u0643\u0646\u062a \u0641\u064a\u0647 \u064a\u062f\u0645\u0643 \u0648\u0643\u0627\u0646 \u05de \u0648\u0643\u0627\u0646 \u0639\u0646\u062f \u0635\u0627\u062d\u0629 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a \u062f\u0639\u0648\u0629</li>\n<li>\u0641\u062a\u0642\u0644\u0648 \u0639\u0644\u0649 \u0628\u0627 \u0627\u0644\u0644\u064a\u0644 \u0648\u0643\u0627\u0646 \u0628\u0646 \u0635\u0627\u0644\u062d \u0627\u0644\u062d\u0632\u0627\u0646 \u062d\u0627\u0636\u0631</li>\n<li>\u0641\u0627\u0634\u0647\u062f\u0648 \u0639\u0644\u0649 \u05e8\u05d1 \u05d7\u05d9\u05d9\u05d4 \u0627\u0644\u0640\u05de\u05de\u05d7\u05d4 \u0634\u0647\u0627\u062f \u0641\u0627\u0646\u0641\u062f \u0648\u0644\u062f\u0648 \u0648\u0627\u0628\u0646 \u0627\u062e\u062a\u0647 \u0648\u0635\u0627\u0646\u0639 \u0639\u0646\u062f \u0645\u0646\u0635\u0648\u0631 \u0627\u0644\u062f\u064a\u064a\u0646</li>\n<li>\u062d\u062a\u0649 \u062e\u0631\u062c \u0639\u0644\u064a\u0647\u0645 \u0643\u0645\u0627\u0647 \u0645\u0648\u0633\u062a\u0643\u0628\u064a \u0648\u062a\u0635\u0627\u0631\u0628\u0648 \u0645\u0639\u0647\u0645 \u0648\u0643\u0627\u0646 \u0635\u0647\u0631 \u0627\u0644\u0640\u05de\u05de\u05d7\u05d4 \u0645\u0639 \u0627\u0644\u0642\u0648\u0645</li>\n<li>\u0648\u0643\u0627\u0646\u0648 \u0627\u0644\u0643\u0644 \u0633\u062e\u0627\u0631\u0627 \u0641\u062a\u062c\u0627\u0634\u0627 \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0645 \u0648\u0635\u0627\u062d\u0648 \u062d\u0648\u0627\u0644\u064a\u0629 \u0648\u0627 \u0642\u062a\u064a\u0644\u0627\u0647 \u0648\u0627\u062c\u062a\u0645\u0639\u062a \u0627\u0644\u0646\u0627\u0633 \u0627\u0644\u062d\u0632\u0627\u0646 \u0644\u0627\u0646 \u0627\u0644\u0646\u0648\u0628\u0629 \u0643\u0627\u0646\u062a \u0639\u0644\u0649 \u0628\u0627\u0628\u0629 \u0648\u0634\u062d\u0637 \u0627\u0644\u0649 \u062c\u0648\u0627 \u0627\u0644\u062f\u0647\u0644\u064a\u0632</li>\n<li>\u0648\u062c\u0627 \u062a\u0641\u0631\u0642\u0648 \u0648\u0627\u062c\u062a\u0645\u0639\u062a \u0643\u0627\u0646\u062a \u0646\u0648\u0628\u0629 \u0635\u0639\u0628\u0629 \u0648\u062c\u0627 \u0627\u0644\u0648\u0627\u0644\u0649 \u0648\u0644\u0648\u0644\u0627 \u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u064a</li>\n<li>\u0648\u062c\u0627\u0647 \u0645\u0646 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062f\u064a\u0645\u0647 \u0639\u0633\u0627\u0647 \u0646\u0648\u0628\u0629 \u062e\u0628\u064a\u0631 \u0628\u062a\u0634\u0646\u064a\u0639\u0647 \u0639\u0644\u0649 \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0648\u0644\u0648 \u0643\u0627\u0646 \u0641\u064a\u0627\u0644\u0628\u0644\u062f \u0645\u0642\u062f\u0645</li>\n<li>\u063a\u064a\u0631 \u0647\u0630\u0627 \u0644\u0645\u0627 \u062b\u0645 \u0644\u0647 \u0627\u0646 \u064a\u0641\u0639\u0644 \u0645\u0627 \u064a\u0641\u0639\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0642\u062f\u0645 \u0648\u064a\u0648\u062e\u062f\u0648 \u062c\u0645\u0627\u0639\u0647 \u064a\u062f\u062e\u0644\u0648 \u0627\u0644\u062d\u0628\u0633 \u064a\u062c\u064a \u0648\u064a\u062e\u0631\u062c\u0647\u0645</li>\n<li>\u0628\u0644\u0627 \u062e\u0633\u0627\u0631\u0629 \u062d\u0628\u0647 \u0627\u0644\u0628\u0627\u0631\u064a \u062a\u0639\u0627\u0644\u064a \u064a\u062f\u064a\u0645 \u0645\u0646 \u0628\u0633\u0639\u0627\u062f\u062a\u0647 \u0642\u062f \u0639\u0627\u0634\u062a \u0647\u0630\u0647 \u0627\u0644\u0637\u0627\u0626\u0641\u0629 \u0648\u0627\u0645\u0627 \u0627\u0644\u0630\u064a</li>\n<li>\u0636\u0639\u062f\u0647 \u0627\u0644\u0638\u0644\u0645\u0629 \u0648\u0642\u062f \u0643\u0627\u0646 \u0639\u0645\u0644 \u0645\u0639\u0647\u0645 \u0643\u0644 \u062c\u0645\u064a\u0644 \u0641\u062e\u0627\u0641\u0648\u0647 \u0628\u0627\u0646 \u0637\u0644\u0639\u0648 \u0627\u0633\u062a\u062c\u0627\u062a\u0648</li>\n<li>\u0641\u064a\u0647 \u0627\u0646\u0627 \u062d\u0627\u0636\u0631 \u0628\u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0648\u0628\u0629 \u0648\u0628 \u0648\u0628\u062c\u0645\u064a\u0639 \u0645\u0627 \u0641\u0639\u0644\u0648 \u0648\u0647\u0645 \u0645\u0646 \u062c\u0645\u0644\u0629</li>\n<li>\u0627\u0644\u0645\u0634\u0646\u0639\u064a\u0646 \u0648\u0644\u0645 \u064a\u0643\u0648\u0646 \u0627\u062e\u0630\u0647\u0645 \u0627\u0644\u0649 \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0627\u0644\u0627 \u0644\u0633\u0628\u0628 \u062a\u0634\u0646\u064a\u0639\u0647\u0645 \u0639\u0644\u064a\u0647 \u0648\u0635\u064a\u0627\u062d\u0647\u0645 \u0641\u064a \u0627\u0644\u0644\u064a\u0644</li>\n<li>\u0648\u0644\u0645\u0627 \u0645\u0646 \u062c\u0645\u0644\u0629 \u0645\u0646 \u062f\u062e\u0644 \u0627\u0644\u0649 \u0627\u0644\u0627\u0645\u064a\u0631 \u0645\u0639 \u0627\u0644\u0640\u05de\u05de\u05d7\u05d4 \u05e9\u05de \u05e6 \u0648\u0633\u0627\u0644\u0646\u0627</li>\n<li>\u0627\u0644\u0627 \u0645\u0627 \u0643\u0627\u0646 \u062c\u0639\u0644 \u0648\u0644\u0648 \u0643\u0627\u0646\u062a \u0647\u0630\u0647 \u0627\u0644\u0646\u0648\u0628\u0629</li>\n<li>\u062a\u062d\u062a \u0644\u0627 \u062a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062a\u0645 \u0628\u0647</li>\n<li>\u0648\u064a\u0642\u0631\u0646 \u0627\u064a\u0627\u0645\u0647 \u05dc\u05d9\u05de\u05d9 \u05d4\u05d2\u05d5\u05d0\u05dc \u05d0\u05de\u05df \u05db\u05df \u05d9\u05d4\u05d9 \u05e8\u05e6\u05d5\u05df \u0648\u0644\u0645\u0627 \u0643\u0627\u0646 \u064a\u0648\u0645 \u0627\u0644\u062b\u0646\u064a\u0646 \u0627\u0644\u062a\u0627\u0633\u0639</li>\n<li>\u0645\u0646 \u0634\u0647\u0631 \u05db\u05e1\u05dc\u05d9\u05d5 \u0648\u0635\u0644\u0648 \u062d\u0627\u0644\u0648 \u0648\u0630\u0643\u0631\u0648 \u0628\u0627\u0646 \u0645\u0639\u0647\u0645 \u0643\u062a\u0627\u0628 \u0633\u064a\u062f\u0646\u0627 \u05e9\u05e8 \u05d4\u05e9\u05e8\u05d9\u05dd \u05d9\u05e8\u05d5\u05dd \u05d4\u05d5\u05d3\u05d5</li>\n<li>\u0648\u0635\u0627\u0631\u0648 \u064a\u062c\u0645\u0639\u0648 \u0645\u062d\u0627\u0641\u0644 \u0645\u062d\u0627\u0641\u0644 \u0648\u064a\u0645\u0646\u062f\u0644\u0648 \u0628\u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0645\u0639\u0647\u0645 \u0627\u0644\u0640\u05e8\u05e9\u05e2\u05d4 \u0627\u0644\u0632\u0645\u0629 \u0627\u0644\u0646\u0627\u0637\u064a\u0641\u0627\u0646\u064a\u0629 \u0648\u064a\u062c\u0627\u062c\u0648</li>\n<li>\u0641\u064a \u0627\u0644\u0627\u0633\u0648\u0627\u0642 \u0648\u0641\u064a \u0627\u0644\u0628\u064a\u0648\u062a \u062d\u062a\u0649 \u0635\u0639\u0628 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0648\u0645\u0636\u064a\u062a \u0627\u0644\u0649 \u0639\u0646\u062f \u0627\u0644\u0648\u0627\u0644\u0649 \u0648\u0637\u0644\u0628\u062a \u0645\u0646\u0647 \u0645\u0627</li></ol>\n",
          "format": "text/html"
        }
