      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0645\u0638\u0629 \u0645\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0645\u0646\u0635\u0648\u0631 \u0643\u062c\u0642 \u05de\u05e8 \u05d5\u05e8 \u05d0\u05dc\u05e2\u05d6\u05e8 \u05d4\u05d1\u05d7\u05d5\u05e8 \u05d4 \u05d4\u05d6\u05e7\u05df \u05d4\u05d9\u05e7\u05e8 \u05d4\u05d9\u05d3\u05d5\u05e2 \u05d1\u05d0\u05d1\u05df \u05d6\u05d1\u05e7\u05dc\u05d4 \u05e1\u05d8 \u05e7\u05e0\u05d9\u05df \u05e9\u05dc\u05dd \u05d1\u05db\u05dc\u05d9 \u05d4\u05db\u05e9\u05e8 \u05d1\u05dc\u05d9 \u05d0\u05d5\u05e0\u05e1 \u05db\u05dc\u05dc \u05d1\u05d1\u05d9\u05d8\u05d5\u05dc \u05db\u05dc \u05de\u05d5\u05d3\u05e2\u05d9\u05df \u05d5\u05ea\u05e0\u05d0\u05d9\u05df \u0627\u0646 \u0639\u0644\u064a\u0647 \u0648\u0639\u0646\u062f\u0647 \u05e8 \u05d0\u05dc\u05e2\u05d6\u05e8 \u05d4\u05d1\u05d7\u05d5\u05e8 \u05d4\u05d9\u05e7\u05e8 \u05d1\u05e8 \u0643\u062c\u0642 \u05de\u05e8 \u05d5\u05e8 \u05db\u05e8\u05de\u05d9 \u0646\u0639 \u0645\u0646 \u0627\u0644\u0641\u0644\u0648\u0633 \u0627\u0644\u063a\u064a\u0627\u062f \u0627\u0644\u062e\u0627\u0645\u0644\u064a\u0629 \u0627\u0644\u0645\u062a\u0639\u0627\u0645\u0644 \u0628\u0647\u0645 \u0627\u0644\u0627\u0646 \u062f\u0631\u0647\u0645\u0627 \u0648\u0630\u0644\u0643 \u0639\u0646 \u062a\u0633\u0639\u0629 \u062f\u0631\u0627\u0647\u0645 \u0646\u0627\u0635\u064a\u0629 \u0648\u0645\u0639\u0647\u0627 \u0648\u0632\u0646\u0629 \u0645\u062e\u0633 \u0644\u0645\u062e\u0627\u0633\u064a\u0646 \u0645\u0635\u0631 \u0645\u0646 \u062c\u0631\u0629 \u0627\u0646\u062e\u0627\u0642 \u05d7\u05e9\u05d9\u05e9\u05d4 \u05ea\u05e0\u05d9\u05df \u0648\u0633\u062a\u064a\u0646 \u062f\u0631\u0647\u0645\u0627 \u0639\u0646\u062f \u0627\u0644\u0645\u0634\u0627\u0631 \u0627\u0644\u064a\u0647 \u062f\u064a\u0646 \u062d\u0627\u0644 \u05d7\u05d5\u05d1 \u0645\u062a\u0649 \u0627\u062d\u0628 \u0648\u0627\u062e\u062a\u0627\u0631 \u0628\u063a\u064a\u0631 \u0645\u0645\u0627\u0637\u0644\u0627\u0642\u0646\u064a\u0646\u0627 \u05d0\u05e0\u05df \u05d7\u05ea\u05d5\u05de\u05d9 \u