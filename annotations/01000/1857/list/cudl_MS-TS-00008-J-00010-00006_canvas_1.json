      "body": [
        {
          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>\u0645\u0648\u0633\u0649 \u0628\u0646 \u05d9\u05d5\u05e1\u05e3 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0648</li>\n<li>\u062f\u0648\u0646 \u063a\u064a\u0631\u0647 \u0645\u0646 \u0631\u0648\u0633\u0627 \u0627\u0644\u064a\u0647\u0648\u062f \u0648\u0644\u0645 \u064a\u0643\u0646 \u064a\u0641\u0639\u0644</li>\n<li>\u0630\u0644\u0643 \u062d\u064a\u0646\u0626\u0630 \u0628\u0627\u062e\u062a\u064a\u0627\u0631\u0647 \u062d\u062a\u0649 \u062d\u0648\u062c\u0648\u0627 \u0635\u0637\u0631</li>\n<li>\u0627\u0644\u064a\u0647 \u0628\u063a\u0631\u064a\u0645\u062a\u0647 \u064a\u0645\u064a\u0646 \u0648\u0644\u0645\u0627</li>\n<li>\u0644\u064a\u0633 \u064a\u062a\u0645 \u0644\u0647 \u0630\u0644\u0643 \u0627\u0644\u0627 \u0628\u062a\u0639\u0628 \u0634\u062f\u064a\u062f \u0627\u0639\u0632\u0644</li>\n<li>\u0639\u0646 \u062a\u0644\u0643 \u0627\u0644</li>\n<li>\u05d9\u05e9\u05e8\u05d0\u05dc \u0641\u0643\u064a\u0641 \u064a\u0639\u0648\u062f \u0627\u0644\u0649 \u0628\u0639\u0636\u0647\u0627 \u0644\u0627 \u0633\u064a\u0645\u0627 \u0648\u0642\u062f</li>\n<li>\u062d\u062f\u062b \u0641\u064a \u0627\u0644 \u0645\u0646 \u0627\u0644</li>\n<li>\u064a\u062e\u0631\u0645 \u0644\u0633\u0627\u0646 \u0637\u0627\u0644\u0628 \u0648\u0635\u0641\u0647\u0627 \u0648\u064a\u0636\u0645\u0645 \u0633\u0627\u0645\u0639\u0647\u0627</li>\n<li>\u0648\u0643\u0627\u0646 \u0633\u0628\u0628 \u0630\u0644\u0643 \u0645\u0646 \u0627\u0646\u0642\u0645 \u0627\u0644\u0644\u0647 \u0645\u0646\u0647 \u0648\u0644\u0627</li>\n<li>\u0627\u0647\u0644\u0647 \u0627\u0644\u0627 \u0644\u0645\u0627 \u064a\u0633\u062a\u062d\u0642\u0647 \u062e\u0627\u062f\u0645\u0627 \u0644\u0647</li>\n<li>\u0627\u0645\u0648\u0631 \u0627\u0644\u062f\u064a\u0646 \u0648\u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u064a\u0636\u0627 \u0627\u0646 \u0627\u0644\u0627\u0645\u0648\u0631</li>\n<li>\u0627\u0644\u062a\u064a \u0641\u064a \u0627\u0644\u0632\u0645\u0627\u0646 \u0643\u0644\u0647\u0627 \u0627\u0644\u0645\u062a \u0644</li>\n<li>\u0648\u0627\u0644\u062f\u0646\u064a\u0627 \u0627\u0645\u0648\u0631 \u0627\u0644\u0630\u064a\u0646 \u0648\u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u064a\u0636\u0627 \u0627\u0646 \u0627\u0644\u0627\u0645\u0648\u0631 \u0627\u0644\u062a\u064a \u0641\u064a \u0627\u0644\u0632\u0645\u0627\u0646 \u0643\u0644\u0647\u0627 \u0627\u0644\u0645\u062a \u0644 \u0648\u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u0631\u064a\u0627\u0633\u0627\u062a \u0648\u0627\u0644\u0633\u064a\u0627\u0633\u0627\u062a \u0645\u0633</li>\n<li>\u0627\u0644\u0649 \u062a\u062f\u0627\u0628\u064a\u0631 \u0627\u062a\u0642\u0646 \u0645\u0646 \u0627\u0644\u062a\u064a \u0627\u0631\u0649 \u0648\u0642\u062f</li></ol>\n",
