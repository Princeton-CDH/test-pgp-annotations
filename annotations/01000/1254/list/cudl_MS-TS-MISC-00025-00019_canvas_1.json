          "value": "<ol>\n<li><span lang=\"he\">\u05d3' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9,</span></li>\n<li><span lang=\"he\">\u05e9\u05d9\u05e1\u05dc\u05e7 \u05dc\u05da \u05d0\u05d5\u05ea\u05dd.</span></li>\n<li><span lang=\"he\">\u05e8\u05d9\u05e9\u05d5\u05dd \u05d4\u05de\u05e9\u05d5\u05d0\u05d9\u05dd:</span></li>\n<li><span lang=\"he\">\u05dc\u05d1\u05e8\u05d4\u05d5\u05df \u05d5\u05e0\u05e1\u05d9\u05dd \u05d1\u05e0\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05e1\u05d7\u05e7 \u05d4\u05ea\u05d0\u05d4\u05e8\u05ea\u05d9</span></li>\n<li><span lang=\"he\">\u05d5\u05e0\u05d4\u05d5\u05e8\u05d0\u05d9 \u05d1\u05df \u05e0\u05e1\u05d9\u05dd</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05dc \u05d4\u05e6\u05d3\u05d3\u05d9\u05dd \u05d4\u05e2\u05dc\u05d9\u05d5\u05e0\u05d9\u05dd</span></li>\n<li><span lang=\"he\">\u05d1\u05e6\u05d3 (\u05d0\u05d7\u05d3): \u05dc\u05d1\u05e8\u05d4\u05d5\u05df</span></li>\n<li><span lang=\"he\">\u05d5\u05e0\u05e1\u05d9\u05dd, \u05d5\u05d1\u05e6\u05d3\u05d4 \u05d4\u05d0\u05d7\u05e8:</span></li>\n<li><span lang=\"he\">\u05d5\u05e0\u05d4\u05d5\u05e8\u05d0\u05d9;</span></li>\n<li><span lang=\"he\">\u05d5\u05de\u05d0\u05d7\u05d5\u05e8\u05d9\u05d4\u05dd</span></li>\n</ol>",
