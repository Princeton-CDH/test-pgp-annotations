      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00002-00008/canvas/1",
          "type": "Canvas",
