        {
          "type": "TextualBody",
          "label": "Recto, margin:",
          "value": "<p>\u0641\u0645\u0627 \u063a\u0646\u064a \u062e\u0628\u0631 \u0648\u0643\u0627\u0646 \u0642\u0644\u0649 \u0645\u0641\u0635\u0644 \u0645\u0648\u0631 \u0645\u0639 \u0643\u062a\u0628\u064a \u05dc\u05e8\u05d1\u05d9 \u05de\u05e0\u05d7\u05dd \u0627\u0634\u0643\u0648\u0647 \u0642\u0635\u062a\u0643 \u062a\u0642\u0635\u0629 \u062d\u062c\u062a\u0643</p>\n<p>\u0645\u0627 \u0647\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0640\u05de\u05d2\u05d9 \u0645\u0639 \u062d\u0628\u064a\u0628</p>",
