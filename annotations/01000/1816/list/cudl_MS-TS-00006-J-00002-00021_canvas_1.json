      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0643\u062a\u0627\u0628\u064a \u064a\u0627 \u0634\u064a\u0643\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643\u0645\u0646 \u0627\u0644 \u05e8\u05de\u05dc\u05d4 \u064a\u0648\u0645 \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u05d9\u05d6 \u0645\u0646 \u05d0\u05d1 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0642\u062f \u0643\u0627\u0646 \u0646\u0641\u062f \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 \u064a\u0627 \u0633\u064a\u062f\u064a \u05d1 \u0645\u0646 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u062d\u0631\u0633\u0647\u0627 \u0627\u0644\u0644\u0647 \u0648\u0647\u064a \u0627\u0644\u0642 \u0648\u0639\u0631\u0641\u062a\u0643 \u0627\u0646 \u0648\u0635\u0644 \u0627\u0644\u0649 \u0643\u0644 \u0627\u062d\u062f \u0645\u0627 \u0631 \u0634\u0648\u0643\u0631 \u0648\u0627\u0644\u0630\u0648\u0627\u0639 \u0648\u0644\u0645 \u064a\u0643\u0648\u0646 \u0633\u0628\u0628 \u0627 \u0644\u0648\u0644\u0627 \u0630\u0627\u0644\u0643 \u0644\u0642\u062f \u0643\u0627\u0646\u062a \u0627\u0644\u0643\u0648\u062a\u0628 \u062a\u0635\u0644 \u0627\u0648\u062c\u0628 \u0627\u0646 \u0627\u0643\u062a\u0628 \u0628\u0647\u0630\u0627 \u0627\u0644\u0643\u0644\u0627\u0645 \u0645\u0627 \u0642 \u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0627 \u0628\u0639\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0642\u0628\u0648\u0636 \u0628\u0627\u0644\u0627 \u0641\u064a\u0647 \u062b\u0648\u0627\u0646\u064a \u0641\u0648\u062c\u0628 \u0627\u0646 \u0627\u0639\u0631\u0641\u0643 \u0627\u0646 \u0644\u0645 \u064a\u0643\u0648\u0646 \u0633\u0641\u062a\u062c\u0647 \u0648\u0627\u0645\u0627 \u0647\u0630\u0647 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0630\u064a \u062f\u0641\u0639 \u0627\u0628\u0646 \u0645\u0648\u0633\u0627\u0641\u0631 \u0627\u064a\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u0643\u062a\u0628 \u0628\u0647\u0627 \u0627\u0644\u0649 \u0631\u0648\u062d \u0627\u064a\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u062e\u064a\u064a\u0631\u0629 \u0627\u0645\u0627 \u0627\u0646 \u0627\u0644\u0630\u064a \u062f\u0641\u0639\u0647\u0627 \u0648\u0627\u0644\u0630\u0629 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0639\u0634\u0631 \u062f\u064a\u0646\u0631 \u0648\u062a\u0648\u0644\u062a\u064a\u064a\u0646 \u062f\u064a\u0646\u0631 \u05de \u0628\u0631\u0633\u0645\u064a \u0627\u0646\u0627 \u062a\u0633\u0639\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0628\u0631\u0633\u0645 \u0633\u064a\u062f\u064a \u0627\u0628 \u0628\u064a\u062a \u062f\u064a\u0646 \u0648\u0628\u0631\u0633\u0645 \u0633\u064a\u062f\u064a \u0627\u0644 \u0634\u0644\u064a\u0634\u064a \u0627\u064a\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u0628\u0631\u0633\u0645 \u0641\u0630\u0627\u0644\u0643 \u062b\u0645\u0627\u0646\u064a\u0629 \u0639\u0634\u0631 \u062f\u064a\u0646\u0631 \u0648\u062a\u0648\u0644\u062a\u064a\u064a\u0646 \u0627\u0628\u0646 \u0645\u0648\u0633\u0627\u0641\u0631 \u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0642\u0648\u062f\u0633 \u0644\u0627\u0646 \u0637\u0644\u0628 \u0627\u0646 \u064a\u0643\u0648\u0646 \u0641\u064a\u0647 \u062e\u0637 \u0633\u064a\u062f\u064a \u0627\u0644\u0640\u05e9\u05dc\u05d9\u05e9\u05d9 \u0648\u0647\u0648 \u0641\u064a \u0627\u0644\u0642\u0648\u0633\u062f \u0648\u0627\u0646\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0628\u0627\u0644\u0631\u0645\u0644\u0629 \u0639\u0631\u0641\u062a\u0643 \u0630\u0627\u0644\u0643 \u0641\u0644\u0627 \u062a\u0633\u062a\u0628\u0637\u064a \u0648\u0627\u0644\u0630\u064a \u0627\u0642\u0648\u0644 \u0627\u062c\u0627\u0628 \u0627\u0644\u0644 \u0627\u0644\u0645\u0648\u0635\u064a \u0648\u0627\u0644\u0645\u0648\u0635\u0644 \u0648\u0627\u0646\u0627 \u0648\u0627\u0633\u062a\u0648\u062f\u0639\u0629 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0631\u0627\u0633 \u0634 \u0644\u0648\u0644\u0627 \u0630\u0627\u0644\u0643 \u0644\u0642\u062f \u0643\u0627\u0646\u062a \u0627\u0644\u0643\u0648\u062a\u0628 \u05ea\u05e6 \u0627\u0648\u062c\u0628 \u0627\u0646 \u0627\u0643\u062a\u0628 \u0628\u0647\u0630\u0627 \u0627\u0644\u0643\u0644\u0627\u0645 \u0645\u0627 \u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0627 \u0628\u0639\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0642\u0628\u0648\u0636 \u0628\u0627\u0644\u0627 \u0641\u064a\u0647 \u062b\u0648\u0627\u0646\u064a \u0641\u0648\u062c\u0628 \u0627\u0646 \u0627\u0639\u0631\u0641\u0643 \u0627\u0646 \u0644\u0645 \u064a\u0643\u0648\u0646 \u0633\u0641\u062a\u062c\u0647 \u0648\u0627\u0645\u0627 \u0647\u0630\u0647 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0630\u064a \u062f\u0641\u0639 \u0627\u0628\u0646 \u0645\u0648\u0633\u0627\u0641\u0631 \u0627\u064a\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u0643\u062a\u0628 \u0628\u0647\u0627 \u0627\u0644 \u0631\u0648\u062d \u0627\u064a\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u062e\u064a\u064a\u0631\u0629 \u0627\u0645\u0627 \u05d0 \u0627\u0644\u0630\u064a \u062f\u0641\u0639\u0647\u0627 \u0648\u0627\u0644\u0630\u0629 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0639\u0634\u0631 \u062f\u064a\u0646\u0631 \u0648\u062a\u0648\u0644\u062a\u064a\u064a\u0646 \u062f\u064a\u0646\u0631 \u0628\u0631\u0633\u0645\u064a \u0627\u0646\u0627 \u062a\u0633\u0639\u0629 \u05e8 \u0628\u0631\u0633\u0645 \u0633\u064a\u062f\u064a \u05d0\u05d1 \u05d1\u05d9\u05ea \u05d3 \u05e9\u05dc\u05d9\u05e9\u05d9 \u0627\u0626\u062f\u0629 \u0627\u0644\u0644\u0647 \u05d5 \u0641\u0630\u0627\u0644\u0643 \u062a\u0645\u0627 \u0627\u0628\u0646 \u0645\u0648\u0633\u0649 \u0634\u064a\u0643 \u05d0 \u0641\u0647 \u0645\u0646 \u0627\u0644\u0642\u0648\u0631\u0628 \u0644\u0627\u0646 \u0637\u0644\u0628 \u0627\u0646 \u064a\u0643\u0648\u0646 \u0641\u064a\u0647 \u062e\u0637 \u0633\u064a\u062f\u064a \u0627\u0644\u0640\u05e9\u05dc\u05d9\u05e9\u05d9 \u0648\u0647\u0648 \u0641\u064a \u0627\u0644\u0642\u0648\u062f\u0633 \u0648\u0627\u0646\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0628\u0627\u0644\u0631\u0645\u0644\u0629 \u