          "type": "TextualBody",
          "label": "",
          "value": "<p>\u064a\u062e\u062a\u0635 \u0628\u0627\u0644\u062d\u0644\u0628\u064a \u0648\u0627\u0631\u062a \u0627\u0644\u0639\u0632\u0627\u0632\u064a \u062d\u0636\u0631 \u0627\u0644\u064a \u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u0633\u0627\u0644\u0645 \u0628\u0646 \u0645\u0646\u0635\u0648\u0631 \u0627\u0644\u062d\u0644\u0628\u064a \u0648\u0630\u0643\u0631 \u0627\u0646 \u0644\u0647 \u05d6\u05db\u05d5\u05ea \u05d5\u05e2\u05d3\u05d5\u05ea \u0639\u0646\u062f \u0645\u0646 \u064a\u0627\u062a\u064a \u0630\u0643\u0631\u0647 \u0628\u0639\u062f \u0647\u0630\u0627 \u0641\u062d\u0635\u0631 \u0627\u0644\u064a\u0646\u0627 \u05e8\u05d1 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05e8 \u05e9\u05de\u05e8\u05d9\u05d4 \u05d4\u05d3\u05d9\u05d9\u05df \u0627\u0644\u062d\u0644\u0628\u064a \u05e0\u05e2 \u0648\u0630\u0643\u0631 \u0627\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0627\u0644\u0639\u0632\u0627\u0632\u064a \u0627\u0644\u062d\u0644\u0628\u064a \u0627\u0644\u0645\u062a\u0648\u0641\u0627 \u05d1\u05e2\u05db\u05d4 \u0641\u062e\u0644\u0641 \u0627\u0643\u0648\u064a\u0646 \u05d1\u05d7\u05dc\u05d1 \u0627\u0633\u0645 \u0627\u062d\u062f\u0647\u0645\u0627 \u0627\u0633\u062f \u0644\u0647 \u05d2 \u0627\u0648\u0644\u0627\u062f \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u0647\u0628\u0647 \u0644\u0647 \u0648\u0644\u062f\u064a\u0646 \u0648\u0627\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0647\u0630\u0627 \u0647\u0648 \u05e2\u05dd \u0644\u0633\u0627\u0644\u0645 \u0647\u0630\u0627 \u0648\u0627\u0646 \u0645\u0627 \u0643\u0627\u0646\u0648 \u0642\u0637 \u063a\u064a\u0631 \u05d3 \u0627\u062e\u0648\u0647 \u0627\u062e\u0628\u0631\u0647\u0645 \u0627\u0633\u062f \u0648\u0628\u0639\u062f\u0647 \u0647\u0628\u0647 \u0648\u0628\u0639\u062f\u0647 \u0645\u0646\u0635\u0648\u0631 \u0648\u0627\u0644\u062f \u0633\u0627\u0644\u0645 \u062f\u0646\u0646 \u0648\u0627\u0635\u063a\u0631\u0647\u0645 \u0627\u0633\u0645\u0639\u064a\u0644 \u0627\u0644\u0645\u062a\u0648\u0641\u0627 \u05d1\u05e2\u05db\u05d4 \u0648\u062b\u0645 \u062d\u0636\u0631 \u0627\u064a\u0636\u0627 \u05d0\u05dc\u05e2\u05d6\u05e8 \u05d1\u05e8 \u05d4\u05dc\u05dc \u0627\u0644\u062d\u0644\u0628\u064a \u0627\u064a\u0636\u0627 \u0648\u0630\u0643\u0631 \u0645\u062b\u0644 \u0647\u0630\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0628\u0639\u064a\u0646\u0647\u0627 \u062d\u0631\u0641 \u0628\u062d\u0631\u0641 \u0644\u0627 \u0632\u0627\u0626\u062f \u0648\u0644\u0627 \u0646\u0627\u0642\u0635 \u0648\u062a\u0645 \u0633\u0627\u0644\u0646\u0627\u0647\u0645\u0627 \u0627\u0646\u0646 \u0628\u064a \u062f\u064a\u0646\u0627 \u0647\u0644 \u062a\u0639\u0644\u0645\u0627 \u0627\u0646 \u0643\u0627\u0646 \u062a\u0632\u0648\u062c \u0627\u0633\u0645\u0639\u064a\u0644 \u0645\u0646 \u0642\u0628\u0644 \u0648\u0641\u0627\u062a\u0647 \u05d1\u05e2\u05db\u05d4 \u0627\u0644\u062a\u064a \u0642\u062f \u0635\u062d\u062a \u0639\u0646\u062f\u0643\u0645 \u0641\u0642\u0627\u0644\u0648 \u05dc\u05d0 \u0648\u0645\u0627 \u062a\u0632\u0648\u062c \u0642\u0637 \u0648\u062a\u0645 \u062d\u0636\u0631 \u0627\u064a\u0636\u0627 \u05e8 \u05d4\u05dc\u05dc \u05d1\u05e8 \u05de\u05d5\u05d1\u05d7\u05e8 \u0627\u0644 \u062d\u0644\u0628\u064a \u0648\u0634\u0647\u062f \u0628\u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u064a\u0646 \u0641\u0648\u0642 \u0647\u0630\u0627 \u0644\u0627 \u0632\u0627\u0626\u062f \u0648\u0644\u0627 \u0646\u0627\u0642\u0635 \u0648\u0643\u0627\u0646 \u0630\u0644\u0643 \u05d1\u05d9\u05d5\u05dd \u05e9\u05e0\u05d9 \u0641\u064a \u05d9\u05d1 \u05d9\u05d5\u05dd \u05db\u05dc\u05ea \u05dc\u05d7\u05d3\u05e9 \u05db\u05e1\u05dc\u05d9\u05d5 \u0645\u0646 \u0633\u0646\u0629 \u0627\u062a\u064a\u0627 \u0648\u0645\u0627 \u0630\u0647\u0648\u0629 \u0642\u062f\u0645\u0646\u0627 \u0648\u0645\u0647 \u062f\u0627\u0633\u0647\u064a\u062f\u0648 \u0642\u0645\u0646\u0627 \u0635\u0644 \u0642\u062f\u0645\u0646\u0627 \u0643\u062a\u0628\u0646\u0627 \u0648\u062d\u062a\u0645\u0646\u0627 \u0644\u0632\u0643\u0648 \u0648\u0644\u0631\u0627\u0626\u0629 \u0644\u0645 \u0633\u0627\u0644\u0645 \u062f\u0646\u0646 \u05d9\u05e6\u05d7\u05e7 \u05d1\u05d9\u05e8 \u05e9\u05de\u05d5\u05d0\u05dc \u05d6\u05dc \u05d9\u05d5\u05e1\u05e3 \u05d4\u05db\u05d4\u05df \u05d1\u05e8 \u05d7\u05dc\u05e4\u05d5\u05df \u05e0\u05e2 \u05e4\u05e8\u05d7\u05d9\u05d4 \u05d4\u05de\u05dc\u05de\u05d3 \u05d1\u05e8 \u05d0\u05e8\u05d7 \u0646\u0646 \u062d\u0636\u0631 \u0627\u0644\u064a\u0646\u0627 \u0627\u0646\u0646 \u0628\u064a \u062f\u064a\u0646\u0627 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0645\u0631\u062c\u0627 \u05de\u05e8 \u05d5\u05e8\u05d1 \u05d9\u05d5\u05e1\u05e3 \u05d1\u05e8 \u05de\u05e8 \u05de\u05d1\u05d5\u05e8\u05da \u05d3\u05d9\u05d3\u05d9\u05e2 \u0628\u0646 \u0627\u0644\u0646\u0627\u0642\u062f \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u05de\u05e8 \u05d0\u05d4\u05e8\u05df \u05d1\u05e8 \u05de\u05e8 \u05d9\u05e4\u05ea \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u0627\u0646\u064a \u0648\u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u05de\u05e8 \u05d9\u05e9\u05d5\u05e2\u05d4 \u05d1\u05e8 \u05de\u05e8 \u05d9\u05e6\u05d7\u05e7 \u0627\u0644\u0635\u0628\u0627\u062c \u0648\u0636\u0645\u0646\u0627 \u05d1\u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u0627\u0646 \u062c\u0645\u064a\u0639 \u0645\u0627 \u064a\u0627\u062e\u0630\u0647 \u0633\u0627\u0644\u0645 \u062f\u0646\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0628\u0627\u0637\u0646 \u0647\u0630\u0647 \u0627\u0644\u0631\u0642\u0639\u0629 \u0645\u0646 \u062f\u064a\u0646\u0627\u0631 \u0648\u0627\u062d\u062f \u0627\u0644\u0649 \u0645\u0627\u0626\u0629 \u05d3\u05d9\u05e0 \u0648\u0630\u0644\u0643 \u05d1\u05e7\u05e0\u05d9\u05df \u05d5\u05db\u05dc\u05d9 \u05d4\u05db\u05e9\u05e8 \u0645\u0646 \u0641\u064a \u0627\u062d\u0631\u064a\u0648\u062a\u0647\u0645 \u0627\u0646 \u0648\u0635\u0644 \u0637\u0627\u0644\u0628 \u0627\u062d\u0642 \u0633\u0627\u0644\u0645 \u05dc\u05e7\u05e0\u05d5\u05ea \u05d1\u05d5 \u05d1\u05d1\u05d9\u05d8\u05d5\u05dc \u05db\u05dc \u05de\u05d5\u05d3\u05e2\u05d9 \u05d5\u05ea\u05e0\u05d0\u05d9 \u05e9\u05e8\u05d9\u05e8 \u05d5\u05e7\u05d9\u05d9\u05dd \u0648\u0630\u0644\u0643 \u05d1\u05d7\u05d3\u05e9 \u0630\u0646\u0646 \u0628\u0647\u0630\u0627 \u05db\u05e1\u05dc\u05d5 \u05e9\u05e0\u05ea \u05d0\u05ea\u05d9\u05d0 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u062a\u0644\u0649 \u05d1\u05d9\u05e0\u05d9 \u05e9\u05d9\u05d8\u05d9 \u0648\u0645\u0643\u062a\u0648\u0628 \u0641\u064a \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0645\u0642\u062f\u0627\u0631 \u0641\u064a \u0627\u062d\u0631\u064a\u0648\u062a\u0647\u0645 \u0627\u0646 \u0648\u0635\u0644 \u0645\u0646 \u064a\u0633\u062a\u062d\u0642 \u0637\u0627\u0644\u0628 \u0627\u062d\u0642 \u0645\u0646 \u0633\u0627\u0644\u0645 \u062f\u0646\u0646 \u0628\u0647\u0630\u0627 \u0627\u0644\u0645\u0642\u062f\u0627\u0631 \u0648\u0642\u064a\u064a\u0645\u064a\u0646 \u0648\u062f\u064a\u0646 \u0642\u064a\u0648\u0645\u064a\u0647\u0648\u0646 \u05d4\u05dc\u05dc \u0628\u064a\u0631 \u0639\u0644\u0649 \u05d6\u05dc \u05e2\u05de\u05e8\u05dd \u05d1\u05e8 \u05d0\u05d1\u05e8\u05d4\u05dd \u0646\u0646 \u05d9\u05e6\u05d7\u05e7 \u0628\u064a\u0631 \u05e9\u05de\u05d5\u05d0\u05dc \u05d6\u05dc \u062d\u0636\u0631 \u0627\u0644\u0649 \u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u05e8 \u05e2\u05dc\u05d9 \u05d1\u05df \u05db\u05d1\u05d5\u05d3 \u062c\u0642 \u05d4\u05dc\u05dc \u05d4\u05d7\u05d6\u05df \u05d4\u05d2\u05d3\u05d5\u05dc \u0648\u0637\u0627\u0644\u0628 \u05e8 \u05de\u05e9\u05d4 \u05d4\u05d6\u05e7\u05df \u05d1\u05d9\u05e8 \u05d0\u05e4\u05e8\u05d9\u05dd \u0628\u0639\u0645\u0627\u0645\u062a\u064a\u0646 \u0633\u0642\u064a\u0644\u064a\u0629 \u0634\u0631\u0627\u0647\u0627 \u0633\u062a\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0631\u0628\u0639 \u0645\u0646\u062f \u05d9\u05d1 \u0633\u0646\u0629 \u0648\u0646\u062d\u0648\u0647\u0627 \u0641\u0633\u0627\u0644 \u05de\u05e8 \u05de\u05e9\u05d4 \u062f\u0646\u0646 \u0639\u0646 \u0630\u0644\u0643 \u0641\u0642\u0627\u0644 \u05dc\u05d0 \u05d4\u05d9\u05d5 \u05d3\u05d1\u05e8\u05d9\u05dd \u05de\u05e2\u05d5\u05dc\u05dd \u0645\u0627 \u0639\u0627\u0645\u0644\u062a\u0647 \u064a\u0648\u0645 \u0642\u0637 \u0648\u0645\u0627 \u0630\u0647\u0648\u0627 \u0642\u062f\u0645\u0646\u0627 \u0643\u062a\u0628\u0646\u0627 \u0648\u062d\u062a\u0645\u0646\u0627 \u05d9\u05e6\u05d7\u05e7 \u05d1\u05d9\u05e8 \u05e9\u05de\u05d5\u05d0\u05dc \u05d6\u05dc \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05e8 \u05e0\u05ea\u05df \u05d4\u05d7\u05d1\u05e8 \u05d6\u05dc \u05d9\u05e9\u05d5\u05e2\u05d4 \u05d1\u05e8 \u05d9\u05db\u05d9\u05df</p>",
