      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u05d1\u05e9\u05de\u05da \u0631\u062d\u0645\u0646\u0627</li>\n<li>\u0646\u0639\u0644\u0645 \u0633\u064a\u062f\u064a \u0627\u0644\u0641\u0631\u0646\u0633 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0643</li>\n<li>\u0648\u062a\u0627\u0626\u062f\u062a\u0643 \u0648\u0633\u0639\u062f\u062a\u0643 \u0648\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0646 \u0644\u0645\u0627 \u0643\u0627\u0646 \u064a\u0648\u0645 \u0633\u0628\u0639\u0647 \u0639\u0634\u0631</li>\n<li>\u0628\u062a\u0645\u0648\u0632 \u0648\u0635\u0644 \u0627\u0644\u0649 \u0639\u0646\u062f\u0646\u0627 \u0627\u0634\u064a\u0643 \u0627\u0628\u0648 \u0639\u0645\u0631\u0646 \u0645\u0648\u0633\u0629 \u05d1\u05df \u05d9\u05e7\u05d5\u05ea\u05d9\u05d0\u05dc</li>\n<li>\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647 \u0648\u0627\u0647\u0644\u0647 \u0648\u0647\u0648 \u0648\u062c\u0639 \u0645\u0646 \u0627\u062b\u0631 \u0645\u0627 \u062c\u0631\u0627 \u0639\u0644\u064a\u0647 \u0628\u0627\u0644\u0641\u064a\u0648\u0645</li>\n<li>\u0645\u0646 \u0627\u0646\u0647\u0628 \u0648\u0627\u0644\u0639\u0642\u0648\u0628\u0629 \u0641\u064a \u0635\u0641\u0635\u0641 \u0648\u0642\u0648\u0637\u0639 \u0627\u064a\u0636\u0627 \u0639\u0644\u064a\u0647 \u0628\u0627\u0644\u0642\u0648\u0631\u0628 \u0645\u0646</li>\n<li>\u0636\u064a\u0639\u062a\u0646\u0627 \u0648\u0627\u0648\u062e\u062f \u062c\u0645\u064a\u0639 \u0645\u0627 \u0643\u0627\u0646 \u0642\u062f \u0633\u0644\u0645 \u0644\u0648\u0647 \u0645\u0646 \u0635\u0648\u0628\u0627\u0628\u0647</li>\n<li>\u0631\u062d\u0644 \u0648\u0639\u064a\u0646 \u0648\u0648\u0635\u0644 \u0648\u0644\u0630\u0647 \u0627\u0634\u064a\u0643 \u0627\u0628\u0648 \u064a\u0639\u0642\u0648\u0628 \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647</li>\n<li>\u0639\u0632\u0629 \u0628\u0639\u062f \u0630\u0627\u0644\u0643 \u0628\u0627\u064a\u0627\u0645 \u0648\u0642\u062f \u062c\u0631\u062a \u0639\u0644\u064a\u0647 \u0627\u0647\u0648\u0627\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646</li>\n<li>\u0634\u0631\u062d\u0647\u0627 \u0648\u0627\u0642\u0627\u0645 \u0639\u0646\u062f\u0647 \u0627\u0644\u0627\u0646 \u0642\u0636\u0627 \u0627\u0644\u0644\u0647 \u0648\u0641\u0627\u062a\u0647 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633</li>\n<li>\u0645\u0646 \u0627\u0628 \u0648\u0644\u0645 \u064a\u062e\u0644\u0641 \u0639\u0646\u062f\u0646\u0627 \u0644\u0627 \u062f\u064a\u0646\u0627\u0631 \u0648\u0644\u0627 \u062f\u0631\u0647\u064a\u0645 \u0648\u0644\u0627 \u0642\u0644\u064a\u0644 \u0648\u0644\u0627</li>\n<li>\u0643\u062b\u064a\u0631 \u0644\u0627\u0646 \u0648\u0635\u0644 \u0647\u0648\u0647 \u0648\u0643\u0644 \u0645\u0646 \u0645\u0639\u0647 \u0639\u0631\u0627\u064a\u0627 \u0648\u0628\u0639\u062f \u0630\u0627\u0644\u0643 \u0628\u0627\u064a\u0627\u0645</li>\n<li>\u062a\u0648\u0641\u064a\u064a\u062a \u0628\u0646\u062a\u0647 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0648\u0627\u0635\u0644 \u0635\u0648\u062d\u0628\u0647 \u0647\u0630\u0647 \u0627\u0644\u0649</li>\n<li>\u0627\u062d\u0631\u0641 \u0648\u062a\u0648\u0641\u064a\u064a\u062a \u0627\u064a\u0636\u0627 \u0645\u0631\u062a\u0647 \u0627\u0644\u0627\u062e\u0631\u0627 \u0627\u0644\u062a\u064a \u0647\u064a \u0643\u0627\u0646\u062a \u0627\u0645 \u0648\u0644\u0630\u0629</li>\n<li>\u062d\u0631\u0633\u0629 \u0627\u0644\u0644\u0647 \u0648\u0628\u0642\u064a\u064a\u062a \u0647\u0630\u0647 \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0629 \u0648\u0627\u062e\u062a\u0647\u0627 \u0639\u0646\u062f\u0646\u0627</li>\n<li>\u0648\u0627\u0644\u0648\u0644\u062f \u0648\u0647\u0648 \u0644\u0627 \u064a\u0642\u062f\u0631 \u064a\u0635\u0647\u0631 \u0643\u0648\u0641 \u0645\u0646 \u0627\u0644\u0640\u05db\u05d5\u05e9\u05d9\u05dd \u0628\u0633\u0628\u0628 \u0645\u0646 \u0643\u0627\u0646</li>\n<li>\u064a\u0635\u062d\u0628\u0647 \u0641\u0627\u0644\u0632\u0645\u0646\u0647 \u0628\u0627\u064a\u062c\u0627\u0631\u0629 \u0627\u062d\u062f \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0648\u062a\u0633\u064a\u0631 \u0647\u0630\u0647</li>\n<li>\u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0649 \u0645\u0646 \u0630\u0643\u0631\u062a \u0627\u0646\u0647\u0648 \u0627\u0628\u0646 \u0639\u0645\u0647\u0627 \u0627\u0644\u0645\u0642\u064a\u0645 \u0628\u0645\u0635\u0631 \u0648\u064a\u0648\u0639\u0631\u0641</li>\n<li>\u0628\u0627\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0645\u0639\u0644\u0649 \u0645\u0646\u0635\u0648\u0631 \u0627\u0628\u0646 \u0645\u0648\u0633\u0629 \u0627\u0628\u0646 \u0645\u062e\u0634\u0648\u0644 \u0627\u0644\u0643\u0627\u0645\u0643\u064a</li>\n<li>\u0627\u0644\u0642\u0631\u0627 \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0629 \u0648\u0627\u0644\u0627 \u0628\u0644\u062f \u064a\u0643\u0648\u0646 \u0641\u064a\u0647 \u05d9\u05e9\u05e8\u05d0\u05dc \u0627\u0630 \u0645\u0627</li>\n<li>\u064a\u0645\u0643\u0646 \u0644\u0645\u062b\u0644\u0647\u0627 \u0627\u0644\u0645\u0642\u0627\u0645 \u0639\u0646\u062f\u0646\u0627 \u0648\u0643\u062a\u0628\u0646\u0627 \u0647\u0630\u0647 \u0627\u0644\u0627\u062d\u0631\u0641 \u0627\u0644\u0649 \u0633\u064a\u062f\u064a</li>\n<li>\u0627\u0644\u0641\u0631\u0646\u0633 \u062d\u0631\u0633\u0629 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u064a\u062f \u0631\u0633\u0648\u0644\u0646\u0627 \u0627\u0644\u0648\u0627\u0635\u0644 \u0635\u0648\u062d\u0628\u062a\u0647\u0627</li>\n<li>\u0644\u062a\u0642\u0641 \u0639\u0644\u0649 \u0645\u0636\u0645\u0648\u0646\u0647\u0627 \u0648\u062a\u0646\u0639\u0645 \u0628\u062a\u0633\u0644\u064a\u0645\u0647\u0627 \u0645\u0646\u0647 \u0648\u062a\u0648\u0635\u0644\u0647\u0627 \u0627\u0644\u0649</li>\n<li>\u0627\u0628\u0646 \u0639\u0645\u0647\u0627 \u0627\u0644\u0645\u0648\u0642\u062f\u0645 \u0630\u0643\u0631\u0647 \u0627\u0648 \u062a\u0641\u0639\u0644 \u0641\u064a \u0628\u0627\u0628\u0647\u0627 \u0645\u0627 \u064a\u062c\u0628</li>\n<li>\u0641\u0639\u0644\u0647 \u0645\u0639 \u0645\u062b\u0644\u0647\u0627 \u05d5\u05e9\u05dc\u05d5\u05de\u05da \u05d9\u05e8\u05d1\u05d4 \u05dc\u05e2\u05d3 \u05d0\u05de\u05df</li></ol>\n",
