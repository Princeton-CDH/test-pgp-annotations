      "body": [
        {
          "type": "TextualBody",
          "label": "Right Margin",
          "value": "\n<ol><li>\u0648\u0643\u062a\u0628\u062a \u0628\u062d\u0633\u0628 \u0627\u0644\u062f\u0627\u0644\u0629 \u0648\u0627\u0644\u0627\u0646\u0643\u0633\u0627\u062d \u0643\u062a\u0627\u0628 \u0627\u0644\u0649 \u0627\u0644\u0648\u0627\u0644\u062f\u064a\u0646 \u062d\u0631\u0633\u0647\u0645\u0627 \u0627\u0644\u0644\u0647 \u0631\u0627\u063a\u0628\u0627 \u0627\u0644\u0649 \u0645\u0648\u0644\u0626\u064a \u0648\u0631\u0626\u064a\u0633\u064a \u0643\u0628\u062a \u0627\u0644\u0644\u0647 \u0639\u062f\u0627\u0647</li>\n<li>\u0644\u0639\u0644\u0629 \u064a\u0631\u0627\u0639\u064a \u0645\u0646 \u0627\u0647\u0644 \u0637\u0644\u064a\u0637\u0644\u0647 \u062a\u062c\u0627\u0631 \u0627\u0648 \u0645\u0646 \u0642\u062f \u0627\u0646\u0635\u0631\u0641 \u0645\u0646 \u0627\u0644\u062d\u062c \u0645\u0646 \u0645\u063a\u0631\u064a\u0637 \u0644\u0639\u0644 \u064a\u0648\u0635\u0644\u0647 \u0627\u0644\u064a\u0647\u0645\u0627 \u0627\u0628\u0642\u0627\u0647\u0645\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0633\u0644\u0627\u0645</li></ol>\n",
