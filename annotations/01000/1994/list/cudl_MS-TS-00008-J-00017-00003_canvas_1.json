      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-J-00017-00003/canvas/1",
          "type": "Canvas",
