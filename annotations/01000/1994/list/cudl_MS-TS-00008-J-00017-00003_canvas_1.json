      "body": [
        {
          "type": "TextualBody",
          "label": "margin",
          "value": "<p>\u0648\u0644\u0648 \u0627\u0645\u0643\u0646\u0646\u064a \u0643\u0646\u062a \u0639\u0648\u0636 \u0627\u0644\u0631\u0642\u0639\u0629 \u0648\u0627\u0645\u0627 \u0627\u0644\u062d\u0627\u0644 \u0643\u0645\u0627 \u0644\u0627 \u064a\u062e\u0641\u0627 \u0639\u0646\u0643 \u0648\u062a\u0648\u0635\u0644\u064a</p>\n<p>\u0633\u0644\u0627\u0645\u064a \u0644\u0644\u0627\u0648\u0644\u0627\u062f \u05d9\u05e9 \u05e6\u05d5 \u0648\u0644\u0644\u0635\u0628\u064a\u0629 \u0647\u0642\u0628\u0629 \u064a\u062c\u0628\u0631 \u0635\u062f\u0639\u0647\u0627 \u0648\u064a\u0642\u0644 \u0642\u0644\u0628\u0647\u0627 \u05d5\u05e9\u05dc\u05d5\u05dd</p>",
