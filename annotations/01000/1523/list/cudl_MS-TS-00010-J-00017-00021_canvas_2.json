          "label": "Verso, left margin (right margin in original orientation, per Gil)",
          "value": "<ol>\n<li><span lang=\"he\">\u05d5\u05d0\u05d1\u05df \u05d0\u05dc\u05db\u05d9\u05e8</span></li>\n<li><span lang=\"he\">\u05d9\u05e7\u05e8\u05d9 \u05d0\u05d1\u05d9</span></li>\n<li><span lang=\"he\">\u05e1\u05e2\u05d3</span></li>\n<li><span lang=\"he\">\u05d5\u05de\u05e0\u05e1\u05d5\u05db\u05d4</span></li>\n<li><span lang=\"he\">\u05d0\u05e4\u05e6\u05dc \u05d0\u05dc</span></li>\n<li><span lang=\"he\">\u05e1\u05dc\u05dd</span></li>\n<li><span lang=\"he\">\u05d5\u05d0\u05e0\u05d0</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05e8\u05d4\u05d9\u05dd</span></li>\n<li><span lang=\"he\">\u05d1\u05df \u05d0\u05d1\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05d7\u05d9</span></li>\n<li><span lang=\"he\">&nbsp;\u05e0\u05e7\u05e8\u05d9\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05e1\u05dc\u05dd</span></li>\n</ol>",
