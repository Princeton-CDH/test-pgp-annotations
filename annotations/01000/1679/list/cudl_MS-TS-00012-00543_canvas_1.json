      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0646\u0642\u0648\u0644 \u0646\u062d\u0646 \u05e7\u05d4\u05dc \u05de\u05e0\u05d9\u05d9\u05d4 \u0632\u0641\u062a\u0627 \u062c\u0648\u0627\u062f \u0627\u0646 \u0644\u0645\u0627 \u0648\u0631\u062f \u0639\u0644\u064a\u0646\u0627 \u05d2\u05d6\u05d9\u05e8\u05ea</li>\n<li>\u05d4\u05de\u05dc\u05da \u05d1\u05e2\u05d5\u05d5\u05e0\u05d5\u05ea\u05d9\u05e0\u05d5 \u05d4\u05e8\u05d1\u05d9\u05dd \u05d1\u05d7\u05d3\u05e9 \u05d0\u05d1 \u05e9\u05e0\u05ea \u05d0\u05ea\u05e7\u05e2\u05d5 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea</li>\n<li>\u0627\u062e\u0631\u062c\u0646\u0627 \u0645\u0646 \u0627\u0644\u0636\u0639\u0641 \u0642\u0648\u0648\u0629 \u0648\u0634\u0627\u0631\u0643\u0646\u0627 \u05d9\u05e9\u05e8\u05d0\u05dc \u0641\u064a \u0634\u062f\u0627\u0626\u0626\u062f\u0647\u0645</li>\n<li>\u0639\u0644\u0649 \u0639\u062f\u0645 \u0642\u062f\u0631\u062a\u0646\u0627 \u0648\u0636\u0639\u0641\u0646\u0627 \u0648\u0641\u0642\u0631\u0646\u0627 \u0645\u0631\u062a\u064a\u0646 \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629</li>\n<li>\u062a\u0627\u0631\u064a\u0643\u0647\u0627 \u062b\u0627\u0646\u064a \u0639\u0634\u0631 \u05d0\u05d1 \u0633\u0646\u0629 \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629</li>\n<li>\u062a\u0627\u0631\u064a\u0643\u0647\u0627 \u062b\u0627\u0645\u0646 \u05de\u05e8\u05d7\u05e9\u05d5\u05df \u05e9\u05e0\u05ea \u05d0\u05ea\u05e7\u05e2\u05d6 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u0648\u0647\u0630\u0627</li>\n<li>\u062a\u0641\u0635\u064a\u0644 \u0645\u0627 \u0627\u0648\u0631\u062f\u0646\u0627\u0647 \u0641\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u0643\u064a\u0646 \u0628\u062a\u0641\u0635\u064a\u0644 \u0627\u0633\u0627\u0645\u064a\u0646\u0627</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0645\u0643\u064a\u0646 \u0628\u0646 \u0645\u062e\u062a\u0627\u0631 \u0641\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u0643 \u0627\u0644\u0627\u0648\u0644 \u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0639\u0644\u0627</li>\n\n<p></p>\n\n<li>\u0628\u0646 \u0641\u062a\u0648\u062d \u0639\u0637\u0627\u0631 \u0627\u0648\u0644 \u062a\u0627\u0631\u064a\u0643 \u0648\u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0634\u064a\u0643 \u05d9\u05d5\u05e1\u05e3 \u0627\u0644\u062d\u0643\u064a\u0645 \u0641\u064a \u0627\u0644\u0627\u0648\u0644</li>\n\n<p></p>\n\n<li>\u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0627\u0644\u0643\u0647\u0646 \u0628\u0646 \u0631\u0627\u0636\u064a \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0641\u0642\u0637 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0628\u0646 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a</li>\n\n<p></p>\n\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0633\u062d\u0627\u0642 \u0628\u0646 \u0641\u062a\u0648\u062d \u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0627\u0628\u0648 \u0627\u0644\u0631\u0636\u0627 \u0627\u062e\u0648\u0647</li>\n\n<p></p>\n\n<li>\u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0627\u0628\u0648 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0637\u0628\u064a\u0628 \u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0633\u0631\u0648\u0631 \u0635\u0627\u0626\u063a</li>\n\n<p></p>\n\n<li>\u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0648\u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a \u0645\u0648\u0633\u0649 \u0628\u0646 \u0627\u0644\u0643\u0647\u0646 \u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u0645\u062e\u0644\u0635 \u0627\u0648\u0644 \u0648\u062b\u0627\u0646\u064a</li>\n\n<p></p>\n\n<li>\u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u0648\u0631 \u0628\u0646 \u0627\u0628\u0631\u0647\u064a\u0645 \u0641\u064a \u0627\u0644\u0627\u0648\u0644 \u0641\u0642\u0637 \u0645\u0643\u064a\u0646 \u0648\u0632\u0643\u064a \u0627\u0648\u0644\u0627\u062f \u0627\u0628\u0631\u0647\u064a\u0645 \u0627\u0648\u0644 \u0648\u062b\u0627\u0646\u064a</li>\n\n<p></p>\n\n<li>\u05d9\u05d5\u05e1\u05e3 \u05db\u05d4\u05df \u0635\u0627\u0645\u0646 \u0627\u062a\u0641\u0647\u0646\u0627 \u0627\u0648\u0644 \u0648\u062b\u0627\u0646\u064a \u0627\u0628\u0648 \u0639\u0644\u0649 \u0635\u0627\u0645\u0646 \u05ea\u05e7 \u0627\u0648\u0644 \u0648\u062b\u0627\u0646\u064a</li>\n\n<p></p>\n\n<li>\u0627\u0628\u0631\u0647\u064a\u0645 \u0628\u0646 \u0628\u064a\u0627\u0646 \u0639\u0646 \u0633\u0646\u062f \u0627\u0644\u0643\u0647\u0646 \u0648\u0635\u062d \u062c\u0645\u0644\u0629 \u0645\u0627 \u0627\u0648\u0631\u062f\u0646\u0627\u0647 \u0641\u064a</li>\n\n<p></p>\n\n<li>\u0627\u0644\u062a\u0627\u0631\u064a\u0643\u064a\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u0627\u0644\u0649 \u0633\u0644\u0643 \u0627\u0644\u0633\u0627\u0628\u0639 \u05de\u05d7\u05d3\u05e9 \u05d0\u05d3\u05e8 \u05e9\u05e0\u05ea</li>\n<li>\u05d0\u05ea\u05e7\u05e2\u05d6 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u05d0\u05dc\u05e3 \u05d3\u05e8\u05d4\u05dd \u0648\u0639\u0634\u0631\u064a\u0646 \u05d3\u05e8\u05d4\u05dd \u0648\u0646\u0635\u0641 \u0648\u0631\u0628\u0639</li>\n<li>\u0648\u0628\u0630\u0644\u0643 \u0648\u0636\u0639\u0646\u0627 \u062e\u0637\u0648\u0637\u0646\u0627 \u0628\u0635\u062d\u0629 \u0645\u0627 \u0646\u0633\u0628 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0643\u062a\u0648\u0628</li>\n<li>\u05e2\u05d6\u05d9\u05d4 \u05d1\u05e8 \u05e4\u05ea\u05d7\u05d9\u05d4 \u05e0\u05e2 \u05e2\u05d5\u05d1\u05d3\u05d9\u05d4 \u05d1\u05e8 \u05d8\u05d4\u05e8 \u05e0\u05e2 \u05e0\u05ea\u05df \u05d1\u05e8 \u05e0\u05e2</li>\n<li>\u05e9\u05dc\u05d4 \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d1\u05e8 \u05d0\u05dc\u05e2\u05d6\u05e8 \u05e0\u05e2 \u05d0\u05d4\u05e8\u05df</li>\n<li>\u05d9\u05d5\u05e1\u05e3</li></ol>\n",
