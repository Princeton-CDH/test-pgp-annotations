          "value": "<p>\u0648\u0644\u0632\u0648\u062c\u062a\u064a \u0639\u0644\u0649 \u05dc \u062f\u064a\u0646\u0627\u0631 \u0645\u0648\u0648\u0643\u0631 \u062a\u062f\u0641\u0639 \u0644\u0647\u0627 \u0648\u0644\u064a \u0639\u0646\u062f \u0627\u0628\u0648 \u0646\u0635\u0631 \u0627\u0644\u0635\u064a\u0631\u0641\u064a \u0627\u0644\u0643\u0647\u0646 \u0634\u062a \u062f\u0631\u0647\u0645</p>\n<p>\u062a\u0635\u0631\u0641 \u0641\u064a\u0645\u0627</p>",
