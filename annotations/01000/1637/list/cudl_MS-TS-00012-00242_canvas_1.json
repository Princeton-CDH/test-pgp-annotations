        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0630\u0643\u0631\u0627 \u0627\u0646 \u0643\u0627\u0646 \u0642\u062f \u0627\u0635\u062f\u0631 \u0627\u0644\u064a\u0647\u0627</li>\n<li>\u05d9 \u0627\u0631\u062c\u0648 \u0648\u0635\u0648\u0644\u0647 \u0648\u0627\u0639\u0631\u0641 \u062d\u0635\u0631\u062a\u0647 \u0627\u0644\u0633\u0627\u0645\u064a\u0629</li>\n<li>\u0646\u0627\u0633 \u0648\u0642\u062f \u062a\u0648\u0641\u064a\u062a \u0627\u0644\u0627\u0645 \u0645\u0630 \u0633\u0628\u0639\u0629</li>\n<li>\u0633\u0646\u064a\u0646 \u0648\u0643\u062b\u0631\u062a \u0627\u0644\u0634\u0646\u0627\u0639\u0629 \u0639\u0644\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0646 \u0632\u0648\u062c\u0647\u0627 \u0645\u0646</li>\n<li>\u0639\u0646\u062f\u0647\u0627 \u0648\u0634\u0646\u0639\u0627\u062a \u0642\u0628\u064a\u062d\u0629 \u062c\u062f\u0627 \u0648\u0635\u0627\u062d \u0627\u0644\u0646\u0627\u0633 \u0641\u0627\u0633\u062a\u062f\u0639\u064a\u062a\u0647</li>\n<li>\u0648\u062e\u0627\u0637\u0628\u062a\u0647 \u0628\u0627\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0647\u0630\u0627 \u0627\u0644\u0631\u062c\u0644 \u0645\u0646 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u064a\u0647 \u0641\u0635\u0639\u0628 \u0639\u0644\u064a\u0647</li>\n<li>\u0630\u0644\u0643 \u0643\u062b\u064a\u0631 \u0648 \u0630\u0647 \u0627\u0646 \u0647\u0630\u0627 \u0627\u0644\u0631\u062c\u0644 \u0639\u0644\u064a \u0645\u0627 \u0630\u0643\u0631 \u0627\u0644\u0646\u0627\u0633 \u064a\u0646\u0641\u0642 \u0639\u0644\u064a\u0647\u0645 \u0646\u0641\u0642\u0629 \u063a\u064a\u062f\u0629 \u0627\u0644\u0646\u0627\u0633 \u064a\u0646\u0641\u0642</li>\n<li>\u0639\u0644\u064a\u0647\u0645 \u0646\u0641\u0642\u0647 \u063a\u064a\u062f\u0629 \u0641\u0644\u0645\u0627 \u0643\u0627\u0646 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0627\u0633\u0628\u0648\u0639 \u0632\u0627\u062f \u0627\u0644\u0639\u0631\u0639\u0648\u0631</li>\n<li>\u0639\u0644\u064a\u0647\u0645 \u0648\u0627\u0633\u062a\u062c\u0627\u062a \u0627\u0644\u0646\u0627\u0633 \u0641\u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0647 \u064a\u062d\u0636\u0631 \u0627\u0644\u0649 \u0639\u0646\u062f \u0627\u0644\u0645\u0633\u062a\u063a\u064a\u062a\u064a\u0646</li>\n<li>\u0641\u0642\u0627\u0644 \u0641\u064a \u062c\u062f \u0627\u062c\u064a \u0648\u0627\u0635\u0628\u062d \u0637\u0644\u0628\u0646\u0627\u0647 \u0641\u0642\u0627\u0644\u062a \u0632\u0648\u062c\u062a\u0647 \u0642\u062f \u0645\u0636\u0627 \u0627\u0644\u0649 \u0645\u0635\u0631</li>\n<li>\u064a\u0633\u062a\u063a\u064a\u062a \u0641\u064a \u0627\u0644\u062d\u0632\u0627\u0646 \u0648\u0644\u064a\u0644\u0647 \u0645\u0633\u064a\u0631\u0629 \u0639\u0648\u0644\u0648 \u0627\u0644\u0646\u0627\u0633 \u0639\u0646 \u064a\u0648\u0642\u0639\u0648 \u0627\u0644\u062e\u0635\u0645</li>\n<li>\u0641\u064a \u064a\u062f \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0641\u0642\u0627\u0644 \u0627\u0646\u0627 \u0627\u062d\u0644\u0641 \u0627\u0646\u0646\u064a \u0644\u0627 \u0631\u062c\u0639\u062a \u062f\u062e\u0644\u062a \u0627\u0644\u0649 \u0639\u0646\u062f \u0647\u0630\u0647</li>\n<li>\u0627\u0644\u0627\u0645\u0631\u0627\u0629 \u0641\u0627\u0642\u0646\u064a \u0645\u0646\u0647 \u0648\u0627\u0642\u062f\u0634 \u062f\u064a\u0646\u0631\u064a\u0646 \u0627\u0646 \u0639\u0627\u0648\u062f \u062f\u062e\u0644 \u0627\u0644\u064a\u0647\u0627 \u0648\u0627\u064a\u0636\u0627</li>\n<li>\u0627\u0639\u0631\u0641 \u062d\u0636\u0631\u062a\u0647 \u0627\u0646 \u0639\u0646\u062f\u0646\u0627 \u0627\u0646\u0633\u0627\u0646 \u064a\u0633\u062a\u062c\u064a\u062a \u0648\u064a\u0642\u0648\u0644 \u0644\u064a \u0645\u0639 \u0632\u0648\u062c\u062a\u064a</li>\n<li>\u0633\u0646\u062a\u064a\u0646 \u0648\u0644\u0645 \u062a\u0645\u0643\u0646\u064a \u0645\u0646 \u0646\u0641\u0633\u0647\u0627 \u0641\u0627\u062d\u0636\u0631\u0646\u0627\u0647\u0627 \u0648\u0642\u0627\u0644\u062a \u0627\u0644\u0630\u064a \u0642\u0627\u0644 \u0635\u062d\u064a\u062d</li>\n<li>\u0648\u0645\u0627 \u0644\u064a \u0642\u062f\u0631\u0629 \u0627\u0646 \u064a\u0644\u062a\u0632\u0642 \u0627\u0644\u064a\u0647 \u0631\u062c\u0644 \u0648\u0639\u0645\u0631 \u0647\u0630\u0647 \u0627\u0644\u062c\u0627\u0631\u064a\u0629 \u0646\u064a\u0641 \u062b\u0644\u062b\u0629</li>\n<li>\u0639\u0634\u0631 \u0633\u0646\u0629 \u05d5\u05d4\u05d9\u05d4 \u05d9\u05ea\u05d5\u05de\u05d4 \u0648\u0642\u062f \u0637\u0644\u0628 \u0637\u0644\u0627\u0642\u0647\u0627 \u0648\u0627\u064a\u0636\u0627 \u0647\u064a\u0629 \u062a\u0637\u0644\u0628 \u0627\u0644\u0637\u0644\u0627\u0642</li>\n<li>\u0641\u0627\u0634\u062a\u0647\u064a \u0645\u0646 \u062d\u0636\u0631\u062a\u0647 \u0627\u0646 \u062a\u0639\u0631\u0641 \u0645\u0645\u0644\u0648\u0643\u0647\u0627 \u0647\u0644 \u064a\u0632\u0645\u0645 \u0647\u0644 \u064a\u0644\u0632\u0645 \u0627\u0644\u0631\u062c\u0644</li>\n<li>\u0648\u0632\u0646 \u0627\u0644\u0645\u0648\u0643\u0631 \u0627\u0644\u0630\u064a \u0641\u064a \u0627\u0644\u0643\u062a\u0648\u0628\u0629 \u05d0\u05dd \u0644\u0627 \u0627\u0648 \u064a\u062c\u0648\u0632 \u0627\u0646 \u064a\u062a\u0632\u0648\u062c \u0627\u062e\u0631\u0647 \u0645\u0639\u0647\u0627</li>\n<li>\u0627\u0645 \u0644\u0627 \u0648\u0639\u064a\u0646\u064a \u0627\u0644\u0639\u0628\u062f \u0634\u0627\u062e\u0635\u0647 \u0627\u0644\u0649 \u0645\u0627 \u064a\u0635\u0644\u0647 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0639\u0646\u0649</li>\n<li>\u0641\u0627\u0646 \u0627\u0644\u0632\u0648\u062c \u0645\u0633\u062a\u062c\u064a\u062a \u0644\u064a\u0644 \u0648\u0646\u0647\u0627\u0631 \u0648\u064a\u062d\u0645\u0644 \u0627\u0644\u0646\u0627\u0633 \u0639\u0644\u064a\u0647 \u0648\u0627\u0633\u0644</li>\n<li>\u062d\u0636\u0631\u062a\u0647 \u0627\u0644\u0633\u0627\u0645\u064a\u0629 \u0627\u0646 \u062a\u0628\u0633\u0637 \u0639\u0630\u0631 \u0645\u0645\u0644\u0648\u0643\u0647\u0627 \u0641\u064a \u0643\u062a\u0628 \u0647\u0630\u0647</li>\n<li>\u0627\u0644\u0627\u062d\u0631\u0641 \u0641\u0627\u0644\u0644\u0647 \u064a\u0639\u0644\u0645 \u0627\u0646\u0646\u064a \u0645\u0627 \u0643\u062b\u0628\u062a\u0647</li></ol>\n",
          "format": "text/html"
        }
      ],
