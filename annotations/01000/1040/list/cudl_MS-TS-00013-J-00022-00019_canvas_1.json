      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u064a\u0627 \u0628\u0646\u064a \u0627\u0648\u0635\u064a\u0643 \u0628\u062a\u0642\u0648\u0649 \u0627\u0644\u0644\u0647 \u0641\u064a \u0627\u0644\u063a\u064a\u0628 \u0648\u0627\u0644\u0634\u0647\u0627\u062f\u0629</li>\n<li>\u0648\u0643\u0644\u0645\u0629 \u0627\u0644\u062d\u0642 \u0641\u064a \u0627\u0644\u0631\u0636\u0627 \u0648\u0627\u0644\u063a\u0636\u0628 \u0648\u0627\u0644\u0642\u0635\u062f \u0641\u064a \u0627\u0644\u063a\u0646\u0627</li>\n<li>\u0648\u0627\u0644\u0641\u0642\u0631 \u0648\u0627\u0644\u0639\u062f\u0644 \u0641\u064a \u0627\u0644\u0635\u062f\u064a\u0642 \u0648\u0627\u0644\u0639\u062f\u0648 \u0648\u0627\u0644\u0639\u0645\u0644 \u0641\u064a</li>\n<li>\u0627\u0644\u0646\u0634\u0627\u0637 \u0648\u0627\u0644\u062e\u0633\u0644 \u0648\u0627\u0644\u0631\u0636\u0627 \u0639\u0646 \u0627\u0644\u0644\u0647 \u0641\u064a \u0627\u0644\u0634\u062f\u0629 \u0648\u0627\u0644\u0631\u0636\u0627</li>\n<li>\u064a\u0627 \u0628\u0646\u064a \u0645\u0646 \u0627\u0628\u0635\u0631 \u0639\u064a\u0628 \u0646\u0641\u0633\u0647 \u0634\u063a\u0644 \u0639\u0646 \u0639\u064a\u0628</li>\n<li>\u063a\u064a\u0631\u0647 \u0648\u0645\u0646 \u0631\u0636\u0649 \u0628\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0644\u0645 \u064a\u062d\u0632\u0646 \u0639\u0644\u0649 \u0645\u0627</li>\n<li>\u0648\u0645\u0646 \u0633\u0644 \u0633\u064a\u0641 \u0628\u063a\u064a \u0642\u062a\u0644 \u0628\u0647 \u0648\u0645\u0646 \u062d\u0641\u0631 \u0644\u0627\u062e\u064a\u0629</li>\n<li>\u0627\u0644\u0645\u0648\u0645\u0646 \u0628\u064a\u0631\u0627 \u0648\u0642\u0639 \u0641\u064a\u0647\u0627 \u0648\u0645\u0646 \u0647\u062a\u0643 \u0627\u062e\u064a\u0629 \u062e\u0634\u0641</li>\n<li>\u0639\u0648\u0627\u062a \u0628\u064a\u062a\u0647 \u0648\u0645\u0646 \u0646\u0633\u0649 \u062e\u0637\u064a\u062a\u0647 \u0627\u0633\u062a\u0639\u0638\u0645</li>\n<li>\u062e\u0637\u064a\u0629 \u063a\u064a\u0631\u0647 \u0648\u0645\u0646 \u0627\u0639\u062c\u0628 \u0628\u0631\u0627\u064a\u0629 \u0635\u0644 \u0648\u0645\u0627</li>\n<li>\u0648\u0645\u0646 \u062a\u062e\u0628\u0631 \u0639\u0644 \u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0646\u0627\u0633 \u062f\u0644 \u0648\u0645\u0646 \u062e\u0627\u0644\u0637</li>\n<li>\u0627\u0644\u0627\u0646\u062f\u0627\u0644 \u0627\u062d\u062a\u0642\u0631 \u0648\u0645\u0646 \u062f\u062e\u0644 \u0645\u062f\u062e\u0644 \u0627\u0644\u0633\u0648 \u0627\u062a\u0647\u0645</li>\n<li>\u0648\u0645\u0646 \u062c\u0627\u0644\u0633 \u0627\u0644\u0639\u0644\u0645\u0627 \u0648\u0642\u0631 \u0648\u0645\u0646 \u0645\u0632\u062d \u0627\u062a\u062e\u0641 \u0628\u0647</li>\n<li>\u0648\u0645\u0646 \u0627\u0643\u062b\u0631 \u0645\u0646 \u0634\u064a \u0639\u0631\u0641 \u0628\u0647 \u0648\u0645\u0646 \u0643\u062b\u0631 \u0643\u0644\u0627\u0645\u0647</li>\n<li>\u0643\u062b\u0631 \u062e\u0637\u0627\u0648\u0647 \u0648\u0645\u0646 \u0643\u062b\u0631 \u062e\u0637\u0627\u0648\u0629 \u0642\u0644 \u062d\u064a\u0627\u0648\u0629</li>\n<li>\u0648\u0645\u0646 \u0642\u0644 \u062d\u064a\u0627\u0648\u0629 \u0642\u0644 \u0648\u0631\u0639\u0629 \u0648\u0645\u0646 \u0642\u0644 \u0648\u0631\u0639\u0629</li>\n<li>\u0645\u0627\u062a \u0642\u0644\u0628\u0647 \u0648\u0645\u0646 \u0645\u0627\u062a \u0642\u0644\u0628\u0647 \u062f\u062e\u0644 \u0627\u0644\u0646\u0627\u0631</li>\n<li>\u064a\u0627 \u0628\u0646\u064a \u0627\u0644\u0627\u0630\u0628 \u062e\u064a\u0631 \u0645\u064a\u0632\u0627\u0646 \u0648\u062d\u0633\u0646 \u0627\u0644\u062e\u0644\u0642 \u062e\u064a\u0631</li>\n<li>\u0642\u0631\u064a\u0646 \u064a\u0627 \u0628\u0646\u064a \u0627\u0644\u0639\u0627\u0642\u0628\u0629 \u0639\u0634\u0631\u0629 \u0627\u062c\u0632\u0627</li>\n<li>\u062a\u0633\u0639\u0629 \u0645\u0646\u0647\u0627 \u0641\u064a \u0627\u0644\u0636\u0645\u062a \u0627\u0644\u0627 \u0639\u0646 \u0630\u0643\u0631 \u0627\u0644\u0644\u0647</li>\n<li>\u062a\u0639\u0627\u0644\u0649 \u0648\u0627\u062d\u062f \u0641\u064a \u062a\u0631\u0643 \u0645\u062c\u0627\u0644\u0633 \u0627\u0644\u0633\u0641\u0647\u0627 \u064a\u0627 \u0628\u0646\u064a</li>\n<li>\u0632\u064a\u0646\u0629 \u0627\u0644\u0641\u0642\u0631 \u0627\u0644\u0635\u0628\u0631 \u0648\u0632\u064a\u0646\u0629 \u0627\u0644\u063a\u0646\u0627 \u0627\u0644\u0634\u0643\u0631 \u064a\u0627</li>\n<li>\u0628\u0646\u064a \u0644\u0627 \u0643\u0631\u0645 \u0627\u0639\u0632 \u0645\u0646 \u0627\u0644\u062a\u0642\u0648\u0627 \u0648\u0644\u0627 \u0645\u0639\u0642\u0644</li>\n<li>\u0627\u062d\u0631\u0632 \u0645\u0646 \u0627\u0644\u0648\u0631\u0639 \u0648\u0644\u0627 \u0634\u0641\u064a\u0639 \u0627\u0646\u062c\u062d \u0645\u0646 \u0627\u0644\u062a\u0648\u0628\u0629</li>\n<li>\u0648\u0644\u0627 \u0644\u0628\u0627\u0633 \u0627\u062c\u0645\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0641\u064a\u0629 \u0627\u0644\u062d\u0631\u0636 \u0645\u0641\u062a\u0627</li>\n<li>\u0645\u0641\u062a\u0627\u062d \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0642\u062a \u0648\u0645\u0637\u064a\u0629 \u0627\u0644\u0646\u0635\u0628</li>\n<li>\u0627\u0644\u062a\u0630\u0643\u064a\u0631 \u0642\u0628\u0644 \u0627\u0644\u0639\u0645\u0644 \u064a\u0648\u0645\u0646\u0643 \u0627\u0644\u0646\u062f\u0645 \u0628\u064a\u0633</li>\n<li>\u0627\u0644\u0632\u0627\u062f \u0644\u0644\u0645\u0639\u0627\u062f \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u063a\u0646\u064a \u0637\u0648\u0628\u0627</li>\n<li>\u0644\u0645\u0646 \u0627\u062e\u0644\u0635 \u0644\u0644\u0647 \u0639\u0644\u0645\u0647 \u0648\u0639\u0644\u0645\u0647 \u0648\u0639\u0645\u0644\u0647</li>\n<li>\u0648\u062d\u0628\u0647 \u0648\u0628\u063a\u0636\u0647 \u0648\u0627\u0647 \u062a\u0648\u0629 \u0648\u0643\u0644\u0627\u0645\u0647</li>\n<li>\u0648\u0636\u0645\u062a\u0647 \u0646\u0642\u0648\u0644\u0647</li></ol>\n",
