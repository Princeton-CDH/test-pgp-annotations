          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0643\u062a\u0627\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0644\u0634\u064a\u0643 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0647 \u0648\u0633\u0644\u0627\u0645\u062a\u0647 \u0648\u0646\u0639\u0645\u0627\u0647 \u0648\u0643\u0628\u062a \u0627\u0639\u062f\u0627\u0647 \u05dc\u05d7 \u0628\u0642\u0649 \u0645\u0646 \u05d0\u05d1 \u05d9\u05d4\u05e4\u05da \u05dc\u05e9\u05de\u05d7\u05d4 \u0628\u0639\u062f \u0627\u0646 \u062a\u0642\u062f\u0645\u062a \u0643\u062a\u0628\u064a \u0627\u0644\u064a\u0643 \u0635\u062d\u0628\u0629 \u05d1\u05e8\u05d5\u05da \u0627\u0631\u062c\u0648 \u0648\u0635\u0648\u0644\u0647\u0627 \u0627\u0644\u064a\u0643 \u0627\u0639\u0644\u0645\u062a\u0643 \u0641\u064a\u0647\u0627 \u0627\u0646 \u0648\u0635\u0644 \u0645\u0631\u0643\u0628 \u0645\u0646 \u0627\u0644\u0645\u0647\u062f\u064a\u0629 \u0648\u0627\u0644\u0649 \u0627\u0644\u0633\u0639\u0629 \u0644\u0645 \u064a\u0635\u0644 \u0627\u062d\u062f \u0645\u0646 \u0627\u0637\u0631\u0627\u0628\u0644\u0633 \u0648\u0644\u0627 \u0645\u0646 \u0633\u0641\u0627\u0642\u0636 \u0648\u0627\u0646\u0627 \u0637\u0648\u0644 \u0646\u0647\u0627\u0631\u064a \u0639\u0644\u0649 \u0627\u0644\u0628\u062d\u0631 \u0641\u0627\u0631\u062c\u0648 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0642\u0637\u0639 \u0631\u062c\u0627\u0646\u0627 \u0628\u0631\u062d\u0645\u062a\u0647 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0644\u0643 \u0635\u062d\u0628\u0647 \u0643\u062a\u0627\u0628\u064a \u0647\u0627\u0630\u064a \u0643\u062a\u0627\u0628 \u0627\u0628\u0648 \u0633\u0647\u0644 \u0639\u0637\u0627 \u0648\u0643\u062a\u0627\u0628 \u05e0\u05e1\u05d9\u05dd \u0648\u0642\u062f \u0643\u0646\u062a \u0627\u062e\u0630\u062a \u0644\u0643 \u0645\u0646 \u062c\u0645\u0644\u0629 \u0627\u0644\u0643\u0627\u0641\u0648\u0631 \u0627\u0644\u0648\u0627\u0635\u0644 \u0631\u0628\u0639 \u0645\u0646 \u0648\u0644\u0645 \u064a\u0648\u062d\u062a\u0633\u0628 \u0639\u0644\u064a\u0643 \u0644\u0627 \u0646\u0642\u0635 \u0648\u0644\u0627 \u0645\u0627\u0648\u0646\u0629 \u0627\u0644\u0649 \u0648\u0635\u0648\u0644 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u0641\u0639\u0631\u0641\u0646\u0627\u0647 \u0635\u0648\u0631\u062a \u0627\u0644\u062d\u0627\u0644 \u0641\u0642\u0627\u0644 \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u0627\u0628\u062f \u0645\u0627 \u064a\u0648\u062d\u062a\u0633\u0628 \u0639\u0644\u064a\u0647 \u0628\u0627\u0644\u0646\u0642\u0635 \u0648\u0627\u0644\u0645\u0648\u0646\u0629 \u0648\u0642\u062f \u0646\u0642\u0635 \u062c\u0645\u0644\u062a\u0647 \u0646\u062d\u0648 \u05db\u05d4 \u062f\u0631\u0647\u0645 \u0648\u0627\u0644\u0645\u0627\u0648\u0646\u0629 \u062f\u064a\u0646\u0631\u064a\u0646 \u0648\u062a\u0644\u062a\u064a\u064a \u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0644\u0643 \u0648\u0642\u062f \u0630\u0643\u0631 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0646 \u0627\u0646\u0647 \u062a\u0631\u0643 \u0627\u0644\u0635\u0641\u0638 \u0627\u0644\u0630\u064a \u0627\u0634\u062a\u0631\u0627 \u0644\u064a \u0628\u064a\u062f\u0643 \u0641\u0646\u062d\u0628 \u0645\u0646\u0643 \u0644\u0639\u0644 \u062a\u0639\u064a\u062f\u0647 \u0644\u0635\u0627\u062d\u0628\u0647 \u0648\u0646\u062a\u0631\u0643\u0648 \u0644\u0647 \u0627\u0645\u0627 \u0642\u064a\u0631\u0637 \u0627\u0648 \u0642\u064a\u0631\u0637\u064a\u0646 \u0643\u064a\u0641 \u0645\u0627 \u0631\u0627\u064a\u062a\u0647 \u0644\u0627\u0646\u064a \u0642\u062f \u0627\u0634\u062a\u0631\u064a\u062a \u062b\u0645 \u0630\u0643\u0631\u062a \u0628\u064a\u0639 \u062d\u0648\u0627\u0626\u062c\u0643 \u0648\u0627\u0635\u0644\u0627\u062d \u0627\u0644\u062f\u0627\u0631 \u0648\u0627\u062c\u0627 \u0648\u0627\u0644\u0644\u0647 \u0641\u064a \u0647\u0627\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u062a\u062d\u062a \u0645\u0627 \u064a\u0639\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0634\u063a\u0644 \u0627\u0644\u0633\u0631 \u0648\u062a\u0639\u0644\u0642 \u0627\u0644\u0642\u0644\u0628 \u0627\u0633\u0644\u0629 \u0627\u0644\u0641\u0631\u062c \u0628\u0631\u062d\u0645\u062a\u0647 \u0648\u0627\u0639\u0644\u0645\u0643 \u0627\u0646 \u0648\u0635\u0644 \u0641\u064a \u0647\u0627\u0630\u0627 \u0627\u0644\u0627\u0633\u0628\u0648\u0639 \u0645\u0631\u0643\u0628 \u0627\u0646\u062f\u0644\u0633\u064a \u0645\u0646 \u0627\u0646\u062f\u0644\u0633 \u0645\u0646 \u062f\u0627\u0646\u064a\u0629 \u0641\u064a\u0647 \u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0645\u062e\u062a\u0627\u0631 \u0627\u0644\u062d\u0644\u0628\u064a \u05d5\u05d3\u05d0\u05d5\u05d3 \u05d1\u05df \u05e9\u05de\u05d7\u05d5\u05df \u0648\u0648\u0644\u062f \u0628\u0646 \u0644\u062e\u062a\u0648\u062c \u0648\u0627\u0628\u0646 \u0627\u0644\u0634\u0631\u0627\u0628\u064a \u0648\u0644\u0645 \u064a\u062f\u062e\u0644\u0648 \u0627\u0644\u0645\u0647\u062f\u064a\u0629 \u062c\u0645\u0644\u0629 \u0648\u0644\u064a\u0633 \u0639\u0646\u062f\u0647\u0645 \u062e\u0628\u0631 \u0648\u0641\u064a\u0647 \u062d\u0631\u064a\u0631 \u0627\u0646 \u0643\u062b\u064a\u0631 \u0648\u0628\u0636\u0627\u0626\u0639 \u0627\u0646 \u0643\u062b\u064a\u0631\u0629 \u0648\u0648\u0635\u0644 \u0645\u0646 \u0628\u0644\u062f \u0627\u0644\u0631\u0648\u0645 \u0645\u0646 \u062c\u0646\u0648\u0627 \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0631\u0627\u0643\u0628 \u0648\u064a\u0630\u0643\u0631\u0648 \u0627\u0646 \u064a\u0635\u0644 \u0645\u0646 \u0627\u0646\u062f\u0644\u0633 \u05d2 \u0645\u0631\u0627\u0643\u0628 \u063a\u064a\u0631 \u0647\u0627\u0630\u0627 \u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0644\u0643 \u0648\u0627\u0644\u0632\u064a\u062a \u0627\u0644\u062d\u0627\u0631 \u0644\u0639\u0644 \u062a\u0646\u0641\u062f\u0647 \u0627\u0644\u0644 \u0645\u0639 \u0645\u0646 \u064a\u0635\u0644\u062d \u0627\u0648 \u0627\u062a\u0631\u0643\u0647 \u0644\u0645\u0646 \u064a\u062c\u064a \u0641\u064a \u0627\u0644\u062e\u0644\u064a\u062c \u0644\u0627\u0646 \u0627\u0644\u0648\u0642\u062a \u0642\u0631\u0628 \u0648\u0642\u062f \u0642\u0631\u064a\u062a \u0643\u062a\u0627\u0628\u0643 \u0639\u0644\u0649 \u0632\u0648\u062c\u0647 \u0639\u0648\u0627\u0636 \u0646\u0639 \u0648\u0647\u0645 \u0634\u0627\u062e\u0631\u064a\u0646 \u0643\u062b\u064a\u0631 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u0645\u0639 \u0634\u0631\u064a\u0643\u0629 \u062a\u062d\u062a \u0648\u0642\u0641\u0629 \u0627\u0644\u0644\u0647 \u064a\u0635\u0644\u062d \u062d\u0627\u0644\u0629 \u0648\u062d\u0627\u0644\u0646\u0627 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0635\u062d\u0628\u0629 \u0645\u064a\u0645\u0648\u0646 \u062c\u0644\u0627\u0645 \u0645\u0648\u0644\u0626\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0627\u0644\u0628\u0634\u0631 \u0627\u0632\u0647\u0631 \u0627\u0644\u0645\u0642\u0637\u0639 \u0627\u0644\u0630\u064a \u0644\u0643 \u0627\u0631\u062c\u0648 \u0648\u0635\u0648\u0644\u0647 \u0627\u0644\u064a\u0643 \u0648\u0642\u062f \u0630\u0643\u0631 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u0627\u0646 \u062f\u0641\u0639 \u0644\u0643 \u062f\u064a\u0646\u0631\u064a\u0646 \u0648\u0642\u0627\u0644 \u0627\u062f\u0641\u0639 \u0644\u064a \u0627\u0644\u0643\u0627\u0641\u0648\u0631 \u0627\u0644\u0630\u064a \u0644\u0645\u0648\u0644\u0627\u064a \u0648\u0627\u0646\u0627 \u0627\u062f\u0641\u0639\u0647 \u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0644\u0643 \u0648\u0644\u0639\u0644 \u062a\u0646\u0641\u062f \u0644\u064a \u0627\u0644\u0648\u0631\u062f \u0645\u0631\u0628\u0627 \u0627\u0644\u0630\u064a \u0630\u0643\u0631 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u0627\u0646\u0647 \u062a\u0631\u0643 \u0627\u0644\u0632\u0648\u064a\u062f \u0639\u0646\u062f \u0628\u0646 \u0637\u064a\u0628\u0627\u0646 \u062a\u062e\u062a\u0635 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0646\u0633\u064a\u0645 \u062d\u0641\u0636\u0629 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0642\u062f \u062f\u0641\u0639\u062a \u0643\u062a\u0627\u0628\u0643 \u0644\u0645\u0648\u0644\u0626\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0649 \u0627\u0644\u062d\u0633\u0646 \u0648\u0647\u0648 \u064a\u062e\u0635\u0643 \u0628\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u062a\u062e\u0635\u0643 \u0628\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u062a\u0642\u0631\u0627 \u0633\u0644\u0627\u0645\u064a \u0639\u0644\u0649 \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0634\u064a\u0643 \u05e8 \u05d9\u05e9\u05d5\u05e2\u05d4 \u0648\u062a\u0639\u0644\u0645\u0647 \u0634\u0648\u0642\u064a \u0627\u0644\u064a\u0647 \u05d5\u05e9\u05dc\u05d5\u05dd \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0648\u0627\u0644\u062f \u05e8\u05d1\u05e0\u05d5 \u05e0\u05d4\u05e8\u05d0\u05d9 \u0628\u064a\u0631 \u05e0\u05e1\u05d9\u05dd \u05d6\u05dc \u0634\u0627\u062e\u0631\u0647 \u05e0\u05ea\u05df \u05d1\u05df \u05e0\u05d4\u05e8\u05d0\u05d9 \u0646\u0639 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0643\u062a\u0627\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0644 \u0634\u064a\u0643 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0647 \u0648\u0633\u0644\u0627\u0645\u062a\u0647 \u0648\u0646\u0639\u0645\u0627\u0647 \u0648\u0643\u0628\u062a \u0627\u0639\u062f\u0627\u0647 \u05dc\u05d7 \u0628\u0642\u0649 \u0645\u0646 \u05d0\u05d1 \u05d9\u05d4\u05e4\u05da \u05dc\u05e9\u05de\u05d7\u05d4 \u0628\u0639\u062f \u0627\u0646 \u062a\u0642\u062f\u0645\u062a \u0643\u062a\u0628\u0649 \u0627\u0644\u064a\u0643 \u0635\u062d\u0628\u0629 \u05d1\u05e8\u05d5\u05da \u0627\u0631\u062c\u0648 \u0648\u0635\u0648\u0644\u0647\u0627 \u0627\u0644\u064a\u0643 \u0627\u0639\u0644\u0645\u062a\u0643 \u0641\u064a\u0647\u0627 \u0627\u0646 \u0648\u0635\u0644 \u0645\u0631\u0643\u0628 \u0645\u0646 \u0627\u0644 \u0645\u0647\u062f\u064a\u0629 \u0648\u0627\u0644\u0649 \u0627\u0644\u0633\u0639\u0629 \u0644\u0645 \u064a\u0635\u0644 \u0627\u062d\u062f \u0645\u0646 \u0627\u0637\u0631\u0627\u0628\u0644\u0633 \u0648\u0644\u0627 \u0645\u0646 \u0633\u0641\u0627\u0642\u0636 \u0648\u0627\u0646\u0627 \u0637\u0648\u0644 \u0646\u0647\u0627\u0631\u064a \u0639\u0644\u0649 \u0627\u0644 \u0628\u062d\u0631 \u0641\u0627\u0631\u062c\u0648 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0642\u0637\u0639 \u0631\u062c\u0627\u0646\u0627 \u0645\u0646 \u0631\u062d\u0645\u062a\u0647 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0644\u0643 \u0635\u062d\u0628\u0647 \u0643\u062a\u0627\u0628\u0649 \u0647\u0627\u0630\u064a \u0643\u062a\u0627\u0628 \u0627\u0628\u0648 \u0633\u0647\u0644 \u0639\u0637\u0627 \u0648\u0643\u062a\u0627\u0628 \u05e0\u05e1\u05d9\u05dd \u0648\u0642\u062f \u0643\u0646\u062a \u0627\u062e\u0630\u062a \u0644\u0643 \u0645\u0646 \u062c\u0645\u0644\u0629 \u0627\u0644 \u0643\u0627\u0641\u0648\u0631 \u0627\u0644 \u0648\u0627\u0635\u0644 \u0631\u0628\u0639 \u0645\u0646 \u0648\u0644\u0645 \u064a\u0648\u062d\u062a\u0633\u0628 \u0639\u0644\u064a\u0643 \u0644\u0627 \u0646\u0642\u0635 \u0648\u0644\u0627 \u0645\u0627\u0648\u0646\u0629 \u0627\u0644\u0649 \u0648\u0635\u0648\u0644 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u062a\u0639\u0631\u0641\u0646\u0627\u0647 \u0635\u0648\u0631\u0629 \u0627\u0644 \u062d\u0627\u0644 \u0641\u0642\u0627\u0644 \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u0627\u062e\u0630 \u0645\u0627 \u064a\u0648\u062d\u062a\u0633\u0628 \u0639\u0644\u064a\u0647 \u0627\u0644 \u0646\u0642\u0635 \u0648\u0627\u0644 \u0645\u0648\u0646\u0647 \u0648\u0642\u062f \u0646\u0642\u0635 \u062c\u0645\u0644\u062a\u0647 \u0646\u062d\u0648 \u05db\u05d7 \u062f\u0631\u0647\u0645 \u062f\u064a\u0646\u0631\u064a\u0646 \u0648\u062b\u0644\u062a\u064a\u064a \u0627\u0639\u0644\u0645\u062a\u06