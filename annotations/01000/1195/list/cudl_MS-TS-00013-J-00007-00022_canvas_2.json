      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0628\u064a\u0646 \u05e9\u05de\u05d5\u05d0\u05dc \u05d1\u05df \u0627\u0643\u0648 \u0627\u0644\u0631\u0628 \u0627\u0644\u0627\u062c\u0644</li>\n<li>. . . . . . . . . . . . . . . . .</li>\n<li>. . . . . . . . . . . . . . . . .</li>\n<li>\u0627\u0646 \u0643\u0627\u0646 \u0627\u0644\u0634\u064a\u0643 \u0632\u0643\u0631\u064a \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0642\u062f \u062f\u0641\u0639\u0643\u0645</li>\n<li>\u064a\u0646\u0639\u0645 \u064a\u0627\u062e\u0630 \u0645\u0646\u0647\u0645 \u062a\u0633\u0639\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u0642\u0631\u0637\u0627\u0633</li>\n<li>\u0644\u0631 \u0645\u062a\u062a\u064a\u0629 \u0648\u0643\u0630\u0644\u0643 \u064a\u0627\u062e\u0630 \u0645\u0646\u0647 \u062b\u0644\u062b\u0629 \u062e\u0631\u0627\u0631\u064a\u0633 \u0645\u062e\u062a\u0627\u0631\u0629</li>\n<li>\u062a\u0648\u0636\u064a\u0629 \u0645\u062d\u0645\u062f \u0627\u0646 \u0644\u0627 \u064a\u0641\u0631\u0637 \u0645\u0646 \u062c\u0645\u064a\u0639 \u0645\u0627</li>\n<li>\u0628\u0634\u064a \u0648\u0627\u0646 \u062a\u0647\u064a\u0627 \u0627\u0646 \u064a\u0628\u064a\u0639 \u0627\u0644\u0631\u0627\u0648\u0646\u062f \u0627\u0644\u0630\u064a \u0641\u064a \u0627\u0644</li>\n<li>\u064a\u0628\u064a\u0639\u0629 \u064a\u0646\u0641\u062f\u0647\u0627 \u0644 \u064a\u0635\u062d\u0628\u0647 \u0645\u0639\u0647 \u0627\u0644\u0639\u0644\u0628</li>\n<li>\u0627\u0644\u0637\u0648\u0627\u0644 \u0648\u0645\u0627 \u0641\u064a\u0647\u0645\u0627</li>\n<li>\u0628\u0646 \u0643\u0645\u0648\u0646\u0647 \u0631\u0637\u0644</li>\n<li>\u0627\u0628\u0631\u0647\u064a\u0645 \u05de \u0631\u0637\u0644</li>\n<li>\u0627\u0644\u062d\u0627\u062c \u0639\u0645\u0631 \u0631\u0628\u0639 \u0631\u0637\u0644</li>\n<li>\u0627\u0628\u0631\u0647\u064a\u0645 \u0648\u0635\u0647\u0631\u0647 \u0628\u0632\u0631 \u0631\u0637\u0644 \u05d5 \u0631\u0637\u0644</li>\n<li>\u062d\u062c\u0627\u062c \u0628\u0632\u0631 \u0631\u062c\u0644\u0647 \u0631\u0637\u0644</li>\n<li>\u062e\u0648\u0627\u062c\u0647 \u05d2 \u0631\u0637\u0644 \u0631\u0637\u0644</li>\n<li>\u0633\u0639\u062f \u0628\u0646 \u062f\u0642\u0646 \u0646\u0635\u0631\u0627\u0646\u064a \u0631\u0637\u0644\u064a\u0646</li></ol>\n",
