          "value": "<ol>\n<li><span lang=\"he\">\u05d5\u05d0\u05dc\u05e4\u05e8\u05d0 \u05dc\u05d0 \u05ea\u05e4\u05e8\u05d8</span></li>\n<li><span lang=\"he\">\u05e4\u05d9\u05d4\u05d0 \u05e4\u05d4\u05d3\u05d0 \u05d5\u05e7\u05ea</span></li>\n<li><span lang=\"he\">\u05d0\u05e0\u05d2\u05d0\u05d6\u05d4\u05d0</span></li>\n</ol>",
