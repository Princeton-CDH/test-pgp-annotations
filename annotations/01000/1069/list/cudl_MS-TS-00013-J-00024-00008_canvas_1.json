\u0648\u062a\u0631\u063a\u0645 \u0639\u0644\u064a\u0647\u0627 \u0647\u0630\u0627 \u0645\u0627 \u0642\u0627\u0644\u0647 \u05de\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0641\u064a \u0641\u0633\u0642\u064a\u0629 \u0648\u0632\u0631\u0627\u0642\u0627\u062a \u0648\u0647\u0630\u0627 \u0645\u0627 \u0642\u0627\u0644\u0647 \u062c\u0648\u0627\u0628\u0647 \u0648\u0647\u0630\u0627 \u0645\u0627 \u0642\u0627\u0644\u0647 \u05de\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0634\u0635 \u0641\u064a \u062f\u062c\u0627\u062c \u0648\u0647\u0630\u0627 \u062c\u0648\u0627\u0628\u0647 \u0648\u0645\u0627 \u0642\u0627\u0644\u0647 \u0641\u064a \u0641\u0644\u0627\u0646 \u0648\u0641\u064a \u0641\u0644\u0627\u0646 \u0648\u0641\u064a \u0641\u0644\u0627\u0646 \u0648\u0645\u0627 \u0642\u0627\u0644\u0647 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0645 \u0641\u0643\u0627\u0646 \u0645\u0646 \u064a\u0639\u0627\u0626\u0646\u0647\u0627 \u0645\u0645\u0646 \u0644\u0645 \u064a\u0642\u0641 \u0639\u0644\u0649 \u063a\u064a\u0631\u0647\u0627 \u064a\u0642\u0648\u0644 \u0637\u0627\u0644\u0628 \u062d\u062c \u064a\u0643\u0648\u0646 \u0647\u0630\u0627 \u0642\u0648\u0644\u0647 \u0641\u064a \u0634\u064a \u0647\u0630\u064a\u0627\u0646 \u0648\u062e\u0627\u0635\u0629 \u0627\u0630 \u0639\u0627\u0626\u0646 \u0645\u0627 \u0639\u0627\u0626\u0646 \u0648\u0647\u0630\u0627 \u062c\u0645\u0644\u0629 \u062a\u063a\u0646\u064a \u0639\u0646 \u0627\u0644\u062a\u0641\u0635\u064a\u0644 \u0648\u0643\u0644 \u0647\u0630\u0627 \u0639\u0646\u062f\u0627 \u0628\u0634\u0647\u0648\u062f \u0628\u0634\u0647\u0648\u062f \u0627\u0644\u0627 \u062e\u0628\u0631 \u0648\u0627\u062d\u062f \u0644\u0645 \u064a\u0642\u0648\u0644\u0647 \u0627\u0644\u0627 \u0648\u0627\u062d\u062f \u0645\u0646 \u0646\u0627\u062d\u064a\u062a\u0647 \u0648\u0627\u0646\u0647 \u0642\u0627\u0644 \u0642\u062f \u0627\u0639\u0631\u0636 \u0639\u0644\u064a\u0647 \u0641\u064a \u0628\u064a\u062a\u0647 \u062e\u064a\u0627\u0631 \u0627\u0644\u0646\u0627\u0633 \u062e\u0628\u0632 \u0644\u0645 \u064a\u0627\u0643\u0644\u0647 \u0648\u0643\u0627\u0646 \u0639\u0646\u062f\u0646\u0627 \u0644\u0645 \u064a\u0632\u0644 \u0648\u064a\u0645\u062f\u062d\u0646\u0627 \u0641\u0642\u0627\u0645 \u0642\u064a\u0627\u0645\u0647 \u062c\u0645\u0627\u0639\u0629 \u0645\u0645\u0646 \u0627\u0636\u0645\u0631 \u0627\u0646 \u0637\u0631\u0627 \u0647\u0630\u0627 \u0639\u0644\u064a\u0647 \u0644\u0639\u0645\u0631\u0643 \u0627\u0633\u0645\u0639\u062a \u0643\u0644 \u0645\u0646\u0647\u0645 \u062c\u0648\u0627\u0628\u0647 \u0648\u0627\u0646 \u0643\u0646\u062a \u063a\u064a\u0631 \u0631\u0627\u0636\u064a \u0639\u0644\u0649 \u0645\u0646 \u0643\u0627\u0646 \u0647\u0630\u0627 \u0628\u0633\u0628\u0628\u0647 \u0645\u0646 \u0646\u0627\u062d\u064a\u0629 \u0627\u0644\u062f\u064a\u0627\u0646 \u0644\u0633\u0648\u0645\u0647\u0645 \u0627\u0644\u0646\u0627\u0633 \u0647\u0630\u0627 \u0648\u0641\u064a \u0642\u0648\u0644\u0647 \u0641\u064a \u0627\u0644\u0642\u0635\u064a\u062f\u0629 \u0627\u0644\u0630\u064a \u0627\u0648\u0644\u0647\u0627 \u0633\u0639\u0641\u0649 \u05d1\u05d7\u05e0\u05d5\u05db\u05d4 \u05dc\u05d0 \u05e9\u05de\u05d7\u05d9\u05dd \u064a\u0642\u0648\u0644 \u0641\u064a\u0647\u0627 \u05dc\u05d1\u05d9\u05df \u05e7\u05d5\u05e6\u05d9\u05dd \u05db\u05e1\u05d5\u05d7\u05d9\u05dd \u0648\u0645\u0627 \u062d\u0645\u0644\u0646\u064a \u0639\u0644\u0649 \u0630\u0644\u0643 \u0648\u0627\u0644\u0644\u0647 \u0627\u0644\u0627 \u0645\u062d\u0628\u062a\u0643 \u0645\u062d\u0636 \u0648\u0644\u064a\u0633 \u0628\u063a\u0636\u0629 \u063a\u064a\u0631\u0643 \u05d5\u05e9\u05e4\u05e7\u05ea\u05d9 \u05e2\u05dc\u05d9 \u05d4\u05d5\u05d3\u05d4 \u05d9\u05d2\u05d3\u05dc \u05dc\u05e2\u05d3 \u0648\u0644\u0627 \u062a\u0633\u0648\u0645\u0646\u064a \u0641\u064a \u0647\u0630\u0627 \u0643\u0644\u0647 \u0644\u0637\u064a\u0634 \u0648\u0644\u0644\u0643\u0641\u0629 \u0641\u0645\u0627 \u0647\u0648 \u062e\u0644\u0642\u0649 \u0648\u0627\u0646\u0645\u0627 \u0627\u0646\u0627 \u0628\u0641\u0631\u062f \u0648\u062c\u0647 \u063a\u064a\u0631 \u0645\u0648\u0627\u0631\u0