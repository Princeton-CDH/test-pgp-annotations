          "value": "<p>\u0628\u0634\u0645 \u062a\u0627\u062e\u0630\u062a \u0627\u0634\u0648\u0627\u0642\u0649 \u0644\u0645\u0648\u0644\u0627\u064a \u0648\u0633\u064a\u064a\u062f\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0641\u064a \u0627\u0644\u0646\u0639\u0645\u0629 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0639\u0644\u0648\u0647 \u0648\u0627\u0631\u062a\u0642\u0627\u0647 \u0648\u062d\u0628\u0627\u0647 \u0648\u0648\u0642\u0627\u0647 \u0648\u062a\u0627\u062e\u0631\u062a \u0627\u062e\u0628\u0627\u0631\u0647 \u0639\u0646 \u0645\u0646\u062a\u0635\u0631\u0647\u0627 \u062c\u0645\u0639 \u0627\u0644\u0644\u0647 \u0628\u0647 \u0639\u0644\u0649 \u0627\u0644\u0645\u0631\u062c\u0648\u0628 \u0627\u0646\u0647 \u0627\u0644\u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627\u0644\u0644\u0647 \u0648\u0643\u0646\u062a \u0642\u062f \u0643\u062a\u0628\u062a \u0643\u062a\u0627\u0628\u064a\u0646 \u0648\u0644\u0645 \u0627\u0644\u062d\u0642 \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u064a\u0646 \u0641\u064a \u0627\u0645\u0648\u0631 \u0627\u0644\u0645\u0633 \u0627\u0630 \u062e\u0631\u062c\u0648 \u0639\u0646 \u0633\u062d\u0631 \u0641\u0627\u062a\u0628\u0639\u062a \u0647\u0630\u0647 \u0627\u0644\u062d\u0631\u0641\u064a\u0646 \u0644\u0627\u0639\u0644\u0645\u0643 \u0645\u0627 \u0643\u0646\u062a \u0639\u064a\u064a\u0646\u062a \u0639\u0644\u064a\u0647 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u064a\u0646 \u0644\u062d\u0636\u0631\u062a\u0647 \u0648\u062d\u0636\u0631\u0629 \u0645\u0648\u0644\u0626\u064a \u0627\u0628\u064a \u0627\u0644\u0631\u0628\u064a\u0639 \u062c\u0645\u0639 \u0627\u0644\u0644\u0647 \u0628\u0643\u0645\u0627 \u0627\u0646 \u0634\u0627\u0644\u0644\u0647 \u0648\u0627\u0639\u0631\u0641\u0647 \u0627\u064a\u0636\u0627 \u0627\u0646 \u0639\u0628\u062f\u0643 \u0648\u0627\u0644\u0630\u064a \u0645\u0627 \u0642\u0636\u0627 \u062d\u0627\u062c\u0629 \u0644\u0627 \