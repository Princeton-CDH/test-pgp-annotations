          "value": "\n<ol><li>. . . [. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .]</li>\n<li>\u0647\u0630\u0627 \u064a\u0648\u0645 \u0627\u0644 \u05e9\u05dc\u05d9\u05e9</li>\n<li>\u05e0\u05d5\u05d7 \u05e9\u05d1\u05ea \u05e9\u05d5\u05d1\u05d4 \u0648\u0643\u0627\u0646 \u0647\u0630\u0627 \u0645\u0627 \u0627\u0646\u0641\u062f\u0648 \u0648\u0637\u0644\u0628\u0648</li>\n<li>\u0643\u062a\u0627\u0628\u0643 \u0628\u0634\u064a \u0627\u0646 \u064a\u0648\u062f\u0641\u0639 \u0627\u0644\u064a\u0647\u0645 \u0641\u0642\u0648\u0644\u062a \u0645\u0627</li>\n<li>\u0627\u062f\u0641\u0639 \u0632\u0648\u062c \u062f\u0645\u0627\u062c \u0648\u062f\u0641\u0639\u062a \u0644\u0647\u0645 \u0645\u0646 \u062f\u0646\u0627\u0646\u064a\u0631</li>\n<li>\u0646\u0635\u0641 \u062f\u064a\u0646\u0631 \u0627\u0644\u0649 \u0633\u064a\u062f\u064a \u0631\u0627\u0633 \u0627\u0644\u0640\u05e1\u05d3\u05e8 \u0627\u0646 \u064a\u062f\u0641\u0639 \u0627\u0644\u064a\u0643</li>\n<li>\u0639\u0634\u0631\u0629 \u0642\u062f \u0646\u0641\u062f\u062a \u0643\u0648\u062a\u0628\u064a \u0627\u0644\u0649 \u062a\u0646\u064a\u0633 \u0627\u0644\u0649</li>\n<li>\u0627\u0644 \u0630\u0644\u0643 \u0648\u0647\u064a \u062f\u0631\u062c \u0643\u0648\u062a\u0628</li>\n<li>\u0627\u0644\u064a\u0643 \u0627\u0644 \u0644\u0647 \u0644 \u0639\u0646 \u0645\u0627 \u0643\u0648\u0646\u062a \u0633\u0627\u0644\u062a\u0643 \u0627\u062b\u0631 \u0644\u0633\u064a\u062f\u064a</li>\n<li>\u0627\u0628\u0648 \u0627\u0645\u0627 \u0627\u0646\u0627 \u0641\u0627\u0631\u064a\u062f \u0628\u0646\u0635\u0641 \u062f\u064a\u0646\u0631 \u0648\u064a\u0643\u0648\u0646</li>\n<li>\u0645\u063a\u0637\u0648\u0645 \u0645\u0642\u0644\u0648\u0628 \u0627\u0644\u062d\u0648\u0627\u0641 \u0648\u0644\u0627 \u064a\u0643\u0648\u0646 \u0641\u064a \u063a\u0637\u0627\u0631\u0647 \u0644\u0648\u0646\u064a\u0646</li>\n<li>\u0648\u064a\u0643\u0648\u0646 \u0627\u062a \u0639 \u0648\u064a\u0643\u0648\u0646 \u0641\u064a\u0647 \u0627\u0631\u0628\u0639\u0629 \u0627\u0646\u0635\u0627\u0641 \u0648\u064a\u0643\u0648\u0646 \u0635\u0627\u062d\u0628</li>\n<li>\u0627\u0644\u063a\u0637\u0627\u0631\u0629 \u064a\u0647 \u0644\u0639\u0644 \u0644\u0627 \u064a\u0646\u0643\u0633\u0631 \u0645\u0646\u0647 \u0634\u064a \u0648\u0627\u0630\u0627 \u0646\u0632\u0644\u062a \u0627\u0644\u0649 \u0645\u0635\u0631 \u062a\u0634\u062a\u0631\u0649 \u064a\u0646\u0643\u0633\u0631 \u0645\u0646\u0647 \u0634\u064a \u0648\u0627\u0630\u0627 \u0646\u0632\u0644\u062a \u0627\u0644\u0649 \u0645\u0635\u0631</li>\n<li>\u062a\u0634\u062a\u0631\u064a \u0644\u064a \u0631\u062c\u0648\u062c\u0629 \u0643\u0628\u064a\u0631\u0629 \u0644\u0644\u0645\u0627 \u0648\u063a\u0637\u0627\u0631 \u0627\u0628\u0648 \u0633\u0639\u062f \u0648\u0645\u0627</li>\n<li>\u0646\u0627\u0628\u0647 \u0648\u0632\u0646\u0646\u0627 \u05d5\u05e9\u05dc\u05d5\u05de\u05da \u05d9\u05e8\u05d1\u05d4 \u05dc\u05db\u05dc \u05d4\u05d6\u05e7\u05e0\u05d9\u05dd \u05de\u05e9\u05d9\u05d0\u05d9\u05dd \u05dc\u05da</li>\n<li>\u05e9\u05dc\u05d5\u05dd \u05d5\u05d0\u05d1\u05d9\u05da \u05e9\u05dc\u05d5\u05dd \u05d5\u05db\u05dc \u05e7\u05e8\u05d5\u05d1\u05d9\u05da \u05d9\u05e9\u05e2</li></ol>\n",
