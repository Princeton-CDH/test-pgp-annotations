          "value": "<p>\u0634\u0647\u062f\u0627 \u0627\u062a\u0636\u0648 \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u05dc\u05e6\u05e4\u05e8 \u0633\u0646\u0629 \u0627\u062d\u062f\u064a \u0648\u062b\u0645\u0627\u0646\u064a\u0646 \u0642\u0627\u0637\u0639\u0629 \u0645\u0627\u0636\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u064a\u064a\u0645 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u0648\u0639\u0644\u0649 \u0645\u0646 \u064a\u0627 \u0631 \u0648\u0644\u0645\u0646 \u064a\u0627\u062a\u064a \u0628\u0633\u0628\u0628\u0629 \u0644\u064a\u0639\u0645\u0644 \u0641\u064a\u0647 \u0643\u0631\u0643 \u0644\u0644\u0645\u0648\u0627\u0631\u0649 \u0644\u0647 \u0627\u062c\u0627\u0631\u0629 \u0644\u0627 \u0627\u0645\u0631 \u064a\u0639\u0644\u0647\u0627 \u0648\u0644\u0627 \u062a\u0627\u0648\u064a\u0644 \u064a\u0628\u0637\u0644\u0647\u0627 \u0641\u0631\u062c \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0645\u0646 \u0642\u0628\u0644\u0647 \u0644\u0645\u0646 \u0627\u0631\u0627\u062f \u0648\u0627\u062e\u062a\u0627\u0631 \u0645\u0646 \u0627\u0644\u064a\u0647\u0648\u062f \u0648\u0627\u0647\u0645 \u0627\u0644\u0648\u0642\u062a \u062f\u064a\u0646 \u0645\u0644\u062d\u0642 \u0648\u0647\u0648 \u0635\u062d\u064a\u062d \u0641\u064a \u0645\u062e\u0637\u0648\u0637 \u0639\u0644\u064a\u0647 \u05dc\u05d9\u05d4\u05d5\u05d9 \u05dc\u05d6\u05db\u05d5 \u0648\u0644\u0631\u0627\u064a\u0629 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d9\u05d5\u05dd \u05d5\u05d4\u05db\u05dc \u0639\u0644\u064a\u0647 \u05dc\u05d9\u05d4\u05d5\u05d9 \u05dc\u05d6\u05db\u05d5 \u05d5\u05dc\u05e8\u05d0\u05d9\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d9\u05d5\u05dd \u05d5\u05d4\u05db\u05dc \u05e7\u05d9\u05d9\u05dd \u05e0\u05e2 \u05de\u05e0\u05e9\u05d4 \u05d1\u05d9\u05e8 \u05d9\u05d5\u05e1\u05e3 \u05d6\u05e6\u05dc \u05d0\u05dc\u05e2\u05d6\u05e8 \u05d4\u05db\u05d4\u05df \u05d1\u05e8 \u05e9\u05de\u05e8\u05d9\u05d4 \u05e0\u05e2 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e8 \u05e0\u05ea\u05df \u05e0\u05