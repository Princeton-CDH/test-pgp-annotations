          "value": "<p>\u0648\u0627\u0646 \u0630\u0644\u0643 \u0627\u0644\u0634\u062e\u0635 \u0627\u0642\u0627\u0645 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u062e\u0645\u0633\u0629 \u0627\u064a\u0627\u0645 \u0648\u062a\u0648\u062c\u0647 \u0627\u0644\u0649 \u0639\u062f\u0646 \u0627\u0639\u0644\u0645\u062a \u0645\u0648\u0644\u0627\u064a \u0628\u0630\u0644\u0643 \u0648\u0628\u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0643 \u064a\u0627 \u0645\u0648\u0644\u0627\u064a \u0627\u0646 \u0627\u062d\u0648\u062c\u062a \u0639\u0628\u062f\u0643 \u0627\u0646 \u064a\u0628\u0637\u0644 \u0627\u0644\u062f\u0643\u0627\u0646 \u0627\u0644\u0649 \u0627\u0646 \u0646\u0633\u0627\u0641\u0631 \u0644\u0645\u0635\u0631 \u0644\u0627\u0646\u0643 \u062a\u0639\u0644\u0645 \u0627\u0644\u062d\u0627\u0644 \u0648\u0633\u0641\u0631 \u0627\u0644\u0628\u0631 \u0635\u0639\u0628 \u0648\u0644\u0648 \u0627\u0646\u0647 \u062d\u062a\u0649 \u064a\u0643\u0648\u0646 \u062b\u0645 \u0627\u0644\u0646\u064a\u0644 \u0644\u0645\u0627 \u0628\u0627\u0644\u0647 \u0641\u0627\u0633\u0639\u0629 \u062a\u062c\u0631\u064a\u0646\u064a \u0639\u0644\u0649 \u062d\u0633\u0628 \u062a\u0641\u0636\u0644\u0643 \u0648\u0627\u0646\u0639\u0627\u0645\u0643 \u0641\u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u062e\u0644\u064a\u0646\u064a \u0645\u0646 \u0627\u0646\u0639\u0627\u0645\u0643 \u0648\u0627\u0646 \u064a\u062c\u0645\u0639 \u0634\u0645\u0644\u0643 \u0648\u064a\u0631\u0632\u0642\u0643 \u0645\u0627 \u064a\u0642\u0631 \u0645 \u0645 \u0642\u0631\u0628 \u062d\u0635\u0631\u062a\u0643 \u0645\u062e\u0635\u0648\u0635\u0629 \u0639\u0646\u064a \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0646 \u062a\u062d\u0648\u0637\u0647 \u0639\u0646\u0627\u064a\u062a\u0643 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u062e\u064a \u05d9\u05d5\u05e1\u05e3 \u064a\u062e\u0635\u0643 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0648\u0644\u0626\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0648\u0627\u062e\u0648\u0629 \u0627\u0644\u0634\u064a\u0643 \u05e9\u05dc\u05de\u05d4 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u05d5\u05e9\u05dc\u05d5\u05de\u05da \u05d9\u05d2\u05d3\u05dc \u05dc\u05e2\u05d3 \u05e0\u05e6\u05d7 \u05e1\u05dc\u05d4 \u0627\u0644\u062d\u0636\u0631\u0629 \u0628\u0627\u0646 \u064a\u062a\u0641\u0635\u0644 \u0647\u0627 \u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0634\u064a\u0643 \u0639\u0645\u0631\u0627\u0646 \u0627\u0644\u0649 \u0645\u0635\u0631 \u062a\u062a\u0642\u0636\u0627 \u0644\u064a \u0627 \u0641\u0627\u0646 \u062e\u0631\u062c \u0645\u0646 \u0627\u0644\u062c\u0627\u0648\u0629 \u0648\u0627\u0646 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0644\u064a \u0645\u0639\u0647 \u0643\u062a\u0627\u0628 \u0648 \u0647 \u062e\u0631\u0648\u062c \u0641\u064a \u0645\u0627 \u0642\u0631\u0628 \u0644\u0627\u0646\u0643 \u064a\u0627 \u0645\u0648\u0644\u0627\u064a \u0627\u0646\u062a \u062a\u0639\u0644\u0645 \u0646\u0627\u0631 \u0641\u064a \u0642\u0644\u0628\u064a \u0644\u0637\u0648\u0644 \u063a\u064a\u0628\u062a\u0647 \u0639\u0646\u064a \u0648\u0627\u0646\u0642\u0637\u0627\u0639 \u0643\u062a\u0628\u0629 \u0639\u0646\u064a \u0641\u0646\u0639\u0644\u0645 \u0627\u0646\u064a \u0646\u062a\u0642\u0644 \u0639\u0644\u064a\u0643 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0627\u0645\u0631 \u0648\u0644\u0627\u0643\u0646 \u0627\u0644 \u062c\u062a \u0641\u064a \u0627\u0644\u062a\u062a\u0642\u064a\u0644 \u0639\u0644\u0649 \u062d\u0636\u0631\u062a\u0643 \u0648\u0644\u0627\u0643\u0646 \u0627\u0628\u0627 \u0627\u0644\u0644\u0647 \u0627\u0646 \u0646 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0627 \u0644\u0643 \u0648\u0642\u062f \u062a\u0642\u0636\u064a\u062a \u0645\u0646 \u0627\u0646\u0633\u0627\u0646 \u0645\u063a\u0631\u0628\u064a \u0648\u0635\u0644 \u0644\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0645\u0646 \u0639\u062f\u0646 \u0648\u0627\u062e\u0628\u0631\u0646\u064a \u0639\u0646 \u0645\u0648