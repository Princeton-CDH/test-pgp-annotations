        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0627\u0644\u0630\u064a \u0627\u0639\u0631\u064a\u0641 \u0633\u064a\u062f\u0646\u0627</li>\n<li>\u0628\u0627\u0646 \u0644\u0645 \u064a\u0635\u0644 \u0644\u064a</li>\n<li>\u062d\u0628\u0631 \u0648\u0627\u0646\u0646\u064a \u0628\u0637\u0627\u0644</li>\n<li>\u0641\u0627\u0634\u062a\u0647\u064a \u0628\u0627\u0646\u0643</li>\n<li>\u062a\u062a\u0645 \u0641\u0636\u0644\u0643 \u0648\u062a\u0633\u064a\u0631</li>\n<li>\u0644\u064a \u0627\u0644\u062d\u0628\u0631 \u0648\u0633\u064a\u0631\u062a</li>\n<li>\u0644\u0643 \u062e\u0631\u0627\u0633\u064a\u0646 \u0627\u0646</li>\n<li>\u0627\u062e\u0631 \u0648\u0627\u0646\u0646\u064a \u0627\u0639\u0631\u0641\u0643</li>\n<li>\u0628\u0627\u0646 \u0633\u064a\u062a \u0645\u0631\u0636\u062a \u0648\u0627\u0646\u062a</li>\n<li>\u0641\u0644\u0627 \u062a\u062a\u062e\u0644\u0641 \u0628\u0627\u0644\u0645\u062c\u064a</li>\n<li>\u0627\u0646 \u0644\u0643 \u0627\u0630\u0627 \u0628\u062d\u0642 \u0627\u0644\u0644\u0647</li>\n<li>\u062a\u0639 \u0639\u0644\u064a\u0643 \u0644\u0627 \u062a\u0628\u0637\u0644</li>\n<li>\u0627\u0644\u062e\u0631\u0627\u0631\u064a\u0633 \u0648\u062a\u0634\u062a\u0631\u0649</li>\n<li>\u0644\u064a \u0648\u0642\u064a\u064a\u062a\u064a\u0646 \u05d7\u05d1\u05e8</li>\n<li>\u0644\u0627\u0646\u064a \u0628\u0637\u0627\u0644 \u0648\u0627\u0646\u062a</li>\n<li>\u062a\u0639\u0644\u0645 \u0645\u0627 \u0627\u0646\u0627</li>\n<li>\u0641\u064a\u0647 \u0645\u0646 \u0627\u0644\u0635\u0627\u0626\u0642\u0629</li>\n<li>\u0648\u062a\u0633\u064a\u0631 \u0644\u0647\u0645</li>\n<li>\u0634\u064a \u05d9 \u0648 \u0639\u0644\u064a\u0647</li>\n<li>\u05d5\u05e9\u05dc\u05d5\u05de\u05da</li>\n<li>. . . .</li></ol>\n",
