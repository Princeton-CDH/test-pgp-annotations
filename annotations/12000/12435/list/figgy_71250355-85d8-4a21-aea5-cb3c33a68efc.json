          "type": "TextualBody",
          "label": "Right margin",
          "value": "\n<ol><li>\u0627\u0644\u0634 \u05e9\u05de\u05d5\u05d0\u05dc \u05d1\u05df</li>\n<li>\u05e2\u05d1\u05d3 \u0627\u0644\u0648\u0644\u064a \u0648\u0643\u0644 \u0645\u0646</li>\n<li>\u064a\u0644\u0648\u062f \u0628\u0645\u0646\u0632\u0644\u0629</li>\n<li>\u0627\u0644\u0633\u0639\u064a\u062f \u0648\u0628\u064a\u0646 \u064a\u062f\u064a \u0627\u0644\u0634</li>\n<li>\u0627\u0644\u0646\u062c\u064a\u0628 \u05e2\u05de\u05d4 \u05db\u05db\u05db</li>\n<li>\u0648\u0628\u064a\u0646 \u064a\u062f\u064a \u0627\u0644\u0634 \u0627\u0644\u0641\u0643\u0631</li>\n<li>\u0635\u0647\u0631\u0629 \u0648\u0643\u0644 \u0645\u0646 \u064a\u0644\u0648\u062f</li>\n<li>\u0628\u0645\u0646\u0632\u0644\u0629 \u0627\u0644\u0645\u0639\u0645\u0648\u0631</li>\n<li>\u05db\u05db\u05db \u0648\u0628\u064a\u0646 \u064a\u062f\u064a \u0627\u0644\u0645\u0648\u0644\u0649</li>\n<li>\u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u0645\u062d\u062a\u0631\u0645</li>\n<li>\u0645\u062e\u062f\u0648\u0645\u0646\u0627 \u0627\u0644\u0634\u064a\u0643</li>\n<li>\u0627\u0644\u0634\u0645\u0633 \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645</li>\n<li>\u0642\u0631\u0627\u0628\u0629 \u0627\u0644\u0645\u0643 \u0648\u0648\u0627\u0644\u062f\u0629</li>\n<li>\u0648\u0627\u0643\u0648\u0629 \u05db\u05db\u05db \u0648\u0628\u064a\u0646</li>\n<li>\u064a\u062f\u064a \u0643\u0631\u064a\u0645\u0629 \u0627\u0644\u0645\u0643</li>\n<li>\u0648\u0643\u0644 \u0645\u0646 \u064a\u0644\u0648\u062f \u0628\u0645\u0646\u0632\u0644\u0647\u0627</li>\n<li>\u0627\u0644\u0645\u0639\u0645\u0648\u0631 \u0648\u0628\u064a\u0646</li>\n<li>\u064a\u062f\u064a \u0627\u0644\u0634 \u0627\u0644\u0633\u0646\u064a</li>\n<li>\u0648\u0644\u062f\u0647\u0627 \u05db\u05db\u05db \u0648\u0648\u0627\u0644\u062f\u0629</li>\n<li>\u0648\u0628\u064a\u0646 \u064a\u062f\u064a \u062c\u0645\u064a\u0639</li>\n<li>\u0627\u0644\u0633\u0627\u062f\u0629 \u0627\u0644\u062c\u0645\u0627 \u05d1\u05d9</li>\n<li>\u05de\u05d2\u05d3\u05d5\u05dc\u05dd \u05d5\u05e2\u05d3</li>\n<li>\u05e7\u05d8\u05e0\u05dd \u05d5\u05e9\u05dc\u05d5\u05dd</li>\n<li>\u0648\u0627\u0644\u0645\u0643 \u0644\u0627 \u064a\u0639\u062a\u0628</li>\n<li>\u0639\u0644\u0649 \u0627\u0644\u0645\u0645 \u0641\u064a</li>\n<li>\u0642\u0635\u0631 \u0627\u0644\u0639\u0628\u0627\u0631\u0629</li>\n<li>\u0648\u0627\u0644\u062e\u0637 \u0648\u0627\u0644\u0641\u0647\u0645</li>\n<li>\u0644\u0627\u0646 \u0639\u0644\u0645 \u0633\u064a\u064a\u062f\u064a</li>\n<li>\u0645\u062d\u064a\u0637 \u0628\u0627\u0634\u062a\u063a\u0627\u0644</li>\n<li>\u062e\u0627\u0637\u0631 \u0627\u0644\u0645\u0645 \u0645\u0646</li>\n<li>\u062c\u0647\u0629 \u0645\u0627 \u0646\u0641\u062f \u0645\u0646</li>\n<li>\u0627\u0644\u0645\u0645 \u0628\u0633\u0628\u0628</li>\n<li>\u0630\u0644\u0643 \u0627\u0644\u0627\u0645\u0631 \u0648\u0647\u0648</li>\n<li>\u0634\u064a \u0644\u0647\u0648 \u0635\u0648\u0631\u0629</li>\n<li>\u0648\u0645\u0627 \u0627\u0642\u062f\u0631</li>\n<li>\u0627\u0628\u064a\u062d \u0628\u0647 \u0648\u0645\u0627</li>\n<li>\u0631\u0627\u062d \u0645\u0646 \u0627\u0644\u0627\u0645\u0648\u0627\u0644</li>\n<li>\u0643\u0627\u0646 \u0641\u0630\u0627 \u0627\u0644</li>\n<li>\u0627\u062f\u064a\u0627\u0646 \u0648\u0639\u0644\u0649</li>\n<li>\u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0648\u0636</li>\n<li>\u0648\u0627\u0646 \u0644\u0627 \u064a\u0633\u0627\u0644</li>\n<li>\u0627\u0644\u0645\u0643 \u0645\u0627 \u062d\u0635\u0644</li>\n<li>\u0639\u0644\u0649 \u0627\u0644\u0645\u0645 \u0645\u0646</li>\n<li>\u062c\u0647\u0629 \u0627\u0644\u0627\u0643 \u05d9\u05d5\u05e1\u05e3</li>\n<li>\u0628\u0633\u0628\u0628 \u0627\u0644\u062a\u0639\u0628</li>\n<li>\u0627\u0644\u0630\u064a \u0647\u0648 \u0641\u064a\u0647</li>\n<li>\u0648\u0627\u0644\u0630\u064a\u0646</li>\n<li>\u0643\u062a\u0628 \u062a\u0627\u0645\u0646</li>\n<li>\u05ea\u05de\u05d5\u05d6 \u05d9\u05d4 \u05d0\u05d1 \u05dc\u05e9</li>\n<li>\u0648\u0627\u0644\u0645\u0643 \u064a\u062e\u0644\u0641</li>\n<li>\u062e\u0627\u0637\u0631\u0647 \u0648\u064a\u0633\u0644\u0645</li>\n<li></li></ol>\n",
