          "value": "\n<ol><li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li></li>\n<li>\u0642\u062f \u062a\u0633\u0644\u0645\u0646\u064a \u0648\u0642\u0627\u0644 \u0644\u0647 \u062a\u0633\u064a\u0631 \u0628\u0647\u0630\u0627 \u0627\u0644\u0633\u0627\u0639\u0629 \u062a\u0639\u064a\u064a\u062f \u0628 \u0628\u0628\u0646\u0647\u0627</li>\n<li>\u0648\u0633\u0637 \u0627\u0644\u0639\u064a\u062f \u062a\u0633\u064a\u0631 \u0628\u0647 \u0627\u0644\u0649 \u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0648\u0644\u0627 \u062a\u0627\u062e\u0630 \u0645\u0646\u0647 \u0631\u0628\u0639 \u062f\u0631\u0647\u0645</li>\n<li>\u0639\u0644\u0649 \u0645\u0646 \u0627\u0644\u062c\u0639\u0644 \u0627\u0644\u0630\u064a \u062f\u064a\u0646\u0631\u064a\u0646 \u0648\u0646\u0635\u0641 \u0648\u0639\u0634\u0631\u064a\u0646 \u062f\u0631\u0647\u0645\u0627 \u0643\u0644</li>\n<li>\u0642\u062f \u0631\u062f\u062f\u062a \u0639\u0644\u064a\u0647 \u0627\u0644\u062c\u0639\u0644 \u0641\u0628\u0627\u062a \u0639\u0628\u062f\u0647\u0627 \u0639\u0646\u062f \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u064a \u0641\u0627\u062e\u0630 \u0645\u0646\u064a \u0639\u0634\u0631</li>\n<li>\u062f\u0631\u0627\u0647\u0645 \u062f\u0641\u0639\u0647\u0627 \u0644\u0628\u064a\u062a\u0647 \u0648\u0633\u0631\u0642 \u0644\u064a \u0645\u0644\u062d\u0641\u0629 \u062a\u0633\u0648\u0649 \u0646\u0635\u0641 \u0648\u0631\u0628\u0639 \u062f\u064a\u0646\u0631</li>\n<li>\u062c\u0630\u064a\u062f\u0629 \u0648\u062d\u0642 \u05ea\u05d5\u05e8\u05ea \u05d0\u05dc\u05d4\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd \u0645\u0627 \u0627\u0645\u0644\u0643 \u0644\u0644\u0633\u0641\u0631 \u0648\u0627\u0644\u062d\u0636\u0631 \u0648\u0644\u0644\u0627\u0645\u0631\u0627\u0629</li>\n<li>\u062a\u062e\u0631\u062c \u0628\u0647\u0627 \u0627\u0644\u0637\u0631\u064a\u0642 \u0633\u0648\u0627\u0647\u0627 \u0648\u0633\u0631\u0646\u0627 \u05d9\u05d5\u05dd 