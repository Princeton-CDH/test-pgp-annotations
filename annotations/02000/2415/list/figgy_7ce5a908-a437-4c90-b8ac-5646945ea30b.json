      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/a58b4f2a-6f7b-4770-8be6-b24cc3fde0bf/manifest/canvas/7ce5a908-a437-4c90-b8ac-5646945ea30b",
