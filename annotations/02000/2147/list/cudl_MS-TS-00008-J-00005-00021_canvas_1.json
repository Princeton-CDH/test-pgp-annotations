        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05d1\u05e9\u05e2\u05ea \u05db\u05d5\u05e9\u05e8 \u05d5\u05d4\u05e6\u05dc\u05d7\u05d4 \u05d5\u05e9\u05e9\u05d5\u05df \u05d5\u05e9\u05de\u05d7\u05d4 \u05d1\u05ea\u05dc\u05ea\u05d4 \u05d1\u05e9\u05d1\u05d0 \u05d3\u05d4\u05d5\u05d0 \u05e2\u05e9\u05e8\u05d9\u05df \u05d5\u05d0\u05e8\u05d1\u05e2\u05d4 \u05d9\u05d5\u05de\u05d9 \u05dc\u05d9\u05e8\u05d7 \u05e1\u05d9\u05d5\u05df \u05e9\u05e0\u05ea \u05d0\u05dc\u05e4\u05d0 \u05d5\u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d4 \u05d5\u05e9\u05d1\u05e2\u05d9\u05df \u05d5\u05d7\u05d3 \u05e9\u05e0\u05d9\u05df \u05dc\u05e9\u05d8\u05e8\u05d5\u05ea \u05dc\u05de\u05e0\u05d9\u05e0\u05d0 \u05d3\u05e8\u05d2\u05d9\u05dc\u05e0\u05e0\u05d0 \u05d1\u05d9\u05d4 \u05d1\u05e2\u05d9\u05e8 \u05d0\u05dc\u05de\u05d7\u05dc\u05d4 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4 \u05d4\u05e1\u05de\u05d5\u05db\u05d4 \u05dc\u05e4\u05e1\u05d8\u05d0\u05d8 \u05de\u05e6\u05e8\u05d9\u05dd \u05d3\u05e2\u05dc \u05e0\u05d4\u05e8\u05d0 \u05d6\u05e2\u05d9\u05e8\u05d0 \u05de\u05d5\u05ea\u05d1\u05d4 \u05e8\u05e9\u05d5\u05ea\u05d9\u05d4 \u05d3\u05d0\u05d3\u05d5\u05e0\u05e0\u05d5 \u05e0\u05ea\u05e0\u05d0\u05dc \u05d4\u05dc\u05d5\u05d9 \u05d9\u05d4\u05d9 \u05e9\u05de\u05d5 \u05dc\u05e2\u05d5\u05dc\u05dd \u062d\u0636\u0631 \u0627\u0644\u064a\u0646\u0627 \u05de\u05e8\u05e0\u05d0 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05e0\u05ea\u05e0\u05d0\u05dc \u05d1\u05e8 \u05db\u05d2\u05e7 \u05de\u05e8\u05e0\u05d0 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05d0\u05e4\u05e8\u05d9\u05dd \u05d7\u05de\u05d3\u05ea \u05d4\u05dc\u05d5\u05d9\u05d9\u05dd \u0648\u0642\u0627\u0644 \u0642\u062f \u0639\u0648\u0648\u0644\u062a \u0648\u0627\u0633\u062a\u0643\u0631\u062a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0627\u0643 \u0639\u0644\u0649 \u0633\u062a \u0627\u0644\u062a\u062c\u0627\u0631 \u05d1\u05ea \u05de\u05e8\u05e0\u05d0 \u05d9\u05e6\u05d7\u05e7 \u05d9\u05d3\u05d9\u05d3 \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u0648\u062d\u0636\u0631 \u05de\u05e8\u05e0\u05d0 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05d9\u05e6\u05d7\u05e7 \u0630\u0646\u0646 \u0627\u0628\u0648 \u0627\u0644\u0635\u0628\u064a\u0629 \u0630\u0627 \u0648\u0627\u0646\u0639\u0645 \u0628\u0630\u0644\u0643 \u064a\u062f\u0641\u0639 \u05de\u05e8\u05e0\u05d0 \u05e0\u05ea\u05e0\u05d0\u05dc \u062f\u0646\u0646 \u05dc\u05de\u05e8\u05e0\u05d0 \u05d9\u05e6\u05d7\u05e7 \u0630\u0646\u0646 \u062e\u0627\u062a\u0645 \u0630\u0647\u0628 \u0648\u062e\u0627\u062a\u0645\u064a\u0646 \u0641\u0636\u0629 \u0644\u0639\u0642\u062f \u0627\u0644\u0645\u0644\u0627\u0643 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0648\u0627\u0634\u0631\u0637 \u05de\u05e8\u05e0\u05d0 \u05d3\u05e0\u05d9\u05d0\u05dc \u062f\u0646\u0646 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u064a\u0642\u062f\u0645 \u062b\u0644\u062b\u064a\u0646 \u0648\u064a\u062e\u0631 \u0633\u062a\u064a\u0646 \u0648\u064a\u0633\u0643\u0646\u0647\u0627 \u0628\u062d\u064a\u062b \u062a\u062e\u062a\u0627\u0631 \u0648\u0644\u0627 \u064a\u0628\u0642\u0649 \u063a\u0627\u0631\u064a\u0629 \u0648\u0644\u0627 \u064a\u062a\u0632\u0648\u062c \u0639\u0644\u064a\u0647\u0627 \u0648\u0644\u0627 \u064a\u062a\u0633\u0631\u0627 \u0639\u0644\u064a\u0647\u0627 \u0648\u0645\u062a\u0649 \u0641\u0639\u0644 \u0634\u064a \u0645\u0646 \u0630\u0644\u0643 \u0643\u0627\u0646 \u0645\u0648\u0643\u0631\u0647\u0627 \u0628\u064a\u062f\u0647\u0627 \u0648\u0639\u0644\u0649 \u0627\u0646\u0647\u0627 \u0645\u0648\u062b\u0631\u0629 \u0644\u0627\u0646\u0641\u0635\u0627\u0644 \u062f\u0648\u0646\u0647 \u0648\u0645\u062a\u0649 \u05d7\u05e1 \u05d5\u05e9\u05dc\u05d5\u05dd \u062a\u0648\u0641\u064a\u062a \u0628\u0644\u0627 \u0648\u0644\u062f \u0639\u0627\u062f \u0646\u0635\u0641 \u0645\u0627\u0644\u0647\u0627 \u0644\u0648\u0627\u0644\u062f\u0647\u0627 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0627\u0646\u0647 \u0644\u0627 \u064a\u0639\u0648\u062f \u0641\u064a \u05d4\u05e2\u05e8\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9 \u05de\u05d0\u05d9 \u05e9\u05e0\u05ea \u05dc\u05d9\u05e6\u05d9\u05e8\u05d4 \u05e9\u05d0\u05dc\u05ea\u05d9 \u05d1\u05e2\u05e6\u05ea \u05d4\u05d0\u05dc \u05d1\u05de\u05e7\u05d5\u05e8 \u0627\u0633\u062a\u0643\u0631\u062a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u05e0\u05ea\u05e0\u05d0\u05dc \u05d4\u05d0\u05e8\u05d5\u05e1 \u05d1\u05d9\u05e6\u05e2 \u0627\u0633\u062a\u0643\u0627\u0631\u0647 \u05db\u05dc\u05d5\u05de\u05e8 \u05d8\u05e7\u05e1 \u05e9\u05d1\u05d5 \u05d4\u05e4\u05e7\u05d9\u05d3 \u05d0\u05ea \u05d4\u05d4\u05d7\u05dc\u05d8\u05d4 \u05d1\u05d9\u05d3\u05d9 \u05d4\u05d0\u05dc \u05d5\u05e0\u05e2\u05e0\u05d4 \u05d1\u05d7\u05d9\u05d5\u05d1 \u05d8\u05e7\u05e1\u05d9\u05dd \u05d0\u05dc\u05d4 \u05db\u05dc\u05dc\u05d5 \u05e4\u05ea\u05d9\u05d7\u05d4 \u05d1\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e0\u05da \u05d0\u05d5 \u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05de\u05d0\u05d2\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d0 \u05e2\u05de \u05d4 \u05e2\u05de \u0633\u062a \u0627\u0644\u062a\u062c\u0627\u0631 \u05e4\u05d9\u05e8\u05d5\u05e9 \u05d4\u05e9\u05dd \u05d4\u05d5\u05d0 \u05d2\u05d1\u05e8\u05ea \u05d4\u05e1\u05d5\u05d7\u05e8\u05d9\u05dd \u05d4\u05e9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05d4\u05e8\u05e7\u05e2 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05e9\u05dc \u05d4\u05d0\u05e8\u05d5\u05e1\u05d4 \u05dc\u05e9\u05d3\u05da \u05e2\u05dc \u05e9\u05dc\u05d5\u05e9\u05ea \u05e9\u05dc\u05d1\u05d9 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05dd \u05e9\u05d9\u05d3\u05d5\u05db\u05d9\u05df \u05d0\u05d9\u05e8\u05d5\u05e1\u05d9\u05df \u05d5\u05de\u05d9\u05de\u05d5\u05e9 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d2 \u05e2\u05de \u05d1\u05e9\u05d8\u05e8 \u05d4\u05e9\u05d9\u05d3\u05d5\u05db\u05d9\u05df \u05e0\u05e7\u05d1\u05e2\u05d9\u05dd \u05ea\u05e0\u05d0\u05d9 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05d4\u05db\u05dc\u05db\u05dc\u05d9\u05d9\u05dd \u05d5\u05d4\u05d0\u05d7\u05e8\u05d9\u05dd \u05db\u05de\u05d5 \u05d1\u05de\u05e1\u05de\u05da \u05e9\u05dc\u05e4\u05e0\u05d9\u05e0\u05d5 \u05e2\u05dc \u05d4\u05de\u05e0\u05d4\u05d2 \u05dc\u05d7\u05dc\u05e7 \u05d0\u05ea \u05de\u05ea\u05e0\u05ea \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05e9\u05dc \u05d4\u05d1\u05e2\u05dc \u05dc\u05de\u05d5\u05e7\u05d3\u05dd \u05d4\u05e1\u05db\u05d5\u05dd \u05d4\u05e0\u05de\u05e1\u05e8 \u05dc\u05d9\u05d3\u05d9 \u05d4\u05db\u05dc\u05d4 \u05e2\u05dd \u05de\u05d9\u05de\u05d5\u05e9 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05d5\u05dc\u05de\u05d0\u05d5\u05d7\u05e8 \u05d4\u05e1\u05db\u05d5\u05dd \u05e9\u05d9\u05e9\u05d5\u05dc\u05dd \u05dc\u05db\u05dc\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05e4\u05d9\u05e8\u05d5\u05e7 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05e8\u05d0\u05d5 \u05e4\u05e8\u05d9\u05d3\u05de\u05df \u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05e2\u05de \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d2 \u05e2\u05de \u05d4\u05e1\u05db\u05d5\u05de\u05d9\u05dd \u05d4\u05e0\u05e7\u05d5\u05d1\u05d9\u05dd \u05d1\u05e9\u05d8\u05e8 \u05d6\u05d4 \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9\u05d4\u05d6\u05d5\u05d2 \u05d1\u05d0 \u05de\u05de\u05e2\u05de\u05d3 \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9 \u05d2\u05d1\u05d5\u05d4 \u05e8\u05d0\u05d5 \u05d2\u05d5\u05d9\u05d8\u05d9\u05d9\u05df \u05d7\u05d1\u05e8\u05d4 \u05d2</p>",
