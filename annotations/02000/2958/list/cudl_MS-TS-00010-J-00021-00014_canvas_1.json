      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627 \u0627\u0646\u0647 \u0627\u0644\u0630\u064a \u062c\u0645\u0648 \u0628\u0647\u0627 \u0639\u0644\u0649 \u0644\u0633\u0627\u0646 \u0627\u0628\u0648 \u0627\u0644 \u0631\u0627\u0641\u0639 \u0644\u0644\u0627\u0633\u062a\u0627\u062f \u0648\u0642\u0627\u0644 \u0627\u064a\u0634 \u064a\u062e\u0627\u0644\u064a \u05e1\u05dc\u05d5\u05dd \u05d1\u05df \u05d9\u05e6\u05d7\u05e7 \u0628 \u0646 \u0647\u0630\u0647 \u0627\u0644\u0639\u064a\u0627\u0644\u0629 \u0645\u0627 \u062e\u0633\u0631 \u0627\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0633\u0627\u0639\u0629 \u0631\u0628\u0639 \u0648\u064a\u0628\u0647 \u062f\u0646\u0627\u0646\u064a\u0631 \u0645\u0646 \u0627\u0644\u062f\u0646\u0627\u0646\u064a\u0631 \u0627\u0644\u0630\u064a \u0648\u062c\u062f\u0647\u0627 \u0648\u0628\u0645\u0627 \u0633\u0645\u0639 \u0645\u0646 \u0643\u0644\u0627\u0645\u0647 \u0648\u0627\u0639\u062a\u0631\u0627\u0641\u0629 \u0627\u062b\u0628\u062a\u0646\u0627 \u0634\u0647\u0627\u062f\u062a\u0646\u0627 \u0639\u0646\u062f \u0645\u0646 \u0642\u0628\u0644 \u0645\u0645\u0646\u0648 \u0627\u0644\u0639\u062f\u0648\u062b \u0648\u0642\u0627\u0644 \u05d1\u05e8\u05db\u05d5\u05ea \u05d4\u05db\u05d4\u05df \u05d3\u05e0\u05df \u05d5\u05d0\u05d1\u05e8\u05d4\u05dd \u05d3\u05e0\u05df \u0627\u0646 \u0643\u0627\u0646 \u062a\u062d\u0645\u0644\u0646\u0627 \u0647\u0630\u0647 \u0627\u0644\u0639\u062f\u0648\u062b \u0641\u064a \u0627\u0644\u0639\u0634\u0631 \u0627\u0644\u0627\u0648\u0644 \u0645\u0646 \u05d7\u05d5\u05d3\u05e9 \u05d8\u05d1\u05ea \u0645\u0646 \u05e9\u05e0\u05ea \u0627\u062a\u0646\u0638 \u05d1\u05e2\u05d9\u05e8 \u05e1\u05d5\u05de\u05d1\u05d0\u05d8 \u05d3\u05e2\u05dc \u05e0\u05d9\u05dc\u05d5\u05e1 \u05e0\u05d4\u05e8\u05d0 \u05de\u05d5\u05ea\u05d1\u05d4 \u0648\u0643\u062b\u0628\u062a \u0630\u0644\u0643 \u0627\u0644\u0640\u05e7\u05d1\u05dc\u05ea \u05e2\u05d3\u05d5\u05ea \u0641\u064a \u0627\u0644 \u0639\u0634\u0631 \u0627\u0644\u0627\u0648\u0633\u0637 \u0645\u0646 \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d9\u05d9\u05e8 \u0645\u0646 \u05e9\u05e0\u05ea \u05d0\u05dc\u05e4\u05d0 \u05d5\u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d4 \u05d5\u05d7\u05de\u05e9\u05d9\u05df \u05d5\u05ea\u05e9\u05e2 \u05e9\u05e0\u05d9\u05df \u05dc\u05de\u05e0\u05d9\u05d9\u05e0\u05d0 \u05d3\u05e8\u05d2\u05d9\u05dc\u05d9\u05e0\u05e0\u05d0 \u05d1\u05d9\u05d4 \u05d1\u05e2\u05d9\u05e8 \u05de\u05e0\u05d9\u05d4 \u05d0\u05e9\u05e0\u05d4 \u05d3\u05e2\u05dc \u05e0\u05d9\u05dc\u05d5\u05e1 \u05d4\u05e0\u05e8\u05d0 \u05de\u05d5\u05ea\u05d1\u05d4 \u05d9\u05e9 \u05ea\u05dc\u05d5\u05d9 \u05d5\u05d9\u05d1\u05d4 \u05d5\u05d3\u05d9\u05df \u05e7\u05d9\u05d5\u05de\u05d9\u05d4 \u05e9\u05e8\u05d9\u05e8 \u05d5\u05d1\u05e8\u05d9\u05e8 \u05d5\u05e7\u05d9\u05d9\u05dd \u05d8\u05d5\u05d1\u05d9\u05d4 \u05d4\u05db\u05d4\u05df \u05d1\u05e8 \u05e2\u05dc\u05d9 \u05d4\u05db\u05d4\u05df \u05d4\u05d7\u05d1\u05e8 \u05d4\u05de\u05e2\u05d5\u05dc\u05d4 \u05d6\u05e6\u05dc \u05e9\u05dc\u05d4 \u05d1\u05e8 \u05d9\u05e4\u05ea \u05e1\u05d8 \u05e9\u05d4\u05d3\u05d5\u05ea\u05d0 \u05d3\u05d4\u05d5\u05ea \u05d1\u05d0\u05e0\u05e4\u05d0\u05e0\u05d0 \u05d0\u05e0\u05df \u05e9\u05d4\u05d3\u05d9 \u05d3\u05d7\u05ea\u05de\u05d5\u05ea \u05d9\u05d3\u05e0\u05d0 \u05dc\u05ea\u05ea\u05d0 \u05db\u05df \u05d4\u05d5\u05d4 \u05d7\u05e6\u05e8 \u0627\u0644\u064a\u0646\u0627 \u05d0\u05e0\u05df \u05de\u05e7\u05d1\u05dc\u05d9 \u05e2\u05d3\u05d5\u05ea \u05db \u05de\u05e8 \u05d1\u05e8\u05db\u05d5\u05ea \u05d4\u05db\u05d4\u05df \u05d1\u05e8 \u05db\u05d2\u05e7 \u05de\u05e8\u05e0\u05d0 \u05d5\u05e8\u05d1\u05e0\u05d0 \u05d0\u05d4\u05e8\u05df \u05d4\u05db\u05d4\u05df \u05d4\u05de\u05de\u05d7\u05d4 \u05d6\u05dc \u05d5\u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05e8 \u05d9\u05e6\u05d7\u05e7 \u05e1\u05d8 \u0648\u0634\u0647\u062f\u0648 \u0639\u0646\u062f\u0646\u0627 \u0627\u0646 \u0644\u0645\u0627 \u0627\u0634\u062a\u0647\u0631 \u062d\u0627\u0644 \u0627\u0644\u0628\u062c\u0644\u0629 \u0627\u0644\u0630\u064a \u0627\u062e\u0630\u0647\u0627 \u0627\u0644\u0627\u0633\u062a\u0627\u062f \u0627\u0644\u0630\u064a \u062e\u0631\u062c \u0639\u0644\u064a \u0627\u0644\u0642\u0628\u0636 \u0639\u0644\u064a \u0645\u0648\u062c\u0648\u062f \u05e8\u05e4\u05d0\u05d9\u05dc \u05d1\u05df \u05d0\u05d1\u05d9 \u05e8\u05d5\u05e0\u05d4 \u0645\u0646 \u0645\u0633\u0644\u0645 \u05d1\u05df \u05d9\u05e6\u05d7\u05e7 \u0648\u0643\u062b\u0631\u0629 \u0627\u0644\u0634\u0641\u0627\u0639\u0629 \u0639\u0646 \u062e\u0644\u0641 \u0628\u0646 \u0647\u0628\u0629 \u0627\u0644 \u0637\u0648\u0627\u0645\u0644\u064a \u0627\u0646\u0647 \u0627\u0644\u0630\u064a \u062c\u0645\u0632 \u0628\u0647\u0627 \u0648\u0627\u0644\u0630\u064a \u0627\u062e\u0631\u062c\u0647\u0627 \u0639\u0646 \u0627\u0644 \u0635\u0648\u0644 \u0627 \u0645\u0636\u064a\u0646\u0627 \u0627\u0644\u064a \u062e\u0644\u0641 \u0628\u0646 \u0644\u0646\u0627\u0647 \u0639\u0646 \u0646 \u062c\u0645\u0632 \u0644\u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u064a \u0627\u0644\u0631\u0627\u0641\u0639 \u0627\u0644\u0627\u0633\u062a\u0627\u062f \u0627\u0644\u0645\u0630\u0643\u0648\u0631</p>",
