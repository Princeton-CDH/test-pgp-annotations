      "body": [
        {
          "type": "TextualBody",
          "label": "Verso.\nColumn 1",
          "value": "\n<ol><li>\u062b\u0644\u062b\u0629 \u0627\u0646\u0635\u0627\u0641 \u05d5 \u0630\u0646\u0627</li>\n<li>\u0627\u0631\u062f\u064a\u0629 \u0644\u062e\u064a\u0633\u0629</li>\n<li>\u0645\u062e\u062a\u0648\u0645\u062a\u064a\u0646 \u0627\u062d\u062f\u062b\u0647\u0646 \u05d7 \u0630\u0646</li>\n<li>\u0633\u0642\u0644\u0627\u0637\u0648\u0646 \u0648\u0627\u0644\u0627\u062e\u0631\u064a \u0639\u062a\u0627\u0628\u064a</li>\n<li>\u0645\u0639\u0631\u0642\u062a\u064a\u0646 \u0633\u0648\u0633\u064a \u05d1 \u0630\u064a\u0646</li>\n<li>\u0645\u0639\u062c\u0631 \u064a\u0627\u0642\u0648\u062a\u064a \u05d1 \u0630\u064a\u0646</li>\n<li>\u0639\u0635\u0627\u0628\u0629 \u0645\u0646\u064a \u0644\u062e\u064a\u0633\u0629 \u05d2 \u0630\u064a\u0646</li>\n<li>\u0645\u0639\u062c\u0631 \u062f\u0631\u0649 \u0645\u0644\u0628\u0648\u0633 \u05d1 \u0630\u064a\u0646</li>\n<li>\u0645\u0646\u062f\u064a\u0644\u064a\u0646 \u0630\u0628\u064a\u0642\u064a \u05d0 \u0630\u064a\u0646</li>\n<li>\u0627\u0631\u0628\u0639\u0629 \u0645\u0639\u0627\u0631\u0642 \u05d2 \u0630\u0646\u0627</li>\n<li>\u062b\u0648\u0628 \u0630\u0628\u064a\u0642\u064a \u0648\u062b\u0648\u0628 \u05d2 \u0630\u064a\u0646</li>\n<li>\u0627\u0632\u0631\u0642 \u062c\u0633\u064a\u0644\u064a\u0646</li>\n<li>\u0645\u0639\u0631\u0642\u0629 \u0632\u0631\u0642\u0627 \u05d1 \u062f\u064a\u0646</li>\n<li>\u0648\u0645\u0646\u062f\u064a\u0644\u064a\u0646 \u0631\u0648\u0645\u064a</li>\n<li>\u0645\u0631\u062a\u0628\u0629 \u0637\u0628\u0631\u064a \u05d9 \u0630\u0646\u0627</li>\n<li>\u0637\u0628\u0631\u0633\u062a\u0627\u0646</li>\n<li>\u0637\u0631\u0627\u062d\u0629 \u05d7 \u0630\u0646\u0627</li>\n<li>\u0648\u0644\u062d\u0627\u0641</li>\n<li>\u0637\u0631\u0627\u062d\u0629 \u0628\u0632\u064a\u0648\u0646 \u05d1 \u0630\u064a\u0646</li>\n<li>\u0648\u0645\u062e\u0630\u062a\u064a\u0646</li>\n<li>\u0645\u0644\u0627\u062a\u064a\u0646 \u0648\u0645\u0644\u062d\u0641\u0629 \u05d7 \u0630\u0646\u0627</li>\n<li>\u0645\u0644\u0628\u0648\u0633\u0629</li>\n<li>\u0632\u0648\u062c \u0633\u062a\u0648\u0631 \u0635\u0648\u0641 \u05d2 \u0630\u064a\u0646</li></ol>\n",
