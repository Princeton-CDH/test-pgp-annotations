          "value": "<p>\u0627\u0644\u0649 \u062c\u0648\u062c\u0631 \u0641\u064a \u064a\u0648\u0645\u064a\u0646 \u0627\u0647\u0648\u0646 \u0644\u0643 \u062c\u0627 \u0645\u0633\u062a\u0631\u064a\u062d\u0629 \u0648\u0627\u0630 \u0644\u0645 \u064a\u062a\u0641\u0642 \u0644\u0643 \u0630\u0644\u0643 \u0644\u0627 \u0631\u062f\u062a\u064a\u0646\u064a \u0627 \u0644 \u0627\u0646\u0627 \u0627\u0644\u064a\u0643 \u0627\u062e\u0630\u0643 \u062f\u062e\u0644\u062a \u0644\u0639\u0645\u0631\u064a \u062a\u0646\u0641\u062f \u064a \u062a\u0639\u064a\u0646\u064a \u0641\u064a \u0643\u062a\u0627\u0628 \u062a\u0642\u0648\u0644\u064a \u0644\u064a \u0627\u062f\u062e\u0644 \u0641\u0627\u0646\u0627 \u0627\u062f\u062e\u0644 \u05e2\u05d4 \u0648\u0647\u0630\u0627 \u0627\u0647\u0648\u0646 \u0645\u0627 \u0639\u0646\u062f\u064a \u0648\u0644\u0648\u0644\u0627 \u0641\u0632\u0639\u064a \u0627\u0646 \u0627\u062f\u062e\u0644 \u0648\u0627\u062a \u0628\u0642\u064a\u062a</p>",
