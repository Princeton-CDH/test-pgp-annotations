          "value": "<p>\u0645\u0627 \u0627\u062e\u0631\u062c \u0644\u0643\u0646\u062a \u0642\u062f \u062f\u062e\u0644\u062a \u0627\u0644\u064a\u0643 \u0645\u0646 \u0632\u0645\u0627\u0646 \u0648\u0627\u0646\u0627 \u0645\u062a\u0646\u064a \u0643\u062a\u0627\u0628\u0643 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0645\u0627</p>\n<p>\u062a\u0627\u0645\u0631\u064a\u0646\u064a \u0628\u0647 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0628\u0648 \u0627\u0644\u0645\u0641\u0635\u0644 \u0648\u0648\u0627\u0644\u0630\u062a\u0647 \u064a\u0642\u0628\u0644\u0648 \u064a\u062f\u064a\u0643 \u0648\u0639\u064a\u0646\u064a\u0643 \u0627\u0644\u0645\u0641\u0635\u0644 \u0648\u0648\u0627\u0644\u062f\u062a\u0647 \u064a\u0642\u0628\u0644\u0648 \u064a\u062f\u064a\u0643 \u0648\u0639\u064a\u0646\u064a\u0643</p>\n<p>\u0648\u064a\u062e\u0635\u0648\u0643 \u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0645</p>",
