          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05e2\u05dc \u05e9\u05de\u05da \u0643\u062a\u0627\u0628\u064a \u064a\u0627\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0626\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0643 \u0648\u0633\u0639\u0627\u062f\u062a\u0643 \u0645\u0646 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0644\u0647 \u0645\u0636\u062a \u0645\u0646 \u05de\u05e8\u05d7\u05e9\u05d5\u05df \u0643\u062a\u0645\u0647 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0628\u0627\u062d\u0633\u0646 \u0643\u0627\u062a\u0645\u0647 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0646\u0639\u0645\u0647 \u0648\u0634\u0648\u0642 \u0627\u0644\u064a\u0647 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0647 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644\u0645\u062d\u0627\u0628 \u0648\u0645\u0627 \u062a\u062d\u0628 \u0639\u0644\u0645\u0647 \u0627\u0646 \u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0643 \u0648\u0648\u0642\u0641\u062a \u0645\u0646\u0647 \u0639\u0644\u0649 \u0645\u0627 \u0633\u0631\u0631\u062a \u0628\u0647 \u0645\u0646 \u0639\u0644\u0645 \u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u062f\u0627\u0645\u0647\u0627 \u0627\u0644\u0644\u0647 \u0644\u0643 \u0628\u0631\u062d\u0645\u062a\u0647 \u0648\u0630\u0643\u0631\u062a \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u064a\u0639\u0629 \u0648\u0627\u0644\u0643\u062b\u064a\u0631\u0629 \u0648\u0627\u0646\u0643 \u0628\u0639\u062b \u0627\u0644\u0643\u062b\u064a\u0631\u0629 \u0628\u0635\u0628\u0631 \u0634\u0647\u0631\u064a\u0646 \u0633\u0639\u0631 \u05d3 \u0627\u0630\u0646 \u0648\u0631\u0628\u0639 \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0648\u0647\u0648 \u0628\u064a\u0639 \u062e\u0633\u064a\u0633 \u0648\u0646\u0642\u0635 \u0648\u0632\u0646\u0647\u0627 \u05d1 \u0631\u0637\u0644 \u0645\u0635\u0631\u0649 \u0644\u0627 \u062d\u064a\u0644\u0629 \u0644\u0627\u0646 \u0643\u0627\u0646 \u0648\u0632\u0646\u0647\u0627 \u05e7\u05e2\u05d5 \u0631\u0637\u0644 \u063a\u0631\u0648\u0649 \u0648\u0627\u0646\u0627 \u0627\u062e\u0634\u0627 \u0627\u064a\u0627\u0643 \u0633\u0631\u0642 \u0645\u0646\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u0648\u0630\u0643\u0631 \u0627\u0646\u0647 \u0639\u0631\u0636 \u0627\u0644\u0645\u064a\u0639\u0629 \u0633\u0648\u064a\u0629 \u0633\u062a\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u0627\u0644\u0642 \u0645\u0646 \u0648\u0627\u0646\u0647 \u0644\u0645 \u064a\u0628\u064a\u0639\u0647\u0627 \u0648\u0642\u062f \u0633\u0631\u0646\u064a \u0630\u0644\u0643 \u0644\u0627\u0646 \u0644\u064a\u0633 \u0645\u0646\u0647\u0627 \u0647\u0646\u0627 \u0634\u064a \u0648\u0642\u062f \u062e\u0631\u062c\u0648 \u0645\u0646\u0647\u0627 \u0642\u0644\u064a\u0644 \u0645\u0646 \u0627\u0633\u0628\u0648\u0639\u064a\u0646 \u0641\u064a \u0627\u0644\u062e\u0645\u0633 \u0627\u0628\u064a\u0639 \u0633\u0639\u0631 \u05d7 \u0627\u0630\u0646 \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0644\u0627\u0646 \u0637\u0644\u0628\u0648\u0647\u0627 \u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0627\u0644\u064a\u0645\u0646 \u0648\u0647\u064a \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u062a\u0637\u0644\u0628 \u0639\u0646\u062f\u0643\u0645 \u0648\u062a\u0628\u064a\u0639\u0647\u0627 \u0644\u064a \u0628\u064a\u0639 \u062c\u064a\u062f \u0648\u0627\u0644\u0631\u0635\u0627\u0635 \u062a\u0628\u064a\u0642\u0629 \u0644\u063a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0648\u0644\u0627 \u062a\u0628\u064a\u0639\u0629 \u0628\u0627\u0642\u0644 \u0645\u0646 \u05d4 \u0627\u0630\u0646 \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0648\u0627\u0644\u062f\u064a\u0646 \u0648\u0631\u0628\u0639 \u0627\u0644\u062e\u0631\u0649 \u0639\u0644\u0649 \u0631\u0635\u0627\u0636 \u0645\u064a\u0645\u0648\u0646 \u0645\u0646\u0647 \u0646\u0635\u0641 \u062f\u064a\u0646 \u062a\u0643\u062a\u0628 \u0639\u0644\u064a\u0647 \u0648\u062a\u0643