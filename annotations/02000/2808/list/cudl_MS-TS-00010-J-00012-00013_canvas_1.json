      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0648\u0646\u062d\u0646\u0627 \u0645\u0642\u0644\u064a\u0646 \u0645\u0646 \u0627\u062d\u0648\u0627\u0644\u0646\u0627 \u0627\u0644\u0630\u064a \u0646\u062d\u0646\u0627 \u0641\u064a\u0647\u0627</li>\n<li>\u0627\u0644\u062c\u0644\u0629 \u0627\u0646 \u0645\u0627 \u0639\u0646\u062f\u0646\u0627 \u0642\u0645\u062d\u0629 \u0641 \u0648\u0642\u062f \u062c\u0627\u062a \u0647\u0630\u0647 \u0627\u0644\u0646\u0648\u0628\u0629 \u0641\u0632\u0627\u062f\u062a</li>\n<li>\u0639\u064a\u0644\u0646\u0627 \u0627\u0648\u0641\u0627 \u0639\u0638\u064a\u0645 \u0645\u0645\u0627 \u0639\u0646\u062f\u0646\u0627 \u0645\u0646 \u0627\u0644\u0642\u0644\u0629 \u0627\u0644\u0630\u064a \u0646\u062d\u0646\u0627 \u0641\u064a\u0647\u0627</li>\n<li>\u0648\u0644\u0627 \u062a\u0642\u0637\u0639 \u0643\u062a\u0628\u0643 \u0639\u0646\u0627 \u0648\u0645\u0627 \u0643\u0627\u0646 \u0645\u0646 \u062d\u0627\u062c\u0629 \u062e\u0635\u0646\u0627 \u0628\u0647\u0627 \u0648\u0628\u0627\u0644\u0644\u0647</li>\n<li>\u0639\u0644\u064a\u0643 \u064a\u0627 \u0648\u0627\u0644\u0630\u064a \u0627\u0646 \u0627\u0646\u062a \u062a\u0643\u0644\u064a\u062a \u0639\u0646\u0627 \u0645\u0646 \u0642\u0637\u0639 \u0627\u062e\u0628\u0627\u0631\u0643 \u0641\u064a \u0643\u0644</li>\n<li>\u0648\u0642\u062a \u0644\u0646\u0641\u0631\u062d \u0628\u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0639\u0627\u0641\u064a\u062a\u0643 \u0648\u064a\u0648\u0645 \u0627\u0646 \u0648\u0635\u0644\u062a \u0643\u062a\u0628</li>\n<li>\u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0645\u062a\u064a\u0628\u064a\u0629 \u062d\u0641\u0636\u0647\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u0628\u0642\u0627\u0647\u0627 \u0648\u0627\u062f\u0627\u0645 \u0633\u0645\u0648\u0647\u0627</li>\n<li>\u0648\u0627\u0631\u062a\u0642\u0627\u0647\u0627 \u0648\u062b\u0628\u062a \u0642\u0648\u0627\u0639\u062f \u0645\u062c\u062f\u0647\u0627 \u0648\u0627\u0647\u0644\u0643 \u0639\u062f\u0648\u0647\u0627 \u0648\u0636\u062f\u0647\u0627</li>\n<li>\u0644\u0642\u062f \u0634\u0643\u0631\u0646\u0627 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0639\u0644\u0649 \u0627\u062d\u0633\u0627\u0646\u0629 \u0627\u0644\u0639\u0645\u0629 \u0648\u0627\u0641\u0636\u0627\u0644\u0629</li>\n<li>\u0627\u0644\u062a\u0627\u0645\u0629 \u0641\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062b\u0628\u062a\u0647\u0627 \u0648\u064a\u062f\u064a\u0645 \u0631\u0641\u0639\u062a\u0647\u0627 \u0648\u0633\u0637\u0648\u0647\u0627</li>\n<li>\u0627\u0628\u062f\u0627 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0646 \u062a\u062d\u0648\u0637\u0647 \u0639\u0646\u0627\u0626\u062a\u0643</li></ol>\n",
          "format": "text/html"
        }
