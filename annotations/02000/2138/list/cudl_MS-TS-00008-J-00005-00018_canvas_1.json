        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0647\u064a \u0639\u0646\u062f\u0647 \u0627\u0644\u0627\u0646 \u0648\u0647\u0648 \u0627\u0644\u0645\u0642\u062f\u0645 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u05d0\u05dd \u0644\u0627 \u0627\u0648 \u0644\u0645\u0646 \u062a\u0639\u062f\u0627 \u0648\u0627\u062e\u0630\u0647\u0627 \u0648\u0647\u0648 \u0647\u0644\u0627\u0644 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0644\u0647\u0645 \u0635 \u0627\u0646 \u064a\u0639\u064a\u0642\u0648 \u0627\u0644\u0643\u062a\u0628 \u0627\u0644 \u0628\u0627\u0642\u064a\u0629 \u0639\u0646\u062f\u0647\u0645 \u0627\u0639\u0646\u064a \u0627\u0644 \u0639\u064a\u0646 \u0643\u062a\u0627\u0628 \u0627\u0644\u0630\u064a \u0639\u0646\u062f \u0627\u0644\u0645\u0642\u062f\u0645 \u0648\u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0630\u064a \u0639\u0646\u062f \u0627\u062e\u064a\u0647 \u05d0\u05d5 \u05dc\u05d0 \u05d9\u05d5\u05e8\u05d5\u05e0\u05d5 \u05e8\u05d1\u05d5\u05ea\u05d9\u05e0\u05d5 \u05d5\u05e9\u05db\u05e8\u05dd \u05db\u05e4\u05d5\u05dc \u05de\u05df \u05d4\u05e9\u05de\u05d9\u05dd \u0627\u0644\u062c\u0648\u0627\u0628 \u0648\u0628\u0627\u0644\u0644\u0647 \u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0627\u0646 \u0643\u0627\u0646 \u0627\u0644\u0627\u0645\u0631 \u0628\u0647 \u0639\u0644\u064a \u0645\u0627 \u062d\u0643\u064a \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0633\u0648\u0627\u0644 \u0641\u0644\u064a\u0633 \u064a\u0644\u0632\u0645 \u0647\u0644\u0627\u0644 \u0632\u0648\u062c \u0627\u0628\u0646\u0647 \u0627\u0644\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0641\u064a\u064a\u0629 \u0645\u0646 \u0627\u0644\u0639\u0629 \u062f\u064a\u0646\u0627\u0631 \u0627\u0644\u062a\u064a \u0643\u0633\u0631\u0647\u0627 \u0627\u0644\u0645\u0642\u062f\u0645 \u0644\u0648\u0627\u0644\u0649 \u0627\u0644\u0628\u0644\u062f \u0634\u064a \u0644\u0627\u0646\u0647 \u0627\u0644\u0630\u064a \u0633\u0628\u0628 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0643\u0633\u0627\u0631\u0629 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u