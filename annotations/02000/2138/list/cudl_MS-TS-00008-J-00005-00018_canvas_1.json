39\u0644\u064a\u0647\u0645\u0627 \u0627\u0644\u0648\u0627\u0644\u0649 \u0628\u0647 \u0641\u064a \u0627\u0645\u0631 \u0627\u0644\u062c\u0627\u0631\u064a\u0629 \u062d\u062a\u0649 \u0643\u0633\u0631\u0627 \u0645\u0627 \u0630\u0643\u0631 \u0639\u0646\u0647\u0645\u0627 \u0641\u0627\u0646\u0647\u0645\u0627 \u062a\u0639\u0644\u0642 \u0639\u0644\u064a\u0647 \u0645\u0627 \u0644\u0648\u0627\u0644\u0649 \u0638\u0644\u0645\u0627 \u0648\u062a\u0639\u062f\u064a\u0627 \u0645\u0639 \u0643\u0648\u0646 \u0627\u0644\u0645\u0642\u062f\u0645 \u0627\u0644\u0645\u0633\u0628\u0628 \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0627\u0644\u062a\u0637\u0631\u0642 \u0627\u0644\u064a\u0647 \u0648\u0627\u0644\u062a\u0639\u0644\u0642 \u0639\u0644\u064a\u0647 \u0641\u064a \u0645\u0627 \u0642\u062f\u0645\u0646\u0627 \u05d5\u05e9\u05dc\u05d5\u05dd \u0648\u0642\u0627\u0644 \u0644\u0627 \u0643\u0633\u0631\u0646\u0643\u0645 \u0627\u0644\u0641\u064a\u0646 \u062f\u064a\u0646\u0627\u0631 \u0641\u063a\u0627\u0644\u0637\u0646\u0627\u0647 \u0628\u062d\u0633\u0628 \u0633\u0643\u0646\u0629 \u0645\u0644\u0643 \u0627\u0644\u0640\u05de\u05e9\u05e0\u05d4 \u0648\u0643\u0644 \u0645\u0646 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0627\u0642\u0627\u0645\u0629 \u0645\u0639\u0647 \u0641\u0647\u062f\u062f\u0646\u0627\u0647 \u0628\u0647\u064a\u0628\u062a \u0633\u064a\u064a\u062f\u0646\u0627 \u0648\u0627\u062e\u0631\u0646\u0627 \u0627\u0633\u062a\u064a\u0641\u0627 \u0627\u0644\u064a\u0645\u064a\u0646 \u0639\u0644\u064a\u0647 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0645\u0627 \u0627\u0646\u0643\u0631\u0647 \u0648\u0633\u0631\u0642\u0647 \u0648\u0648\u0647\u0628\u0646\u0627 \u0644\u0644\u0640\u05e4\u05d5\u05e9\u05e2\u05d9\u05dd \u062f\u0631\u0627 \u0648\u0646\u0641\u062f\u0646\u0627\u0647\u0645 \u0648\u0627\u0646\u0641\u0635\u0644\u0646\u0627 \u0639\u0646\u0647 \u0648\u062d\u0636\u0631\u0646\u0627 \u0645\u0646\u064a\u064a\u0629 \u0632\u0641\u062a\u0649 \u0648\u062c\u062f\u0646\u0627 \u0628\u0647\u0627 \u0639\u0646\u062f \u0639\u0648\u0627\u0636 \u0628\u0646 \u05d9\u05d5\u05e1\u05e3 \u0627\u0644\u0635\u0628\u0627\u063a \u0633\u0628\u0639\u0629 \u0648\u0627\u0631\u0628\u0639\u064a\u0646 \u062f\u064a\u0646\u0627\u0631\u0627 \u0641\u0637\u0627\u0644\u0628\u0646\u0627\u0647 \u0628\u0647\u0627 \u0641\u0642\u0627\u0644 \u05dc\u05d0 \u05d4\u05d9\u05d5 \u05d3\u05d1\u05e8\u05d9\u05dd \u05de\u05e2\u05d5\u05dc\u05dd \u0644\u0645 \u064a\u0638\u0647\u0631 \u0628\u0647\u0627 \u0644\u0627 \u062e\u0637 \u0648\u0644\u0627 \u0634\u0637\u0631 \u0648\u0644\u0627 \u062d\u062c\u0629 \u0648\u0644\u0627 \u062b\u0628\u062a \u0628\u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u063a\u064a\u0631 \u05e8 \u05de\u05e9\u05d4 \u0644\u0627 \u063a\u064a\u0631 \u062f\u064a\u062f\u064a\u0639 \u0628\u0646 \u0627\u0644\u0646\u0645\u064a\u0644\u0629 \u0641\u0627\u062e\u062a\u0635\u0645\u0647 \u0648\u0631\u0627\u0641\u0639\u0629 \u0648\u0637\u0645\u0639 \u0627\u0646\u0647 \u064a\u062d\u0644\u0641 \u0648\u064a\u0628\u0631\u0627 \u0648\u0644\u0645 \u064a\u0632\u0644 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0648\u0645 \u05d7\u05dc\u05e4\u05d5\u05df \u05e1\u05d2\u05d5\u05dc\u05ea \u05d4\u05e0\u05d3\u05d9\u05d1\u05d9\u05dd \u0627\u0644 \u0633\u0627\u0643\u0646 \u0628\u0627\u0644\u0645\u062d\u0644\u0629 \u0646\u0646\u0627\u0642\u0644\u0647 \u0648\u0646\u0639\u0631\u0641\u0647 \u0627\u0646 \u0647\u0630\u0627 \u0634\u064a \u0644\u0627 \u064a\u062a\u0645 \u0644\u0647 \u0648\u0639\u0631\u0641\u0646\u0627\u0647\u0627 \u0627\u0646 \u0627\u0644\u0645\u0648\u0636\u0639 \u0627\u0644\u0630\u064a \u064a\u062a\u0634\u0627\u0631\u0631 \u0628\u0647 \u0627\u0646 \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644 \u0631\u0626\u064a\u0633\u064a\u0629 \u062a\u062e\u0631\u062c \u0639\u0644\u064a\u0647 \u0645\u0646\u0647 \u0627\u0644\u0646\u0628\u064a\u062f \u0641\u062d\u0632\u0628 \u0647\u0630\u0627 \u0639\u0648\u0627\u0636 \u062c\u0645\u064a\u0639 \u0627\u0644\u064a\u0647\u0648\u062f \u0648\u0642\u0627\u0644\u0648 \u0645\u0627 \u064a\u0644\