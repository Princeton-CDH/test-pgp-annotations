        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u05d7\u05d1\u05e9\u05dd \u05d9\u05d5\u05d3\u05e2 \u05ea\u05e2\u05dc\u05d5\u05de\u05d5\u05ea</li>\n<li>\u0633\u0644\u0645\u0627 \u0643\u062b\u0631\u062a \u0627\u0644\u0634\u0646\u0627\u0639\u0627\u062a \u0639\u0646 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0628\u0646 \u0642\u064a\u0648\u0645\u0627</li>\n<li>\u0645\u0646\u062f \u0639\u062f\u0629 \u0633\u0646\u064a\u0646 \u0628\u0627\u0628\u0646\u0647 \u0627\u0628\u0648 \u0627\u0644\u0645\u0639\u0627\u0644\u064a \u0628\u0646 \u062a\u0627\u0645\u0627\u0631 \u0627\u0644\u062a\u064a \u0647\u064a</li>\n<li>\u0632\u0648\u062c\u0629 \u0627\u0628\u0648 \u0633\u0639\u062f \u0628\u0646 \u0635\u062f\u0642\u0629 \u0627\u0644\u0644\u0628\u0627\u0646 \u0648\u0627\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u062c\u0648\u0646 \u0645\u0639\u0647\u0627 \u05d5</li>\n<li>\u0645\u062f\u0629 \u062f\u0627\u0639\u0628\u0629 \u0648\u0627\u0643\u062b\u0631 \u0645\u0646 \u0645\u0645\u0627\u0632\u062d\u062a\u0647\u0627 \u0628\u0645\u0632\u0627\u062d \u0644\u0627 \u064a\u062f\u064a \u0627\u0644\u064a \u062e\u064a\u0631</li>\n<li>\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0639\u0644\u064a\u0647 \u0627\u0644\u0649 \u062e\u064a\u0631 \u0648\u0627\u0646\u0647 \u0645\u0633\u062a\u0645\u0631 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0627\u0644\u062d\u0627\u0644</li>\n<li>\u0648\u0642\u062a \u0645\u0639 \u0643\u0631\u0629 \u0627\u0644\u0645\u0631\u0627\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0627\u0645\u0631 \u0648\u0643\u062b\u0628\u062a</li>\n<li>\u0628\u0630\u0644\u0643 \u0631\u0642\u0639\u0629 \u0627\u0644\u0649 \u0643\u0627\u062a\u0628 \u0647\u0630\u0647 \u0627\u0644\u0627\u0633\u0637\u0631 \u0648\u0631\u0645\u064a\u062a \u0641\u064a \u0645\u0643\u0627\u0646\u0629 \u0645\u0642\u0627\u0645\u0629</li>\n<li>\u063a\u064a\u0631 \u0627\u0646 \u064a\u0639\u0644\u0645 \u0645\u0646 \u0647\u0648 \u0643\u0627\u062a\u0628\u0647\u0627 \u0627\u0642\u062a\u0636\u062a \u0627\u0644\u062d\u0627\u0644 \u0627\u0634\u0639\u0627\u0631 \u0643\u062c\u0642\u0645</li>\n<li>\u05e8\u05d0\u05e9 \u05e2\u05dd \u05e1\u05d2\u05d5\u05dc\u05d4 \u05e0\u05e9\u05d9\u05d0 \u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05d2\u05d5\u05dc\u05d4 \u05d9\u05e8\u05d5\u05dd \u05d4\u05d5\u05d3\u05d5 \u05d5\u05d9\u05d2\u05d3\u05dc \u05db\u05d1\u05d5\u05d3\u05d5</li>\n<li>\u0628\u0647\u0630\u0647 \u0627\u0644\u0646\u0648\u0628\u0629 \u0648\u0627\u064a\u0642\u0627\u0641\u0629 \u0639\u0644\u0649 \u0627\u0644\u0631\u0642\u0639\u0629 \u0641\u0639\u0646\u062f \u0630\u0644\u0643 \u062c\u0644\u0633 \u0627\u0644\u0646\u0634\u064a\u0627</li>\n<li>\u05d5\u05e8 \u05e0\u05d6\u05e8\u05e0\u05d5 \u05d5\u05db\u05ea\u05e8\u05e0\u05d5 \u05d5\u05e2\u05d8\u05e8\u05ea \u05e8\u05d0\u05e9\u05d9\u05e0\u05d5 \u05d0\u05d3\u05d5\u05e0\u05e0\u05d5 \u05d4\u05e0\u05e9\u05d9\u05d0 \u05d4\u05d2\u05d3\u05d5\u05dc \u05e9\u05dc\u05de\u05d4</li>\n<li>\u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0628\u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0627\u0644\u0645\u0639\u0632\u064a\u064a\u0629 \u0641\u064a \u062f\u0627\u0631 \u0643\u0631\u064a\u0645\u062a\u0647 \u0648\u062d\u0635\u0631</li>\n<li>\u0643\u0627\u062a\u0628 \u0647\u0630\u0647 \u0627\u0644\u0627\u0633\u0637\u0631 \u0648\u062c\u0645\u0627\u0639\u062a\u0647 \u0645\u0646 \u0637\u0627\u0626\u0641\u0629 \u0627\u0644\u0642\u0631\u0627\u0626\u064a\u0646 \u0645\u0646</li>\n<li>\u0645\u0646 \u0643\u062b\u0631\u0629 \u062e\u0637\u0629 \u0627\u062e\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u0637\u0648\u0631 \u0648\u0627\u062d\u0636\u0631\u062a \u0627\u0644\u0627\u0645\u0631\u0627\u0629</li>\n<li>\u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0648\u0648\u0644\u064a\u0647\u0627 \u0648\u062a\u0642\u0636\u0649 \u0645\u0646\u0647\u0627 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0646\u0648\u0628\u0629 \u0641\u0630\u0643\u0631\u062a</li>\n<li>\u0627\u0646\u0647\u0627 \u0643\u0627\u0646\u062a \u0645\u0646\u062f \u0639\u062f\u0629 \u0633\u0646\u064a\u0646 \u0642\u062f \u0631\u0627\u062a \u0645\u0646 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631</li>\n<li>\u0634\u0645\u0627\u0626\u0644 \u0631\u0636\u064a\u0629 \u0648\u062e\u0635\u0644 \u0642\u0628\u064a\u062a\u0647 \u0648\u0627\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u062a\u0631\u062f\u062f \u0627\u0644\u0649 \u0628\u064a\u062a\u0647\u0627</li>\n<li>\u062d\u062a\u0649 \u0627\u0646\u0647 \u0643\u0627\u0646 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0627\u0648\u0642\u0627\u062a \u064a\u062c\u064a \u062b\u0644\u062b\u0629 \u0627\u0631\u0628\u0639 \u0637\u0631\u0642 \u0641\u064a \u0627\u0644</li>\n<li>\u0646\u0647\u0627\u0631 \u0641\u062e\u0627\u0641\u062a \u0645\u0646\u0647 \u0648\u0642\u0627\u0644\u062a \u0644\u0639\u0645\u0629 \u0648\u0644\u064a\u0647\u0627 \u05d0\u05d1\u05d0 \u05e8\u05d0\u05d9\u05ea\u05d9 \u05d0\u05d1\u05d9 \u0646\u0635\u0631</li></ol>\n",
          "format": "text/html"
        }
      ],
