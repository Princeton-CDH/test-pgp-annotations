      "body": [
        {
          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>\u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0644\u0643 \u0648\u0627\u0639\u062f\u0646\u064a \u0641\u0627\u0646\u064a \u0648\u0627\u0644\u0644\u0647 \u0646\u062e\u0634\u0627 \u0639\u0644\u0649 \u0646\u0641\u064a\u0633 \u0646\u0641\u0633\u064a</li>\n<li>\u0648\u0643\u0644 \u064a\u0648\u0645 \u064a\u0637\u0631\u0627 \u0639\u0644\u0649 \u0627\u0644\u0627\u0645\u0631 \u0648\u064a\u0635\u0642 \u0633\u062f\u0631\u064a \u0645\u0646 \u0645\u0646 \u0644\u0647 \u0639\u0646\u062f\u064a</li>\n<li>\u0634\u064a \u0648\u062e\u0644\u0642 \u0630\u0644\u0643 \u062c\u0627\u0647\u064a \u0648\u0647\u0627\u0630\u0627 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0644\u064a\u0633 \u0645\u0646 \u0627\u062d\u062f</li>\n<li>\u0646\u0639\u0644\u0645 \u0644\u0646\u0641\u0633\u0649 \u0639\u0627\u0629 \u0643\u0627\u0646</li>\n<li>\u0648\u0643\u062a\u0628\u062a \u0627\u0644\u064a\u0647 \u0627\u0644\u0641 \u0643\u062a\u0628 \u0648\u0627\u0646\u0627 \u0627\u0633\u0627\u0644\u0647</li>\n<li>\u0648\u0627\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0630\u064a \u064a\u0648\u062c\u0647 \u0627\u0641 \u0627\u0648\u0644 \u0644\u063a\u0631\u0628</li>\n<li>\u064a\u0639\u0632\u0644 \u0628\u0627\u0644\u0636\u062f \u064a\u062c\u0645\u0639 \u0627\u0644\u062d\u0627\u0644 \u0648\u064a\u0634\u062a\u0631 \u0633</li>\n<li>\u0643\u0644 \u0634\u064a \u0645\u0639 \u0648\u0644\u0630\u0647 \u0627\u0628\u0648 \u0627\u0644\u0646\u0627\u0633 \u0647\u0627\u0630\u0627</li>\n<li>\u0627\u0644\u0644\u0647 \u0627\u0644\u0630\u064a \u0627\u0642\u0648\u0644 \u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0627 \u0648\u0634\u0627\u062a \u0643\u0648\u0629</li>\n<li>\u0627\u0639\u062f\u0627 \u0648\u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0633\u0648 \u0648\u064a\u0631 \u0644\u0634\u0631\u064a\u0643 \u0627\u0644\u0635\u0628\u064a \u0628\u062f\u0644</li>\n<li>\u0644\u0633\u0647 \u0627\u0646 \u062f\u0639\u0643 \u0648\u0644\u0644\u0647 \u0627\u0646 \u0633\u0627\u0639\u062a \u0648\u0635\u0644 \u0643\u062a\u0628\u0643 \u0627</li>\n<li>\u0627\u0643\u0644\u062a \u0634\u064a \u0637\u0644\u0639 \u0639\u0644\u0627 \u0627\u0645\u0631 \u0627\u0644\u0635\u0648\u0645 \u0648\u0646\u0641\u0637\u0631 \u0639\u0644\u0627 \u0627\u0644</li>\n<li>\u064a\u0627\u062f\u0645 \u0627\u0644\u0644\u0647 \u0648\u064a\u0646\u0635\u0631 \u0645\u0646\u0647 \u0648\u0644\u0627 \u064a\u0648\u062e\u0631\u0647 \u062e\u0631\u0648\u062c \u0627\u0628\u0648\u0647</li>\n<li>\u0641\u064a \u0647\u0627\u0648\u0644\u0627 \u0648\u0641\u064a \u0639\u0635\u0628 \u0642\u0644\u0648\u0628\u0646\u0627 \u0648\u0628\u0627\u0644\u0644\u0647 \u0627\u0646 \u0642\u062f \u0632\u062c\u0631\u0627 \u0644</li>\n<li>\u0642\u0644\u0628\u064a \u0643\u0648\u0641 \u0648\u062c\u0639 \u064a\u0639\u0631\u0641\u0646\u064a \u0627\u0636 \u0645\u0646 \u0645\u0627 \u0627\u0646\u062a \u0641\u064a\u0647</li>\n<li>\u0645\u0646 \u0634\u063a\u0644 \u0627\u0644\u0633\u0631 \u0627\u0644\u0644\u0647 \u064a\u0646\u0641\u0639\u0647 \u0648\u064a\u0646\u0641\u0639\u0627 \u0628\u062f\u0639\u0643 \u062e\u0635 \u0646\u0641\u0633\u0643</li>\n<li>\u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0644\u0645 \u0641\u0627 \u0645\u0646 \u0634\u063a\u0644 \u0627\u0644\u0633\u0631 \u0627\u0644\u0644\u0647 \u064a\u0646\u0641\u0639\u0647 \u0648\u064a\u0646\u0641\u0639\u0627 \u0628\u0630\u0639\u0643 \u062e\u0635 \u0646\u0641\u0633\u0643 \u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0644\u0645 \u0641\u0627 \u0631\u062c\u064a \u0645\u0646 \u0627\u0644\u0644\u0647 \u0642\u062f \u0648\u0635\u0644</li></ol>\n",
