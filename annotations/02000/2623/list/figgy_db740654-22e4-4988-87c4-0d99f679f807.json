          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>\u0627\u0644\u0639\u0627</li>\n<li>\u0641\u0627\u0644\u0644\u0647 \u064a\u0628\u0644\u063a\u0646\u064a</li>\n<li>\u0627\u0633\u0631 \u062d\u0627\u0644</li>\n<li>\u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0630\u064a \u0643\u062a</li>\n<li>\u0627\u064a\u0634 \u0642\u0627\u0644 \u0644\u0643\u0645 \u0648\u0627\u0646 \u0643\u0648\u0646\u062a\u0645</li>\n<li>\u0637\u0644\u0639\u062a\u0645 \u062a\u0637\u0647 \u0642\u0648\u0644\u0648 \u0644\u0647 \u0641\u0638</li>\n<li>\u0627\u0644\u0645\u0633\u062e\u064a\u0644 \u05d5\u05dc\u05de\u05e0\u05e9\u05d4 \u05d5\u05dc\u05e9\u05de\u05e8\u05d9\u05d4</li>\n<li>\u0627\u064a\u0634 \u0641\u064a \u0642\u0644\u0628\u0647 \u0645\u0639 \u0627\u0639\u0646\u0649 \u0627\u0644\u0631\u0626\u064a\u0633 \u0648\u062e\u0628\u0631\u0648\u0646\u064a \u0628\u0647</li>\n<li>\u0627\u0644\u064a\u0643\u0645 \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u062a\u0642\u062f\u0645\u0629 \u0647\u0644 \u0628\u064a \u05d5\u05d2</li>\n<li>\u0627\u0644\u0644\u064a\u0644 \u0648\u0627\u0644\u0646\u0647\u0627\u0631 \u0627\u062f\u0639\u064a \u0644\u0644\u0644\u0647 \u0627\u0646 \u064a\u0646\u0635\u0631\u0643\u0645</li>\n<li>\u0643\u062b\u064a\u0631 \u0628\u0633\u0628\u0628 \u0647\u0630\u0647 \u0627\u0644\u0641\u0646 \u0648\u0644\u0627 \u062a\u0634\u063a\u0644</li>\n<li>\u0639\u0646\u0643\u0645 \u0648\u064a\u0642\u0648\u0645 \u0641\u064a \u0628\u0627\u0644\u0643\u0645 \u0627\u0646\u064a \u0636\u0627</li>\n<li>\u062e\u064a\u0631 \u0627\u0643\u0627\u0644 \u0627\u0643\u0644 \u0634\u0627\u0631\u0628 \u0637\u064a\u0628 \u0627\u0644\u0639 \u0627\u0644\u0639\u064a\u0634 \u05d5</li>\n<li>\u0628\u0627\u0644 \u0627\u0646 \u0627\u0628\u0648 \u0627\u0644\u064a\u0648\u0633\u0631 \u0644\u0647 \u0627\u0644\u064a\u0648\u0645 \u0645\u0646 \u0648\u0642\u062a</li>\n<li>\u0645\u0631\u064a\u0636 \u0639\u0644\u0649 \u062e\u0637\u0647 \u0627\u0646 \u0642\u0628\u064a\u062d\u0647 \u0648\u0628\u064a\u0642</li>\n<li>\u0627\u0644\u062f\u0627\u0631 \u0648\u0644\u0643\u0646 \u0627\u0644\u0644\u0647 \u0643\u0627\u0646 \u0648\u0627\u0644\u0644\u0647 \u064a\u0643\u0648\u0646</li>\n<li>\u0643\u0648\u0644\u0643\u0645 \u0639\u0646\u064a \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0628\u062d\u0642 \u0627\u0628\u0639\u062a\u0648 \u0644\u064a \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628</li>\n<li>\u0648\u0627\u0627\u0646 \u0642\u0644\u0628\u064a \u0645\u0634\u063a\u0648\u0644</li></ol>\n",
