      "modified": "2026-10-29T19:46:41.975158+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/3916/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-J-00020-00026/canvas/1",
          "type": "Canvas",
