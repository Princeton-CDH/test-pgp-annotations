        {
          "type": "TextualBody",
          "label": "right margin, diagonal lines at 180 degrees to main text",
          "value": "<p>\u0648\u0627\u0644\u0633 \u0641\u062d\u062a\u0641\u0635\u0644\u0649 \u062d\u0627\u062c\u0629 \u0648\u062d\u062c\u0629 \u0627</p>\n<p>\u0645\u0639\u0649 \u0648\u0627 \u062a\u0646\u0635\u0631\u064a \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u062f\u0627\u0631 \u0648\u062c\u0627 \u0643\u062a\u0627\u0628 \u05d9\u05d5\u05e1\u05e3 \u064a\u0639\u0644\u0645\u0646\u0627</p>\n<p>\u0627\u062e\u0628\u0627\u0631\u0643\u0645 \u0641\u0639\u0631\u0641\u0646\u0627\u0647 \u0627\u062e\u0628\u0627\u0631 \u0627\u0633\u0645\u0627\u0639\u064a\u0644 \u0648\u0627\u062e\u0628\u0627\u0631</p>\n<p>\u0643\u0644\u0647\u0645 \u0648\u0633\u0627\u0644\u0648 \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0627 \u0639\u0646 \u0648\u0644\u062f\u0647 \u05de \u0627\u0644\u0627 \u0627\u064a\u0645\u062a\u0627</p>",
          "format": "text/html"
        }
      ],
