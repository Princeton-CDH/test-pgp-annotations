        {
          "type": "TextualBody",
          "label": "right margin, diagonal lines at 180 degrees to main text",
          "value": "<p>\u0648\u0639\u0644\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0628\u064a \u0627\u0644\u062d\u0633\u0646 \u0648\u0639\u0644\u0649 \u0627\u062e\u0648\u062a\u0647 \u0648\u0639\u0644\u0649 \u0648\u0644\u062f\u0647 \u0648\u0639\u0644\u0649</p>\n<p>\u0627\u0628\u0631\u0627\u0647\u064a\u0645 \u0648\u0639\u0644\u0649 \u0643\u0644 \u0645\u0646 \u064a\u0633\u0627\u0644 \u0639\u0646\u0649 \u0627\u0644\u0635\u063a\u064a\u0631 \u0648\u0627\u0644\u0643\u0628\u064a\u0631 \u0648\u0627\u0644\u062e\u0628\u064a\u0631 \u0648\u0639\u0644\u0649 \u0633\u064a\u062f\u064a \u0648\u0648\u0644\u062f\u0647</p>\n<p>\u0648\u0627\u062e \u0644\u0648\u0627 \u0645\u0627 \u0643</p>",
