        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u0638\u0645\u0646\u0648 \u0642\u0644\u0628\u0646\u0627 \u0645\u0646 \u062c\u0647\u062a\u0643\u0648\u0645 \u0628\u062d\u0642 \u0627\u0644\u0644\u0647 \u064a\u0627\u062e\u062a\u0649</li>\n<li>\u0639\u0632\u0649 \u0639\u0646\u064a \u0628\u0646\u062a \u0643\u0627\u0644\u062a\u064a \u0627\u0644\u062d\u0627\u0644 \u0627\u0646\u064a \u0643\u0646\u062a \u0645\u0631\u064a\u0636\u0629</li>\n<li>\u0645\u0627 \u0644\u062d\u0642\u062a \u0646\u0643\u062a\u0628 \u0644\u0628\u0646\u062a \u0643\u0627\u0644\u062a\u064a \u0646\u0639\u0632\u064a\u0647\u0627 \u0641\u064a</li>\n<li>\u0627\u0645\u0647\u0627 \u0648\u0633\u0627\u0639\u0629 \u0648\u0642\u0648\u0641\u0643 \u0639\u0644\u0649 \u0647\u0627\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628</li>\n<li>\u062a\u0646\u0641\u062f\u064a \u062c\u0648\u0627\u0628\u0647 \u0648\u0627\u064a\u0634 \u0645\u0627 \u062e\u0635\u0631\u062a\u064a \u0627\u0648 \u0628\u0635\u0631\u062a\u064a \u0644\u0645\u0646 \u064a\u0648\u0635\u0644</li>\n<li>\u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0646\u0627 \u0646\u0632\u0646\u0647 \u0648\u0645\u0631\u0636\u0648 \u0627\u0648\u0644\u0627\u062f\u064a \u0643\u0644\u0647\u0645</li>\n<li>\u0648\u0627\u0644\u062c\u0627\u0631\u064a\u0629 \u0645\u0631\u064a\u0636\u0629 \u0627\u0644\u0644\u0647 \u064a\u0631\u062f \u0627\u0644\u0639\u0627\u0642\u0628\u0629 \u0627\u0644\u0649 \u0627\u0644</li>\n<li>\u062e\u064a\u0631 \u0628\u062d\u0642 \u0627\u0644\u0644\u0647 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u064a \u0648\u0635\u064a\u0629 \u0641\u064a \u0627\u0646\u0641\u0627\u062f</li>\n<li>\u0643\u062a\u0627\u0628 \u0633\u0631\u0639\u0629 \u0644\u0627\u0646 \u0639\u064a\u0646\u064a \u0627\u0644\u0627 \u0627\u0644\u0637\u0631\u064a\u0642 \u0644\u0645\u0646 \u064a\u062c\u064a \u0648\u0643\u0644</li>\n<li>\u0645\u0627 \u0633\u0645\u0639\u062a \u0627\u0646\u0643\u0645 \u0641\u064a \u0639\u0627\u0641\u064a\u0629 \u0627\u0641\u0631\u062d \u0648\u0642\u062f \u062d\u0644\u0641\u062a \u0627\u0646\u064a</li>\n<li>\u0645\u0627 \u0646\u0641\u0638\u0631 \u0628\u0646\u0647\u0627\u0631 \u062d\u062a\u0649 \u064a\u062c\u064a \u0643\u062a\u0627\u0628\u0643 \u0648\u0642\u062f \u0647\u0644\u0643\u062a</li>\n<li>\u0645\u0646 \u0627\u0644\u0635\u064a\u0627\u0645 \u0648\u0644\u0639\u0644 \u062a\u0643\u0644\u0649 \u0639\u0648\u0636 \u0643\u062a\u0627\u0628\u0643 \u062a\u0628\u0635\u0631\u064a</li>\n<li>\u0627\u064a\u0634 \u062a\u0639\u0645\u0644\u0649 \u0641\u064a \u0642\u0633\u0645\u0645 \u0644\u0627\u0646 \u0627\u0628\u0646 \u0647\u0644\u0627\u0644 \u0645\u0627</li>\n<li>\u064a\u0646\u062a\u0635\u0631 \u0627\u0644\u0627 \u0627\u0628\u0646 \u0627\u0644\u0642\u0627\u0635\u064a \u064a\u062c\u064a \u0648\u0642\u062f \u0646\u0641\u062f \u0648\u0627\u0646\u062f\u0631\u0646\u0627</li>\n<li>\u0628\u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0643 \u062a\u0639\u0627\u0644\u0649 \u0645\u0646 \u0643\u0644 \u0628\u062f \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643</li>\n<li>\u0648\u0642\u062f \u0643\u062b\u0628\u062a \u0643\u062a\u0627\u0628 \u0644\u0633\u062a \u0627\u0644\u0639\u0644\u0645 \u062a\u0646\u0641\u062f\u064a\u0647 \u0644\u0647\u0627</li>\n<li>\u0648\u062a\u0643\u0644\u064a\u0647\u0627 \u062a\u0646\u0641\u062f \u062c\u0648\u0627\u0628 \u0648\u0627\u0644\u0633\u0644\u0627\u0645</li></ol>\n",
          "format": "text/html"
