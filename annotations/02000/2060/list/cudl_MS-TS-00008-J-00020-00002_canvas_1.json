      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0643 \u0648\u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u0633\u0639\u0627\u062f\u062a\u0643 \u0648\u0643\u0627\u0646 \u0644\u0643 \u0648\u0645\u0639\u0643 \u0639\u0648\u0632\u0631 \u0648\u0633\u0648\u0645\u0643 \u0645\u0646 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0644\u0647 \u0628\u0642\u064a\u0646 \u0645\u0646 \u05de\u05e8\u05d7\u05e9\u05d5\u05df \u0648\u0627\u0644\u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0634\u0648\u0642 \u0627\u0644\u064a\u0643 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0643 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644\u0627\u062d\u0648\u0627\u0644 \u062a\u0642\u062f\u0645\u062a \u0643\u062a\u0628\u064a \u0627\u0644\u064a\u0643 \u0639\u062f\u0629 \u0627\u0631\u062c\u0648 \u0648\u0642\u0648\u0641\u0643 \u0639\u0644\u064a\u0647\u0645 \u0627\u0639\u0644\u0645\u062a\u0643 \u0628\u0648\u0635\u0648\u0644 \u0627\u0644\u0633\u0631\u064a\u0631\u0629 \u0627\u0644\u0645\u0634\u062a\u064a\u0629 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u0639\u0646\u062f \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u05d9\u05d5\u05e1\u05e3 \u05d9\u05e2\u05e7\u05d1 \u0648\u0642\u0628\u0636\u0647\u0627 \u0627\u0628\u0648 \u0632\u0643\u0631\u064a\u0627 \u0627\u062e\u064a\u0629 \u0648\u0647\u064a \u062e\u0644\u0637\u0629 \u05e8 \u05e0\u05d4\u05e8\u05d0\u05d9 \u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0626\u064a \u0627\u0628\u0648 \u05d9\u05d7\u05d9\u05d9 \u062d\u0631\u0633\u0629 \u0627\u0644\u0644\u0647 \u0648\u0644\u0645 \u0627\u0631\u0627 \u0644\u0628\u0646 \u0644\u0646\u062c\u0648 \u0643\u062a\u0627\u0628 \u0644\u0627 \u0644\u0643 \u0648\u0644\u0627 \u0644\u063a\u064a\u0631\u0643 \u0648\u0627\u0639\u0644\u0645\u062a\u0643 \u0628\u0648\u0635\u0648\u0644 \u0645\u0631\u0643\u0628 \u0645\u062c\u0627\u0647\u062f \u0645\u0646 \u062f\u0627\u0646\u064a\u0629 \u0648\u0644\u064a\u0633 \u0641\u064a\u0647 \u0639\u0628\u0631\u064a \u0648\u0644\u0627 \u0631\u0627\u064a\u062a \u0644\u0643 \u0641\u064a\u0647 \u0627\u064a\u0636\u0627 \u0634\u064a\u064a \u0648\u0627\u0645\u0627 \u0627\u0644\u0646\u062f\u0644\u0633\u064a \u0627\u0644\u0648\u0627\u0635\u0644 \u0645\u0646 \u0627\u0644\u0645\u0631\u064a\u0629 \u0644\u0627 \u0627\u0634\u0643 \u0627\u0646\u0643 \u0643\u0646\u062a \u062d\u0627\u0636\u0631 \u0641\u064a \u0648\u0635\u0648\u0644\u0647 \u0644\u0645 \u064a\u0635\u0644 \u0644\u0643 \u0634\u064a\u064a \u0627\u0633\u0627\u0644 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0643\u064a\u064a\u0628 \u0639\u0646\u0627\u0643 \u0648\u064a\u0646\u0639\u0644 \u0633\u0639\u064a\u064a\u062a\u0643 \u0644\u0643 \u0645\u0639 \u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0647 \u0643\u062a\u0627\u0628 \u0644\u0644\u0635\u0628\u064a \u0627\u0644\u0642\u0627\u0628\u0633\u064a \u0635\u0628\u064a \u0627\u0628\u064a \u0627\u0644\u0641\u0635\u0644 \u0628\u0646 \u062e\u0644\u0641\u0629 \u062a\u0639\u0631\u0641\u0647 \u0627\u0646\u0647 \u0644\u064a \u0635\u062d\u0628\u062a\u0647 \u0634\u0642\u064a\u0642\u0627\u062a \u0645\u0636\u0627 \u0627\u0644\u0649 \u0627\u0637\u0631\u0627\u0628\u0644\u0633 \u0627\u0644\u0634\u0627\u0645 \u0631\u0643\u0628 \u0641\u064a \u0639\u0634\u0627\u0631\u0649 \u0645\u0639 \u0647\u062c\u0627\u0645 \u0648\u0645\u0639 \u0627\u0628\u064a \u0627\u0644\u0648\u0631\u062f \u064a\u0631\u064a\u062f \u0627\u0644\u0649 \u0637\u0631\u0627\u0628\u0644\u0633 \u0627\u062a\u0641\u0636\u0644 \u0648\u0627\u0646\u0641\u062f \u0628\u0647 \u0627\u0644\u064a\u0647 \u0645\u0639 \u0645\u0646 \u062a\u062a\u0642 \u0628\u0647 \u0644\u0627 \u0639\u062f\u0645\u062a\u0643 \u0648\u0644\u0627 \u062e\u0644\u0648\u062a \u0645\u0646\u0643 \u0648\u0642\u062f \u0643\u062a\u0628\u062a \u0644\u0643 \u0641\u064a \u062d\u0648\u064a\u062c\u0627\u062a \u0645\u0627 \u0633\u0647\u0644 \u0645\u0646\u0647\u0627 \u0627\u0641\u0639\u0644\u0647 \u0627\u0644\u0628\u0644\u062f \u062d\u0638\u064a\u0645 \u05d2 \u0628\u062f\u064a\u0646\u0627\u0631 \u0633 \u0647 \u0648\u062d\u0627\u0644\u0629 \u062d\u0627\u0644 \u0635\u0639\u0628 \u0648\u0637\u0631\u0642\u0627\u062a \u0645\u0627 \u0647\u064a \u063a\u064a\u0627\u062f \u0648\u0641\u0631\u062d \u0641\u064a \u0628\u0648\u0635\u064a\u0631 \u0644\u0627\u0644\u0627\u0646 \u0627\u062d\u0633\u0646 \u0627\u0644\u0644\u0647 \u062e\u0644\u0627\u0635\u0629 \u0648\u0643\u062a\u0628\u0629 \u0644\u0627 \u0634\u0643 \u0627\u0646\u0647\u0627 \u0648\u0635\u0644\u062a \u0627\u0644\u064a\u0643 \u0645\u0646 \u0628\u0648\u0635\u064a\u0631 \u062e\u0635\u0635\u062a\u0643 \u0627\u0641\u0635\u0644 \u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0644\u0632\u064a\u062a \u0648\u0635\u0644 \u0645\u0646 \u0627\u0644\u063a\u0631\u0628 \u05d5 \u0627\u0644\u0627\u0641 \u0632\u0642 \u0648\u0633\u0639\u0631 \u0627\u0644\u0632\u064a\u062a \u0628\u062f\u064a\u0646 \u0648\u0646\u0635\u0641 \u0627\u0644\u0642\u0644\u0629 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0633\u0639\u0631 \u0648\u0645\u0627 \u0641\u064a \u0627\u0644\u0628\u0644\u062f \u0627\u0628\u064a\u0639 \u0645\u0646 \u0634\u0626\u064a \u064a\u0648\u0643\u0644 \u0627\u0644\u0643\u062a\u0627\u0646 \u0632\u0627\u062f \u062f\u0646 \u0641\u064a \u0627\u0644\u0642\u0646\u0638\u0627\u0631 \u0628\u0642\u064a\u0629 \u0627\u0644\u0645\u0631\u0627\u0643\u0628 \u0645\u0627 \u0639\u0646\u062f\u0646\u0627 \u0635\u062d\u0629 \u0648\u0635\u0648\u0644\u0647\u0627 \u0627\u0644\u0631\u064a\u062d \u062b\u0645 \u0634\u0631\u0642\u0649 \u0628\u0639\u062f \u0627\u0644\u0635\u0644\u064a\u0628 \u05db \u064a\u0648\u0645 \u0648\u0635\u0644\u062a \u0645\u0646 \u05d0\u05dc\u05dc\u05d0\u05d3\u05e7\u05d9\u05d4 \u0639\u062f\u0629 \u0645\u0631\u0627\u0643\u0628 \u0648\u0645\u0646 \u0627\u0644\u0