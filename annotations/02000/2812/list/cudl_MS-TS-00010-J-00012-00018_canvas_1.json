      "body": [
        {
          "type": "TextualBody",
          "label": "Recto:",
          "value": "\n<ol><li>\u0628\u0634\u0645 \u0631\u062d\u0645</li>\n<li>\u0627\u0644\u0630\u064a \u0627\u0631\u064a\u062f \u0628\u0647 \u0627\u0639\u0644\u0645\u0643 \u064a\u0627 \u0648\u0627\u0644\u0630\u062a\u064a \u0627\u0646\u064a \u0648\u0635\u0644\u062a \u0627\u0644\u0649 \u0627\u0644\u0645\u062d\u0644\u0629</li>\n<li>\u0648\u0642\u0644\u0628\u064a \u0639\u0646\u062f\u0643 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062c\u0639\u0644\u0643 \u0641\u064a \u062d\u064a\u064a\u0632 \u0627\u0644\u0633\u0644\u0627\u0645\u0629</li>\n<li>\u0648\u0639\u0646\u062f\u064a \u0645\u0646 \u0627\u0644\u0634\u0648\u0642 \u0648\u0627\u0644\u0648\u062d\u0634\u0629 \u0644\u0641\u0631\u0642\u0643\u0645 \u0645\u0627 \u0644\u0627 \u0627\u062d\u0633\u0646 \u0627\u0635\u0641</li>\n<li>\u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0645\u0642\u0628\u0648\u0644 \u0642\u0635\u0627\u0629 \u0648\u0645\u0645\u0627 \u0627\u0639\u0644\u0645\u0643 \u064a\u0627 \u0648\u0627\u0644\u0630\u062a\u0649</li>\n<li>\u0627\u0646 \u0645\u0646 \u0648\u0642\u062a \u062e\u0631\u0648\u062c\u064a \u0645\u0646 \u0639\u0646\u062f\u0643 \u0645\u0627 \u0635\u0641\u0627 \u0644\u064a \u0639\u064a\u0634 \u0648\u0644\u0627 \u062d\u064a\u064a\u0629</li>\n<li>\u0645\u0645\u0627 \u064a\u062e\u0627\u0644\u0642\u0646\u064a \u0648\u064a\u0637\u0644\u0628 \u0645\u0646\u064a \u0627\u0644\u0631\u062c\u0648\u0639 \u0627\u0644\u0649 \u062d\u0644\u0628 \u0648\u0642\u062f \u0645\u0644\u062a</li>\n<li>\u0631\u0648\u062d\u064a \u0641\u0628\u0644\u0644\u0647 \u0639\u0644\u064a\u0643 \u0627\u0633\u0639\u064a\u064a \u0641\u064a \u062e\u0644\u0627\u0635\u064a \u0645\u0646 \u0627\u0644\u0630\u064a \u0627\u0646\u0627 \u0641\u064a\u0647</li>\n<li>\u062e\u0631\u0648\u062c\u0643 \u0627\u0644\u0649 \u0639\u0646\u062f\u064a \u0627\u0648 \u0628\u0648\u062e\u064a\u0644 \u062a\u0648\u0643\u0644\u064a\u0629 \u0627\u0648 \u062a\u0628\u0639\u062a\u0649 \u0644\u0647</li>\n<li>\u0627\u0644\u0630\u064a \u0639\u0646\u062f\u0643 \u0641\u0627\u0646\u064a \u0645\u0639\u0647 \u0641\u064a \u0627\u0644\u0646\u0627\u0631 \u0648\u064a\u0643\u0648\u0646 \u0633\u0631\u0639\u0629</li>\n<li>\u0644\u062a\u0639\u062a\u0642\u064a\u0646\u064a \u0645\u0646 \u0627\u0647\u0644 \u0646\u0627\u0631 \u0648\u064a\u0643\u0648\u0646 \u0630\u0627\u0644\u0643 \u0628\u0644\u0627</li>\n<li>\u0627\u0645\u0631 \u0641\u0627\u0646\u064a \u0645\u0627 \u062a\u0646\u0634\u0641 \u0644\u064a \u062a\u0645\u0639\u0647</li>\n<li>\u0648 \u0644\u0630\u062a\u0643 \u0642\u0628\u0644 \u0627\u0646 \u064a\u0643\u0648\u0646</li>\n<li></li></ol>\n",
