      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, upside down",
          "value": "<p>Right side:</p>\n<p>To my lord and illustrious master [...] Abu 'l-A\u02bel\u0101, may God keep him.&nbsp;</p>\n<p>&nbsp;</p>\n<p>Left side:</p>\n<p>[From] his grate[ful] A[bu '1] Ri\u1e0da. Convey and be rewarded!</p>\n<p>Between the two lines in small script: son of Abu 'l-Khayr, son of ...</p>\n<p>&nbsp;</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
