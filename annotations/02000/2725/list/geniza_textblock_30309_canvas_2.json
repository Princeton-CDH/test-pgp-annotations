        {
          "type": "TextualBody",
          "label": "Firkovitch II NS 1700 25a (page 2)",
          "value": "<p>\u0639\u0645\u0648\u062f\u0629 \u05d1</p>\n\n<ol><li>\u0633\u0637\u0644 \u0648\u0643\u0631\u0646\u064a\u0628 \u0648\u062e\u0648\u0632 \u0632\u064a\u062a \u05d1</li>\n<li>\u0645\u0642\u062f\u0645\u0629 \u0648\u0645\u0647 \u0630\u0627\u0626\u062a\u0628\u0629 \u05d3</li>\n<li>\u0645\u0646\u0634\u0641\u0629 \u05d1</li>\n<li>\u062d\u0642 \u0627\u0644\u062d\u0644\u064a \u0644\u0644\u062d\u0644\u0649 \u05d0 \u0644\u0644\u062d\u0644\u064a \u05d0</li>\n<li>\u0633\u0641\u0638 \u0648\u062e\u0631\u0633\u064a\u0629 \u0648\u0645\u0642\u062f\u0645\u0629 \u0644\u0637\u064a\u0641\u0629</li>\n<li>\u05d4</li>\n<li>\u0632\u0648\u062c \u062c\u0648\u0627\u0643\u064a\u0646 \u0648\u0631\u062f\u0647 \u062f\u0628\u064a\u0642\u064a</li>\n<li>\u0648\u0645\u0644\u062d\u0641\u0629 \u05d3</li>\n<li>\u0645\u0646\u062f\u064a\u0644 \u062f\u0628\u064a\u0642\u064a \u0645\u062c\u0627\u0648\u0645 \u05d4</li>\n<li>\u0645\u0646\u062f\u064a\u0644 \u0628\u064a\u0627\u0636 \u0644\u0627\u0644\u0645 \u05d1</li>\n<li>\u062c\u0627\u0631\u064a\u0629 \u062a\u062f\u0639\u0627 \u0639\u0648\u062f \u0627\u0644\u0632\u0627\u0646\u0643</li>\n<li>\u0627\u0644\u062c\u0645\u0644\u0629 \u05e7</li>\n<li>\u0645\u0635\u0628\u063a \u05d3</li>\n<li>\u0627\u0644\u062c\u0645\u0644\u0629 \u0628\u0627\u0644\u0645\u0642\u062f\u0645 \u05d5\u05dc</li>\n<li>\u0645\u062e\u0635\u0631 \u05ea\u05e7 \u05e7</li>\n<li>\u0627\u0644\u062c\u0645\u0644\u0629 \u0628\u0627\u0644\u0645\u0642\u062f\u0645 \u0648\u0627\u0644\u0645\u0648\u062e\u0631</li>\n<li>\u0633\u062a\u0629 \u0645\u0627\u0626\u0629 \u0648\u0633\u0628\u0639\u064a\u0646</li>\n<li>\u0634\u0648\u064a \u062f\u064a\u0646\u0631 \u0628\u062f\u064a\u0646\u0631</li>\n<li>\u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0635\u0641 \u0645\u0646 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u062a\u064a \u0627\u0644\u0645\u0639\u0631\u0648\u0643\u0629</li>\n<li>\u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0628\u062d\u0627\u0631\u0629 \u0632\u0648\u064a\u0644\u0629 \u0627\u0644\u062a\u064a \u0627\u0648\u0647\u0628</li>\n<li>\u0644\u0647\u0627 \u0627\u062e\u0648\u0647\u0627 \u0627\u0644\u062a\u064a \u0627\u0644\u0645\u0639\u0631\u0648\u0643\u0629 \u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0628\u062d\u0627\u0631\u0629 \u0632\u0648\u064a\u0644\u0629 \u0627\u0644\u062a\u064a \u0627\u0648\u0647\u0628 \u0644\u0647\u0627 \u0627\u0643\u0648\u0647\u0627 \u0627\u0644\u062a\u064a \u0628\u0627\u0632\u0642\u0629 \u0627\u0644\u0646\u0635\u0627\u0631\u064a</li>\n<li>\u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0635\u0641 \u0645\u0646 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0635\u063a\u064a\u0629 \u0627\u0644</li>\n<li>\u0645\u062c\u0627\u0648\u0631\u0629 \u0644\u0647\u0627 \u0627\u0644\u062a\u064a \u0627\u0648\u0647\u0628\u0647\u0627</li>\n<li>\u0627\u0645\u064a\u0646 \u0627\u0644\u062f\u0648\u0644\u0629</li></ol>\n",
