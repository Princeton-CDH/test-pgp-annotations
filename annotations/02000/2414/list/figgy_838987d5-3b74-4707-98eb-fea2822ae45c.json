          "type": "TextualBody",
          "label": "Verso, right margin",
          "value": "\n<ol><li></li>\n<li></li>\n<li>\u0627\u0644\u0646\u062c\u064a\u0628</li>\n<li>\u0644\u0627</li>\n<li>\u062a\u063a\u0641\u0644 \u0639\u0646 \u0647\u0630\u0647</li>\n<li>\u0627\u0644\u0642\u0635\u0629 \u0642\u0631\u0627\u062a</li>\n<li>\u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0639\u0644\u0649 \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0648\u0627\u0644\u062f</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0639\u0644\u0649 \u0645\u0648\u0644\u0627\u064a</li>\n<li>\u0627\u0644\u0645\u0643\u064a\u0646</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0639\u0644\u0649 \u0627\u0647\u0644 \u0628\u064a\u062a\u0643</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0645\u0648\u0644\u0627\u064a \u0648\u0627\u0643\u064a</li>\n<li>\u0648\u0648\u0627\u0644\u062f\u062a\u064a</li>\n<li>\u0648\u0643\u0627\u0644\u062a\u064a</li>\n<li>\u0648\u0648\u0644\u062f\u0647\u0627</li>\n<li>\u064a\u0633\u0644\u0645\u0648</li>\n<li>\u0639\u0644\u064a\u0643\u0645</li>\n<li></li></ol>\n",
