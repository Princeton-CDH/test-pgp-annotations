        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u064a\u062e\u0631\u062c\u0647\u0627 \u0645\u0646 \u0639\u0646\u062f\u0647 \u062d\u062a\u0649 \u064a\u0627\u062e\u0630</li>\n<li>\u0645\u0646 \u0635\u0627\u062d\u0628\u0647 \u05d9\u05d3 \u062f\u0631\u0647\u0645 \u05d9\u05d1</li>\n<li>\u062d\u0642 \u0635\u0641\u0648 \u0648\u0642\u0635\u0627\u0631\u0647 \u0648\u0637\u0631\u0632 \u0648\u0648\u0627\u062c\u0628</li>\n<li>\u0628\u0627\u0628 \u0648\u062f\u0631\u0647\u0645\u064a\u0646 \u062d\u0642 \u0627\u0644\u0630\u064a \u0648\u0635\u0644\u0647\u0627</li>\n<li>\u0627\u0644\u0649 \u0645\u0635\u0631 \u0648\u0647\u0648 \u062d\u0627\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628</li>\n<li>\u0648\u0644\u0627 \u062a\u062f\u0641\u0639\u0648 \u0644\u0647 \u062d\u0628\u0647 \u0644\u0627\u0646\u0647 \u0627\u062e\u0630</li>\n<li>\u062d\u0642\u0647 \u0645\u0646\u064a \u0648\u0627\u0634\u062a\u0647\u064a \u0645\u0646 \u062d\u0636\u0631\u062a\u0643</li>\n<li>\u0627\u062e\u0630 \u0643\u0627\u0644\u0643 \u0627\u0644\u062f\u0631\u0627\u0647\u0645 \u0645\u0646 \u0635\u0627\u062d\u0628</li>\n<li>\u0627\u0644\u0634\u0642\u0629 \u064a\u0633\u062a\u0648\u0641\u0649 \u05d2 \u0627\u0644\u0630\u064a \u0628\u0642\u064a\u062a \u0644\u0647 \u0648\u064a\u0628\u0642\u0627</li>\n<li>\u064a\u0627 \u062a\u062a\u0641\u0636\u0644 \u062a\u0627\u062e\u0630 \u0644\u064a \u0628\u0647\u0627</li>\n<li>\u0648\u062a\u0636\u064a\u0641 \u0645\u0646 \u0639\u0646\u062f\u0643 \u0627\u0644\u0628\u0642\u064a\u0629 \u0631\u0628\u0639</li>\n<li>\u0642\u0646\u0638\u0627\u0631 \u0635\u0647\u0648\u062f \u062c\u064a\u0627\u062f \u0648\u0627\u0631\u064a\u062f \u0645\u0646\u0643</li>\n<li>\u0627\u0646 \u062a\u062a\u0641\u0636\u0644 \u062a\u0648\u062c\u0647 \u0644\u064a \u0642\u0644\u064a\u0644 \u0631\u0637\u0628</li>\n<li>\u0627\u0645\u0647\u0627\u062a \u0648\u0628\u0627\u0642\u062a\u064a\u0646 \u0646\u0648\u0641\u0631 \u0648\u0627\u0630\u064a\u0647\u0627</li>\n<li>\u0642\u0628\u0644 \u0627\u0644\u0639\u064a\u062f \u0648\u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0648\u0635\u064a\u0629</li>\n<li>\u0648\u0643\u0627\u0646 \u0639\u0644\u0649 \u0627\u0646\u064a \u0627\u0648\u062c\u0647 \u05e0 \u0633\u0641\u0631\u062c\u0644\u0647 \u0645\u0627</li>\n<li>\u0648\u062c\u062f\u062a \u0645\u0646 \u064a\u0627\u062e\u0630\u0647\u0627 \u0645\u0639\u0647 \u0648\u0627\u0646\u0627 \u0627\u0646 \u0634\u0627\u0644\u0644\u0647</li>\n<li>\u0627\u0648\u062c\u0647\u0627 \u0641\u064a \u0645\u0627 \u0642\u0631\u0628 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643</li>\n<li>\u0627\u0644\u0633 \u062a\u062e\u0635 \u0643\u0627\u0644\u0643 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633 \u0648\u062a\u062e\u0635</li>\n<li>\u0639\u0646\u0649 \u0633\u062a \u0646\u0639\u0645 \u0627\u0644\u0633 \u0648\u0646\u0633\u064a\u0645 \u064a\u0642\u0631\u064a\u0643 \u0627\u0644\u0633</li>\n<li>\u0648\u0645\u0646 \u0639\u0646\u062f\u064a \u0641\u064a \u0627\u0644\u0628\u064a\u062a \u064a\u062e\u0635\u0648\u0643 \u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0645\u0627 \u062a\u0639\u0631\u0641 \u0645\u0627 \u0639\u0644\u0649 \u0642\u0644\u0648\u0628\u0647\u0645 \u0645\u0646</li>\n<li>\u062c\u0647\u062a\u0643 \u0648\u0643\u0631\u064a\u0645\u062a\u0643 \u0648\u0627\u062e\u0648\u0643 \u0648\u064a\u062e\u0635\u0648\u0643</li>\n<li>\u0628\u0627\u0644\u0633 \u0648\u062a\u062e\u0635 \u0639\u0646\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646</li>\n<li>\u0648\u0647\u0631\u0648\u0646 \u0627\u0644\u0633 \u0648\u0627\u0628\u0648 \u0639\u0644\u0649 \u0628\u0646 \u0627\u0644\u0642\u0635\u064a\u0631 \u0648\u0627\u062e\u0648\u0629 \u0627\u0644\u0633</li>\n<li>\u0627\u062e\u064a \u0648\u0627\u0644\u0639\u0632\u064a\u0632 \u0639\u0644\u0649 \u0648\u0639\u0646\u062f\u064a \u0627\u0644\u0634\u064a\u062e \u0627\u062e\u0648\u0647 \u0648\u0642\u064a\u0629</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u062e\u064a\u0631 \u0628\u0631 \u05e0\u05e1\u05d9\u05dd \u0646\u0639 \u0627\u0644\u0633\u0648 \u0641\u064a\u0647 \u05d9\u05e2\u05e7\u05d1</li>\n<li>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647</li></ol>\n",
          "format": "text/html"
        }
      ],
