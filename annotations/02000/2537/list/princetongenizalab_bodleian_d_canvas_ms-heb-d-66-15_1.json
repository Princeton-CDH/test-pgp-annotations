      "body": [
        {
          "type": "TextualBody",
          "label": "\u05e9\u05d5\u05dc\u05d9\u05d9\u05dd, \u05d9\u05de\u05d9\u05df",
          "value": "<p><span lang=\"he\">\u05d4\u05d9\u05d5\u05dd, \u05de\u05de\u05e9, \u05d5\u05d0\u05ea\u05d4 \u05de\u05e6\u05d5\u05d5\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc\u05dd \u05dc\u05e1\u05d9\u05e6\u05d9\u05dc\u05d9\u05d4, \u05d0\u05d1\u05dc \u05dc\u05d0 \u05e0\u05e1\u05ea\u05d9\u05d9\u05e2 \u05d4\u05d3\u05d1\u05e8, \u05db\u05d9 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05e0\u05d5 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3\u05dd (\u05d1\u05d7\u05d6\u05e8\u05d4), \u05d5\u05d4\u05dc\u05d5\u05d0 \u05db\u05d1\u05e8 \u05e9\u05d9\u05dc\u05de\u05e0\u05d5 \u05d3\u05de\u05d9 \u05d4\u05d5\u05d1\u05dc\u05d4 \u05d1\u05e2\u05d3\u05dd. \u05d4\u05d9\u05d4 \u05d1\u05d3\u05e2\u05ea\u05e0\u05d5 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05d0\u05ea \u05de\u05e8\u05d1\u05d9\u05ea \u05d4\u05e4\u05e9\u05ea\u05d9\u05dd \u05e9\u05dc\u05e0\u05d5 \u05dc\u05e1\u05d9\u05e6\u05d9\u05dc\u05d9\u05d4, \u05d0\u05d1\u05dc \u05d4\u05d2\u05d9\u05e2\u05d5 \u05d9\u05d3\u05d9\u05e2\u05d5\u05ea \u05e9\u05d4\u05d0\u05de\u05d9\u05e8 \u05e9\u05e8\u05e3 \u05d0\u05dc\u05d3\u05d5\u05dc\u05d4, \u05d9\u05ea\u05de\u05d9\u05d3 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05ea \u05d2\u05d3\u05d5\u05dc\u05ea\u05d5, \u05d7\u05d6\u05e8 \u05d0\u05dc</span></p>\n<p><span lang=\"he\"></span></p>",
