      "body": [
        {
          "type": "TextualBody",
          "label": "Right margin, diagonal lines written upside down.",
          "value": "<p>\u0627\u0648 \u062a\u0644\u064a\u0633 \u062a\u0627\u062e\u0630 \u0641\u064a\u0647 \u0627\u0644\u062f\u0642\u064a\u0642 \u0648\u062a\u0639\u0631\u0641\u0646\u064a \u062e\u0628\u0631 \u0627\u0644\u0645\u0633 \u0648\u0643\u064a\u0641 \u0641\u064a\u0647 \u0648\u0644\u0627 \u062a\u0646\u062a\u0638\u0631 \u0645\u0631\u0643\u0628 \u0627\u0646 \u0633\u0647\u0644 \u0645\u0631\u0643\u0628 \u0645\u0646 \u0627\u0644\u0645\u062f\u0644\u0629 \u0648\u0627\u0644\u0627 \u0627\u0645\u0634\u0649 \u0627\u0644\u0649 \u0628\u0646\u0647\u0627 \u0648\u062a\u0631\u0643\u0628 \u0645\u0646 \u0628\u0646\u0647\u0627 \u0628\u0646\u0635\u0641 \u062f\u0631\u0647\u0645 \u0627\u0644\u0649 \u0645\u0646\u064a\u0629 \u0632\u0641\u062a\u0627 \u062a\u0627\u062e\u0630 \u0645\u0627 \u0633\u0647\u0644 \u0644\u0627\u0646 \u0642\u0644\u0628\u064a \u0645\u0634\u063a\u0648\u0644 \u0628\u0643 \u0643\u062b\u064a\u0631 \u0648\u0644\u0627 \u062a\u062d\u0648\u062c\u0646\u064a \u0627\u0643\u062a\u0628 \u0644\u0643 \u0643\u062a\u0627\u0628 \u0627\u062e\u0631</p>",
