        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0639\u0646 \u0645\u0627</li>\n<li>\u0646 \u0645\u0627 \u0645\u0646 \u0627\u0628\u0648 \u0646\u0635\u0631 \u0630\u0644\u0643</li>\n<li>\u062a \u0641\u062e\u0631\u062c \u0639\u0644\u0649 \u0648\u0633\u0627\u0644\u0646\u064a \u0628\u062d\u0636\u0631\u0629</li>\n<li>\u0627\u062c\u0627\u0648\u0628\u0643 \u0644\u0627\u0646\u064a \u0627\u0634\u0641\u0642 \u0639\u0644\u0649 \u0645\u062e\u0627\u0633\u0631\u062a\u0643 \u062b\u0645</li>\n<li>\u0642\u062f\u0631\u062a \u0644\u0643 \u0643\u0644\u0627</li>\n<li>\u0639\u0644\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0628\u0631\u0643\u0627\u062a \u0627\u0644\u0649 \u0627\u0646 \u062e\u0631\u062c\u062a \u0648\u0628\u0642\u064a \u0647\u0648 \u0628\u0639\u062f\u0649 \u0641\u0645\u0627</li>\n<li>\u0645\u0646 \u0644\u0648 \u064a\u0633\u0628\u0647 \u0648\u0630\u0643\u0631 \u062d\u062a\u0649 \u0627\u0644\u0646\u0633\u0627 \u0648\u0628\u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0638\u064a\u0645 \u0645\u0627 \u0647\u0627\u0646 \u0644\u064a \u0627\u0644\u0646\u0641\u0633</li>\n<li>\u0648\u0644\u0627 \u063a\u064a\u0631\u0647 \u0639\u0644\u0649 \u0645\u0627 \u0633\u0645\u0639\u0648\u0647 \u0645\u0646\u0647 \u0642\u062f\u0627\u0645 \u0631\u062c\u0627\u0644 \u0648\u0646\u0633\u0627 \u0648\u0627\u0646\u0627 \u0627\u0633\u0644 \u062d\u0636\u0631\u062a\u0647 \u0627\u0646 \u064a\u0646\u0641\u062f</li>\n<li>\u062e\u0644\u0641 \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0636\u0631\u064a\u0646 \u0648\u064a\u0633\u062a\u062d\u0644\u0641\u0647\u0645 \u0641\u064a\u0639\u0631\u0641\u0648\u0647 \u0645\u0627 \u0633\u0645\u0639\u0648\u0647 \u0645\u0646\u0647\u0645 \u0641\u0627\u0646 \u0643\u0627\u0646</li>\n<li>\u0628\u0633\u0628\u0628 \u0627\u0646 \u0627\u0646\u0633\u0628 \u0627\u0644\u0649 \u0627\u0646\u064a \u0630\u0643\u0631\u062a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0628\u0631\u0643\u0627\u062a \u064a\u062c\u0628 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0641\u0627\u0646\u0627</li>\n<li>\u0627\u0631\u062c\u0639 \u0639\u0644\u0649 \u062f\u064a\u0646 \u062c\u0648\u0627\u0631 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0628\u0631\u0643\u0627\u062a \u0645\u0641\u0627\u0648\u0642 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0632\u0643\u0631\u064a \u0641\u0643\u064a\u0641</li>\n<li>\u0627\u0646\u064a \u0644\u0645 \u0627\u0642\u0648\u0645 \u0644 \u0648\u0642\u062f \u0648\u062c\u0631\u0649 \u0639\u0644\u0649 \u0639\u0628\u062f\u0629 \u064a\u0645\u064a\u0646 \u0639\u0635\u064a\u0645 \u0627\u0646 \u0644\u0645 \u0646\u0627\u062e\u0630 \u0645\u0627 \u064a\u062c\u0628 \u0644\u064a</li>\n<li>\u0641\u064a \u0630\u0644\u0643 \u0648\u0645\u0627 \u0646 \u0646 \u0641\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u062f \u062d\u0642 \u064a\u0648\u062e\u0630 \u0645\u0646\u0647 \u0639\u0648\u0636\u0629 \u0627\u0631\u0628\u0639\u0629 \u0641\u0628\u0627\u0644\u0644\u0647</li>\n<li>\u064a\u0627 \u0633\u064a\u064a\u062f\u0646\u0627 \u0644\u0627 \u062a\u063a\u0641\u0644 \u0639\u0646 \u0645\u0627 \u062c\u0631\u0649 \u0639\u0644\u0649 \u0648\u0644\u0627 \u062a\u062a\u0631\u0643\u0646\u064a \u0627\u062a\u0634\u062a\u062a \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0648\u0642\u062a</li>\n<li>\u0648\u062d\u0636\u0631\u0629 \u0633\u064a\u064a\u062f\u0646\u0627 \u0645\u0627 \u062a\u063a\u0641\u0644 \u0639\u0646 \u0639\u0628\u062f\u0647\u0627 \u062c\u0639\u0644\u062a \u0641\u0630\u0627\u0647</li>\n<li>\u0648\u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0637\u0631\u064a\u0646 \u0627\u0628\u0648 \u0646\u0635\u0631 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d1\u05df \u064a\u062d\u064a\u064a</li></ol>\n",
