        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li></li>\n<li>\u062a\u0642\u062f\u0645\u062a \u0643\u062a\u0628\u064a \u0627\u0644\u0649 \u062d\u0636\u0631\u0629 \u0645\u0648\u0644\u0626\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0627\u0637\u0627\u0644</li>\n<li>\u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0647 \u0648\u0639\u0644\u0647 \u0648\u0631\u0641\u0639\u062a\u0647 \u0648\u0633\u0646\u0627\u0647 \u0648\u062a\u0645\u0643\u064a\u0646\u0647</li>\n<li>\u0648\u0643\u0628\u062a \u0627\u0639\u062f\u0627\u0647 \u0639\u0646 \u0634\u0648\u0642 \u0627\u0644\u064a\u0647\u0627 \u0634\u062f\u064a\u062f \u062c\u0645\u0639 \u0627\u0644\u0644\u0647 \u0628\u064a\u0646\u0646\u0627</li>\n<li>\u0639\u0644\u0649 \u0627\u0633\u0631 \u062d\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648\u062e\u0631\u0645\u0647 \u0627\u0646\u0647 \u0648\u0644\u0649 \u062f\u0627\u0644\u0643 \u0648\u0647\u0648 \u0627\u0644\u0642\u0627\u062f\u0631</li>\n<li>\u0639\u0644\u064a\u0647 \u0627\u0646\u0634\u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0630\u064a \u0627\u0639\u0644\u0645\u0647\u0627 \u0627\u0646\u0646\u064a \u0642\u062f \u0648\u062c\u0647\u062a \u0635\u062d\u0628\u062a</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0632\u064a\u062f \u0627\u0644\u0630\u064a \u0648 \u062b \u0627\u0646\u0627 \u0648\u0647\u0648 \u0648\u0643\u0627\u0646 \u0635\u064a\u0641\u0646\u0627 \u062a\u062a\u0645\u0647</li>\n<li>\u0627\u0644\u0646\u0642\u062f \u0627\u0644\u0633\u062a\u064a\u0646 \u0648\u0645\u0628\u0644\u063a\u0629 \u0647\u064a \u062f\u064a\u0646\u0627\u0631 \u0648\u0632\u0646\u0647\u0627 \u0627\u0631\u0628\u0639\u0629</li>\n<li>\u062a\u0639\u0634\u0631 \u062f\u064a\u0646\u0627\u0631 \u0648\u0646\u0635\u0641 \u0648\u0631\u0628\u0639 \u0627\u0646\u0639\u0645 \u0627\u0642\u0641 \u0645\u0639\u0647 \u062d\u062a\u0649 \u064a\u0633\u0644\u0645\u0647\u0627</li>\n<li>\u0644\u0647\u0627 \u0642\u062f\u0627\u0645\u0643 \u0648\u0642\u062f\u0627\u0645 \u0627\u062e\u064a \u0648\u0642\u062f \u0627\u0648\u0636\u064a\u062a\u0647\u0627 \u0644\u0627\u0639\u0644\u0645\u0647\u0627</li>\n<li>\u0627\u0644\u0627 \u0645\u0646 \u064a\u062f\u0647 \u0627\u0644\u0649 \u064a\u062f\u0647\u0627 \u0642\u062f\u0627\u0645\u0643\u0645 \u0648\u0647\u064a \u0648\u062d\u064a\u0627\u062a\u0643 \u0639\u0644\u0649</li>\n<li>\u0641\u0627\u0646\u0647\u0627 \u0642\u0633\u0645 \u0645\u062e\u062a\u0648\u0645\u0629 \u0645\u0646 \u0627\u0648\u0644 \u064a\u0648\u0645 \u0627\u0646 \u0648\u0635\u0644\u062a \u0648\u0645\u0627</li></ol>\n",
