        {
          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0628</li>\n<li>\u0627\u0644\u0630\u064a \u0633\u0627\u0644 \u062d\u0636\u0631\u0629 \u0633\u064a\u064a\u062f\u0646\u0627 \u0641\u064a\u0647 \u0645\u0645\u0627\u0644\u064a\u0643\u0647\u0627 \u0627\u0628\u0648 \u0627\u0644\u0631\u0636\u0627 \u0627\u0644</li>\n<li>\u0627\u0628\u0648\u0627\u0646\u064a \u0627 \u0643\u062a\u0627\u0628 \u0645\u0646 \u0627\u0644\u0645\u0639\u0638\u0645 \u0627\u0644\u064a \u0627\u0644\u0642\u0627\u0636\u064a \u0627\u0644\u0645\u0643\u064a\u0646 \u0627\u0644</li>\n<li>\u0645\u0634\u0627\u0631\u0641 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0628\u0627\u0644\u0648\u0636\u064a\u0629 \u0641\u064a \u0627\u0646 \u064a\u0637\u0644\u0642 \u0644\u0647 \u0631\u0628\u0639 \u0627\u0644 \u0647</li>\n<li>\u062c\u0644\u0629 \u0628\u0631\u0633\u0645 \u0645\u0627\u0648\u0646\u0629 \u0645\u0646\u0632\u0644\u0629 \u0639\u0644 \u062c\u0631\u062a \u0628\u0647 \u0627\u0644</li>\n<li>\u064a\u0637\u0627\u0644\u0628 \u0628\u0648\u0627\u062c\u0628 \u0627\u0644\u0639\u0631\u0636 \u0641\u0627\u0646 \u0630\u0644\u0643 \u0627\u0646\u0645\u0627 \u0647\u0648 \u0644\u0627\u0632\u0645</li>\n<li>\u0627\u0644\u0645\u062a\u0631\u0628\u062d\u064a\u0646 \u0648\u0644\u0627 \u064a\u0644\u0632\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0627\u0648\u0646\u0629 \u0627\u0644\u0627 \u0648\u0627\u062c\u0628</li>\n<li>\u0633 \u05d4 \u0644\u0627 \u063a\u064a\u0631 \u0648\u0627\u0646 \u064a\u062e\u0641 \u0639\u0646\u0647 \u0641\u064a \u0630\u0644\u0643 \u0627\u0639\u0646\u0627\u062a \u05de</li>\n<li>\u05d1 \u0648\u0627\u0644\u0645\u062a\u0635\u0631\u0641\u064a\u0646</li></ol>\n",
