      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627\u0639\u0644\u0645 \u0627\u0644\u0627\u0643 \u0627\u0644\u0639\u0632\u064a\u0632 \u0639\u0644\u064a\u064a \u0627\u0646\u064a \u0642\u062f \u0633\u0645\u0639\u062a \u0627\u0646 \u0627\u0645\u064a \u0636\u0639\u064a\u0641\u0629 \u0648\u0627\u0634\u062a\u063a\u0644 \u0642\u0644\u0628\u064a \u0639\u0644\u064a\u0647\u0627 \u0643\u062b\u064a\u0631 \u0641\u0627\u0644\u0644\u0647 \u0627\u0644\u0644\u0647 \u0633\u0627\u0639\u062a \u0648\u0642\u0648\u0641\u0641 \u0639\u0644\u0649 \u0647\u0627\u0630\u0629 \u0627\u0644\u0627\u062d\u0631\u0641 \u0645\u0646 \u0643\u0644 \u0628\u062f \u0648\u0633\u0628\u0628 \u0633\u064a\u0631 \u0644\u064a \u0643\u062a\u0627\u0628 \u0628\u062c\u0645\u064a\u0639 \u0627\u062d\u0648\u0627\u0644\u0643\u0645 \u0648\u0627\u0646\u062d\u0646 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639\u062a \u0627\u0644\u0639\u0627\u0641\u064a\u0629 \u0627\u0646\u0627 \u0648\u0627\u062e\u064a \u0648\u063a\u064a\u0631 \u0647\u0627\u0630\u0627 \u0627\u0646\u0643 \u0644\u0627 \u062a\u063a\u0641\u0644 \u0639\u0646 \u0645\u0639\u0644\u0645\u0643 \u0648\u0644\u0627 \u0633\u0627\u0639\u0629 \u0648\u0627\u062d\u062f\u0629 \u05d5\u05e9\u05dc\u05d5\u05dd \u0648\u0642\u0648\u0644 \u0644\u062e\u0627\u0644\u0649 \u0627\u0644\u0630\u064a\u0627\u0646 \u0627\u062e\u064a \u064a\u0642\u0631\u064a\u0643 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0642\u062f \u0642\u0627\u0644 \u0643\u0627\u0644\u0647 \u0645\u0627 \u0645\u0639\u0647 \u0634\u064a \u0648\u0647\u0627\u0630\u0627\u0643 \u0627\u0644\u0639\u062f\u0629 \u0627\u0644\u0630\u064a \u0644\u0647 \u0639\u0646\u062f\u0643 \u0627\u0646 \u0648\u0644\u0648 \u0627\u0646 \u0645\u0639 \u0627\u062e\u064a \u0634\u064a \u0633\u064a\u0631 \u0644\u0643 \u0648\u0627\u0646 \u0635\u0628\u0631\u062a \u0644\u0627 \u062a\u0639\u0631\u0641\u0647\u0627 \u0627\u0644\u0649 \u0645\u0646\u0647 \u0648\u0644\u0648 \u0627\u0646\u0647 \u064a\u0628\u0635\u0631 \u0644\u0643 \u0645\u0646 \u0639\u0646 \u05d5\u05e9\u05dc\u05d5\u05dd \u0639\u0644\u064a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0649 \u0627\u0644 \u0627 \u0648\u0627\u0648\u0635\u0644 \u0633\u0644\u0627\u0645\u064a \u0644\u0643\u0627\u0644\u0649 \u0627\u0644\u062d\u0628\u0631 \u0648\u0642\u0648\u0644 \u0644\u0647 \u0627\u062e\u064a \u064a\u0633\u0644\u0645 \u0639\u0644\u064a\u0643 \u0648\u0639\u0644\u0649 \u0648\u0644\u062f\u0643 \u0648\u0642\u0648\u0644 \u0644\u064a \u0628\u0643\u0645 \u0635\u0631\u0641\u062a \u0627\u0644\u062f\u064a\u0646\u0627\u0631 \u062d\u062a\u0627 \u0627\u0633\u062a\u0647\u0645 \u0641\u064a \u0627\u0644\u0630\u064a \u064a\u062a\u0628\u0642\u0627 \u0648\u0627\u0633\u062a\u0641\u0647\u0645 \u0645\u0646\u0647 \u0628\u0643\u0645 \u0628\u0627\u0639\u0629 \u0648\u0643\u0627\u0645 \u064a\u0641\u0635\u0644 \u0644\u0647 \u0648\u0627\u0639\u0644\u0645\u0646\u064a \u0628\u0632\u0627\u0644 \u0628\u0630\u0627\u0644\u0643 \u0633\u0631\u0639\u0629 \u0641\u0645\u0627 \u062a\u0639\u0644\u0645\u0648 \u0645\u0627 \u0639\u0646\u062f\u064a \u0645\u0646 \u0634\u063a\u0644 \u0627\u0644\u0642\u0644\u0628 \u0644\u0645\u0627 \u0633\u0645\u0639\u062a \u0648\u0639\u0631\u0641\u0646\u064a \u0627\u0646 \u0633\u0627\u0641\u0631 \u0627\u0644\u0641\u0631\u0633 \u0639\u0634\u0631\u062a \u0627\u0648 \u0644\u0643 \u0628\u0647\u0627</p>",
