      "body": [
        {
          "type": "TextualBody",
          "label": "recto - right margin",
          "value": "\n<ol><li>\u0627\u0628\u0648 \u0627\u0644\u0631\u0636\u0627 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0642\u0644\u0647 \u0627\u0644\u064a\u0648\u0645 \u0645\u0646 \u0634\u0647\u0631 \u0648\u0646\u0635\u0641 \u062f\u0641\u0639\u062a \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0628\u0639 \u0628\u0627\u0644\u0627\u0648\u062c\u0631\u0629 \u0644\u0633\u0644\u0645\u0627\u0646 \u0627\u0644\u0645\u062e\u0627\u0631\u064a</li>\n<li>\u0645\u0627 \u0648\u0635\u0644 \u0639\u0631\u0641\u062a\u0643 \u0628\u0630\u0644\u0643 \u0648\u062a\u062e\u0635 \u062d\u0635\u0631\u0629 \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0631\u0636\u0627 \u0628\u0646 \u0643\u0644\u0627\u0645 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645</li></ol>\n",
