      "body": [
        {
          "type": "TextualBody",
          "label": "Recto Margin",
          "value": "<ol>\n<li>\n<p>Answer quickly.</p>\n</li>\n<li>\n<p>Be so</p>\n</li>\n<li>\n<p>kind as</p>\n</li>\n<li>\n<p>to do</p>\n</li>\n<li>\n<p>it.</p>\n</li>\n<li>\n<p>May your peace</p>\n</li>\n<li>\n<p>increase</p>\n</li>\n<li>\n<p>and not</p>\n</li>\n<li>\n<p>decrease.</p>\n</li>\n<li>\n<p>Amen</p>\n</li>\n<li>\n<p>Selah.</p>\n</li>\n</ol>",
          "format": "text/html"
        }
