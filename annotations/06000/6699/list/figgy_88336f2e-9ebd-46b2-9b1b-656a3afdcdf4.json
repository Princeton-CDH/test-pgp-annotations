      "body": [
        {
          "type": "TextualBody",
          "label": "Recto:",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 \u064a\u0627 \u0628\u0646\u062a\u064a \u0648\u0627\u0644\u0639\u0632\u064a\u0632\u0629 \u0639\u0644\u0649 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0646\u0639\u0645\u0627\u0643 \u0648\u0635\u0627\u0646\u0643 \u0648\u0648\u0642\u0627\u0643 \u0648\u0645\u0646 \u062d\u0633\u0646 \u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0644\u0627 \u0627\u0643\u0644\u0627\u0643</li>\n<li>\u05d0\u05dc\u05d5\u05dc \u0639\u0631\u0641\u0643 \u0627\u0644\u0644\u0647 \u0633\u0639\u0627\u062f\u0629 \u0645\u0627 \u064a\u0644\u064a\u0647 \u0645\u0646 \u0627\u0644\u0627\u0639\u064a\u0627\u062f \u0627\u0644\u0645\u0628\u0627\u0631\u0643\u0629 \u0648\u0627\u0644\u0635\u0648\u0645\u0648\u062a \u0627\u0644\u0644\u0647 \u064a\u0634\u0647\u062f\u0643 \u0627\u0646\u062a \u0648\u0648\u0644\u062f\u0643 \u0633\u0646\u064a\u0646 \u0643\u062b\u064a\u0631\u0629</li>\n<li>\u064a\u0627 \u0628\u0646\u062a\u064a \u0637\u0627\u0644\u062a \u0639\u0644\u0649 \u0627\u0644\u0633\u0646\u064a\u0646 \u0648\u0627\u0646\u062a\u0642\u0644\u062a \u0627\u0644\u0627\u062d\u0648\u0627\u0644 \u0648\u0638\u0646\u064a \u0627\u0646\u0643 \u0646\u0633\u064a\u062a\u0646\u064a \u0648\u063a\u0641\u064a\u062a\u0646\u064a \u0644\u0627\u0646 \u0627\u0644\u064a\u0648\u0645 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0633\u0646</li>\n<li>\u0648\u0644\u0627 \u0635\u0628\u0631 \u0648\u0627\u0646\u062a \u0644\u0639\u0645\u0631\u064a \u0641\u0645\u0639\u0630\u0648\u0631\u0647 \u0645\u0627 \u0639\u0646\u062f\u0643 \u0639\u0644\u0645 \u0645\u0646 \u062d\u0627\u0644\u0649 \u0648\u0644\u0627 \u0645\u0646 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a\u064a \u0645\u0646 \u0627\u0644\u0642</li>\n<li>\u0645\u0639 \u0627\u062e\u062a\u0643 \u0641\u064a\u0627 \u0644\u064a\u062a \u0634\u0639\u0631\u064a \u064a\u0627 \u0628\u0646\u062a\u064a \u0627\u064a\u0634 \u0646\u0633\u0627\u062e \u062a\u0631\u0628\u064a\u062a\u064a \u0648\u0645\u0639\u0627\u0646\u062f\u062a\u064a \u0645\u0639 \u0645\u0639\u0631\u0641\u062a\u0643 \u0627\u0646 \u0648\u0627\u0644\u0630\u0643</li>\n<li>\u0648\u0642\u062f\u0631 \u0627\u0644\u0644\u0647 \u062e\u0631\u062c\u062a \u0645\u0646\u0647\u0627 \u0631\u062c\u0645\u0627 \u0643\u0645\u0627 \u062e\u0631\u062c \u0627\u0643\u062b\u0631 \u0627\u0644\u0646\u0627\u0633 \u0648\u0639\u0627\u0646\u062f\u062a \u0627\u0644\u0649 \u0627\u0646 \u0648\u0635\u0644\u062a \u0627\u062e\u062a\u0643 \u0627\u0644\u0649 \u0628\u064a\u062a\u0647\u0627</li>\n<li>\u0648\u0639\u0627\u0646\u062f \u0645\u0627 \u0644\u064a \u0628\u0627\u0628 \u0646\u0641\u062a\u062d\u0647 \u0641\u0645\u0627 \u0642\u0648 \u0639\u064a\u0646 \u062a\u0630\u0643\u0631\u0646\u064a \u0641\u064a\u0647\u0627 \u0646\u0642\u0648\u0644 \u0639\u0646\u062f\u064a \u0645\u0646 \u064a\u0633\u0627\u0644 \u0627\u0644</li>\n<li>\u0627\u0644\u0644\u0647 \u0648\u0635\u0644 \u0627\u0644\u064a\u0646\u0627 \u0628\u0639\u062f \u0633\u0646\u062a\u064a\u0646 \u0645\u0627</li>\n<li>\u0628 \u0627\u0644\u0627 \u0648\u064a\u0648\u0635\u0644\u0647 \u0627\u0644\u0649 \u0644</li></ol>\n",
