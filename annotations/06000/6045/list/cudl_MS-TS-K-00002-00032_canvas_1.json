      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05d1\u05e8\u05db\u05ea \u05d9\u05d9 \u05d4\u05d9\u05d0 \u05ea\u05e2\u05e9\u05d9\u05e8 \u0634\u0631\u062d \u0645\u0627 \u0628\u0642\u0649 \u0644\u0646\u0627 \u0628\u0645\u0635\u0631 \u0639\u0646\u062f \u0627\u0628\u064a \u064a\u062d\u064a\u064a \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0645\u0645\u0627 \u0647\u0648 \u0644\u062e\u0627\u0635\u0629 \u0627\u0628\u0649 \u0627\u0644\u0641\u0631\u062c \u05d9\u05e9\u05d5\u05e2\u05d4 \u0632\u0648\u062c \u0634\u0642\u0627\u0642 \u0643\u0627\u0645 \u0648\u0645\u0645\u0627 \u0647\u0648 \u0644\u0644\u062e\u0644\u0637\u0629 \u0627\u064a\u0636\u0627 \u0628\u064a\u062f \u0627\u0628\u064a \u064a\u062d\u064a\u064a \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u062b\u0645\u0646 \u0641\u0648\u0637\u0647 \u0639\u0646\u062f \u0642\u063a\u0627\u0631\u0647 \u0648\u062b\u0645\u0646 \u0645\u0631\u062c\u0627\u0646 \u0628\u0646 \u0627\u0628\u0649 \u0627\u0644\u0645\u0639\u0627\u0644\u0649 \u05d9\u05d2 \u062f\u064a\u0646 \u0648\u0642\u0641\u0629 \u0645\u0633\u0645\u0627\u0631 \u0648\u062b\u0645\u0646 \u0642\u0641\u0629 \u0633\u064a\u0627\u0644\u0629 \u05d5 \u0645\u0646 \u0633\u0646\u0629 \u05de\u05d5 \u062b\u0645\u0646 \u05d2 \u0633\u0648\u0633\u064a\u0627\u062a \u05d6 \u05d9\u05d2 \u0631\u0637\u0644 \u062d\u0631\u064a\u0631 \u05d2 \u0644\u0627\u0633\u064a\u0646 \u0648\u0642\u062f \u062f\u0641\u0639 \u0644\u064a \u0645\u0627 \u0627\u0628\u064a\u0639 \u0645\u0646 \u062c\u0645\u0644\u062a\u0647 \u0648\u0645\u0627 \u062d\u0635\u0644 \u0644\u0647 \u0648\u0645\u0627 \u0628\u0642\u0649 \u063a\u064a\u0631 \u0645\u0628\u064a\u0648\u0639 \u0648\u0645\u0627 \u0628\u0642\u0649 \u064a\u0642\u062a\u0636\u0627 \u0627\u0646\u062a \u062a\u0633\u062a\u062e\u0631\u062c \u062b\u0645\u0646\u0647 \u0648\u062a\u062d\u0627\u0633\u0628\u0647 \u0639\u0644\u064a\u0647 \u0644\u0647 \u0645\u0646 \u0630\u0644\u0643 \u062b\u0645\u0646 \u0643\u0627\u0641\u0648\u0631 \u05db \u0648\u062b\u0645\u0646 \u0646\u0635\u0641 \u0643 \u0645\u0627 \u0628\u0642\u0649 \u0639\u0646\u062f\u0647 \u0648\u0645\u0627 \u062d\u0645\u0644 \u05d6 \u0627\u0648\u0642 \u0648\u0627 \u0628\u0634\u0631\u0649 \u05d9\u05d1 \u05e4 \u0634\u0642\u0647 \u0633\u0648\u0645 \u05d1\u05e8\u05db\u05ea \u05d9\u05d9 \u05d4\u05d9\u05d0 \u05ea\u05e2\u05e9\u05d9\u05e8 \u0634\u0631\u062d \u0645\u0627 \u062d\u0645\u0644\u062a\u0647 \u0645\u0646 \u0631\u062d\u0644 \u0635\u062d\u0628\u062a\u0643 \u0639\u0631\u0641\u0646\u0627 \u0627\u0644\u0644\u0647 \u0628\u0631\u0643\u062a\u0647 \u0645\u0646 \u0630\u0644\u0643 \u05d2 \u0642\u0646\u0627\u0637\u064a\u0631 \u05d9 \u0627\u0631\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0631\u0643\u062a\u0647 \u0645\u0646 \u0630\u0644\u0643 \u05d2 \u0642\u0646\u0627\u0638\u064a\u0631 \u05d9 \u0627\u0631\u0637\u0627\u0644 \u0632\u0627\u0628\u0642 \u0635\u0627\u0641\u0649 \u0627\u0644\u0641 \u0634\u062e\u0637 \u0627\u0644\u0649 \u0642\u064a\u0631\u0637\u064a\u0646 \u05dc\u05d1 \u0643\u0633\u0627 \u0627\u0646\u062f\u0644\u0633\u064a \u0646\u0647 \u0648\u0642\u0637\u0627\u0639 \u05e7 \u0634\u0639\u0631 \u0631\u0628\u0627\u0639\u064a \u05d2 \u05d9 \u0627\u0641\u0631\u064a\u0627 \u0645\u0627 \u0646\u0635\u0641 \u0627\u0644\u062b\u0645\u0646 \u05ea\u05e7\u05dc \u05e7\u05e7\u05e4 \u0648\u0642\u064a\u0631\u0637\u064a\u0646 \u062b\u0645\u0646 \u05e7 \u0641\u0631\u0643\u0629 \u0648\u0627\u062e\u0633\u064a\u0627 \u062e\u0644\u0637\u0629 \u0628\u0646 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u0627\u0646\u064a \u0648\u0628\u0642\u0649 \u0639\u0644\u064a\u0647\u0627 \u05e7\u05e7\u05d8\u05d5 \u0648\u0632\u0646 \u0642\u0641\u0629 \u05d9\u05d0 \u0644\u0648\u0644\u0648 \u05d4 \u0631\u0628\u0627\u0639\u064a\u0629 \u062e\u0628\u0631\u064a\u062a \u05d3 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0648\u0646\u0629 \u05d9\u05d2 \u062b\u0648\u0628 \u0628\u0648\u0646\u064a \u0631\u0628\u0627\u0639\u064a\u0629 \u0643\u0628\u0631\u064a\u062a \u05d3 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0648\u0646\u0629 \u05d9\u05d2 \u062b\u0648\u0628 \u0628\u0648\u0646\u064a \u0645\u062f \u05d3 \u0641\u0631\u0627\u0643 \u0643\u0627\u0645 \u0648\u0641\u0631\u0643\u062a\u064a\u0646 \u0631\u0628\u0627\u0639\u064a \u05d8\u05d5 \u0641\u0631\u0643\u0629 \u0645\u0642\u0635\u0648\u0631 \u05db \u0631\u0628\u0627\u0639\u064a \u05d9\u05d7 \u0631\u0637\u0644 \u0648\u0646\u0635\u0641 \u0634\u064a\u0634 \u05d5 \u0646\u0635\u0641 \u0644\u0647 \u0631\u0637\u0644 \u062d\u0631\u064a\u0631 \u05e7\u05e7\u05e4 \u05d5 \u0627\u0631\u0637\u0627\u0644 \u063a\u064a\u0631 \u0631\u0628\u0639 \u062d\u0631\u064a\u0631 \u05d4 \u05d8 \u0627\u062e\u0633\u064a\u0627 \u05db\u05d1 \u05d9\u05d3 \u0642\u0646\u0638\u0627\u0631 \u05d5 \u0646\u0635\u0641 \u062f\u064a\u0646 \u05d5 \u05e4\u05d6 \u0646\u0635\u0641 \u05e6 \u05d9\u05d3 \u0631\u0637\u0644 \u0631\u0628\u0639 \u0644\u0627\u0633\u064a\u0646 \u0641\u0628 \u0648\u0643\u0644\u0647 \u0633\u0642\u0644\u0627\u0637\u0648\u0646 \u0648\u0631\u062f\u0627\u0648\u064a\u0646 \u05d5\u05de \u0643\u0627\u0645 \u0648\u0631\u062f\u0627\u0648\u064a\u0646 \u0648\u0641\u0648\u0638\u0647 \u0645\u0646 \u0627\u0644 \u0648\u0645\u0631\u062c\u0627\u0646 \u05d2\u05d5\u05d9\u05e0\u05d4 \u05e9\u05d9\u05e9 \u05e4\u05d4 \u0648\u0644\u0641\u0627\u0641\u0629 \u0648\u0645\u062e\u0630\u0629 \u0644\u0644\u063a\u0631\u064a\u0628 \u05db\u05d1 \u062c\u0628\u0627 \u0635\u0648\u0641 \u05d8 \u0627\u062e\u0633\u064a\u0647 \u0648\u0646\u0635\u0641 \u0627\u0644\u063a\u0644\u0627\u0628\u064a\u0628 \u0648\u0645\u0639 \u05e1\u05dc\u05de\u05d0\u05df \u05d1\u05df \u05d4\u05e8\u05d5\u05df \u05d9\u05d2 \u062f\u064a\u0646\u0627\u0631 \u05d2 \u0627\u0644\u0627\u0641 \u05e7\u05e7\u05d1 \u0648\u0644\u062e\u0627\u0635\u062a\u0643 \u0642\u0641\u0629 \u0645\u0631\u0628\u0627 \u0648\u062c\u0648\u0646\u0629 \u0645\u0631\u062c\u0627\u0646 \u062f\u064a\u0646\u0627\u0631 \u05d2 \u0627\u0644\u0627\u0641 \u05e7\u05e7\u05d1 \u0648\u0644\u062e\u0627\u0635\u062a\u0643 \u0642\u0641\u0629 \u0645\u0631\u0628\u0627 \u0648\u062c\u0648\u0646\u0647 \u0645\u0631\u062c\u0627\u0646 \u05d1\u05e8\u05db\u05ea \u05d9\u05d9 \u05d4\u05d9\u05d0 \u05ea\u05e2\u05e9\u05d9\u05e8 \u0634\u0631\u062d \u0645\u0627 \u062d\u0645\u0644\u062a\u0647 \u0645\u0646 \u0631\u062d\u0644 \u0635\u062d\u0628\u062a\u0643 \u0639\u0631\u0641\u0646\u0627 \u0627\u0644\u0644\u0647 \u0628\u0631\u0643\u062a\u0647 \u0645\u0646 \u0630\u0644\u0643 \u05d2 \u0642\u0646\u0627\u0637\u064a\u0631 \u05d9 \u0627\u0631\u0637\u0627\u0644 \u0632\u0627\u0628\u0642 \u0635\u0627\u0641\u0649 \u0627\u0644\u0641 \u0634\u062e\u0637 \u0627\u0644\u0649 \u0642\u064a\u0631\u0637\u064a\u0646 \u05dc\u05d1 \u062e\u0633\u0627 \u0627\u0646\u062f\u0644\u0633\u064a \u05e0\u05d4 \u0648\u0642\u0637\u0627\u0639 \u05e7 \u0634\u0639\u0631 \u0631\u0628\u0627\u0639\u0649 \u05d2 \u05d9 \u0627\u0641\u0631\u064a\u0627 \u0645\u0627 \u0646\u0635\u0641 \u0627\u0644\u062b\u0645\u0646 \u05ea\u05e7\u05dc \u05e7\u05e7\u05e4 \u0648\u0642\u064a\u0631\u0637\u064a\u0646 \u062b\u0645\u0646 \u05e7 \u0641\u0631\u0643\u0629 \u0648\u0627\u062e\u0633\u064a\u0627 \u062e\u0644\u0637\u0629 \u0628\u0646 \u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u0627\u0646\u064a \u0648\u0628\u0642\u0649 \u0639\u0644\u064a\u0647\u0627 \u05e7\u05e7\u05d8\u05d5 \u0648\u0632\u0646 \u0642\u0641\u0629 \u05d9\u05d0 \u0644\u0648\u0644\u0648 \u05d4 \u0631\u0628\u0627\u0639\u064a\u0629 \u0643\u0628\u0631\u064a\u062a \u05d3 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0648\u0646\u0629 \u05d9\u05d2 \u062b\u0648\u0628 \u0628\u0648\u0646\u064a \u0645\u062f \u062f \u0641\u0631\u0627\u0643 \u0643\u0627\u0645 \u0648\u0641\u0631\u0643\u062a\u064a\u0646 \u0631\u0628\u0627\u0639\u064a \u05d8\u05d5 \u0641\u0631\u0643\u0629 \u0645\u0642\u0635\u0648\u0631 \u05db \u0631\u0628\u0627\u0639\u064a \u05d9\u05d7 \u0631\u0637\u0644 \u0648\u0646\u0635\u0641 \u0634\u064a\u0634 \u05d5 \u0646\u0635\u0641 \u0644\u0647 \u0631\u0637\u0644 \u062d\u0631\u064a\u0631 \u05e7\u05e7\u05e4 \u05d5 \u0627\u0631\u0637\u0627\u0644 \u063a\u064a\u0631 \u0631\u0628\u0639 \u062d\u0631\u064a\u0631 \u05d4 \u05d8 \u0627\u062e\u0633\u064a\u0627 \u05db\u05d1 \u05d9\u05d3 \u0642\u0646\u0638\u0627\u0631 \u05d5 \u0646\u0635\u0641 \u062f\u064a\u0646 \u05d5 \u05e4\u05d6 \u0646\u0635\u0641 \u05e6 \u064a\u062f \u0631\u0637\u0644 \u0627\u0644\u0649 \u0631\u0628\u0639 \u0644\u0627\u0633\u064a\u0646 \u0641\u0628 \u0648\u0643\u0644\u0647 \u0633\u0642\u0644\u0627\u0637\u0648\u0646 \u0648\u0631\u062f\u0627\u0648\u064a\u0646 \u05d5\u05de \u0643\u0627\u0645 \u0648\u0631\u062f\u0627\u0648\u064a\u0646 \u0648\u0641\u0648\u0638\u0647 \u0645\u0646</p>",
