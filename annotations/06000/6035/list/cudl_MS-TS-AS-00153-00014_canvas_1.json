      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u064a\u0643\u062a\u0648\u0628 \u0639\u0644\u064a\u0647\u0648\u0645 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0642\u062f \u0642\u0628\u0636\u062a \u064a\u0627\u062e\u064a \u0645\u0627 \u0638\u0627\u0631 \u0639\u0644\u0649 \u064a\u0627\u062e\u064a \u0627\u0644\u0630\u064a \u0648\u062f\u064a\u062a \u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u0648\u0631\u0628\u0627\u0639\u064a \u064a\u0644\u0632\u0645\u0646\u0627 \u0641\u0644\u0641\u0644 \u0631\u0628\u0627\u0639\u064a \u0644\u0627\u0646 \u062e\u0631\u062c\u0648 \u0634\u0648\u062d\u062f \u0648\u0627\u062d\u0648\u0627\u0644 \u0643\u062a\u0627\u0628 \u0627\u0628\u0648 \u05d9\u05e2\u05e7\u05d1 \u0627\u062e\u0648 \u062a\u0645\u0631\u0647 \u064a\u0638\u0646 \u0627\u0646 \u0627\u0644\u0641\u0644\u0641\u0644 \u0648\u0635\u0644 \u0627\u0644\u0641\u0644\u0641\u0644 \u0627\u0648 \u0627\u0644\u064a\u0647 \u0648\u0642\u062f \u0648\u062f\u064a\u062a \u0639\u062c \u0642\u0631\u0641\u0629 \u0627\u0644\u0644\u0647 \u064a\u0646 \u0641\u0627\u0645\u0627 \u062a\u062f\u0641\u0639\u0648 \u0627\u0644\u064a\u0647 \u0641\u0644\u0641\u0644 \u0627\u0648 \u0642\u0646\u0638\u0627\u0631 \u0642\u0631\u0641\u0629 \u0627\u0644\u064a\u0647 \u0644\u0627\u0646\u0647 \u0634\u064a\u062e \u0633\u0639\u0644\u0648\u0643 \u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u0648\u062f\u064a\u062a \u0639\u0644\u0649 \u0645\u0646 \u0634\u064a\u0643 \u0633\u0639\u0644\u0648\u0643 \u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u0648\u062f\u064a\u062a \u0639\u0644\u0649 \u0645\u0646 \u0646\u0635\u0641 \u0639\u0644\u0649 \u0627\u0644\u0628\u0642\u0645 \u0648\u062a\u0646\u0638\u0631 \u0645\u0627 \u0628\u0642\u0649 \u0644\u064a \u0645\u0646 \u0627\u0644\u0629 \u0639\u0646\u064a \u0646\u0635\u0641 \u0627\u0644\u0633\u0644\u0641\u0629 \u0648\u0645\u0627 \u0627\u0648\u0639\u062f\u062a\u0646\u064a \u0641\u064a \u0627\u0645\u0631 \u0627\u0644\u0634\u064