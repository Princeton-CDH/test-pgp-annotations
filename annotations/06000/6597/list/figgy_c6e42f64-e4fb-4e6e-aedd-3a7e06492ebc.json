        {
          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>. . .</li>\n<li>\u0645 \u0627\u062e\u0630\u0647\u0627 \u0648\u0644\u0645</li>\n<li>. . .</li>\n<li>\u0645\u0646 \u0645\u062f\u0646 \u0639\u0636\u064a\u0645</li>\n<li>\u0644\u0648 \u0641\u0639\u0644\u062a \u0645 \u0627 \u0648\u0627\u062e\u0630\u062a \u0645\u0646\u0647</li>\n<li>\u0639\u0634\u0631 \u062f\u0631\u0627\u0647\u0645 \u0648\u0631\u0627\u062d\u062a \u0627\u0644\u0649</li>\n<li>\u0645\u0635\u0631 \u0648\u0643\u0634\u0641\u062a \u0627\u062d\u0648\u0627\u0644\u0647\u0627</li>\n<li>\u0644\u062f\u0641\u0639\u0629 \u0644\u0647\u0627</li>\n<li>\u062a\u0631\u0648\u062d\u0649 \u0648\u0627\u0646\u0627 \u0627</li>\n<li>\u0639 \u0647\u0645 \u0648 \u0633\u064a\u064a\u0631\u0647\u0627 \u0644\u0643</li>\n<li>\u0645\u0646 \u0643\u0644 \u0628\u062f \u0642\u0628\u0644 \u0645\u0627 \u064a\u0641\u0631\u062c</li>\n<li>\u0627\u0644\u0634\u0647\u0631 \u0648\u062a\u0633\u062a\u062d\u0642 \u0627\u0644\u062c\u0632\u064a\u0629 \u0648\u0645\u0627</li>\n<li>\u0646\u0642\u062f\u0631 \u0646\u0642\u0639\u062f \u0644\u0627 \u0627\u0646\u0627 \u0648\u0644\u0627 \u0647\u0648</li>\n<li>\u0648\u0642\u062f \u0627\u0633\u062a\u0642\u0631 \u0645\u0639\u0647 \u0627\u0630 \u0644\u0645 \u062a\u063a\u064a</li>\n<li>\u0648\u0627\u0644\u0627 \u0631\u062d\u062a \u0627\u0646\u0627 \u0648\u0647\u0648 \u0648\u0627\u0644\u0635\u063a\u064a\u064a\u0631\u0629</li>\n<li>\u0648\u062a\u0628\u0642\u0648 \u0627\u0644\u0630\u064a \u0641\u064a \u062f\u064a\u0627\u0631 \u0645\u0635\u0631</li>\n<li>\u0627 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0627\u063a\u064a \u0648\u0627</li>\n<li>\u0634\u064a \u0627\u063a\u064a\u064a\u0628\u0643\u0645 \u0648\u0627\u0646 \u0627\u0631\u062a\u064a \u0627\u0646</li>\n<li>\u062a\u0632\u0648\u062c\u064a \u0628\u0646\u062a\u062e \u0644\u0644\u0631\u0636\u064a \u0648\u062a\u0642\u0639\u062f\u064a</li>\n<li>\u0641\u064a \u062f\u064a\u064a\u0627\u0631 \u0645\u0635\u0631 \u0627\u0642\u0639\u062f\u064a \u0648\u0627\u0630</li>\n<li>\u0644\u0645 \u062a\u0631\u064a\u062f\u064a \u0644\u0627 \u062a\u0632\u0648\u062c\u0647\u0627</li></ol>\n",
