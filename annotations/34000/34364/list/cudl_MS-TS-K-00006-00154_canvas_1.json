      "body": [
        {
          "type": "TextualBody",
          "label": "(a)",
          "value": "\n<ol><li>\u0642\u0627\u0644 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062e\u064a\u0631 \u0634\u0635 \u0641\u064a \u0628\u0639\u0636 \u0642\u0648\u0644\u0647 \u0644\u064a \u0648\u0644\u0627\u0628 \u0634\u0635 \u0627\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0645\u0646\u0635\u0648\u0631 \u0643\u0627\u0646 \u064a\u0639\u062a\u0642\u062f</li>\n<li>\u0641\u064a \u0648\u0627\u0644\u062f\u0643\u0645 \u0645\u062b\u0644 \u0645\u0643\u0634\u0648\u0641 \u0627\u0644\u0631\u0627\u0633 \u0627\u0644\u062e\u0648\u0645\u0631 \u0648\u0627\u0644\u0633\u0627\u0639\u0629 \u0641\u0642\u062f \u0635\u0644\u062d \u062d\u0627\u0644\u0629 \u0639\u0646 \u0645\u0627 \u0643\u0627\u0646 \u0628\u0643\u062b\u064a\u0631 \u0648\u0642\u0627\u0644 \u0645\u0627 \u0644\u0627 \u064a\u0646\u062d\u062f</li></ol>\n",
