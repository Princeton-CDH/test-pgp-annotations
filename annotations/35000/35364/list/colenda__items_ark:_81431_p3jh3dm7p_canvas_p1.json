          "type": "TextualBody",
          "label": "recto",
          "value": "\n<ol><li>\u0645\u0639 \u0627\u0644\u0643\u0630 \u0631\u0628\u0627\u0639\u0649 \u062a\u0645\u0646 \u0627\u0644\u0641\u0631\u0643\u062a\u064a\u0646 \u0648\u0627\u0644\u0631\u062f\u062a\u064a\u0646 \u062a\u0643\u0627\u062a\u0643\u0646\u064a \u0628\u0647 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0648\u0639\u0627\u0626\u062f \u0628\u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0644\u0632\u0645\u0647 \u0634\u064a \u0648\u0644\u0627 \u064a\u0635\u062d</li>\n<li>\u0645\u0646\u0647\u0627 \u0634\u064a \u062a\u0643\u0627\u062a\u0628\u0646\u064a \u0628\u0630\u0627\u0644\u0643 \u0648\u062a\u0642\u0635 \u0647\u0630\u0647 \u0627\u0644\u0643\u0630 \u0631\u0628\u0627\u0639\u0649 \u0648\u0645\u0627 \u064a\u062e\u0635\u0628\u064a \u0641\u064a \u0627\u0644\u063a \u0627\u0632\u0642\u0627\u0642 \u0648\u062a\u0643\u0627\u062a\u0628\u0628 \u0628\u0627\u0644\u0628\u0642\u064a\u0629 \u0646\u0635\u064a\u0641\u0647\u0627 \u0627\u0644\u0649</li>\n<li>\u062d\u0633\u0627\u0628\u0643 \u062d\u062a\u0649 \u0644\u0627 \u064a\u0628\u0642\u0627 \u0641\u064a \u0627\u0644\u062d\u0633\u0627\u0628 \u0639\u0644\u0642\u0629 \u0627\u0644\u0627 \u0635\u0627\u0641\u0649 \u0648\u0627\u0645\u0631 \u0627\u0644\u0646\u064a\u0644 \u064a\u0627\u0645\u0648\u0644\u0626\u064a \u0642\u062f \u0634\u0627 \u0627\u0644\u0644\u0647 \u0641\u064a\u0647 \u0628\u062d\u0643\u0645\u0629 \u0648\u0627\u0628\u062a \u0644\u064a\u0633 \u064a\u062e\u0635\u0643</li>\n<li>\u0641\u064a\u0647 \u063a\u064a\u0631 \u0628\u0639\u0636\u0647 \u0641\u0627\u0646 \u062e\u0627\u0644\u0641\u062a\u0646\u0648 \u0634\u0626\u064a\u0626 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062c\u0627\u0645\u0644\u0629 \u0627\u0644\u062a\u064a \u0628\u064a\u0646\u0646\u0627 \u0641\u0646\u062a\u062d\u0645\u0644\u0647 \u0648\u0644\u0627 \u0646\u062d\u0633\u0628 \u0639\u0644\u064a\u0643 \u0645\u0646\u0647 \u0634\u064a</li>\n<li>\u0648\u0627\u0646\u0627 \u0648\u0627\u0644\u0644\u0647 \u0645\u0627 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646\u0643 \u0645\u0627\u0644 \u0648\u0644\u0627 \u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0627\u0646\u0627 \u0646\u0639\u0644\u0645 \u0627\u0646\u064a \u0646\u062e\u0627\u0644\u0641 \u0639\u0644\u064a\u0643 \u0627\u0645\u062b\u0627\u0644\u0647 \u0648\u0627\u0646\u062a \u0627\u064a\u0636\u0627 \u0627\u0630\u0627\u0646 \u062a\u062d\u0645\u0644\u062a</li>\n<li>\u0627\u0628\u0627 \u062a\u062e\u0627\u0644\u0641 \u0639\u0644\u0649 \u0627\u0645\u062b\u0627\u0644\u0647 \u0648\u0633\u0648\u0627\u0644\u0649 \u0644\u0643 \u0641\u064a \u0627\u0646 \u062a\u062c\u062a\u0647\u062f \u0641\u064a \u0627\u0644\u0633 \u062f\u064a\u0646\u0627\u0631 \u0627\u0644\u0627 \u062a\u0643\u0648\u0646 \u0643\u0633\u0627\u0631\u062a\u064a\u0646 \u0648\u0627\u0646\u0627 \u0646\u0639\u0644\u0645 \u0627\u0646\u0647 \u0644\u0627</li>\n<li>\u064a\u062e\u0627\u0633\u0631\u0643 \u0639\u0644\u064a\u0647\u0627 \u0644\u064a \u0643\u0627\u0646 \u0627\u0645\u062b\u0627\u0644\u0647\u0627 \u0641\u0646\u062d\u0628 \u0644\u0627 \u062a\u0628\u0642\u0649 \u0645\u0646 \u0627\u0644\u0627\u062c\u062a\u0647\u0627\u062f \u0634\u064a \u0641\u0627\u0630\u0627 \u062c\u0645\u0639 \u0627\u0644\u0644\u0647 \u0647\u0630\u0647 \u0627\u0644\u0633 \u062f\u064a\u0646\u0627\u0631</li>\n<li>\u0627\u0646\u0638\u0631 \u0645\u0627 \u0627\u0631\u062f\u062a \u062d\u0645\u0644\u0646\u064a \u0646\u062a\u062d\u0645\u0644 \u0648\u0645\u0627 \u0628\u064a\u0646\u064a \u0648\u0627\u0644\u0644\u0647 \u0648\u0628\u064a\u0646\u0643 \u0644\u0627 \u062f\u064a\u0646\u0627\u0631 \u0648\u0644\u0627 \u062f\u0631\u0647\u0645 \u0643\u0645\u0627 \u062a\u062d\u0645\u0644\u062a \u063a\u064a\u0631 \u0647\u0630\u0627</li>\n<li>\u0627\u0644\u0634\u064a \u0627\u0648\u0644\u0627 \u0643\u0645\u0627 \u062a\u0639\u0644\u0645 \u0648\u0646\u0639\u0644\u0645 \u0627\u0646 \u0645\u0627 \u064a\u0641\u0633\u062f \u062d\u0627\u0644\u0646\u0627 \u0648\u0642\u0644\u0648\u0628\u0646\u0627 \u0639\u0644\u0649 \u0628\u0639\u0636\u0647\u0627 \u0628\u0639\u0636 \u0627\u0644\u0627 \u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0648\u0627\u0646\u0627</li>\n<li>\u0646\u0631\u0627 \u0627\u0646 \u0646\u062a\u062d\u0645\u0644 \u0643\u0633\u0627\u0631\u062a \u0627\u0644\u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0644\u0627 \u064a\u0633\u0645\u0639 \u0627\u062d\u062f \u0628\u064a\u0646\u0646\u0627 \u0643\u0644\u0645\u0647 \u0648\u0627\u0646\u0627 \u0648\u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u0639\u0647\u062f \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0628\u064a\u0646\u0646\u0627</li>\n<li>\u0627\u0648\u0644\u0627 \u062d\u062a\u0649 \u0644\u0627 \u064a\u0631\u0627\u0646\u064a \u0627\u0644\u0644\u0647 \u0646\u0643\u0648\u0646\u0643 \u0628\u062f\u0631\u0647\u0645 \u0648\u0644\u0627 \u0628\u062f\u064a\u0646\u0627\u0631 \u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0627\u0644\u0643 \u0648\u0627\u0646\u0627 \u0646\u0639\u0644\u0645 \u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0627\u0646\u0643 \u0627\u0641\u0631\u062d</li>\n<li>\u0627\u0644\u0646\u0627\u0633 \u0628\u0633\u0643\u0646\u0627\u064a \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0648\u0628\u0645\u0627 \u064a\u062c\u064a\u0628\u064a \u063a\u064a\u064a\u062f \u0648\u0627\u0646\u0627 \u0646\u0639\u0644\u0645 \u0648\u0630\u0643 \u0627\u0646 \u0644\u064a\u0633 \u0641\u064a\u0647 \u0634\u0628\u0647\u0627 \u0648\u0627\u0646\u062a \u062a\u0639\u0644\u0645 \u064a\u0627\u0645\u0648\u0644\u0626\u064a</li>\n<li>\u0627\u0646 \u0644\u064a\u0633 \u064a\u0648\u062f\u064a \u0647\u0630\u0647 \u0627\u0644\u062e\u0644\u0637\u0629 \u0627\u0644\u0627 \u0647\u0630\u0627 \u0627\u0644\u0639\u0627\u0626\u0642 \u0627\u0644\u0630\u064a \u0627\u0639\u0627\u0642 \u0628\u0644\u062f\u0646\u0627 \u0627\u0644\u0644\u0647 \u064a\u0641\u0631\u062c \u0645\u0627 \u0643\u0646\u0627 \u0644\u0627\u0646 \u0628\u0644\u062f\u0646\u0627</li>\n<li>\u0645\u062c\u0628\u0631 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0646 \u0648\u0644\u0648 \u062d\u062a\u0649 \u0643\u0627\u0646 \u0627\u0644\u0630\u064a \u0648\u062c\u0647\u062a \u0639\u0627\u0645\u0627\u0648\u0644 \u0643\u062a\u0627\u0646 \u0648\u0648\u062c\u0647\u062a\u0647 \u0644\u0633\u0641\u0627\u0642\u0633 \u0627\u0644\u0627 \u0646\u062c\u0628\u0631\u0628\u0627 \u0641\u064a\u0647 \u0644\u0627\u0643\u0646\u0647</li>\n<li>\u0647\u0630\u0627 \u0627\u0644\u0630\u064a \u0634\u0627 \u0627\u0644\u0644\u0647 \u0644\u0627\u0646 \u0628\u0644\u063a \u0627\u0644\u0643\u062a\u0627\u0646 \u0641\u064a \u0627\u062e\u0631 \u0627\u0644\u0634\u062a\u0648\u0629 \u0641\u064a \u0633\u0641\u0627\u0642\u0633 \u0635\u0648\u0631\u0629 \u0648\u0627\u0644\u0649 \u0627\u0644\u0633\u0627\u0639\u0629 \u0648\u0647\u0648 \u0628\u0627\u0626\u0639 \u0648\u0645\u0627</li>\n<li>\u062c\u0639\u0644\u0646\u064a \u0644\u0645 \u0646\u062e\u0631\u062c \u0647\u0630\u0647 \u0627\u0644\u0627\u0639\u062f\u0627\u0644 \u0627\u0644\u064a\u0647\u0627 \u062a\u0643\u0648\u0646 \u0628\u064a\u0646\u0646\u0627 \u0627\u0644\u0627 \u062e\u0641\u062a \u0645\u0646 \u0627\u0644\u0640\u05d2\u05e8\u05e8 \u0648\u0627\u064a\u0627\u0643 \u062a\u0643\u0648\u0646 \u0645\u062b\u0644 \u0645\u0633\u0627\u0644\u062a \u0627\u0644\u063a\u064a\u0644</li>\n<li>\u0648\u0628\u0639\u062f \u0647\u0630\u0627 \u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0627\u0646\u0627 \u0644\u0643 \u0639\u062f\u0629 \u0648\u0627\u0646\u062a \u0643\u0645\u062b\u0644 \u0627\u0646\u0638\u0631 \u0645\u0627 \u0627\u0631\u062f\u062a \u0643\u0644\u0641\u0646\u064a \u0627\u064a\u0627\u0647 \u0628\u0641\u0639\u0644\u0647 \u0648\u0645\u0627 \u0627\u0631\u062f\u062a</li>\n<li>\u0645\u0646 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0646\u0641\u062f\u062a\u0647 \u0628\u064a\u062f \u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u05e0\u05e1\u05d9\u05dd \u0627\u0645\u0627 \u0643\u062a\u0627\u0646 \u0627\u0648 \u063a\u064a\u0631\u0647 \u0648\u0627\u0643\u062a\u0628\u0647 \u0628\u0627\u0633\u0645\u064a \u062d\u062a\u0649 \u0644\u0627 \u062a\u0646\u0642\u0637\u0639 \u0627\u0644</li>\n<li>\u0645\u0648\u0627\u0635\u0644\u0629 \u0628\u064a\u0646\u0646\u0627 \u0648\u0627\u0646\u0627 \u0645\u062c\u062f \u0639\u0644\u0649 \u0627\u0644\u0633\u0641\u0631 \u0627\u064a\u0644 \u0627\u0644\u0632\u0645\u0627\u0646 \u0644\u0627\u0646 \u063a\u0631\u0636\u064a \u062a\u062d\u0635\u064a\u0644 \u0627\u0647\u0644\u064a \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0634\u062a\u0648\u0629 \u0641\u064a</li>\n<li>\u0645\u0627\u0632\u0631 \u0648\u0646\u0633\u0627\u0641\u0631 \u0627\u0648\u0644 \u0627\u0644\u0632\u0645\u0627\u0646 \u0627\u0646 \u0643\u0646\u0627 \u0645\u0646 \u0627\u0647\u0644\u0647 \u062e\u0635\u0635\u062a\u0647 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0645 \u0648\u062c\u0645\u064a\u0639 \u0645\u0646 \u062a\u062d\u0648\u0637\u0647 \u0639\u0646\u0627\u0626\u062a\u0643 \u0627\u062a\u0645</li>\n<li></li></ol>\n\n<p> </p>",
