      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627\u0644 \u0644\u0627\u0646\u0647 \u064a\u062e\u0631\u062c \u064a\u062c\u064a\u0628 \u0639\u0646\u0647\u0627 \u0633\u062a\u0629 \u0634\u0647\u0648\u0631 \u0648\u0633\u0628\u0639\u0629 \u0646\u062d\u0648 \u0627\u0644\u0634\u0647\u0631 \u0648\u064a\u062e\u0631\u062c \u0648\u0641\u064a \u062d\u0627\u0644 \u0643\u0648\u0646\u0647 \u062d\u0627\u0636\u0631 \u0644\u0627 \u064a\u0642\u0637\u0639 \u0627\u0644\u0634\u062a\u064a\u0645\u0629 \u0631\u0629 \u0648\u0647\u064a \u062a\u062f\u0627\u0641\u0639 \u0627\u0644\u0632\u0645\u0627\u0646 \u062d\u062a\u0649 \u0644\u0627 \u062a\u0646\u0647\u062a\u0643 \u0648\u0644\u0627 \u064a\u0639\u0631\u0641 \u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u062c\u0633\u0645 \u0644\u0627 \u0644\u0647\u0627 \u05d7\u05d9\u05d9 \u05e9\u05e2\u05d4 \u0648\u0647\u064a \u0639\u0644\u0649 \u0627 \u0643\u0627\u0646 \u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0648\u0646\u0629 \u0644\u0646\u0641\u0633\u0647\u0627 \u0641\u064a \u063a\u064a\u0628\u0627\u062a\u0647 \u0627\u0646\u0647 \u0645\u0627 \u0628\u0642\u0649 \u0644\u0647\u0627 \u0645\u0627 \u062a\u0628\u064a\u0639 \u0648\u0644\u0627 \u0645\u0627 \u062a\u0631\u062c\u0639 \u0648\u0642\u062f \u0627\u0646\u0647\u062a \u062d\u0627\u0644\u0647\u0627 \u05dc\u05d4\u05d3\u05e8\u05ea \u05d4\u05e7\u05d3\u05d5\u05e9\u05d4 \u0627\u0636\u0647\u0627 \u0645\u0646\u0647 \u0648\u0627\u062e\u0630 \u062d\u0642\u0648\u0642\u0647\u0627 \u0639\u0644\u0649 \u062d\u0633\u0628 \u0645\u0627 \u0646 \u0648\u0642\u0639 \u0645\u0646\u0647\u0645\u0627 \u0627\u0647\u0645\u0627\u0644 \u0648\u0644\u0627 \u062b\u0648\u0627\u0646\u064a \u0641\u0627\u0646\u0647\u0627 \u0627 \u064a\u0642\u0631\u0628\u0647\u0627 \u0627\u0644\u0649 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0648\u062c\u0645\u064a\u0639 \u05d1\u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u064a\u0639\u0644\u0645\u0627 \u0635\u062d\u0647 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u062a \u0644\u0627\u0633\u062a\u062e\u0644\u0