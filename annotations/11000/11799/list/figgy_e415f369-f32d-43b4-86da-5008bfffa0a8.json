        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>] . . . . . . [</li>\n<li>\u0648\u0633\u0628\u0628 \u062a\u0627\u062e\u064a\u0631\u0647\u0645 \u0641\u0647\u0648 \u064a\u0639\u0644\u0645 \u0627\u0646\u0647 \u0645\u0627 \u0646\u0641\u062f\u0647\u0645</li>\n<li>\u0627\u0644\u0627 \u0645\u0639 \u0645\u0646 \u0627\u0648\u0635\u0644\u0647\u0645 \u0641\u0644\u0639\u0644 \u064a\u062c\u062a\u0647\u062f\u0648 \u0641\u064a \u0631\u062f</li>\n<li>\u062c\u0648\u0627\u0628\u0647\u0645 \u0641\u0627\u0644\u062d\u0627\u062c\u0629 \u062f\u0627\u0639\u064a\u0629 \u0644\u0647\u0645 \u05d5\u05e9\u05dc\u05d5\u05dd</li>\n<li>\u0648\u0643\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u062e\u0635\u0648\u0635 \u0628\u0647\u0645 \u0641\u0642\u0637</li>\n<li>\u0645\u0627 \u0627\u0645\u0643\u0646\u0647 \u064a\u0630\u0643\u0631 \u0641\u064a\u0647 \u0634\u062e\u0635 \u0627\u062e\u0631 \u063a\u064a\u0631</li>\n<li>\u0645\u0646 \u062a\u0642\u062f\u0645 \u0630\u0643\u0631\u0647 \u062d\u062a\u0649 \u0648\u0644\u0627 \u062a\u0628\u0644\u064a\u062c \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0627\u0644\u0649 \u0643\u0644 \u0645\u0646 \u064a\u0644\u0648\u062f \u0628\u0647\u0645 \u0641\u0644\u0627 \u064a\u0648\u062e\u062f \u0639\u0644\u064a\u0647 \u0641\u064a \u0630\u0644\u0643</li>\n<li>\u0628\u0644 \u064a\u0635\u0644 \u0645\u0646\u0647 \u0627\u0644\u064a\u0647\u0645 \u0643\u062a\u0627\u0628 \u0628\u0639\u062f \u0648\u0635\u0648\u0644 \u062c\u0648\u0627\u0628\u0647</li>\n<li>\u0627\u0644\u064a\u0647\u0645 \u0628\u0645\u0627 \u064a\u0633\u0631 \u0642\u0644\u0628\u0647 \u0628\u0645\u0627 \u064a\u0634\u0643\u0631 \u0639\u0644\u064a\u0647 \u0627\u0646\u0647\u0627</li>\n<li>\u0630\u0644\u0643 \u0643\u062a\u0628 \u0641\u064a \u0633\u0644\u0643 \u05e1\u05d9\u05d5\u05df \u05e7\u05db\u05d7 \u0648\u0647\u0648 \u0635\u0641\u0631</li></ol>\n",
