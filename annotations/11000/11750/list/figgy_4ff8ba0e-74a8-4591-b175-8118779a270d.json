        {
          "type": "TextualBody",
          "label": "Recto:",
          "value": "\n<ol><li>\u0628\u0634 \u0631\u062d</li>\n<li>\u0627\u0644\u0644\u0647 \u062a\u0639\u0644\u0627 \u0644\u0627</li>\n<li>\u064a\u0648\u062d\u0634\u0646\u064a \u0645\u0646 \u0627\u0644\u0648\u0644\u062f</li>\n<li>\u0627\u0644\u0645\u0628\u0627\u0631\u0643 \u05de\u05e9\u05d4</li>\n<li>\u0648\u064a\u062c\u0645\u0639 \u0627\u0644\u0634\u0645\u0644</li>\n<li>\u0628\u0647 \u0628\u0631\u0632\u0642 \u0648\u0627\u0633\u0639</li>\n<li>\u0627\u0645\u0646 \u0648\u0627\u0646 \u0627\u0643\u0648\u0643</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644</li>\n<li>\u062d\u0633\u0646 \u0639\u0644\u064a \u062c\u0645\u0644\u0629</li>\n<li>\u0627\u0644\u0633\u0644\u0645\u0629 \u0648\u0627\u0644\u0639\u0641\u064a\u0629</li>\n<li>\u0645\u0646 \u0641\u0636\u0644 \u0627\u0644\u0644\u0647</li>\n<li>\u0648\u0645\u0627 \u0627\u062d\u062a\u0627\u062c</li>\n<li>\u0627\u0648\u0636\u064a\u0643 \u0628\u0646\u0641\u0633\u0643</li>\n<li>\u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0641\u0635\u0644</li>\n<li>\u0648\u0627\u062a\u062e\u0627\u0644\u064a \u0639\u0644\u064a</li>\n<li>\u0627\u0644\u0644\u0647 \u05d5\u05e9\u05dc\u05d5\u05dd</li></ol>\n",
