      "body": [
        {
          "type": "TextualBody",
          "label": "Recto:",
          "value": "\n<ol><li>\u0628\u0634 \u0631\u062d</li>\n<li>\u0643\u062a\u0627\u0628\u064a \u064a\u0627\u0648\u0627\u0644\u0630\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0643 \u0648\u0645\u0646 \u062a\u0648\u0641\u064a\u0642\u0647</li>\n<li>\u0644\u0627 \u0627\u0643\u0644\u0627\u0643 \u0648\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0646\u0639\u0645\u0647 \u0648\u0639\u0646 \u0634\u0648\u0642 \u0627\u0644\u064a\u0643 \u0634\u062f\u064a\u062f \u062c\u0645\u0639</li>\n<li>\u0627\u0644\u0644\u0647 \u0628\u064a\u0646\u0646\u0627 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644\u0627\u062d\u0648\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648\u062c\u0648\u062f\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li>\n<li>\u0648\u0627\u0639\u0644\u0645\u0643 \u064a\u0627\u0648\u0627\u0644\u0630\u064a \u0627\u0646\u064a \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0639\u062f\u0629 \u0643\u062a\u0628 \u0641\u0645\u0627 \u0648\u0635\u0644 \u0627\u0644\u0649</li>\n<li>\u0644\u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0627 \u062c\u0648\u0627\u0628 \u0641\u0627\u0634\u063a\u0644 \u0642\u0644\u0628\u064a \u0630\u0644\u0643 \u063a\u0627\u064a\u0629 \u0627\u0644\u0634\u063a\u0644 \u0627\u0631\u062c\u0648 \u064a\u0643\u0648\u0646</li>\n<li>\u0630\u0644\u0643 \u0644\u062e\u064a\u0631 \u0648\u0639\u0627\u0641\u064a\u0629 \u062b\u0645 \u0627\u0646 \u0648\u0635\u0644 \u0628\u0646 \u0633\u064a\u0645\u0646\u0637\u0628 \u0648\u0639\u0631\u0641\u0646\u064a \u0645\u0627 \u0627\u0646\u062a \u0639\u0644\u064a\u0647</li>\n<li>\u0641\u0633\u0631\u0646\u064a \u0645\u0627 \u0639\u0631\u0641\u0646\u064a \u0645\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u062a\u0643 \u0648\u062c\u0645\u0646\u064a \u0627\u0646\u0647 \u0642\u0627\u0644 \u0644\u064a \u0627\u0646\u064a \u0631\u0627\u064a\u062a\u0647</li>\n<li>\u0642\u062f \u0627\u0634\u062a\u0631\u0627 \u062a\u0644\u064a\u0633 \u0642\u0645\u062d \u0628\u0632 \u062f\u0646\u0627\u0646\u064a\u0631 \u0641\u0628\u0627\u0644\u0644\u0647 \u0627\u0644\u0640\u05e2\u05e6\u05d9\u05dd \u0644\u0648 \u0627\u0646 \u0627\u0644\u0634\u0648\u0649</li>\n<li>\u0627\u0644\u0630\u064a \u0644\u064a \u0628\u062a\u0646\u064a\u0633 \u0645\u0639\u0649 \u0644\u0643\u0646\u062a \u0627\u0634\u062a\u0631\u064a\u062a \u0644\u0643 \u0645\u0646 \u0647\u0627\u0647\u0646\u0627 \u062a\u0644\u064a\u0633\u064a\u0646 \u0642\u0645\u062d</li>\n<li>\u0647\u0648 \u0643\u0627\u0646 \u0627\u0635\u0644\u062d \u0645\u0646 \u0639\u0646\u062f\u0643\u0645 \u0641\u0627\u062a\u0641\u0642 \u0627\u0646 \u0642\u0644\u0647 \u0645\u0639\u064a\u0634\u0647 \u062d\u062a\u0649 \u0644\u0627 \u0646\u0642\u062f\u0631</li>\n<li>\u0639\u0644\u0649 \u0627\u0644\u0645\u0627\u0648\u0646\u0629 \u0648\u0627\u0644\u0634\u0648\u0649 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0645\u0639\u0649 \u0628\u062a\u0646\u064a\u0633 \u0641\u0645\u0646 \u0643\u062b\u0631\u0629 \u0645\u0627 \u062d\u0645\u0644\u062a</li>\n<li>\u0639\u0644\u0649 \u0642\u0644\u0628\u064a \u0644\u062d\u0642\u0646\u064a \u062e\u0644\u0637 \u0635\u0641\u0631\u0627\u0648\u0649 \u0648\u0637\u0644\u0639 \u0639\u0644\u0649 \u0628\u062b\u0631 \u0641\u0627\u0644\u0644\u0647 \u064a\u0641\u0631\u062c \u0628\u0631\u062d\u0645\u062a\u0647</li>\n<li>\u0648\u0627\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u0643\u0648\u0641 \u0648\u0627\u0645\u0648\u0631 \u0627\u0646 \u064a\u0641\u0631\u062c\u0647\u0627 \u0627\u0644\u0644\u0647 \u0648\u0643\u0646\u062a \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u064a\u0643 \u0639\u0644\u0649 \u064a\u062f</li>\n<li>\u0645\u064a\u0645\u0648\u0646 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0641\u064a \u0643\u0628\u0631 \u0627\u0644\u062a\u0648\u064a\u0628\u0627\u062a \u0627\u0644\u0630\u064a \u0639\u0646\u062f\u0643 \u062a\u0641\u0646\u062f\u0647\u0645 \u0644\u064a \u0635\u062d\u0628\u062a\u0647</li>\n<li>\u0644\u064a\u0627\u0646 \u0648\u0627\u0644\u0644\u0647 \u0645\u0627 \u062a\u0635\u0644 \u064a\u062f\u064a \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0644\u0634\u0631\u0627 \u0634\u064a \u0627\u0644\u0628\u0633\u0629 \u062a\u062d\u0635\u064a\u0647\u0645</li>\n<li>\u0648\u062a\u062f\u0641\u0639\u0647\u0645 \u0627\u0645\u0646 \u0644\u0647 \u0627\u0648 \u0644\u0627\u062e\u0648\u0629 \u0627\u0644\u0648\u0627\u0635\u0644 \u0627\u0644\u064a\u0647\u0645 \u0635\u0644 \u0627\u0644\u0649 \u0644\u064a\u0627\u0646</li>\n<li>\u0644\u064a \u0639\u062f\u0629 \u0633\u0628\u0648\u062a \u0645\u0627 \u062f\u062e\u0644\u062a \u0643\u0646\u064a\u0633\u0629 \u0627\u0639\u0644\u0645\u062a\u0643 \u0630\u0644\u0643 \u0644\u062a\u0642\u0641 \u0639\u0644\u064a\u0647 \u0648\u0645\u0627</li>\n<li>\u0643\u0627\u0646 \u0644\u0643 \u0645\u0646 \u062d\u0627\u062c\u0629 \u0641\u062a\u0634\u0631\u0641\u0646\u064a \u0628\u0642\u0636\u0627\u0647\u0627 \u062e\u0635 \u0646\u0641\u0633\u0643 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645</li>\n<li>\u0648\u0639\u0644\u0649 \u0627\u0648\u0644\u0627\u062f\u0643 \u062c\u0645\u064a\u0639\u0627 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0645\u0646 \u0641\u064a \u0627\u0644\u062f\u0627\u0631</li>\n<li>\u0627\u0644\u0633\u0644\u0627\u0645 \u05d5\u05e9\u05dc\u05d5\u05dd</li></ol>\n",
