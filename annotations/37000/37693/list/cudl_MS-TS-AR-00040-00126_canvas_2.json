      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li>The servants, the dyers in Qaly\u016bb, kiss the ground</li>\n<li>and announce&nbsp;that they perish because of the high price of the wheat,</li>\n<li>the scarcity&nbsp;of work, the heavy license fee, and the rise of the exchange rate</li>\n</ol>",
          "format": "text/html"
        }
