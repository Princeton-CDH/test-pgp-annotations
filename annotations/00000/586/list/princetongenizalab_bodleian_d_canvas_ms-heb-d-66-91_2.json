          "value": "<ol>\n<li><span lang=\"he\">\u05d7\u05e6\u05e8\u05d4 \u05de\u05d5\u05dc\u05d0\u05d9 \u05d0\u05dc\u05d7\u05d1\u05e8 \u05d2\u05d3\u05d5\u05dc \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05e9\u05d0\u05db\u05e8\u05d4 \u05d5\u05de\u05d7\u05d1\u05d4&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05e0\u05ea\u05df \u05d1\u05df \u05e0\u05d4\u05e8\u05d0\u05d9 \u05e0''\u05e2</span></li>\n<li><span lang=\"he\">\u05e8\u05d1\u05e0\u05d5 \u05e0\u05d4\u05e8\u05d0\u05d9 \u05d1\u05d9\u05e8 \u05e0\u05e1\u05d9\u05dd \u05d6''\u05dc&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05d8\u05d0\u05dc \u05d0\u05dc\u05dc\u05d4 \u05d1\u05e7\u05d0\u05d4 \u05d5\u05d0\u05d3\u05d0\u05dd \u05e1\u05e2\u05d0\u05d3\u05ea\u05d4</span></li>\n</ol>",
