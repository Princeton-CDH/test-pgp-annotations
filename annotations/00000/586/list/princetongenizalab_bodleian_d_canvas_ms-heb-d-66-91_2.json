        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "<ol>\n<li><span lang=\"he\">\u05e7\u05d1\u05dc \u05d0\u05d5\u05ea\u05dd \u05de\u05de\u05e0\u05d5. \u05db\u05ea\u05d1\u05ea, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05e2\u05dc \u05de\u05e9\u05dc\u05d5\u05d7 \u05e9\u05de\u05df \u05d4\u05e9\u05e8\u05e4\u05d4; \u05d5\u05d4\u05dc\u05d5\u05d0 \u05db\u05d1\u05e8&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d5\u05d3\u05e2\u05ea\u05d9 \u05dc\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05e9\u05d0\u05d9\u05df \u05d0\u05e6\u05dc\u05d9 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9\u05d9; \u05d0\u05d1\u05e7\u05e9 \u05de\u05de\u05da</span></li>\n<li><span lang=\"he\">\u05e9\u05ea\u05de\u05dc\u05d0 \u05d1\u05e9\u05d1\u05d9\u05dc\u05d9 \u05d0\u05ea \u05d4\u05db\u05d3 \u05e9\u05d4\u05d2\u05d9\u05e2 \u05d0\u05dc\u05d9\u05da \u05e2\u05dd \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05dc\u05e1\u05d2\u05dc\u05ea,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05ea\u05e9\u05dc\u05d7 \u05dc\u05d9 \u05d0\u05d5\u05ea\u05d5. \u05d0\u05e7\u05d5\u05d5\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05d1\u05d3\u05e8\u05da \u05d0\u05dc\u05d9. \u05db\u05ea\u05d1\u05ea, \u05d0\u05d3\u05d5\u05e0\u05d9,</span></li>\n<li><span lang=\"he\">\u05d9\u05ea\u05de\u05d9\u05d3 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05ea \u05d2\u05d3\u05d5\u05dc\u05ea\u05da, \u05e2\u05dc \u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d1\u05e0\u05d9 \u05d4\u05d0\u05d5\u05d3\u05dd. \u05d9\u05e9 \u05dc\u05d7\u05d5\u05ea\u05e0\u05d9 \u05dc' \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d1\u05e7\u05d9\u05e8\u05d5\u05d1,</span></li>\n<li><span lang=\"he\">\u05d5\u05d1\u05d4\u05dd \u05e0\u05e7\u05e0\u05d4 \u05d0\u05d5\u05dc\u05d9 \u05d0\u05d1\u05e0\u05d9 \u05d0\u05d5\u05d3\u05dd, \u05d0\u05d3\u05d5\u05de\u05d5\u05ea, \u05d0\u05d1\u05dc \u05d4\u05db\u05d9 \u05d8\u05d5\u05d1\u05d5\u05ea</span></li>\n<li><span lang=\"he\">\u05e9\u05ea\u05e9\u05d9\u05d2, \u05d1\u05d8\u05d5\u05d1\u05da. \u05d0\u05d1\u05dc \u05d0\u05e9\u05e8 \u05dc\u05e9\u05d8\u05d9\u05d7\u05d9\u05dd, \u05e7\"\u05e0 \u05d3\u05d9\u05e0\u05e8, \u05d0\u05d9\u05df \u05d0\u05e6\u05dc\u05d5</span></li>\n<li><span lang=\"he\">\u05e1\u05db\u05d5\u05dd \u05e9\u05db\u05d6\u05d4. \u05e2\u05d5\u05d3 \u05d0\u05d5\u05d3\u05d9\u05e2\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05e9\u05e9\u05dc\u05d7\u05ea\u05d9 \u05e2\u05dd \u05d0\u05d3\u05d5\u05e0\u05d9,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d5 \u05e2\u05dc\u05d9 \u05d7\u05e1\u05d5\u05df \u05d1\u05df \u05e2\u05d8\u05d9\u05d4 \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1 \u05d7' \u05d5\u05d8\u05dc\u05d9\u05dd \u05de\u05e9\u05d9, \u05e9\u05d4\u05d5\u05d0 \u05e7\u05e8\u05d5\u05d1</span></li>\n<li><span lang=\"he\">\u05dc'\u05db\u05d6', \u05d5\u05d1\u05d9\u05e7\u05e9\u05ea\u05d9 \u05de\u05de\u05e0\u05d5 \u05e9\u05d9\u05e9\u05dc\u05dd \u05d1\u05e2\u05d3\u05dd \u05de\u05db\u05e1, \u05d5\u05d4\u05d9\u05ea\u05d4 \u05d6\u05d5 \u05e9\u05d2\u05d9\u05d0\u05d4, \u05db\u05d9 \u05dc\u05d0 \u05d4\u05ea\u05d1\u05e8\u05e8</span></li>\n<li><span lang=\"he\">\u05d0\u05e6\u05dc\u05d9 \u05db\u05de\u05d4 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d5, \u05e2\u05d3 \u05e2\u05db\u05e9\u05d9\u05d5. \u05d0\u05d1\u05e7\u05e9 \u05de\u05de\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05e9\u05ea\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d1\u05d6\u05d0\u05ea; \u05db\u05ea\u05d1\u05ea\u05d9 \u05d3\u05d1\u05e8\u05d9\u05dd \u05db\u05d9\u05d5\u05e6\u05d0 \u05d1\u05d0\u05dc\u05d4 \u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d9\u05e6\u05d7\u05e7 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d0\u05dc\u05d3\u05e8\u05e2\u05d9,</span></li>\n<li><span lang=\"he\">\u05d0\u05dc \u05ea\u05d6\u05e0\u05d9\u05d7 \u05d0\u05e4\u05d5\u05d0 \u05d3\u05d1\u05e8 \u05d6\u05d4 \u05d5\u05ea\u05d5\u05d3\u05d9\u05e2 \u05dc\u05d9 \u05d1\u05de\u05db\u05ea\u05d1\u05da \u05d0\u05ea \u05d4\u05d3\u05d1\u05e8. \u05d0\u05d1\u05e7\u05e9 \u05de\u05de\u05da</span></li>\n<li><span lang=\"he\">\u05d0\u05d3\u05d5\u05e0\u05d9, \u05db\u05d9 \u05ea\u05de\u05e1\u05d5\u05e8 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd \u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d4\u05e8\u05d1 \u05d4\u05e0\u05db\u05d1\u05d3 \u05e8' \u05d9\u05e6\u05d7\u05e7 \u05d4\u05d7\u05d1\u05e8</span></li>\n<li><span lang=\"he\">\u05d5\u05ea\u05d5\u05d3\u05d9\u05e2 \u05dc\u05d5 \u05e9\u05d0\u05e0\u05d9 \u05de\u05e9\u05ea\u05d5\u05e7\u05e7 (\u05dc\u05e8\u05d0\u05d5\u05ea\u05d5) \u05d5\u05de\u05ea\u05d2\u05e2\u05d2\u05e2 \u05d0\u05dc\u05d9\u05d5; \u05d5\u05de\u05e1\u05d5\u05e8 \u05dc\u05d5 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd \u05d2\u05dd \u05de\u05d0\u05d3\u05d5\u05e0\u05d9</span></li>\n<li><span lang=\"he\">\u05d5\u05e8\u05d1\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05dc\u05d7\u05e1\u05df \u05d7\u05d5\u05ea\u05e0\u05d9; \u05d5\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d5\u05e8\u05d1\u05d9 \u05d0\u05d1\u05d5 \u05e1\u05b7\u05d4\u05b8\u05dc \u05de\u05b6\u05db\u05ea\u05d0\u05e8</span></li>\n<li><span lang=\"he\">\u05d3\u05d5\u05e8\u05e9 \u05d1\u05e9\u05dc\u05d5\u05de\u05d5. \u05d0\u05e0\u05d0 \u05e2\u05e9\u05d4 \u05d6\u05d0\u05ea, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05d1\u05d8\u05d5\u05d1\u05da, \u05d0\u05dc \u05ea\u05d9\u05dc\u05e7\u05d7 \u05de\u05de\u05e0\u05d9</span></li>\n<li><span lang=\"he\">\u05d5\u05d0\u05dc \u05d0\u05e9\u05d0\u05e8 \u05d1\u05dc\u05e2\u05d3\u05d9\u05da; \u05e7\u05d1\u05dc \u05e0\u05d0 \u05d0\u05ea \u05de\u05d9\u05d8\u05d1 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e9\u05dc\u05d5\u05dd; \u05d5\u05dc\u05d1\u05d1\u05ea \u05e2\u05d9\u05e0\u05d9, \u05e0\u05e1\u05d9\u05dd, \u05d9\u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd,</span></li>\n<li><span lang=\"he\">\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd; \u05d5\u05d1\u05e0\u05d9 \u05de\u05e0\u05e9\u05e7 \u05d0\u05ea \u05d9\u05d3\u05da; \u05d4\u05d5\u05d0 \u05e9\u05e8\u05d5\u05d9 \u05d1\u05d8\u05d5\u05d1\u05d4 \u05e8\u05d1\u05d4, \u05d5\u05de\u05d1\u05e7\u05e9 \u05de\u05de\u05da \u05e9\u05dc\u05d0 \u05ea\u05e4\u05e1\u05d9\u05e7</span></li>\n<li><span lang=\"he\">\u05dc\u05d4\u05ea\u05e4\u05dc\u05dc \u05dc\u05de\u05e2\u05e0\u05e0\u05d5 \u05ea\u05e4\u05d9\u05dc\u05ea \u05d9\u05d7\u05d9\u05d3 \u05d9\u05e4\u05d4; \u05db\u05d9\u05d5\u05e6\u05d0 \u05d1\u05d6\u05d4, \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05dc\u05d7\u05e1\u05df \u05d3\u05d5\u05e8\u05e9 \u05d1\u05e9\u05dc\u05d5\u05de\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9.</span></li>\n</ol>",
          "format": "text/html"
        }
      ],
