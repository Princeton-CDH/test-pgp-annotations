4a \u0627\u0644\u0645\u062a\u0627\u062e\u0631 \u0639\u0646 \u0646\u062d\u0627\u0626\u0643 \u0648\u0631\u062f\u0646\u064a \u0627\u0644\u0639\u0632\u064a\u0632 \u062e\u0637\u0627\u0628\u0643 \u0635\u0648\u062d\u0628\u0647 \u0627\u0628\u0648 \u05d9\u05e2\u05e7\u05d1 \u0627\u0628\u0646 \u0627\u0644\u0640\u05e0\u05d2\u05e8\u05d4 \u0633\u064a\u062f\u064a \u0648\u0645\u0639\u0636\u0645\u0643 \u0627\u0628\u0642\u0627\u0647 \u0627\u0644\u0644\u0647 \u0648\u0630\u0643\u0631\u062a \u0641\u064a\u0647 \u0627\u0646 \u0646\u062f\u0641\u0639 \u0644\u0643 \u0639\u0634\u0631\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u0648\u0646\u0635\u0641 \u0648\u0627\u0646\u0627 \u0646\u0645\u062a\u062b\u0644 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u0648\u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0627\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644\u0627\u062d\u062f \u0627\u062e\u0631 \u05ea\u05de\u05d5\u05d6 \u0648\u0643\u0627\u0646 \u0648\u0635\u0644 \u0627\u0644\u0649 \u0642\u0628\u0644 \u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0628\u062f \u0627\u064a\u0627\u0645 \u0645\u0646 \u062a\u0644\u0645\u0633\u0627\u0646 \u0635\u0648\u062d\u0628\u0647 \u0627\u0628\u0648 \u05d9\u05e2\u05e7\u05d1 \u0627\u0628\u0646 \u0627\u0644\u0645\u0646\u0647 \u0633\u064a\u062f\u064a \u0633\u0627\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0648\u0639\u0632\u0627\u0647 \u0645\u062a\u0642\u0627\u0644 \u0648\u062b\u0644\u062b \u0648\u0646\u0635\u0641 \u0645\u0627\u0644 \u0646\u062d\u0627\u0633 \u0645\u062d\u0631\u0648\u0642 \u0648\u0630\u0643\u0631\u062a \u0644\u064a \u0641\u064a \u0643\u062a\u0627\u0628\u0643 \u0627\u0646 \u0646\u0648\u062c\u0647 \u0645\u0646 \u0627\u0644\u0630\u064a \u064a\u0635\u0644 \u0645\u0646 \u062a\u0644\u0645\u0633\u0627\u0646 \u0645\u064a\u0627\u0629 \u0648\u062e\u0645\u0633\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u0648\u0645\u0627 \u0648\u0635\u0644 \u0627\u0644\u0649 \u063a\u064a\u0631 \u0645\u064a\u0627\u0629 \u0646\u0645\u062a\u062b\u0644 \u0641\u064a\u0647\u0627 \u0