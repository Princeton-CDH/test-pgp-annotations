      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0645\u0639\u0636\u0645\u0629 \u0627\u0644\u0645\u062c\u0644 \u0644\u0647 \u0627\u0639\u0632\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0627\u0633\u062d\u0642 \u0627\u0628\u0646 \u05d1\u05e8\u05d5\u05da \u064a\u0627 \u0633\u064a\u062f\u064a \u0627\u0644 \u0627\u0639\u0644\u0649 \u0648\u0639\u0645\u0627\u062f\u064a \u0627\u0644\u0627\u0633\u0646\u064a \u0648\u0633\u0646\u062f\u064a \u0627\u0644\u0627\u0642\u0648\u064a \u0648\u0639\u062a\u0627\u062f\u064a \u0627\u0644\u0627\u0648\u0641\u064a \u0648\u0645\u0639\u062a\u0645\u062f\u064a \u0627\u0644 \u0627\u0633\u0631\u064a \u0648\u064a\u062f \u0627\u0644 \u062f\u0647\u0631 \u0639\u0646\u062f\u064a \u0627\u0644 \u062d\u0633\u0646\u064a \u0648\u0645\u0646 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0628\u0642\u0627\u0647 \u0648\u0627\u062c\u0631\u064a \u0627\u062d\u0648\u0627\u0644\u0647 \u0639\u0644\u0649 \u0631\u0636\u0627\u0647 \u0643\u062b\u0628\u062a \u0627\u0639\u0632\u0643 \u0627\u0644\u0644\u0647 \u0639\u0646 \u0627\u062c\u0644\u0627\u0644 \u0644\u0642\u062f\u0631\u0643 \u0648\u062a\u0639\u0635\u064a\u0645 \u0644\u062e\u0637\u0631\u0643 \u0648\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u0628\u0642\u064a\u0643 \u0648\u064a\u062e\u0641\u064a \u0627\u0644 \u0645\u062d\u0627\u062f\u0631 \u0639\u0646 \u0646\u062d\u0627\u0626\u0643 \u0648\u0631\u062f\u0646\u064a \u0627\u0644\u0639\u0632\u064a\u0632 \u062e\u0637\u0627\u0628\u0643 \u0635\u0648\u062d\u0628\u062a \u0627\u0628\u0648 \u05d9\u05e2\u05e7\u05d1 \u0627\u0628\u0646 \u0627\u0644 \u0646\u062c\u0631\u0629 \u0633\u064a\u062f\u064a \u0648\u0645\u0639\u0636\u0645\u0643 \u0627\u0628\u0642\u0627\u0647 \u0627\u0644\u0644\u0647 \u0648\u0630\u0643\u0631\u062a \u0644\u064a \u0627\u0646 \u0646\u062f\u0641\u0639 \u0644\u0647 \u0639\u0634\u0631\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u0648\u0646\u0635\u0641 \u0648\u0627\u0646\u0627 \u0646\u0645\u062a\u062b\u0644 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u0648\u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0627\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644 \u0627\u062d\u062f \u0627\u062e\u0631 \u05ea\u05de\u05d5\u05d6 \u0648\u0643\u0627\u0646 \u0648\u0635\u0644 \u0627\u0644\u0649 \u0642\u0628\u0644 \u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0628\u062f \u0627\u064a\u0627\u0645 \u0645\u0646 \u062a\u0644\u0645\u0633\u0627\u0646 \u0635\u0648\u062d\u0628\u062a \u0627\u0628\u0648 \u05d9\u05e2\u05e7\u05d1 \u0627\u0628\u0646 \u0627\u0644 \u0645\u0646\u0647 \u0633\u064a\u062f\u064a \u0633\u0644\u0645\u0647 \u0627\u0644\u0644\u0647 \u0645\u064a\u0627\u0647 \u0645\u062a\u0642\u0627\u0644 \u0648\u062b\u0644\u062b \u0627\u062d\u0645\u0627\u0644 \u0646\u062d\u0627\u0633 \u0645\u062d\u0631\u0648\u0642 \u0648\u0630\u0643\u0631\u062a \u0644\u064a \u0641\u064a \u0643\u062a\u0627\u0628\u0643 \u0627\u0646 \u0646\u0648\u062c\u0647 \u0645\u0646 \u0627\u0644\u0630\u064a \u064a\u0635\u0644 \u0645\u0646 \u062a\u0644\u0645\u0633\u0627\u0646 \u0645\u064a\u0627\u0629 \u0648\u062e\u0645\u0633\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u0648\u0645\u0627 \u0648\u0635\u0644 \u0627\u0644\u0649 \u063a\u064a\u0631 \u0645\u064a\u0627\u0629 \u0646\u0645\u062a\u062b\u0644 \u0641\u064a\u0647\u0627 \u0645\u0627 \u062d\u062f\u062f\u062a\u0647 \u0646\u0642\u0636\u0645\u0647\u0627 \u0645\u0639 \u0646\u0641\u0633\u064a\u0646 \u0648\u0646\u0648\u062c\u0647\u0627 \u0627\u0644\u0649 \u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0627\u0628\u0646 \u05d2\u05d9\u05d0\u05ea \u0639\u0645\u0627\u062f\u064a \u0627\u0644 \u0627\u0639\u0644\u0649 \u0627\u0628\u0642\u0627\u0647 \u0627\u0644\u0644\u0647 \u0648\u0645\u0646 \u0639\u0646\u062f\u0647 \u062a\u0635\u0644 \u0627\u0644\u0649 \u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0627\u0644 \u05dc\u05d5\u05d9 \u0639\u0645\u0627\u062f\u064a \u0627\u0644 \u0627\u0639\u0644\u0649 \u062f\u0627\u0645 \u0639\u0632\u0629 \u0648\u0643\u0627\u0646 \u0627\u0639\u0644\u0645\u062a\u0643 \u0627\u0646 \u0643\u0627\u0646 \u0648\u0635\u0644\u062a \u0627\u0644\u0649 \u0627\u0644 \u0645\u064a\u0627\u0629 \u0645\u062a\u0642\u0627\u0644 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0648\u062c\u0647\u062a \u0645\u0646 \u0641\u0627\u0633 \u0643\u0627\u0646 \u0627\u0648\u0636\u064a\u062a\u0646\u064a \u0627\u0646 \u0646\u0634\u062a\u0631\u0649 \u0641\u064a\u0647\u0627 \u062d\u0631\u064a\u0631 \u0648\u0643\u0627\u0646 \u0627\u0644 \u0634\u064a \u0628\u0627\u0626\u0639 \u0641\u0643\u0627\u0646 \u0627\u0634\u062a\u0631\u064a\u062a \u0645\u0646\u0647\u0627 \u0628\u062e\u0645\u0633\u064a\u0646 \u0641\u0644\u0645\u0627 \u0627\u0646\u062d\u0641\u0632 \u0648\u0642\u062a \u0627\u0644\u0633\u0641\u0631 \u0648\u0635\u062d \u0639\u0646\u062f\u064a \u0627\u0646\u0643 \u0645\u0636\u064a\u0641 \u0641\u064a \u0627\u0644 \u0627\u0646\u062f\u0644\u0648\u0633 \u0631\u0641\u0639\u062a \u064a\u062f\u064a \u0648\u0644\u0645 \u0646\u0634\u062a\u0631\u064a \u0641\u064a \u0627\u0644 \u0628\u0627\u0642\u0649 \u0648\u0628\u064a\u0646 \u0645\u0627 \u0643\u0627\u0646 \u0627\u0634\u062a\u0631\u064a\u062a \u0648\u0627\u0644\u064a\u0648\u0645 \u0645\u062a\u0642\u0627\u0644 \u0641\u064a \u0648\u0632\u0646\u0647 \u0643\u0627\u0646 \u0648\u0643\u0633 \u0627\u0644\u0645\u0627\u0644 \u064a\u0633\u0648\u0627 \u0627\u0644\u064a\u0648\u0645 \u0627\u0631\u0641\u0639 \u062e\u0632\u0627\u062c \u0627\u0644 \u0645\u0642\u0634\u0648\u0631 \u0633\u062a\u0629 \u0645\u062a\u0627\u0642\u064a\u0644 \u0648\u0627\u0644\u0645\u0631\u062a\u0641\u062f \u05d4 \u0645\u062a\u0627\u0642\u064a\u0644 \u0633\u062a\u0629 \u0627\u0639\u0644\u0649 \u0627\u0644 \u064a\u0648\u0645 \u0648\u0627\u0631\u0628\u0639\u0629 \u0627\u0642\u0644\u0629 \u0627\u0644\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0643\u0634\u0646 \u0643\u062b\u064a\u0631 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0627\u0644\u0649 \u05d1 \u05d5\u05e0 \u0648\u0627\u0644 \u05db\u05d6 \u064a\u0633\u0648\u0627 \u0645\u0646 \u05d8 \u0645\u062a\u0627\u0642\u064a\u0644 \u0648\u0646\u0635\u0641 \u0627\u0644\u0649 \u05d8 \u0648\u0627\u0644\u0631\u0648\u062c \u0627\u0644\u0630\u064a \u064a\u0646\u062f\u0641\u0639 \u0627\u0644\u064a\u0648\u0645 \u0641\u064a \u0627\u0644\u062d\u0631\u064a\u0631 \u064a\u062c\u0648\u0632 \u0641\u064a\u0647 \u0627\u0644\u062b\u0648\u0644\u062b \u062c\u0648\u0627\u0632 \u0648\u0627\u0644\u0646\u0635\u0641 \u0628\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u062c\u0648\u0627\u0632 \u0627\u0644\u064a\u0648\u0645 \u0648\u0645\u062a\u0642\u0627\u0644 \u062d\u0645\u0648\u062f\u064a \u0627\u0644 \u062b\u0648\u0645\u0627\u0646\u064a \u0648\u064a\u0633\u0648\u0627 \u0627\u0644\u0646\u062d\u0627\u0633 \u062b\u0645\u0646\u064a\u0629 \u0627\u0644\u0637\u064a\u0628 \u0627\u0644\u0645\u062d\u0631\u0648\u0642 \u0648\u0627\u0644\u0633\u0628\u064a\u0643\u0629 \u0633\u0628\u0639\u0629 \u0648\u0627\u0644 \u0634\u0645\u0639 \u0627\u0644 \u0641\u0627\u0633\u0649 \u0627\u0644\u0637\u064a\u0628 \u062b\u0645\u0646\u064a\u0629 \u0648\u0646\u0635\u0641 \u0627\u0644\u0642\u064a\u0646\u0638\u0627\u0631 \u0648\u0627\u0644 \u0641\u0644\u0641\u0644 \u064a\u0633\u0648\u0627 \u0639\u0634\u0631\u064a\u0646 \u0645\u062a\u0642\u0627\u0644 \u0627\u0644 \u0642\u064a\u0646\u0638\u0627\u0631 \u0648\u0627\u0644 \u0644\u0643 \u064a\u0633\u0648\u0627 \u0645\u0646 \u0633\u0628\u0639\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u0627\u0644\u0649 \u062e\u0645\u0633\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u0644\u0648\u0628\u0627\u0646 \u0645\u0646 \u0633\u062a\u0629 \u0627\u0631\u0637\u0627\u0644 \u0628\u0645\u062a\u0642\u0627\u0644 \u0627\u0644\u0649 \u05d4 \u0628\u0645\u062a\u0642\u0627\u0644 \u0646\u0634\u0627\u0630\u0631 \u0645\u0646 \u05d3 \u0627\u0631\u0637\u0627\u0644 \u0628\u0645\u062a\u0642\u0627\u0644 \u0627\u0644\u0649 \u05d2 \u0648\u0631\u0628\u0639 \u0631\u0637\u0644\u064a\u0646 \u0648\u0645 \u0627\u0644 \u0648\u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0649 \u0648\u0635\u0644 \u0627\u0644\u064a\u0643 \u0645\u0646 \u0645\u0646 \u062a\u0644\u06