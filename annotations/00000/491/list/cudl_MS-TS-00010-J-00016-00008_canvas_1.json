        {
          "type": "TextualBody",
          "label": "T-S 10J16.8 recto - \u05e7\u05d8\u05e2 \u05d1",
          "value": "\n<ol><li>\u0648\u062a\u0645\u0646\u0639 \u0627\u0644\u0649 \u0627\u0646 \u062e\u0631\u062c</li>\n<li>\u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0645\u0636\u0645\u0648\u0646 \u0648\u0642\u0627\u0644 \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u063a\u0631\u0628\u0627 \u0634\u064a \u0627\u0646 \u064a\u0637\u0648\u0644 \u0634\u0631\u062d\u0647\u0627</li>\n<li>\u0648\u062c\u0645\u064a\u0639 \u0647\u0627\u0630\u0627 \u0644\u064a\u0633 \u0647\u0648 \u0645\u0646\u0647 \u0627\u0644\u0627 \u0645\u0627 \u062d\u0648\u0645\u0649 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u063a\u0631\u0628\u0627</li>\n<li>\u0648\u0644\u0645 \u064a\u0643\u0648\u0646 \u0641\u064a\u0647\u0648\u0645 \u0645\u0646 \u064a\u0648\u0631\u062f\u0647 \u0639\u0646 \u0630\u0644\u0643 \u0648\u0644\u0645\u0627 \u0643\u0627\u0646 \u064a\u0648\u0645 \u0627\u0644\u0627\u062d\u062f \u0627\u062a\u0641\u0642</li>\n<li>\u0631\u0627\u064a\u0646\u0627 \u0627\u0646 \u0646\u0645\u0636\u064a\u0648 \u0627\u0648\u0644\u0627 \u0627\u0644\u0649 \u0634\u064a\u0643 \u0645\u0636\u0645\u0648\u0646 \u0648\u0646\u0642\u0648\u0644 \u0644\u0647 \u0627\u0646 \u0643\u0627\u0646</li>\n<li>\u0647\u0627\u0630\u064a \u0627\u0644\u0627\u0645\u0648\u0631 \u062c\u0645\u064a\u0639\u0647\u0627 \u0645\u0646 \u0639\u0646\u062f\u0647\u0627 \u0648\u0639\u0646 \u0627\u0645\u0631\u0647 \u0633\u0645\u0639 \u0648\u0637\u0627\u0639\u0629</li>\n<li>\u0646\u0633\u0645\u0639 \u0643\u0644\u0627\u0645\u0647 \u0641\u064a \u0630\u0644\u0643 \u0648\u0646\u0639\u0645\u0644 \u0628\u062d\u0633\u0628\u0648 \u0648\u0645\u0636\u064a\u0646\u0627 \u062c\u0645\u064a\u0639</li>\n<li>\u0627\u0644\u0649 \u0639\u0646\u062f\u0647 \u0648\u0627\u0634\u062a\u0645\u0639\u0646\u0627 \u0628\u0647 \u0648\u0643\u0644\u0645\u0647 \u0643\u0644 \u0648\u0627\u062d\u062f \u0645\u0646\u0627 \u0628\u0645\u0627 \u0627\u0639\u062f \u0645\u0646</li>\n<li>\u0627\u0644\u0643\u0644\u0627\u0645 \u0648\u0633\u0627\u0644\u0646\u0647 \u0639\u0646 \u0647\u0627\u0630\u0627 \u0627\u0644\u0627\u0645\u0648\u0631 \u0628\u0645\u0627 \u0641\u0639\u0644 \u0647\u0630\u0627 \u0627\u0644\u0631\u062c\u0644</li>\n<li>\u0628\u0646\u0627 \u0639\u0646 \u0627\u0644\u062a\u0635\u062f\u064a\u0631 \u0648\u0627\u0644\u0627\u0634\u062a\u0645\u0639 \u0648\u0642\u0627\u0644 \u0644\u0627\u0646 \u0627\u0646\u062a\u0648\u0645 \u062a\u0639\u0644\u0645\u0648 \u0644\u0627\u0646 \u0643\u0644\u0627\u0645\u0649</li>\n<li>\u0645\u0627 \u0643\u0648\u0646\u062a \u062d\u0627\u0636\u0631 \u0641\u064a \u0627\u0644\u062e\u0646\u064a\u0633 \u0648\u0642\u0627\u0644 \u0644\u0646\u0627 \u0644\u0627\u0646 \u0645\u0627 \u0643\u0627\u0646 \u0633\u0628\u0628 \u0643\u0644\u0627\u0645\u0647 \u0627\u0645\u0631</li>\n<li>\u0627\u0644\u0627 \u0628\u0633\u0628\u0628 \u0627\u0644\u062d\u0644\u0628\u064a\u064a\u0646 \u062a\u062c\u0639\u0644\u0645 \u064a\u062c\u064a\u0648 \u0627\u0644\u0649 \u062f\u0627\u0631\u0629 \u0648\u064a\u062d\u0636\u0648\u0631 \u0648\u064a\u062d\u0636\u0631\u0648 \u0645\u0639\u0647 \u0627\u0644\u062e\u0646\u064a\u0633</li>\n<li>\u05d5\u05d9\u05e1\u05de\u05e2\u05d5 \u05e8\u05e9\u05d5\u05ea\u05d5 \u0648\u0647\u0648 \u0633\u0628\u0628 \u0643\u0644\u0627\u0645\u0647 \u0627\u0645\u0633 \u0648\u0627\u0644\u062a\u0641\u062a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f</li>\n<li>\u0648\u0643\u0644\u0645\u0647 \u0648\u0642\u0627\u0644 \u0644\u0647 \u0647\u0630\u0627 \u0627\u0644\u0630\u064a \u0637\u0631\u0627 \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u062c\u0645\u064a\u0639\u0629 \u062a\u062d\u0633\u0646\u0647</li>\n<li>\u0648\u062a\u0631\u0636\u0627 \u0648\u0642\u0627\u0644 \u0644\u0647 \u0645\u0627 \u0643\u0648\u0646\u062a \u062d\u0627\u0636\u0631 \u0648\u063a\u0627\u0644\u0637\u0647 \u0641\u064a \u0630\u0644\u0643 \u0645\u063a\u0627\u0644\u0637\u0629</li>\n<li>\u0648\u0644\u0645\u0627 \u0631\u0627\u0646\u0627 \u0644\u0627\u0646 \u0646\u062d\u0646 \u062c\u0645\u0627\u0639\u0629 \u0627\u0646 \u0645\u0648\u0634\u062a\u0645\u0639\u064a\u0646 \u0639\u0644\u0649 \u0643\u0644\u0645\u0629 \u0627\u0646</li>\n<li>\u0648\u0627\u062d\u062f\u0629 \u0648\u063a\u064a\u0631 \u0637\u064a\u064a\u0628 \u0627\u0644\u0627\u0646\u0641\u0648\u0633 \u0648\u0627\u0644\u062a\u0641\u062a \u0642\u0627\u0644 \u0644\u0641\u0644\u0627\u0646 \u0627\u0645\u0636\u0649 \u0627\u062e\u0644\u0627\u0635</li>\n<li>\u0647\u0627\u0630\u064a \u0627\u0644\u0646\u0648\u0628\u0629 \u0648\u062d\u0648\u0644\u0647\u0627 \u062a\u0646\u062d\u0644 \u0648\u0642\u0627\u0644 \u0644\u0647 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0645\u0646 \u0627\u0634\u062a\u0647\u0627</li>\n<li>\u063a\u064a\u0631 \u0647\u0630\u0627 \u0645\u0646 \u064a\u0631\u064a\u062f \u062a\u0648\u0633\u064a\u0639\u0647\u0627 \u062d\u0631\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0640\u05de\u05d7\u05dc\u05e7\u05d5\u05ea \u0648\u0645\u0646 \u064a\u0631\u064a\u062f\u0647\u0627</li>\n<li>\u0627\u0634 \u0628\u064a\u062f\u064a \u0645\u0646 \u062d\u0644\u0647\u0627 \u0627\u0644\u0627\u0645\u0631 \u0628\u064a\u062f\u0643\u0648\u0645 \u0648\u0642\u0627\u0644 \u0644\u0647 \u062a\u0645\u0636\u0649 \u0627\u0644\u0649 \u0639\u0646\u062f</li>\n<li>\u0627\u0644\u0631\u0626\u064a\u0633 \u0648\u062a\u0643\u0644\u0645\u0647 \u0643\u0644\u0645\u062a\u064a\u0646 \u0644\u0639\u0644 \u064a\u0642\u0648\u0644 \u0645\u0627 \u0641\u064a \u0642\u0644\u0628\u0647 \u0645\u0646 \u0627\u0644\u063a\u064a\u0636 \u0648\u0645\u0627</li>\n<li>\u0639\u0627\u062f \u0634\u064a \u063a\u064a\u0631 \u0647\u0630\u0627 \u0648\u0642\u0627\u0644 \u0644\u0647 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0645\u0627 \u0647\u0627\u0630\u064a \u0627\u0644\u0643\u0644\u0645\u062a\u064a\u0646</li>\n<li>\u0639\u0631\u0641\u0646\u064a \u0627\u064a\u0627\u0647\u0627 \u0648\u0642\u0627\u0644\u0648 \u0644\u0647 \u0627\u0646 \u0627\u0644\u0634\u064a\u0643 \u05d9\u05d5\u05e1\u05e3 \u0648\u0627\u0628\u0648 \u05e1\u05e2\u05d9\u05d3 \u0627\u0628\u0646 \u062c\u0645\u0627\u0647\u064a\u0631</li>\n<li>\u0648\u0633\u0627\u0644\u0645 \u064a\u0639\u0631\u0641\u0648\u0643 \u0627\u064a\u0627\u0647\u0627 \u0648\u0627\u0646\u0635\u0631\u0641\u0646\u0627 \u0645\u0646 \u0642\u0648\u062f\u0645\u0647 \u05d2</li></ol>\n",
          "format": "text/html"
        }
