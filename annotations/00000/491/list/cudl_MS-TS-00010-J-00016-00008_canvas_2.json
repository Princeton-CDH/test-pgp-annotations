        {
          "type": "TextualBody",
          "label": "BL Or 5566.24 verso - \u05e7\u05d8\u05e2\u05d4 \u05d2",
          "value": "\n<ol><li>\u0648\u0628\u0642\u064a\u0646\u0627 \u0645\u0648\u0646\u062a\u0638\u0631\u064a\u0646 \u0645\u0627 \u064a\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u0627\u0645\u0631 \u0648\u0627\u0630\u0627 \u0628\u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646</li>\n<li>\u064a\u0637\u0644\u0628\u0648 \u0627\u0644\u0640\u05d0\u05e9\u05ea\u05de\u05e2 \u0628\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u064a\u062f \u0648\u0627\u062e\u0630\u0648 \u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642</li>\n<li>\u0627\u0644\u0649 \u062c\u0627\u0646\u0628 \u0648\u0642\u0627\u0644\u0648 \u0644\u0647 \u0627\u0646 \u062a\u0642\u0648\u0644 \u0644\u0631\u0626\u064a\u0633 \u0643\u0644\u0627\u0645 \u0627\u0646 \u064a\u0637\u064a\u0628 \u0646\u0641\u0633\u0647 \u062d\u062a\u0649</li>\n<li>\u0644\u0627 \u064a\u0636\u064a\u0639 \u062c\u0645\u0639\u0647 \u0644\u0644\u0646\u0627\u0633 \u0648\u0643\u0644\u0627\u0645\u0647 \u0648\u062a\u0637\u064a\u064a\u0628 \u0642\u0644\u0628\u0647 \u0648\u0642\u0644\u0628 \u0627\u0644\u0634\u064a\u0643 \u0628\u0630\u0644\u0643</li>\n<li>\u0648\u0642\u0644\u062a \u0644\u0647\u0648\u0645 \u0645\u0627 \u0647\u0648 \u0627\u0644\u0643\u0644\u0627\u0645 \u0641\u0642\u0627\u0644\u0648 \u0644\u064a \u0627\u0646 \u062a\u0639\u0631\u0641\u0647 \u0644\u0627\u0646 \u0645\u0627 \u0633\u0628\u0628 \u064a\u0645\u064a\u0646</li>\n<li>\u0627\u0644\u0627 \u0627\u0646 \u0639\u0632 \u0639\u0644\u064a\u0643 \u0644\u0645\u0627 \u0627\u0646 \u0636\u0639\u062f \u0627\u0644\u0634\u064a\u0643 \u062e\u0644\u0641 \u0627\u0644\u0645\u0631\u0643\u0628 \u0648\u062d\u0644\u0641 \u0639\u0644\u064a\u0643</li>\n<li>\u0648\u0639\u0644\u0649 \u0645\u0628\u0627\u0631\u0643 \u0648\u0628\u0642\u0648\u0644 \u0627\u0644\u062d\u0644\u0628\u064a \u0644\u0627\u0646 \u0627\u0644\u0634\u064a\u0643 \u0642\u0627\u0644 \u0644\u0634\u064a\u0643 \u062e\u0644\u0641 \u0644\u0627\u0646 \u062a\u0631\u0647\u0646</li>\n<li>\u0644\u0643 \u062c\u0645\u064a\u0639 \u0645\u0646 \u0648\u0635\u0644 \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0628 \u0633\u0648\u0627 \u0628\u0631\u0643\u0627\u062a \u0627\u0644\u062d\u0644\u0628\u064a \u0648\u0627\u0646 \u0639\u0632 \u0639\u0644\u0649</li>\n<li>\u0643\u0645\u0627 \u0639\u0632 \u0639\u0644\u0649 \u0635\u0627\u062d\u0628\u064a \u0630\u0644\u0643 \u0648\u0634\u0631\u0637 \u0639\u0644\u064a\u0647\u0648\u0645 \u0627\u0646 \u0643\u0627\u0646 \u0644\u064a\u0633 \u062b\u0645 \u0627\u0644\u0627</li>\n<li>\u0647\u0630\u0627 \u0627\u0644\u0643\u0644\u0645\u062a\u064a\u0646 \u0627\u0646\u0627 \u0646\u0645\u0636\u0649 \u0648\u0646\u0642\u0648\u0644\u0647\u0627 \u0648\u0627\u0644\u0632\u0645\u0629 \u0627\u0644\u0645\u0636\u0649 \u0645\u0639\u0647\u0648\u0645 \u0648\u062f\u062e\u0644</li>\n<li>\u0648\u0642\u0644 \u0644\u0647 \u0644\u0627\u0646 \u0647\u0630\u0627 \u0633\u0628\u0628 \u0627\u0644\u064a\u0645\u064a\u0646 \u0648\u0642\u0627\u0644 \u0644\u0647 \u0627\u062e\u0631\u0627\u0645 \u0627\u0646 \u0644\u0643 \u0627\u0644\u0627 \u062a\u062d\u0644\u0641</li>\n<li>\u05d1\u05e1\u05e4\u05e8 \u05ea\u05d5\u05e8\u05d4 \u0628\u0627\u0644\u0645\u0635\u062d\u0641 \u0642\u062f\u0645\u064a \u0641\u0627\u0646 \u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0627 \u0630\u0627</li>\n<li>\u0644\u0647\u0648\u0645 \u0648\u062e\u0631\u062c \u0648\u0639\u0648\u0644\u062a \u062f</li></ol>\n\n<p> </p>",
          "format": "text/html"
        }
      ],
