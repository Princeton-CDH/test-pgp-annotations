      "dc:source": "https://geniza.princeton.edu/sources/885/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/67acf493-8f6d-4bbe-88cf-987b8546cdfc/manifest/canvas/6fdbbb0e-4f0e-4019-9493-cc93478b2ae8",
