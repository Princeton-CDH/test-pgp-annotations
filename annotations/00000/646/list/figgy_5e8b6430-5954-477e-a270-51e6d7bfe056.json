      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/55fa382c-e32b-4c5a-b8b6-258f3b780e2e/manifest/canvas/5e8b6430-5954-477e-a270-51e6d7bfe056",
