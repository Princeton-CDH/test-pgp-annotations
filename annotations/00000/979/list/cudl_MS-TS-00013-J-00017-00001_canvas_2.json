      "body": [
        {
          "type": "TextualBody",
          "label": "Verso - address",
          "value": "<ol>\n<li>To my lord and master Ab\u016b Ya\u1e25y\u0101 Nahr\u0101y b. Niss\u012bm, may he rest in peace,&nbsp;</li>\n<li>may God prolong his existence and make his wellbeing and happiness eternal</li>\n<li>from Mard\u016bk b. M\u016bs\u0101, may he rest in peace,</li>\n<li>may it arrive safely in Fustat, if God wills</li>\n</ol>",
          "format": "text/html"
        }
