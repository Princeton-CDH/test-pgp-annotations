      "body": [
        {
          "type": "TextualBody",
          "label": "verso, right margin",
          "value": "<p><span lang=\"he\">\u05d5\u05d7\u05d2'\u05d0\u05d2'. \u05d5\u05de\u05e1\u05d5\u05e8 \u05dc\u05d0\u05d3\u05d5\u05e0\u05d9, \u05d0\u05d1\u05e8\u05d4\u05dd \u05d0\u05d1\u05df \u05d0\u05b4\u05e1\u05b0\u05d7\u05b7\u05e7 \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05d5\u05dc\u05d0\u05d7\u05d9\u05d5 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd \u05d5\u05dc\u05dc\u05d5\u05d9, \u05d9\u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd, \u05d5\u05dc\u05d0\u05d7\u05d9\u05d5, \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd. \u05d5\u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d6\u05db\u05e8\u05d9 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d1\u05df \u05d0\u05dc\u05e8\u05e7\u05d9, \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd.</span></p>",
          "format": "text/html"
        }
      ],
