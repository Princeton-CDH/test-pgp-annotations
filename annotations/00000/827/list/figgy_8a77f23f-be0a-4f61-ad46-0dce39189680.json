      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0648 \u0648\u0627\u062c\u062f\u0647 \u0627\u0644\u0632\u0648\u062a\u0649 \u0639\u0644\u0649 \u0627\u0644\u0642\u0645\u062d \u0645\u0646 \u0633\u0639\u0631 \u05d2 \u0648\u0647 \u0642\u0631\u0627 \u0627\u0644\u0642 \u0648\u0627\u0644\u0645\u0648\u0646\u0629 \u0627\u062e\u0630\u062a \u064a\u062a\u0648\u0644\u0627 \u0628\u0644\u0627\u0642\u062f \u0643\u062a\u0628\u062a \u0627\u0644\u064a\u0647 \u0627\u062e\u0630\u062a</li>\n<li>\u064a\u062a\u0648\u0644\u0627 \u0628\u0644\u0627\u0642\u062f \u0643\u062b\u0628\u062a \u0627\u0644\u064a\u0647 \u0643\u062a\u0627\u0628 \u0647\u0648 \u064a\u0646\u0648\u0628 \u0641\u064a\u0647\u0645 \u0648\u0627\u0644\u0630\u064a \u064a\u0644\u0632\u0645 \u0627\u0644\u0642 \u05d9 \u062f\u0646\u0627 \u0645\u0633\u0631\u0629 \u0627\u0644\u0649</li>\n<li>\u0641\u0644\u0639\u0644 \u062a\u0632\u0646 \u0639\u0644\u0649 \u0627\u0644\u0627\u0631\u0645\u0633\u0627\u0646 \u05d3 \u0648\u0646\u0635\u0641 \u0648\u064a\u062d\u0631\u0636 \u0645\u0648\u0644\u0627\u064a \u0627\u0646 \u062a\u0643\u0648\u0646 \u062a\u062d\u0645\u0644 \u0627\u0644\u0647\u0644\u0627\u0644\u064a\u0633 \u0645\u0646 \u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0628 \u0627\u0644\u0649</li>\n<li>\u0627\u0644\u0649 \u0627\u0644\u062f\u0627\u0631 \u0641\u0627\u0646 \u0643\u0627\u0646 \u0645\u0648\u0644\u0627\u064a \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0646\u0635\u0641 \u064a\u0642\u0628\u0636\u0647 \u0644\u062f\u0627\u0631\u0647 \u0648\u064a\u062d\u0645\u0644 \u0644\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0649</li>\n<li>\u062f\u0627\u0631\u064a \u0648\u0627\u0646 \u0643\u0627\u0646 \u0645\u062a\u063a\u0646\u064a \u0639\u0646\u0647 \u0641\u064a\u062d\u0645\u0644\u0647 \u0628\u0627\u0645\u0644 \u0627\u0644\u0649 \u0639\u0646\u062f\u064a \u0648\u0642\u062f \u062d\u0635\u0644 \u0639\u0646\u062f\u064a \u0627\u064a\u0636\u0627</li>\n<li>\u0642\u0646\u0638\u0627\u0631\u064a\u0646 \u0635\u0628\u0627\u063a \u0627\u0644\u0649 \u062f\u0627\u0631\u064a \u0648\u0627\u0646 \u0643\u0627\u0646 \u0645\u062a\u063a\u0646\u064a \u0639\u0646\u0647 \u0641\u064a\u062d\u0645\u0644\u0647 \u0628\u0627\u0645\u0644 \u0627\u0644\u0649 \u0639\u0646\u062f\u064a \u0648\u0642\u062f \u062d\u0635\u0644 \u0639\u0646\u062f\u064a \u0627\u064a\u0636\u0627 \u0642\u0646\u0638\u0627\u0631\u064a\u0646 \u0636\u0628\u0627\u062c \u0644\u0639\u0644 \u0627\u0646\u0641\u062f\u0647\u0645 \u0645\u0639 \u064a\u0639\u0642\u0648\u0628 \u0648\u0642\u062f \u0648\u0635\u0644 \u0645\u0639 \u064a\u0639\u0642\u0648\u0628</li>\n<li>\u0641\u064a \u0627\u0644 \u0627\u0646\u0641\u0627\u062f\u0647 \u0648\u0644\u0643\u0646 \u0627\u0644\u0631\u0628\u0627\u0639\u064a\u0627\u062a \u0646\u0627\u0642\u0635\u0629 \u0648\u0627\u0646\u0627 \u0627\u062d\u062a\u0627\u062c</li>\n<li>\u064a\u0639\u0642\u0648\u0628 \u0644\u0627\u0646 \u0627\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0631\u0628\u0627\u0639\u064a \u0646\u0627\u0642\u0635 \u0646\u0635 \u062d\u0628\u0647 \u0645\u0646 \u0627\u0644\u0640\u05d3\u05d0\u05e0\u05e7\u05d9\u05df \u0639\u0644\u064a\u0647 \u0642\u064a\u0631\u0627\u0637</li>\n<li>\u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u0648\u0635\u0644 \u0645\u0639 \u064a\u0639\u0642\u0648\u0628\u064a \u05e0 \u0647\u0644\u0627\u0644\u064a\u0633 \u0648\u0642\u062f</li>\n<li>\u0648\u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0627\u0644\u0630\u064a \u0639\u0646\u062f \u0627\u0644\u0635\u0627\u0626\u062c \u0642\u062f \u0627\u062d\u062a\u0634\u0645\u062a \u0648\u062c\u0647\u064a \u0627\u062d\u062a\u0634\u0645\u062a \u0648\u062c\u0647\u0649 \u0645\u0645\u0627 \u0627\u0631</li>\n<li>\u0627\u0644\u0646\u0633\u0627 \u0639\u0646\u0647\u0645 \u0641\u064a \u062d\u062f\u0636 \u0645\u0648\u0644\u0627\u064a \u0627\u0648\u0644\u0627 \u064a\u0646\u0643\u0631\u0647\u0645 \u0645\u0639 \u064a\u0639\u0642\u0648\u0628 \u064a\u062a\u0641\u0635\u0644 \u0645\u0648\u0644\u0627\u064a</li>\n<li>\u064a\u062f\u0641\u0639 \u0644\u0644\u0627\u0645\u064a\u0646 \u0631\u0628\u0639 \u062f\u064a\u0646 \u0639\u0646 \u0627\u062c\u0631\u062a\u0647 \u0648\u062a\u062f\u0641\u0639 \u0644\u0647 \u062f\u064a\u0646\u0631\u064a\u0646 \u064a\u0634\u062a\u0631\u064a \u0628\u0647\u0645 \u062d\u0648\u0627\u0626\u062c</li>\n<li>\u0648\u0627\u062e\u0630 \u0639\u0648\u0635\u0647\u0645 \u0628\u0627\u0644\u0631\u064a\u0641 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0639\u0644\u0649 \u0633\u0631\u0639\u0629 \u0648\u0627\u0646\u0627 \u0627\u0646\u0641\u062f \u0645\u0639</li>\n<li>\u064a\u0639\u0642\u0648\u0628 \u0643\u062a\u0627\u0628\u064a \u0645\u0634\u062f \u0648\u0644\u0639\u0644 \u064a\u0646\u0641\u062f \u0644\u064a \u0645\u0648\u0644\u0627\u064a \u0645\u0639 \u0632\u0647\u064a\u0631 \u062f\u064a\u0646\u0631\u064a\u0646 \u0631\u0628\u0627\u0639\u064a\u0627\u062a</li>\n<li>\u0648\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0627 \u0641\u0644\u0627 \u062a\u0645\u0634\u064a \u064a\u0627\u062e\u064a\u0641\u064a \u0643\u062a\u0627\u0628\u0647 \u0627\u0646 \u0645\u0648\u0644\u0627\u064a \u0627\u0646\u0641\u062f \u0644\u0647\u0645 \u0642\u0644\u064a\u0644</li>\n<li>\u0642\u0645\u062d \u0634\u0643\u0631\u062a\u0647 \u0641\u0636\u0644\u0647 \u0645\u0648\u0644\u0627\u064a \u064a\u0633\u062a\u0648\u0641\u0649 \u0639\u0648\u0636\u0647\u0645 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644</li>\n<li>\u0648\u062d\u0642 \u0627\u0644\u062e\u0627\u062d\u0644 \u0627\u0644\u0630\u064a \u0648\u0632\u0646\u062a\u0647 \u0642\u062f \u062f\u0641\u0639\u062a\u0647 \u0644\u0645\u0647 \u0641\u0644\u0627 \u062a\u062d\u0627\u0633\u0628\u0647\u0645 \u0628\u0647 \u0641\u0642\u062f</li>\n<li>\u0648\u0632\u0646\u062a\u0647 \u0644\u0647 \u0648\u0647\u064a \u05d8 \u0642\u0631\u0627</li></ol>\n",
