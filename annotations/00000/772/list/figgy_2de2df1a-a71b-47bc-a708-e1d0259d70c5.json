      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u062d\u0635\u0631 \u0635\u0628\u062d \u0648\u0632\u0648\u062c\u062a\u0647 \u0648\u0627\u0642\u0646\u0648 \u0645\u0646\u0647\u0645 \u0645\u0639\u0627 \u0627\u0646\u0647\u0645 \u0631\u0641\u0639\u0648 \u064a\u062f\u0647\u0645 \u0639\u0646 \u0627\u0644\u062a\u0633\u0639\u0629 \u0642\u0631\u0627\u0631\u064a\u0637 \u0627\u0644\u0630\u064a \u0641\u064a \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0628\u062f\u0627\u0631 \u0627\u0644\u0635\u0628\u0627\u063a \u0634\u0631\u0643\u0629 \u0627\u0644\u0639\u0646\u064a\u064a\u0645 \u0648\u0647\u064a \u0628\u0642\u0635\u0631 \u0627\u0644\u0634\u0645\u0639 \u0628\u0632\u0642\u0627\u0642 \u0627\u0644\u062d\u0631\u0627\u0646\u064a \u0648\u0627\u0646\u0647\u0645 \u062c\u0645\u064a\u0639\u0627 \u0644\u0627 \u064a\u0628\u064a\u0639\u0627 \u0648\u0644\u0627 \u064a\u0647\u0628\u0627 \u0648\u0644\u0627 \u064a\u0627\u062c\u0631\u0627 \u0648\u0644\u0627 \u064a\u0633\u0643\u0646\u0627 \u0648\u0644\u0627 \u064a\u0642\u0628\u0636\u0627 \u0634\u064a \u0645\u0646 \u0627\u0644\u0627\u062c\u0631\u0629 \u0645\u0627 \u062f\u0627\u0645 \u0627\u0644\u0649 \u0627\u0646 \u064a\u0633\u062a\u0648\u0641\u0649 \u05e8\u05d1\u05d9\u05e0\u05d5 \u05d9\u05e9\u05e2\u05d9\u05d4\u05d5 \u062c\u0645\u064a\u0639 \u0645\u0627 \u064a\u0642\u0648\u0644\u0647 \u0627\u0646\u0647 \u062e\u0631\u062c \u0627\u0644\u0630\u064a \u0644\u0647\u0645 \u0648\u0647\u0648 \u0627\u0644\u062a\u0633\u0639\u0629 \u062d\u0636\u0631 \u0635\u0628\u062d \u0648\u0632\u0648\u062c\u062a\u0647 \u062c\u0645\u064a\u0639\u0627 \u0648\u0627\u0642\u0646\u0648 \u0645\u0646\u0647\u0645\u0627 \u062c\u0645\u064a\u0639\u0627 \u0645\u0639\u0627 \u0627\u0646 \u0642\u062f \u0627\u0631\u062a\u0636\u0648 \u0628\u0627\u0646 \u064a\u062a\u0648\u0644\u0627 \u0644\u0647\u0645 \u0627\u0644\u0634\u064a\u0643 \u0627\u0644\u0627\u062c\u0644 \u0628\u0648\u0646\u0635\u0631 \u05e8\u05d1\u05d9\u05e0\u05d5 \u05d9\u05e9\u05e2\u05d9\u05d4\u05d5 \u0645\u062a\u0648\u0644\u0649 \u0631\u0628\u0639 \u0627\u0644\u0639\u0646\u064a\u064a\u0645 \u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0631\u0628\u0639 \u0648\u062b\u0645\u0646 \u0645\u0646 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0630\u064a \u0644\u0647\u0645 \u0628\u0627\u0644\u0641\u0633\u0637\u0627\u0637 \u0628\u0642\u0635\u0631 \u0627\u0644\u0634\u0645\u0639 \u0628\u0632\u0642\u0627\u0642 \u0627\u0644\u062d\u0631\u0627\u0646\u064a \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0628\u062f\u0627\u0631 \u0628\u0646 \u0627\u0644\u0635\u0628\u0627\u063a \u0648\u0627\u0646\u0647\u0645 \u0642\u062f \u0627\u0645\u0646\u0648\u0647 \u062c\u0645\u064a\u0639\u0627 \u0641\u064a \u0645\u0627 \u064a\u0642\u0648\u0644 \u0627\u0646\u0647 \u0627\u0646\u0641\u0642\u0647 \u0639\u0644\u0649 \u0627\u0644 \u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u05db\u05e9\u05e0\u05d9 \u05e2\u05d3\u05d9\u05dd \u05db\u05e9\u05e8\u05d9\u05dd \u05e0\u05d0\u05de\u05e0\u05d9\u05dd \u0648\u0633\u0648\u0648\u062c\u0648 \u0644\u0647 \u0643\u0644 \u0645\u0627 \u064a\u0631\u0627\u0647 \u0645\u0646 \u0630\u0644\u0643 \u0648\u0627\u0646\u0647\u0645\u0627</p>",
