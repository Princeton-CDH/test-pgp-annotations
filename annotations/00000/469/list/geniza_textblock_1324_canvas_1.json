      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/469/iiif/textblock/1324/canvas/1/",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/469/iiif/manifest/"
