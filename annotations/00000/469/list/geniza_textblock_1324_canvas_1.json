    {
      "etag": "\"543f8d348864faadb99078828a050189\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/a8eab6f7-9e64-4ec4-ac9f-9b0c99beb0ef/",
      "type": "Annotation",
