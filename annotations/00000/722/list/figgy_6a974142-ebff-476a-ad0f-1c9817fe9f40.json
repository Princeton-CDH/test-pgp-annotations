      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0643\u062a\u0627\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0640\u05de\u05e2\u05d5\u05dc\u05d4 \u05d2\u05d3\u05d5\u05dc \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0647 \u0648\u0633\u0639\u0627\u062f\u062a\u0647 \u0645\u0646 \u05d0\u05dc\u05d0\u05e1\u05db\u05e0\u05d3\u05e8\u05d9\u05d4 \u0644\u064a\u0630 \u0628\u0642\u064a\u0646 \u0645\u0646 \u05ea\u05de\u05d5\u05d6 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0646\u0639\u0645\u0647 \u0648\u0634\u0648\u0642 \u0627\u0644\u064a\u0647 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0643 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644\u0645\u062d\u0627\u0628 \u0628\u0639\u062f \u0631\u062c\u0648\u0639\u064a \u0645\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0633\u0627\u0644\u0645 \u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0644\u0627\u0646 \u0644\u0645 \u0644\u0646\u0627 \u0631\u064a\u062d \u0628\u0646\u0627 \u0648\u0639\u062f\u0646\u0627 \u0628\u062d\u0645\u062f \u0627\u0644\u0644\u0647 \u0633\u0627\u0644\u0645\u064a\u0646 \u0648\u0643\u0627\u0646\u0643\u062a\u0627\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0645\u0648\u0644\u0626\u064a \u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0640\u05de\u05e2\u05d5\u05dc\u05d4 \u05d2\u05d3\u05d5\u05dc \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u0648\u0627\u062f\u0627\u0645 \u062a\u0627\u0626\u062f\u0647 \u0648\u0633\u0639\u0627\u062f\u062a\u0647 \u0645\u0646 \u05d0\u05dc\u05d0\u05e1\u05db\u05e0\u05d3\u05e8\u05d9\u05d4 \u0644\u064a\u0630 \u0628\u0642\u064a\u0646 \u0645\u0646 \u05ea\u05de\u05d5\u05d6 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0646\u0639\u0645\u0647 \u0648\u0634\u0648\u0642 \u0627\u0644\u064a\u0647 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0647 \u0639\u0644\u0649 \u0627\u0644\u0645\u062b\u0627\u0628 \u0628\u0639\u062f \u0631\u062c\u0648\u0639\u064a \u0645\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0633\u0627\u0644\u0645 \u0644\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0644\u0627\u0646 \u0644\u0647 \u0644\u0646\u0627 \u0631\u064a\u062d \u0628\u0646\u0627 \u0648\u0639\u062f\u0646\u0627 \u0628\u0627\u0645\u0631 \u0627\u0644\u0644\u0647 \u0633\u0627\u0644\u0645\u064a\u0646 \u0648\u0643\u0627\u0646 \u062a\u0642\u062f\u0645 \u0643\u062a\u0628\u064a \u0627\u0644\u064a\u0647 \u0628\u064a\u062f \u0627\u0644\u0633\u062e\u0631\u064a \u0641\u0627\u0631\u062c\u0648 \u0648\u0635\u0648\u0644\u0647\u0627 \u0627\u0644\u064a\u0647 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0646\u0633\u064a\u0645 \u0639\u062f\u0644 \u0643\u062a\u0627\u0646 \u064a\u0636 \u0648\u064a\u0643\u062a\u0628 \u0627\u0644\u0649 \u0628\u0647 \u0648\u064a\u0639\u0644\u0645\u0646\u064a \u0627\u0646 \u0643\u0627\u0646 \u0642\u0628\u0636\u0647 \u0645\u0648\u0644\u0626\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0633\u0639\u062f \u0627\u0646 \u064a\u062a\u0641\u0635\u0644 \u0643\u064a \u0627\u0644\u064a\u0647 \u0645\u0646 \u0642\u0628\u0644 \u0633\u0626\u064a\u062f\u064a \u0627\u0628\u064a \u0627\u0644\u062d\u0633\u064a\u0646 \u0627\u0644\u062a\u0646\u064a\u0633\u064a \u0648\u0627\u0646 \u0643\u0627\u0646 \u0648\u0635\u0644 \u0627\u0644\u064a\u0647 \u0641\u0627\u0646 \u0641\u064a \u0643\u062a\u0627\u0628 \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u062d\u0628\u0631 \u0627\u0644\u0640\u05de\u05e2\u05d5\u05dc\u05d4 \u05de\u05e8\u05e0 \u05d5\u05e8\u05d1\u05e0 \u05e0\u05d4\u05e8\u05d0\u05d9 \u05d2\u05d3\u05d5\u05dc \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u05d1\u05d9\u05e8 \u05e0\u05e1\u05d9\u05dd \u05d6\u05e6\u05dc \u0645\u062d\u0628\u0629 \u0645\u0648\u0633\u0649 \u0628\u0646 \u0627\u0628\u0648 \u0627\u0644\u062d\u064a \u0646\u0639 \u0645\u062d\u