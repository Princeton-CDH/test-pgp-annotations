          "type": "TextualBody",
          "label": "",
          "value": "\n<ol><li>\u0641\u0644\u0645\u0627 \u0648\u0635\u0644\u062a \u0643\u062a\u0628 \u0633\u064a\u062f\u0646\u0627 \u0631\u0627\u0633 \u0627\u0644\u0645\u062b\u064a\u0628\u0629 \u0646\u0631 \u0627\u0634\u062a\u0645\u0639\u0648 \u0628\u064a</li>\n<li>\u0627\u0628\u064a \u064a\u0639\u0642\u0648\u0628 \u0648\u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u0627\u064a\u062f\u0647\u0645\u0627 \u0627\u0644\u0644\u0647 \u0648\u0633\u0627\u0644\u0648\u0646\u064a \u0627\u0646 \u0646\u062f\u0628\u0631 \u0645\u0639\u0647\u0645 \u0627\u0644\u062d\u0627\u0644 \u0643\u064a\u0641</li>\n\n<p>\u064a\u062c\u0631\u064a \u0641\u0648\u0642\u0641\u062a \u0639\u0644\u0649 \u0627\u0644\u0643\u062a\u0628</p>\n\n<li>\u0641\u062f\u062e\u0644 \u0642\u0644\u0628\u064a \u0633\u0631\u0648\u0631 \u0639\u0646\u062f \u0645\u0627\u0626\u0642\u0646\u062a \u0645\u0646 \u0634\u0643\u0631 \u0633\u064a\u062f\u064a \u0631\u0627\u0633 \u0627\u0644\u0645\u062b\u064a\u0628\u0629 \u0646\u0631 \u0644\u0643 \u0641\u064a \u0643\u062a\u0627\u0628\u0647</li>\n\n<p>\u0648\u062d\u0645\u062f\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0630\u0644\u0643</p>\n\n<li>\u0644\u0643 \u0630\u0644\u0643 \u0627\u0628\u062f\u0627 \u0648\u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u0645\u0627 \u0648\u0642\u0641\u062a \u0639\u0644\u064a\u0647 \u0645\u0646 \u0630\u0643\u0631\u0643 \u0641\u064a \u0627\u0644\u0643\u062a\u064a\u0628 \u0627\u062e\u064a\u0631 \u0645\u0646 \u0645\u0644\u0648</li>\n\n<p>\u0627\u0644\u062f\u0646\u064a\u0627 \u0630\u0647\u0628 \u0648\u0641\u0636\u0629 \u0630\u0647\u0628 \u0648\u0641\u0636\u0647 \u0628\u0643</p>\n\n<li>\u0646\u0641\u062a\u0643\u0631 \u0648\u0627\u064a \u062d\u0627\u0644 \u0643\u0646\u062a \u0641\u064a\u0647 \u0627\u0646\u0627 \u062d\u0627\u0644 \u0641\u064a\u0647 \u0641\u0627\u0633\u0627\u0644 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u0631\u064a\u0646\u064a \u0648\u0644\u0630\u0643 \u0645\u062b\u0644\u0643</li>\n\n<p>\u0648\u064a\u0642\u064a\u0645 \u0628\u0643 \u0645\u0627 \u0642\u0627\u0644 \u0627\u0644\u0648\u0644\u0649 \u05ea\u05d7\u05ea \u05d0\u05d1\u05d5\u05ea\u05d9\u05da</p>\n\n<li>\u05d9\u05d4\u05d9\u05d5 \u05d1\u05e0\u05d9\u05da \u05ea\u05e9\u05d9\u05ea\u05de\u05d5 \u05dc\u05e9\u05e8\u05d9\u05dd \u05d1\u05db\u05dc \u05d4\u05d0\u05e8\u05e5 \u0641\u0642\u0644\u062a \u0644\u0647\u0645 \u0647\u0630\u0627 \u0627\u0645\u0631 \u064a\u062d\u062a\u0627\u062c \u0641\u064a\u0647 \u0627\u0644\u0627\u0648\u0644\u0641\u0629</li>\n<li>\u0648\u0643\u0644\u0645\u0629 \u0648\u0627\u062d\u062f\u0629 \u0648\u0646\u0645\u0636\u064a\u0648 \u0627\u0644\u0649 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u05d9\u05e6\u05d7\u05e7 \u0627\u0628\u0631\u0647\u064a\u0645 \u0628\u0646 \u05e2\u05d8\u05d0 \u0627\u064a\u062f\u0647</li>\n\n<p>\u0627\u0644\u0644\u0647 \u0648\u064a\u0643\u0648\u0646 \u0645\u0639\u0646\u0627 \u0648\u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0632\u0643\u0631\u064a \u0641\u0642\u0627\u0644\u0648 \u0644\u064a \u0627\u0646 \u0627\u0644\u0634\u064a\u0643</p>\n\n<li>\u0627\u0628\u064a \u05d9\u05e6\u05d7\u05e7 \u0644\u0627 \u064a\u062f\u062e\u0648\u0644 \u0645\u0639\u0646\u0627 \u0641\u0642\u0644\u062a \u0644\u0647\u0645 \u0639\u0644\u0649 \u062d\u062a\u0649 \u064a\u062f\u062e\u0648\u0644 \u0644\u0627\u0646 \u0628\u062f\u062e\u0648\u0644\u0647 \u062a\u0634\u062a\u0645\u0639</li>\n\n<p>\u0627\u0644\u0643\u0644\u0645\u0629 \u0648\u064a\u0642\u0639 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0641\u0644\u0645 \u0646\u0632\u0644</p>\n\n<li>\u0646\u062f\u0628\u0631 \u0627\u0644\u0627\u0645\u0631 \u0627\u0644\u0649 \u0627\u0646 \u0645\u0636\u064a\u0646\u0627 \u0627\u0644\u064a\u0647 \u0627\u0646\u0627 \u0648\u0647\u0645 \u0648\u0627\u0645\u062a\u0646\u0639 \u0645\u0646 \u0630\u0644\u0643 \u0641\u0631\u063a\u0628\u062a \u0627\u0644\u064a\u0647 \u0633\u0631</li>\n\n<p>\u0648\u0639\u0644\u0646 \u0627\u0644\u0649 \u0627\u0646 \u0642\u0628\u0644</p>\n\n<li>\u0648\u062d\u0635\u0644 \u0645\u0627\u0644 \u0627\u0646 \u062e\u0628\u064a\u0631 \u0628\u0627\u062a\u0641\u0627\u0642\u0647 \u0648\u0639\u0637\u0627 \u0647\u0648 \u05dc \u062f\u064a\u0646 \u0639\u0644\u0649 \u0627\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u062c\u0645\u0639</li>\n\n<p>\u0627\u0644\u0646\u0635 \u0644\u0633\u064a\u062f\u0646\u0627 \u0647\u0627\u064a \u05e0\u05e8 \u0648\u0627\u0644\u0631\u0628\u0639 \u0644\u0633\u064a\u062f\u0646\u0627 \u05e9\u05de\u05d5\u05d0\u05dc \u05e0\u05e8</p>\n\n<li>\u0648\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0627\u062e\u0631 \u0644\u0644\u0645\u0642\u0627\u062f\u0633\u0629 \u0648\u0627\u0646\u0645\u0627 \u062f\u0648\u0633\u0627 \u0648\u0634\u0645\u0627\u0644 \u0644\u0645 \u064a\u0643\u0646 \u0644\u0647\u0645 \u0639\u0646\u062f\u0646\u0627 \u062d\u0642 \u0641\u0631\u0627\u062f\u0648</li>\n\n<p>\u0642\u0648\u0645 \u0628\u0630\u0643\u0631\u0647\u0645 \u062a\u0646\u062c\u064a\u0636 \u0648\u0645\u062d\u0644\u0648\u0642\u062a</p>\n\n<li>\u0628\u0631\u064a\u0627\u064a\u0646 \u0645\u0646 \u0637\u0644\u0628\u0647 \u0648\u0639\u0637\u0627 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u064a \u0632\u0643\u0631\u064a \u0644 \u0648\u0639\u0637\u064a\u062a\u0646\u0627 \u0639\u0634\u0631\u064a\u0646 \u0648\u0639\u0637\u0627 \u062e\u0627\u0644\u0649 \u062e\u0645\u0633\u0629</li>\n\n<p>\u0648\u0639\u0637\u062a</p>\n\n<li>\u0639\u064a\u0627\u0634 \u062e\u0645\u0633\u0629 \u0648\u0639\u0637\u0627\u0648 \u0628\u0646\u064a \u0627\u062e\u064a\u0629 \u0639\u0634\u0631\u0629 \u0648\u0633\u0627\u0626\u0631 \u0627\u0644\u0646\u0627\u0633 \u0639\u0637\u0627\u0648 \u0643\u0644 \u0648\u0627\u062d\u062f \u0648\u0637\u0627\u0642\u062a\u0647</li>\n\n<p>\u0648\u0645\u0634\u064a\u062a \u0641\u064a\u0647\u0627 \u0648\u062a\u0639\u0628\u062a \u0646\u0641\u0633\u0649</p>\n\n<li>\u0647\u0645 \u0648\u0637\u0644\u0628 \u0627\u0644\u062b\u0648\u0627\u0628 \u0648\u0627\u062e\u0630\u0647 \u0628\u0633\u0646\u062a\u0643 \u0641\u0644\u0645\u0627 \u0627\u0634\u062a\u0645\u0639 \u0627\u0644\u0645\u0627\u0644 \u0648\u0643\u062a\u0628\u0646\u0627 \u0627\u0644\u0643\u0648\u062a\u0628 \u0644\u0645 \u062a\u0637\u064a\u0628</li>\n\n<p>\u0646\u0641\u0633 \u0642\u0648\u0645 \u0639\u0644\u0649 \u0630\u0644\u0643</p>\n\n<li>\u0639\u0646\u062f\u0647\u0645 \u0644\u0627 \u064a\u0635\u0647\u0631 \u0644\u0647\u0645 \u0627\u0646\u0647 \u064a\u062a\u0645 \u0641\u0644\u0645\u0627 \u0627\u0646 \u062a\u0645 \u0644\u0645 \u064a\u0639\u062c\u0628\u0648 \u0630\u0644\u0643 \u0648\u0639</li>\n\n<p>\u0628\u0643\u0644 \u0648\u062c\u0647 \u0627\u0644\u0649 \u0627\u0646 \u063a\u0631\u0627\u062a \u0641\u064a\u0647</p>\n\n<li>\u0645\u062d\u0644\u0648\u0642\u062a \u0641\u064a \u0645\u0627 \u0628\u0639\u062f \u0648\u0627\u0646\u062a \u062a\u0642\u0641 \u0639\u0644\u064a\u0647\u0627 \u0645\u0646 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0627\u0644\u0648\u0627\u0635\u0644\u064a\u0646 \u0648\u0648\u0642\u0639 \u0627\u0644\u0627\u062a\u0641\u0627\u0642</li>\n\n<p>\u0627\u0646 \u064a\u0628\u0642\u0627 \u0627\u0644\u0627\u0645\u0631 \u0645\u0648\u0642\u0648\u0641 \u0627\u0644\u0649 \u0627\u0644\u0645\u0631\u0627\u0643\u0628</p>\n\n<li>\u0628\u0627\u0642\u0649 \u0627\u0644\u0630\u064a \u064a\u062a\u0641\u0642\u0648 \u0639\u0644\u064a\u0647 \u062d\u062a\u0649 \u064a\u062a\u0641\u0642 \u0639\u0644\u0649 \u062d\u0627\u0644 \u0627\u0645\u0627 \u0641\u0642\u062f</li>\n\n<p>\u0639\u0631\u0641\u062a\u0643 \u0635\u0648\u0631\u062a \u0627\u0644\u0627\u0645\u0631 \u0645\u062e\u062a\u0635\u0631 \u0648\u0644\u0645 \u064a\u0645\u0646\u0639 \u0643\u062a\u0628\u064a \u0648</p>\n\n<li>\u0633\u064a\u062f\u0646\u0627 \u0647\u0627\u064a\u064a \u0631\u0627\u0633 \u0627\u0644\u0645\u062b\u064a\u0628\u0629 \u0646\u0631 \u0627\u0644\u0649 \u0627\u0646\u0647 \u0646\u0637\u0644\u0628 \u0627\u0646 \u0646\u062c\u0631\u064a</li>\n<li>\u0648\u0627\u0646\u062a \u0627\u064a\u062f\u0643 \u0627\u0644\u0644\u0647 \u0639\u064a\u0646\u0647 \u0648\u0645\u0642\u0627 \u0645\u0647</li>\n<li>\u0643\u0644\u0647\u0645 \u064a\u0639\u0631\u0641\u0648\u0643 \u0645\u0646 \u0644\u0633\u064a\u062f\u0646\u0627 \u0647\u0627\u064a\u064a \u0646\u0631 \u0628\u0627\u0644\u0642\u064a\u0631\u0648\u0627\u0646 \u0641\u0627\u0646\u062a \u062a\u0643\u062a\u0628 \u0627\u0644\u064a\u0647 \u0628\u0645\u0627 \u064a\u0643\u0648\u0646</li>\n\n<p>\u0639\u0646\u062f\u0643 \u0645\u0646 \u0627\u0644\u0639\u0644\u0645 \u0641\u0627\u0631\u062c\u0648 \u0627\u0644\u0644\u0647</p>\n\n<li>\u0648\u0645\u062b\u0644\u0646\u0627 \u0641\u0644\u064a\u0633 \u064a\u062e\u0641\u0627 \u0639\u0646\u0643 \u0645\u0646\u0632\u0644\u062a \u0643\u0644</li></ol>\n",
