      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u064a\u0627\u0633\u064a\u062f\u064a \u0648\u0634\u064a\u0643\u064a \u0648\u062c\u0644\u064a\u0644\u064a \u0648\u0627\u0644\u0639\u0632\u064a\u0632 \u0639\u0644\u0649 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0633\u0644\u0627\u0645\u062a\u0643</p>\n<p>\u0648\u0643\u0627\u0646 \u0644\u0643 \u0641\u064a \u062c\u0645\u0648\u0639 \u0627\u0645\u0648\u0631\u0643 \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 \u0645\u0646 \u062f\u0645\u0633\u064a\u0633 \u0639\u0646 \u062d\u0627\u0644 \u0633\u0644\u0627\u0645\u0647 \u0648\u0639\u0627\u0641\u064a\u0629 \u0644\u0644\u0647</p>\n<p>\u0627\u0644\u062d\u0645\u062f \u0639\u0644\u0649 \u0630\u0644\u0643 \u0627\u0639\u0644\u0645\u0643 \u0627\u0646 \u0646\u062d\u0646 \u0641\u064a \u0627\u0634\u063a\u0627\u0644\u0646\u0627 \u0648\u0627\u0644\u0634\u062f\u0627\u062f\u064a\u0646 \u0639\u0646\u062f\u0646\u0627 \u0648\u0642\u062f</p>\n<p>\u0643\u062a\u0628\u062a \u0639\u0644\u0649 \u0627\u0644\u0627\u062d\u0645\u0627\u0644 \u0643\u0645\u0627 \u0631\u0633\u0645\u062a \u0648\u0642\u062f \u0643\u0646\u062a \u0633\u0627\u0644\u062a \u0628\u0646 \u0627\u0644\u062a\u0627\u0647\u0631\u062a\u064a \u0641\u064a \u0627\u0645\u0631 \u0627\u0644\u0639\u0644\u0627\u0648\u0627\u062a</p>\n<p>\u0641\u0627\u0646 \u0633\u0647\u0644\u0648 \u0627\u0645\u0631\u0647\u0627 \u0648\u0644\u0627 \u062a\u0628\u0642\u064a\u0647\u0627 \u0644\u064a \u0639\u0646\u062f \u0648\u0635\u0648\u0644\u064a \u0639\u0646\u062f \u0648\u0635\u0648\u0644\u0649 \u0648\u0643\u0646\u062a \u0633\u0627\u0644\u062a \u0627\u0644\u062d\u0628\u0631 \u0643\u0627\u0644\u0649</p>\n<p>\u0627\u064a\u0634 \u062a\u0634\u064a\u0631 \u0639\u0644\u0649 \u0628\u0647 \u0627\u0646 \u0643\u0627\u0646 \u0646\u0642\u064a\u0645 \u0627\u0648 \u0646\u0633\u0627\u0641\u0631 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0627\u0648 \u0646\u0642\u064a\u0645 \u0648\u0642\u062f</p>\n<p>\u0634\u0627\u0647\u062f\u0646\u0627 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0645\u0646 \u0627\u0633\u0628\u0627\u0644 \u0627\u0644\u0643\u062a\u0627\u0646 \u0645\u0627 \u0644\u0645 \u064a\u0642 \u0627\u0644\u0646\u0627\u0633 \u0645\u0646 \u0633\u0646\u064a\u0646</p>\n<p>\u0627\u0634\u0647\u062f\u0646\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u064a\u0627\u062e \u062e\u064a\u0631\u0647\u0627 \u05d5\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05de\u05df \u0648\u0627\u0644\u0630\u064a \u0639\u0646\u062f\u064a \u0645\u0646 \u0627\u0644\u062d\u0631\u064a\u0631</p>\n<p>\u05e0 \u0631\u0637\u0644 \u0648\u0643\u0646\u062a \u0642\u062f \u0648\u0632\u0646\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0646\u0629 \u0645\u0646 \u062a\u0645\u0646\u0647 \u0648\u0628\u0642\u064a\u062a \u062d\u0627\u0626\u0631</p>\n<p>\u0647\u0627\u0626\u0645 \u0627\u062d\u0628 \u0645\u0646 \u0633\u064a\u062f\u064a \u0627\u0644\u0634\u064a\u062e \u0644\u0627 \u064a\u062e\u0644\u064a\u0646\u064a \u0647\u0627\u0626\u0645 \u0627\u062d\u0628 \u0645\u0646 \u0633\u064a\u062f\u064a \u0627\u0644\u0634\u064a\u062e \u0644\u0627 \u064a\u0643\u0644\u064a\u0646\u064a \u0645\u0646 \u0631\u0627\u064a\u0647 \u0627\u0644\u0627\u062b\u064a\u0631 \u0627\u062f\u0627\u0645</p>\n<p>\u0627\u0644\u0644\u0647 \u0627\u0641\u0636\u0644 \u0627\u0645\u0627\u0644\u0647 \u0648\u0627\u0630\u0627 \u0648\u0635\u0644 \u0627\u0644\u0634\u064a\u0643 \u0628\u0646 \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u062d\u064a \u05d1\u05df</p>\n<p>\u05d9\u05e9\u05d5\u05e2\u05d4 \u062a\u062f\u0641\u0639 \u0644\u0647 \u0644\u0627\u0633\u064a\u0646 \u0647\u064a \u0644\u0645\u0648\u0633\u0649 \u05d1\u05df \u05e0\u05d4\u05e8\u05d0\u05d9 \u0627\u0648 \u0645\u0639\u0627\u0644\u0634\u064a\u0643 \u0631\u0642\u0639\u062a\u064a</p>\n<p>\u0627\u0644\u064a\u0647 \u0627\u0644\u0645\u0631\u0634\u062d\u0629 \u0628\u0627\u0644\u0644\u0627\u0633\u064a\u0646 \u0627\u0644\u0630\u064a \u0641\u064a\u0647\u0627 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0643\u0644\u064a\u0646\u064a \u0645\u0646\u0643</p>\n<p>\u0648\u0627\u0646 \u064a\u0643\u0648\u0646 \u0643\u0644\u0645\u0646\u064a \u0641\u064a\u0643 \u0635\u0627\u0644\u062d \u0627\u0644\u0640\u05e8\u05e2\u05d4 \u0641\u0627\u0646 \u0645\u0627 \u0641\u0643\u0631\u0649 \u0627\u0644\u0627 \u0627\u0646\u062a \u0648\u0645\u0627 \u062a\u0627\u062c \u0631\u0627\u0633\u0649</p>\n<p>\u0627\u0644\u0627 \u0627\u0646\u062a \u0642\u0631\u0627\u062a \u0639\u0644\u0649 \u062e\u0627\u0635\u0629 \u0646\u0641\u0633\u0643 \u0627\u0644\u0634\u0631\u064a\u0641\u0629 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0639\u0644\u0649 \u0633\u064a\u062f\u064a</p>\n<p>\u0627\u0628\u064a \u0627\u0644\u0641\u0635\u0644 \u0648\u0627\u0628\u064a \u0646\u0635\u0631 \u0648\u0645\u0646\u0634\u0647 \u0627\u062d\u0641\u0636\u0647\u0645 \u0627\u0644\u0644\u0647 \u0628\u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0639\u0644\u0649 \u062c\u0645\u064a\u0639</p>\n<p>\u0645\u0646 \u062a\u062d\u0648\u0637 \u0628\u0647 \u0639\u0646\u0627\u0626\u062a\u0643 \u0628\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0628\u064a \u0627\u0644\u062d\u064a \u0648\u062a\u0645\u064a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645</p>",
