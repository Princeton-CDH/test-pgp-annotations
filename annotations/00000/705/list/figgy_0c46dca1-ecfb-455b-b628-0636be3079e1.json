      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/591a8588-b893-4a99-b13a-7bd2236b0463/manifest/canvas/0c46dca1-ecfb-455b-b628-0636be3079e1",
