        {
          "type": "TextualBody",
          "label": "(margin)",
          "value": "\n<ol><li>\u0641\u0644\u0645\u0646 \u0635\u0627\u0631 \u0627\u0644\u0645\u063a\u0646\u0649 \u0639\u0646\u062f\u0647\u0645 \u0631\u0627\u062d \u062d\u0631\u0634 \u0639\u0644\u064a\u0647\u0645 \u0639\u0646\u062f \u0627\u0644\u0634\u0648\u0641\u0638 \u0627\u0644\u062c\u0632\u0631\u064a \u0647\u062c\u0645\u0648 \u0639\u0644\u064a\u0647\u0645 \u0648\u0636\u0631\u0628\u0648\u0647\u0645 \u0648\u062d\u0628\u0633\u0648\u0647\u0645 \u0648\u0627\u0645\u0627</li>\n<li>\u05d0\u05d1\u05e8\u05d4\u05dd \u0636\u0631\u0628\u0648\u0647 \u0648\u0639\u0636\u0631\u0648\u0647 \u062d\u062a\u0649 \u0642\u062a\u0644\u0648\u0647 \u0648\u062c\u0631\u0645\u0648\u0647 \u062a \u05d5\u05de\u05e6\u05de\u05d5\u05df \u05df \u05d0\u05d1\u05e8 \u05df \u05d4\u05d1\u05d4 \u062e\u0645\u0633\u064a\u0646 \u05d5\u05d0\u05d1\u05e8 \u05df \u0627\u0644\u0634\u064a\u0643 \u05d9\u05d4\u05d5\u05d3\u05d4 \u0642</li></ol>\n",
