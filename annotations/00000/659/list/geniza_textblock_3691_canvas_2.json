      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, II",
          "value": "<ol>\n<li>\n<p>The expenditure for building work and repairs,&nbsp;</p>\n</li>\n<li>\n<p>for the six months ...&nbsp;</p>\n</li>\n<li>beginning with the month of Elul of the year 1466,</li>\n<li>\n<p>and ending with the month of Shevat of the year 1467:&nbsp;</p>\n</li>\n<li>\n<p>A carpenter in the synagogue, 1 1/2.&nbsp;</p>\n</li>\n<li>\n<p>Plus, palm branches, 6 1&frasl;2 dir.</p>\n</li>\n</ol>\n<p>&nbsp;</p>",
          "format": "text/html"
