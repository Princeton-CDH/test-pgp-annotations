          "label": "Verso:",
          "value": "\n<ol><li>\u0643\u0646\u062a \u0627\u0646\u0641\u062f\u0647 \u0644\u062a\u0646\u064a\u0633 \u0645\u0642\u0637\u0639 \u0644\u064a \u0648\u0644\u0648 \u0639\u0631\u0641\u062a\u0646\u064a \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u0645\u0642\u0637\u0639\u064a\u0646 \u0645\u062a\u0627\u0639\u0643 \u0645\u0639\u0647\u0645 \u0648\u0627\u0646\u0627 \u0627\u0646\u0641\u062f\u0647\u0645</li>\n<li>\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u062a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062c\u0627\u0632 \u0648\u062a\u062c\u064a \u062a\u062a\u062e\u0644\u0635 \u0645\u0646 \u0647\u0646\u0627 \u0648\u062a\u0631\u0627 \u0627\u064a\u0634 \u062a\u0639\u0645\u0644 \u0641\u064a \u0627\u0644\u0645\u0631\u062c\u0627\u0646 \u0648\u0627\u0644\u0634\u0634 \u0648\u0642\u062f</li>\n<li>\u064a\u0627\u0633\u064a\u062f\u064a \u0637\u0648\u0644\u062a \u0645\u0646 \u0642\u0639\u0648\u062f\u0643 \u062b\u0645 \u0627\u0644\u064a\u0648\u0645 \u05d2 \u0634\u0647\u0648\u0631 \u0648\u0634\u064a \u0644\u0648 \u0643\u0627\u0646 \u0644\u0643 \u0634\u0631\u0627 \u0628\u0648\u0635\u064a\u0631 \u0643\u0644\u0647\u0627 \u0648\u0644\u0627 \u062a\u062a\u0648\u0627\u0646\u0627 \u0644\u0627\u062e\u0631 \u0627\u0644</li>\n<li>\u0648\u0642\u062a \u0645\u062b\u0644 \u0639\u0627\u0645 \u0627\u0648\u0644 \u0627\u0646\u062a \u0639\u0627\u0645 \u0627\u0648\u0644 \u0645\u0627 \u0643\u0627\u0646 \u0644\u0643 \u0634\u063a\u0644 \u0628\u0645\u0635\u0631 \u0648\u0627\u0644\u0633\u0639\u0629 \u0627\u0646\u062a \u0645\u0644\u0628\u0637 \u0645\u0646 \u0643\u0644 \u0648\u062c\u0647 \u0648\u0627\u0642\u0644</li>\n<li>\u0645\u0646 \u0647\u0630\u0627 \u0644\u0645\u062a\u0644\u0643 \u0643\u0641\u0627\u0626\u0629 \u0642\u0631\u0627\u062a \u0639\u0644\u064a\u0643 \u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0645 \u0648\u0633\u064a\u062f\u064a \u0627\u0628\u064a \u0639\u0645\u0631\u0627\u0646 \u0645\u0648\u0633\u0649 \u0627\u0644\u0633\u0644\u0645 \u0648\u062c\u0645\u064a\u0639 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0627\u0644\u0633\u0644\u0645</li>\n<li>\u05d9\u05d5\u05e1\u05e3 \u0648\u0648\u0627\u0644\u0630\u0647\u0648 \u064a\u0642\u0631\u064a\u0648\u0643 \u0627\u0644\u0633\u0644\u0645</li></ol>\n",
