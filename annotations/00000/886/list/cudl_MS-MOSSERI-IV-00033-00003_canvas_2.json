          "type": "TextualBody",
          "label": "verso",
          "value": "<p>. . . .</p>\n\n<ol><li>\u0627\u0644\u0649 \u0645\u0639\u0647 \u0648\u0639\u0646\u062f \u062e\u0631\u0648\u062c \u05e1\u05e4\u05e8 \u05ea\u05d5\u05e8\u05d4</li>\n<li>\u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u05d1\u05d0\u05d1\u05df \u05de\u05d0\u05d9\u05e8 \u0641\u0642\u0627\u0645\u0648 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u064a\u0646</li>\n<li>\u0648\u0642\u0627\u0644\u0648 \u0645\u0627 \u0646\u0642\u0639\u062f \u0645\u0639\u0647 \u0641\u064a \u0645\u0648\u0636\u0639 \u0644\u0627\u0646\u0647</li>\n<li>\u0627 \u062f\u0627\u0631 \u0627\u0646 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u062a\u0628\u0644\u0628\u0644\u0648 \u0627\u064a\u0634 \u0647\u0630\u0627</li>\n<li>\u0644\u0645\u0646 \u0641\u0642\u0627\u0644 \u0644\u0647 \u0633\u064a\u062f\u064a \u0627\u0644\u062d\u0628\u0631 \u0627\u0628\u0648 \u0643\u062b\u064a\u0631</li>\n<li>\u0627\u0644\u0644\u0647 \u0647\u0648 \u0644\u0627 \u0645\u0646 \u0639\u0635\u0628\u064a\u0629 \u0627\u0628\u0648 \u0633\u0647\u0644</li>\n<li>\u0627\u0644\u0646\u0634\u064a\u0627 \u0645\u062c\u0644\u0633\u0629 \u0644\u062d\u0627\u0644 \u0627\u0628\u0646 \u05de\u05d0\u05d9\u05e8 \u0642\u0627\u0644\u0648 \u0627\u0646\u0647</li>\n<li>\u0647 \u0641\u0633\u062a\u062f\u0639\u0627 \u0628\u0647 \u0648\u0642\u0627\u0644 \u0644\u0647 \u062a\u062a\u0641\u0636\u0644 \u0648\u062a\u063a\u0644\u0633</li>\n<li>\u064a\u0643\u0634\u0641 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u062d\u0627\u0644 \u05d1\u05e8\u05e9\u05d5\u05ea \u05d4\u05e6\u05d1\u05d5\u05e8</li>\n<li>\u0644\u0645 \u0648\u0627\u0645\u062a\u0639\u0636\u0648 \u0627\u0644\u0646\u0627\u0633 \u0644\u0647 \u0648\u0642\u0627\u0644\u0648 \u0644\u0648 \u0627\u0646\u0647 \u05d2\u05d5\u05d9 \u0645\u0627 \u0627\u0646\u0635\u0631\u0641</li>\n<li>\u0627 \u0641\u064a \u062d\u0636\u0631\u0647 \u0633\u0641\u0631 \u0627\u0644\u0649 \u0636\u0639\u062f \u05db\u05d4\u05df \u0641\u0642\u0637 \u0648\u0643\u0627\u0646</li>\n<li>\u0645\u0631\u0642\u062f \u0641\u0641\u062a\u062d\u0647 \u0648\u062f\u062e\u0644 \u062f\u0627\u062e\u0644 \u0648\u0627\u063a\u0644\u0642</li>\n<li>\u0628\u062f\u0639\u0627 \u0628\u0627\u062b\u0646\u064a\u0646 \u0645\u0646 \u0627\u0644\u0639\u0635\u0628\u064a\u0629 \u0648\u0647\u0648\u0645 \u0639\u0644\u0648\u0646</li>\n<li>\u0645\u0646\u0647 \u0643\u0644 \u062d\u0627\u0644 \u0645\u0646</li>\n<li></li></ol>\n\n<p>. . . .</p>",
