      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/d8ac188c-5967-4374-bbd4-df16fa0312ef/manifest/canvas/a68501a9-3a13-4fee-99cf-6c2feffcb5d0",
