          "value": "<ol>\n<li><span lang=\"he\">\u05d0\u05dc\u05e6\u05d0\u05d1\u05d5\u05df \u05d1\u05e8'[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]</span></li>\n<li><span lang=\"he\">\u05de\u05df \u05d3\u05d9\u05e0\u05e8 \u05d0\u05dc\u05d9 \u05d1'\u05db' \u05e7\u05d9\u05e8'</span></li>\n<li><span lang=\"he\">\u05d0\u05e1\u05e2\u05d0\u05e8 \u05d0\u05dc\u05d0\u05e1\u05db\u05e0\u05d3\u05e8\u05d9\u05d4&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05d0 \u05d0\u05e7\u05dc\u05d0\u05e2 \u05d0\u05dc\u05db\u05d9\u05d8\u05d9\u05d4 [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d0 \u05db\u05d0\u05df \u05d9\u05e0\u05d7\u05e6'\u05e8&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05dd [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u05db\u05e8\u05d2</span></li>\n</ol>",
