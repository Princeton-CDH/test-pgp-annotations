      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "<ol>\n<li><span lang=\"he\">&hellip;(\u05d4\u05d9\u05ea\u05e8\u05d4) \u05e9\u05d0\u05e0\u05d9 \u05d7\u05d9\u05d9\u05d1, \u05ea\u05d2\u05d1\u05d4 \u05d0\u05d5\u05ea\u05d4, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05de\u05df \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d0\u05e8\u05d9\u05d2\u05d9\u05dd, \u05db\u05d9 \u05dc\u05d0 \u05e0\u05d5\u05ea\u05e8\u05d5 \u05d0\u05e6\u05dc\u05d9&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">&hellip;\u05d9\u05e9 \u05d0\u05e6\u05dc\u05d9 \u05d2' \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9 \u05d5\u05e9\u05e0\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd \u05d5\u05d7\u05d1\u05d4, \u05d5\u05d1\u05d9\u05e7\u05e9 \u05de\u05de\u05e0\u05d9 \u05d0\u05d3\u05d5\u05e0\u05d9</span></li>\n<li><span lang=\"he\">(\u05d5\u05e8\u05d1\u05d9)... \u05e9\u05d0\u05db\u05ea\u05d5\u05d1 \u05dc\u05da \u05de\u05db\u05ea\u05d1 \u05d1\u05e2\u05e0\u05d9\u05d9\u05df&hellip; \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05e7\u05d5\u05e7 \u05dc\u05de\u05db\u05ea\u05d1 \u05e2\u05dd&nbsp;</span></li>\n<li><span lang=\"he\">&hellip;\u05d4\u05d5\u05d0 \u05d0\u05d3\u05dd \u05e9\u05d0\u05d9\u05df \u05e8\u05d1\u05d9\u05dd \u05db\u05de\u05d5\u05d4\u05d5 \u05d1\u05d0\u05e6\u05d9\u05dc\u05d5\u05ea \u05d5\u05d1\u05d8\u05d5\u05d1 \u05dc\u05d1\u05dd, \u05d5\u05d4\u05d2\u05d3\u05d5\u05dc\u05d4</span></li>\n<li><span lang=\"he\">&hellip;\u05de\u05d0\u05ea\u05e0\u05d5 \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d2\u05d9\u05e2 \u05dc\u05d5. \u05d0\u05d1\u05e7\u05e9 \u05d0\u05e4\u05d5\u05d0 \u05de\u05de\u05da, \u05e2\u05dc \u05e4\u05d9 \u05de\u05e0\u05d4\u05d2\u05d9\u05da \u05d4\u05d8\u05d5\u05d1\u05d9\u05dd, \u05d1\u05dc \u05d9\u05d9\u05e4\u05e1\u05e7\u05d5, \u05db\u05d9</span></li>\n<li><span lang=\"he\">&hellip;\u05e2\u05de\u05d5, \u05db\u05d9 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05e2\u05e9\u05d9\u05e0\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05d0\u05de\u05e6\u05d9\u05dd&hellip;</span></li>\n<li><span lang=\"he\">&hellip;\u05d4\u05d5\u05d0 \u05d0\u05d3\u05dd \u05d7\u05e1\u05d9\u05d3&hellip; \u05d1\u05e2\u05e9\u05d9\u05d9\u05ea \u05d8\u05d5\u05d1\u05d5\u05ea; \u05d5\u05d0\u05e3 \u05d1\u05e4\u05d7\u05d5\u05ea \u05de\u05d6\u05d4</span></li>\n<li><span lang=\"he\">\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e1\u05ea\u05e4\u05e7 \u05dc\u05d2\u05d1\u05d9\u05d5. \u05de\u05e8\u05d0\u05d4\u05d5 \u05d9\u05d5\u05d3\u05d9\u05e2 \u05e2\u05dc \u05de\u05e6\u05d1\u05d5 \u05d5\u05e2\u05dc \u05de\u05e6\u05d1\u05d4. \u05d4\u05e6\u05d8\u05e2\u05e8\u05ea\u05d9 \u05e2\u05dc</span></li>\n<li><span lang=\"he\">&hellip;\u05de\u05db\u05ea\u05d1 \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05b7\u05e7 \u05d1\u05b7\u05bc\u05e8\u05b0\u05d4\u05d5\u05bc\u05df, \u05e9\u05d0\u05e0\u05d9 \u05de\u05d0\u05e9\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5; \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05d9\u05d5\u05d3\u05e2&hellip;</span></li>\n<li><span lang=\"he\">&hellip;\u05de\u05d5\u05d3\u05d4 \u05dc\u05da, (\u05d0\u05ea\u05d4) \u05de\u05d9\u05d8\u05d9\u05d1 \u05dc\u05d3\u05e2\u05ea, \u05d5\u05d1\u05d5\u05d8\u05d7 \u05d1\u05d6\u05d0\u05ea \u05d9\u05d5\u05ea\u05e8. \u05e7\u05d1\u05dc \u05e0\u05d0</span></li>\n<li><span lang=\"he\">\u05d0\u05ea \u05de\u05d9\u05d8\u05d1 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e9\u05dc\u05d5\u05dd; \u05d5\u05d0\u05dd \u05d9\u05d4\u05d9\u05d4 \u05dc\u05da \u05e6\u05d5\u05e8\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9, \u05d1\u05e7\u05e0\u05d9\u05d9\u05d4, \u05db\u05d1\u05d3\u05e0\u05d9 \u05d1\u05d5. \u05d7\u05d6\u05e8\u05d4 \u05d0\u05d5\u05e0\u05d9\u05d9\u05d4</span></li>\n<li><span lang=\"he\">\u05de\u05d0\u05dc\u05db\u05e0\u05d0\u05d9\u05dd&hellip; \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d9\u05de\u05e6\u05d9\u05d0 \u05dc\u05d4\u05dd \u05e8\u05d5\u05d7 \u05d1\u05d7\u05e1\u05d3\u05d5. \u05d5\u05d0\u05e0\u05d9 \u05d0\u05d5\u05d4\u05d1\u05da</span></li>\n<li><span lang=\"he\">\u05d5\u05de\u05d5\u05d3\u05d4 \u05d7\u05e1\u05d3\u05da&hellip; \u05d4\u05d9\u05d5\u05dd \u05d4\u05d2\u05d9\u05e2 \u05d0\u05dc\u05d9 \u05de\u05db\u05ea\u05d1\u05da \u05d5\u05e7\u05e8\u05d0\u05ea\u05d9 \u05d1\u05d5 \u05e2\u05dc \u05e9\u05dc\u05d5\u05de\u05da</span></li>\n<li><span lang=\"he\">(\u05d5\u05e2\u05dc) \u05de\u05d4 \u05e9\u05e2\u05e9\u05d9\u05ea \u05e2\u05de\u05d9. \u05d7\u05d9 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d4\u05d2\u05d3\u05d5\u05dc, \u05d1\u05e9\u05de\u05d5, \u05dc\u05d0 \u05d0\u05d5\u05db\u05dc \u05dc\u05d4\u05e9\u05d9\u05d1 \u05dc\u05da \u05d0\u05d3\u05d5\u05e0\u05d9</span></li>\n<li><span lang=\"he\">\u05db\u05d2\u05de\u05d5\u05dc\u05da \u05dc\u05e2\u05d5\u05dc\u05dd; \u05d9\u05d9\u05d8\u05d9\u05d1 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05ea \u05d2\u05de\u05d5\u05dc\u05da. \u05e9\u05de\u05d7\u05ea\u05d9 \u05e9\u05de\u05db\u05e8\u05ea \u05d0\u05ea \u05d4\u05d0\u05e8\u05d9\u05d2\u05d9\u05dd; \u05d0\u05d1\u05e7\u05e9 \u05de\u05de\u05da \u05e9\u05ea\u05de\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d0\u05e8</span></li>\n<li><span lang=\"he\">\u05d1\u05d8\u05d5\u05d1\u05da. \u05d5\u05db\u05d1\u05e8 \u05d4\u05d2\u05d9\u05e2\u05d5 \u05d0\u05dc\u05d9 \u05db\u05dc \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05e9\u05e6\u05d9\u05d9\u05e0\u05ea \u05d1\u05de\u05db\u05ea\u05d1\u05da, \u05d0\u05dc \u05d9\u05d9\u05e7\u05d7 \u05de\u05de\u05e0\u05d9 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05ea \u05d7\u05d9\u05d9\u05da \u05d5\u05d9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05dc\u05d2\u05de\u05d5\u05dc \u05dc\u05da. \u05db\u05d1\u05e8 \u05e4\u05e8\u05e7\u05d5 \u05d0\u05ea \u05e8\u05d5\u05d1 \u05e1\u05d7\u05d5\u05e8\u05ea\u05d9. \u05e0\u05e9\u05d0\u05e8\u05ea\u05d9 \u05d5\u05d0\u05e9\u05d4\u05d4 \u05d4\u05e9\u05e0\u05d4 \u05db\u05d0\u05df; \u05d0\u05db\u05df \u05d7\u05d9 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd, \u05d0\u05d3\u05d5\u05e0\u05d9, (\u05e7\u05e9\u05d4 \u05e2\u05dc\u05d9)</span></li>\n<li><span lang=\"he\">\u05e4\u05e8\u05d9\u05d3\u05ea\u05d9 \u05de\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d4\u05e9\u05e0\u05d4, \u05d0\u05d1\u05dc \u05d0\u05d9\u05df \u05de\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea. \u05d0\u05e9\u05e8 \u05dc\u05d0\u05e8\u05d2\u05d6 \u05d4\u05e0\u05e9\u05d3\u05d5\u05e8, \u05d4\u05d5\u05d0 \u05d0\u05d1\u05d3 \u05d1\u05d0\u05d5\u05e0\u05d9\u05d9\u05ea</span></li>\n<li><span lang=\"he\">\u05d4\u05d0\u05de\u05d9\u05e8; \u05d4\u05d2\u05d9\u05e2 \u05d4\u05e9\u05d5\u05d7\u05d3 \u05e2\u05dc\u05d9\u05d5 \u05dc\u05de' \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d1\u05e7\u05d9\u05e8\u05d5\u05d1, \u05d5\u05d0\u05d1\u05d3\u05d4 \u05e1\u05d7\u05d5\u05e8\u05d4&hellip;</span></li>\n<li><span lang=\"he\">\u05db\u05dc \u05d0\u05dc\u05d4; \u05d5\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05e9\u05d0\u05d6\u05e8\u05d6 \u05d0\u05d5\u05ea\u05da \u05d1\u05de\u05db\u05d9\u05e8\u05ea \u05d4\u05e9\u05d0\u05e8&hellip;</span></li>\n<li><span lang=\"he\">\u05d4\u05e8\u05d9 \u05dc\u05d0 \u05d0\u05d5\u05db\u05dc \u05d0\u05d3\u05d5\u05e0\u05d9 \u05dc\u05d4\u05d1\u05d9\u05d0 \u05dc\u05da \u05ea\u05d5\u05d3\u05d4&hellip;</span></li>\n<li><span lang=\"he\">\u05dc\u05d0 \u05d9\u05e1\u05e4\u05d9\u05e7. \u05d9\u05e8\u05d0\u05e0\u05d9 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05ea \u05e9\u05de\u05d7\u05ea\u05da \u05d5\u05d9\u05d6\u05db\u05d4 \u05d0\u05d5\u05ea\u05da \u05d1\u05de\u05d9\u05d8\u05d1 \u05d4&hellip;</span></li>\n</ol>",
          "format": "text/html"
        }
      ],
