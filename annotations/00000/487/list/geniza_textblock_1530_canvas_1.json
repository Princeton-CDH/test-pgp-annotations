      "body": [
        {
          "type": "TextualBody",
          "label": "recto",
          "value": "<ol>\n<li><span lang=\"he\">\u05d0\u05e0\u05d9 \u05db\u05d5\u05ea\u05d1 \u05dc\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d5\u05e8\u05d1\u05d9, \u05d9\u05d9\u05ea\u05df \u05dc\u05da \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05e8\u05d9\u05db\u05d5\u05ea \u05d9\u05de\u05d9\u05dd, \u05de&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e9\u05dc\u05d5\u05de\u05d9 \u05d8\u05d5\u05d1&hellip; \u05d1\u05e1\u05d9\u05d5\u05df&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05ea\u05e9\u05dc\u05d7 \u05d0\u05d5\u05ea\u05dd&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d6\u05d4 \u05d0\u05ea\u05d4 \u05d7\u05d9\u05d9\u05d1&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05d7\u05e6\u05d9. \u05d5\u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea \u05d7\u05e1\u05d9\u05df \u05d0\u05dc&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05dc\u05d9 \u05d0\u05ea\u05d4 \u05d7\u05d9\u05d9\u05d1 \u05d1\u05e2\u05d3 \u05de\u05d4 \u05e9\u05e9\u05d9\u05dc\u05de\u05ea\u05d9 \u05d1\u05e9\u05d1\u05d9\u05dc\u05da \u05d1\u05e2\u05d3 \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d3\u05e8\u05d5\u05ea, \u05d0\u05e8\u05d9\u05d2\u05d4 \u05d5\u05d8\u05d5\u05d5\u05d9\u05d9\u05d4, \u05d5\u05db\u05d9\u05d5\u05d5\u05e5&hellip;</span></li>\n<li><span lang=\"he\">\u05de\u05d0\u05ea \u05d9\u05e9\u05d5\u05e2\u05d4, \u05ea\u05e9\u05e8 \u05de\u05ea\u05d5\u05da \u05d3\u05de\u05d9 \u05d4\u05d4\u05d5\u05d1\u05dc\u05d4 \u05d1\u05e2\u05d3 \u05d4\u05e4\u05e9\u05ea\u05d9\u05dd \u05e9\u05dc\u05da, \u05d7\u05e6\u05d9 \u05d3\u05d9\u05e0\u05e8, \u05d5\u05e1\u05da \u05d4\u05db\u05d5\u05dc&hellip;</span></li>\n<li><span lang=\"he\">\u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05d9\u05e9\u05d9\u05ea \u05d5\u05d7\u05e6\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8; \u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea\u05da \u05d0\u05e6\u05dc\u05d9: \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05e0\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd \u05d5\u05d7\u05d1\u05d4&hellip;</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05e7 \u05d1\u05e8\u05d4\u05d5\u05df \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d7\u05e6\u05d9; \u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d7\u05d5\u05d1\u05ea\u05da \u05e2\u05d5\u05d3 \u05e8\u05d1\u05e2 \u05d5\u05e9\u05d9\u05e9\u05d9\u05ea, \u05e4\u05d7\u05d5\u05ea \u05d7\u05d1\u05d4&hellip;</span></li>\n<li><span lang=\"he\">\u05d0\u05e0\u05d9 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d5 \u05d0\u05ea \u05d0\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05d1\u05e2\u05d3 (\u05e8\u05b7\u05d8\u05b0\u05dc ?) \u05e4\u05b4\u05dc\u05b0\u05e4\u05b4\u05dc\u05d9, \u05d3' \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d5\u05e9\u05e0\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd. \u05d0\u05d1\u05e7\u05e9 \u05de\u05de\u05da, \u05e2\u05dc \u05e4\u05d9 \u05de\u05e0\u05d4\u05d2\u05d9\u05da \u05d9\u05d9\u05e4\u05e1\u05e7\u05d5 &ndash; \u05e9\u05ea\u05e7\u05d1\u05dc \u05d1\u05e9\u05d1\u05d9\u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05ea \u05d4\u05d9\u05ea\u05e8\u05d4 \u05de\u05de\u05d5\u05db\u05e8 \u05d4\u05d1\u05d2\u05d3\u05d9\u05dd, \u05d4\u05dd \u05e9\u05e0\u05d9 \u05d4\u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05e9\u05d4\u05d6\u05db\u05e8\u05ea\u05d9, \u05db\u05d9 \u05e9\u05d5\u05ea\u05e4\u05d9 \u05db\u05d1\u05e8 \u05e9\u05d9\u05dc\u05dd \u05dc\u05d5</span></li>\n<li><span lang=\"he\">&hellip;\u05d5\u05ea\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05db\u05d5\u05dd&hellip; \u05e9\u05d0\u05e8 \u05d4\u05d0\u05e8\u05d9\u05d2\u05d9\u05dd. \u05d4\u05d2\u05d9\u05e2 \u05de\u05db\u05ea\u05d1\u05d5 \u05d0\u05dc \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d5\u05e8\u05d1\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05e7 \u05d1\u05e8\u05d4\u05d5\u05df, \u05d5\u05d4\u05d5\u05d0 \u05db\u05d5\u05ea\u05d1 \u05dc\u05d5 \u05d1\u05d5 \u05e9\u05d0\u05e0\u05d9 \u05de\u05d0\u05e9\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5; \u05d0\u05d1\u05dc \u05d0\u05ea\u05d4 \u05d4\u05dc\u05d5\u05d0 \u05d9\u05d5\u05d3\u05e2 \u05d0\u05ea \u05d8\u05d1\u05e2\u05d9&hellip;</span></li>\n<li><span lang=\"he\">&hellip;\u05d4\u05d0\u05e8\u05d9\u05d2\u05d9\u05dd \u05d1\u05e9\u05dc\u05de\u05d5\u05ea\u05dd, \u05dc\u05d0 \u05d4\u05d0\u05e9\u05de\u05ea\u05d9 \u05d0\u05d5\u05ea\u05da \u05e2\u05dc \u05d6\u05d0\u05ea, \u05d0\u05dc\u05d0 \u05e9\u05d4\u05d5\u05d0&hellip;</span></li>\n<li><span lang=\"he\">&hellip;\u05dc\u05d0 \u05e8\u05d0\u05d9\u05ea\u05d9 \u05e9\u05d4\u05d0\u05d5\u05e0\u05d9\u05d5\u05ea \u05e2\u05d5\u05de\u05d3\u05d5\u05ea \u05dc\u05d4\u05e4\u05dc\u05d9\u05d2, \u05d5\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d9\u05d3\u05e2&hellip;</span></li>\n<li><span lang=\"he\">\u05d3\u05dc\u05e4\u05d5\u05e0\u05d9\u05dd&hellip; \u05d4\u05d2\u05d9\u05e2\u05d5 \u05d1\u05e9\u05dc\u05d5\u05dd \u05d5\u05d4\u05e2\u05de\u05e1\u05ea\u05d9\u05dd&hellip;</span></li>\n<li><span lang=\"he\">\u05e2\u05dd \u05d0\u05d1\u05df \u05de\u05d5\u05e1\u05d0&hellip; \u05d4\u05d0\u05d3\u05e8\u05d5\u05ea \u05d0\u05d9\u05d7\u05e8\u05d5 \u05d1\u05d2\u05dc\u05dc&hellip;</span></li>\n<li><span lang=\"he\">&hellip;\u05db\u05d9 \u05d9\u05e6\u05d0\u05ea\u05d9 \u05d0\u05dc \u05d4\u05e8\u05d9\u05e3 \u05d5\u05de\u05e1\u05e8\u05ea\u05d9 \u05d0\u05d5\u05ea\u05df \u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05e7</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05df \u05e4\u05e8\u05d0\u05d7 \u05e9\u05d9\u05e9\u05dc\u05d7\u05dd \u05d0\u05dc\u05d9\u05da, \u05d0\u05d1\u05dc \u05d4\u05d0\u05d9\u05e9 \u05e9\u05db\u05d7 \u05d0\u05d5\u05ea\u05dd \u05d0\u05e6\u05dc\u05d5, \u05d5\u05db\u05d0\u05e9\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05d6\u05de\u05df&hellip;</span></li>\n<li><span lang=\"he\">\u05d4\u05dc\u05db\u05d5 \u05d5\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d9 \u05d0\u05dc\u05d9\u05d4\u05df(?)&hellip; \u05d0\u05d7\u05e8\u05d9 \u05e9\u05e0\u05e8\u05e7\u05d1\u05d5, \u05d5\u05d4\u05d3\u05d1\u05e8 \u05d2\u05e8\u05dd \u05dc\u05d9 \u05e2\u05d5\u05d2\u05de\u05ea \u05e0\u05e4\u05e9 \u05e8\u05d1\u05d4&nbsp;</span></li>\n<li><span lang=\"he\">&hellip;\u05d0\u05dc \u05d4\u05d9\u05dd, \u05d5\u05d4\u05dd \u05d9\u05e6\u05d0\u05d5 \u05d1\u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd, \u05d0\u05e9\u05dc\u05d7 \u05d0\u05d5\u05ea\u05dd</span></li>\n<li><span lang=\"he\">&hellip;\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d9\u05e2\u05e7\u05d5\u05d1 \u05d9\u05d5\u05e1\u05e3 \u05d4\u05db\u05d4\u05df. \u05db\u05d1\u05e8 \u05e9\u05dc\u05d7\u05ea\u05d9 \u05d0\u05ea \u05e9\u05e0\u05d9 \u05d4\u05e6\u05e2\u05d9\u05e4\u05d9\u05dd</span></li>\n<li><span lang=\"he\">&hellip;\u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d9\u05e2\u05e7\u05d5\u05d1, \u05d5\u05d4\u05d5\u05d0 \u05db\u05d1\u05e8 \u05d4\u05e4\u05dc\u05d9\u05d2&hellip; \u05d0\u05d1\u05dc \u05d7\u05d6\u05e8&hellip;</span></li>\n<li><span lang=\"he\">\u05de\u05e1\u05e8\u05ea\u05d9 \u05d0\u05ea \u05db\u05d9\u05e1 \u05d0\u05d1\u05e0\u05d9 \u05d4\u05d0\u05d5\u05d3\u05dd \u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05d0\u05e1\u05d7\u05e7 \u05d1\u05e8\u05d4\u05d5\u05df, \u05d5\u05de\u05d4 \u05e9\u05d7\u05d6\u05e8</span></li>\n<li><span lang=\"he\">&hellip;\u05ea\u05d7\u05ea \u05d4\u05de\u05d2\u05d3\u05dc\u05d5\u05e8 (\u05e0\u05de\u05e6\u05d0\u05d5\u05ea) \u05d0\u05d5\u05e0\u05d9\u05d9\u05ea \u05d0\u05d1\u05df \u05d0\u05dc&hellip; \u05d5\u05d0\u05dc\u05dc\u05db\u05d9 \u05d5\u05d0\u05d1\u05df&hellip;</span></li>\n<li><span lang=\"he\">\u05d0\u05d7\u05d9&hellip;</span></li>\n</ol>",
          "format": "text/html"
        }
      ],
