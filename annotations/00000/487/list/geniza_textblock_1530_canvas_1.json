        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u0645\u0645\u0648\u0631\u062f\u0648\u0643 \u0628\u0646 \u0645\u0648\u0633\u0649 \u05e0\u05e2</p>\n<p>\u0627\u0644 \u05e0\u05d4\u05e8\u05d0\u05d9 \u05d1\u05df \u05e0\u05e1\u05d9\u05dd \u05e0\u05e2</p>\n\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u064a\u0627\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0626\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643</li>\n<li>\u0628\u0639\u0627\u062f\u062a\u0643 \u0644\u064a \u0628\u0642\u064a\u0646 \u0645\u0646 \u0633\u064a\u0648\u0627\u0646</li>\n<li>\u0643\u062b\u064a\u0631\u0629</li>\n<li>\u0648\u0644\u0645</li>\n<li>\u0644\u0643 \u0639\u0646\u062f\u0643 \u0645\u0646\u0647\u0627 \u0648\u0646\u0635\u0641 \u064a\u0643\u0648\u0646</li>\n<li>\u0648\u0644\u064a \u0639\u0646\u062f\u0643 \u0645\u0646 \u0645\u0627 \u0648\u0632\u0646\u062a\u0647 \u0639\u0644\u064a\u0643 \u0641\u064a \u0627\u0644</li>\n<li>\u0645\u0646 \u0642\u0628\u0644 \u05d9\u05e9\u05d5\u05e2\u05d4 \u062c\u0639\u0644 \u0646\u0635\u0641 \u062f\u064a\u0646\u0627\u0631 \u064a\u0643\u0648\u0646 \u062c\u0645\u0644\u0629</li>\n<li>\u062f\u064a\u0646\u0627\u0631 \u0648\u0646\u0635\u0641 \u0642\u064a\u0631\u0627\u0637 \u0627\u0644\u0628\u0627\u0642\u064a \u0644\u0643 \u0639\u0646\u062f\u064a \u062f\u064a\u0646\u0627\u0631 \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u0648\u0643\u0630\u0644\u0643</li>\n<li>\u0627\u0628\u064a \u0635\u062d\u0642 \u0628\u0631\u0647\u0648\u0646 \u062f\u064a\u0646\u0627\u0631 \u0648\u0646\u0635\u0641 \u0627\u0644\u0628\u0627\u0642\u064a \u0639\u0646\u062f\u0643 \u062c\u0627\u0626\u0632 \u0645\u0639</li>\n<li>\u0644\u0647 \u0639\u0646\u062f\u064a \u062b\u0645\u0646 \u0641\u0644\u0641\u0644 \u05d3 \u062f\u0646\u0627\u0646\u064a\u0631 \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u0646\u062d\u0628 \u0645\u0646\u0647 \u0643\u0645\u0627 \u0644\u0645 \u062a\u0632\u0627\u0644\u0648 \u0639\u0648\u0627\u0626\u062f\u0629 \u064a\u0642\u0628\u0636</li>\n\n<p>\u0644\u064a</p>\n\n<li>\u0627\u0644\u0628\u0642\u064a\u0629 \u0645\u0646 \u0627\u0644\u0628\u0632\u0627\u0632 \u0648\u0647\u064a \u0627\u0644\u062f\u064a\u0646\u0627\u0631\u064a\u0646 \u0627\u0644\u062a\u064a \u0630\u0643\u0631\u062a \u0644\u0627\u0646 \u0642\u062f</li>\n\n<p>\u0644\u064a \u0641\u064a \u0627\u0644</p>\n\n<li>\u0648\u064a\u062a\u0645 \u0628\u0642\u064a\u062a \u0627\u0644\u0645\u062a\u0627\u0639 \u0642\u062f \u0648\u0635\u0644 \u0643\u062a\u0627\u0628\u0647</li>\n<li>\u0627\u0628\u064a \u0635\u062d\u0642 \u0628\u0631\u0647\u0648\u0646 \u0627\u0646\u064a \u0644\u0627\u0626\u0645 \u0644\u0647 \u0648\u0627\u0646\u062a \u062a\u0639\u0644\u0645</li>\n<li>\u0627\u0644 \u0639\u0644\u064a\u0643\u0645 \u0648\u0644 \u062b\u0645\u0646 \u0627\u0644\u0645\u062a\u0627\u0639 \u0643\u0627\u0645\u0644 \u0644\u0645 \u0643\u0644\u064a\u062a\u0643 \u0639\u0644\u064a\u0647</li>\n<li>\u0627\u0633\u0644\u0643 \u0641\u064a \u0627\u0645\u0631 \u0627\u0644 \u0644\u0627\u0646 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0631\u0627\u0643\u0628 \u0639\u0644\u0649 \u0627\u0642\u0644\u0627\u0639\u0627\u062a \u0648\u0644\u0645 \u064a\u0635\u0644</li>\n<li>\u0636\u0639\u0627\u0644\u064a\u0643 \u0641\u0639\u0644\u064a\u0647 \u0643\u0627\u0646\u062a \u0648\u0642\u062f \u0648\u0635\u0644 \u0648\u0644\u0645 \u0641</li>\n<li>\u062a\u062b\u0628\u062a \u0627\u0628\u0646 \u0628\u0642\u064a\u062a\u0643 \u0648\u0643\u0627\u0646 \u0633\u0628\u0628 \u062a\u0627\u062e\u064a\u0631 \u0627\u0644 \u0627\u062a \u0639\u0646\u0643</li>\n<li>\u0642\u062f \u0639 \u0644\u0645\u0646 \u062e\u0631\u062c\u062a \u0627\u0644 \u0627\u0644\u0631\u064a\u0641 \u062f\u0641\u0639\u062a\u0647\u0627 \u0627\u0644\u0649 \u0633\u064a\u062f\u064a \u0627\u0628\u0648</li>\n<li>\u064a\u0646\u0641\u062f\u0647\u0627 \u0627\u0644\u064a\u0643 \u0646\u0633\u0626\u064a\u0647\u0627 \u0627\u0644\u0631\u062c\u0644 \u0639\u0646\u062f\u0647 \u0641\u0644\u0645\u0627 \u0643\u0627\u0646 \u0641\u064a \u0647\u0627\u0630\u0629 \u0627\u0644\u062c\u0645\u0639\u0629</li>\n<li>\u0645\u0636\u0627\u062a \u0641\u0643\u0631\u0646\u064a \u0641\u064a\u0647\u0627 \u0641 \u0627\u0644\u0649 \u0645\u0646 \u0628\u0639\u062f \u0645\u0627 \u0648\u0642\u062f</li>\n<li>\u0627\u0644\u0649 \u0627\u0644\u0649 \u0627\u0644\u0628\u062d\u0631 \u0648\u0647\u064a \u062a\u062e\u0631\u062c \u0641\u064a \u0647\u0627\u0630\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0646</li>\n<li>\u0633\u064a\u062f\u064a \u0627\u0628\u064a \u05d9\u05e2\u05e7\u05d5\u05d1 \u05d9\u05d5\u05e1\u05e3 \u0627\u0644\u0643\u0647\u0646 \u0648\u0642\u062f \u0627\u0646\u0641\u062f\u062a \u0627\u0644\u0645\u0639\u062c\u0631\u064a\u0646 \u0648\u0627\u0644</li>\n<li>\u0639 \u0633\u064a\u062f\u064a \u0627\u0628\u064a \u05d9\u05e2\u05e7\u05d5\u05d1 \u0648\u0642\u062f \u0627\u0642\u0644\u0639 \u0641\u064a \u0627\u0644 \u0648\u0631\u062c\u0639 \u0648\u0647\u0648 \u064a\u0641</li>\n<li>\u062f\u0641\u0639\u062a \u0627\u0644\u0628\u0642\u064a\u0629 \u0627\u0644\u0649 \u0633\u064a\u062f\u064a \u0627\u0628\u064a\u0635\u062d\u0642 \u0628\u0631\u0647\u0648\u0646</li>\n<li>\u05d4 \u0627\u0644\u0645\u0646\u0627\u0631\u0629 \u0645\u0631\u0643\u0628 \u0627\u0628\u0646 \u0643\u0627\u0646\u062a</li>\n<li>\u0627\u064a \u064a\u0627\u062e\u0630 \u0627\u0644\u0627</li></ol>\n",
          "format": "text/html"
        }
      ],
