      "body": [
        {
          "type": "TextualBody",
          "label": "",
          "value": "<p>\u062a\u0648\u0643\u0644\u062a \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0643\u062a\u0627\u0628\u064a \u064a\u0627 \u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0626\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0643 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0643 \u0648\u062a\u0627\u0626\u062f\u0643 \u0648\u0633\u0639\u0627\u062f\u062a\u0643 \u0648\u0633\u0644\u0627\u0645\u062a\u0643 \u0645\u0646 \u0627\u0644\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0644\u064a \u0643\u0644\u0648\u0646 \u0645\u0646 \u062e\u0633\u0644\u0648 \u0639\u0631\u0641\u0643 \u0627\u0644\u0644\u0647 \u0628\u0631\u0643\u062a\u0647 \u0627\u0639\u0644\u0645\u0643 \u064a\u0627\u0645\u0648\u0644\u0627\u064a \u0627\u0646 \u0648\u0635\u0644 \u0636\u0645\u064a\u0631 \u0627\u0644\u0641\u064a\u063a \u0648\u0644\u0645 \u0627\u0631\u0627 \u0644\u0643 \u0645\u0639\u0647 \u0643\u062a\u0627\u0628 \u0648\u0642\u062f \u0627\u0634\u062a\u063a\u0644 \u0633\u0631\u064a \u0644\u0630\u0644\u0643 \u0639\u0638\u064a\u0645 \u0648\u0642\u062f \u0648\u0635\u0644 \u0627\u0644\u0649 \u0643\u062a\u0627\u0628 \u0633\u064a\u064a\u062f\u064a \u0627\u0628\u064a \u0632\u0643\u0631\u064a \u0648\u0630\u0643\u0631 \u0627\u0646\u0643 \u0648\u062c\u064a\u0639 \u0648\u0642\u062f \u0628\u0644\u063a \u0641\u064a\u0627 \u0645\u0646 \u0634\u063a\u0644 \u0627\u0644\u0633\u0631 \u0645\u0627 \u0645\u0627 \u0627\u0642\u062f\u0631 \u0627\u0635\u0641\u0647 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648\u062c\u0644 \u0644\u0627 \u064a\u0631\u064a\u0646\u0648 \u0641\u064a\u0643 \u0645\u0643\u0631\u0648\u0629 \u0648\u064a\u0643\u0634\u0641 \u0645\u0627 \u0628\u0643 \u0648\u064a\u062c\u0645\u0639 \u0628\u064a\u0646\u0643 \u0648\u0628\u064a\u0646 \u0648\u0627\u0644\u0630\u062a\u0643 \u0648\u0627\u0646\u0627 \u0627\u0644\u0627 \u0627\u0646 \u064a\u0635\u0644 \u0643\u062a\u0627\u0628\u0643 \u0648\u0642\u062f \u0642\u0628\u0636\u062a \u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0648\u0627\u0626\u062c \u0627\u0644\u0630\u064a \u0627\u0646\u0641\u062f\u062a \u0645\u0639 \u0639\u0628\u062f \u0627\u0644\u0639\u0632\u064a\u0632 \u0648\u0627\u0644 \u0639\u062f\u0644 \u0627\u0644 \u0644\u064a\u0645\u0648 \u0645\u0646 \u0645\u064a\u0645\u0648\u0646 \u0648\u0642\u062f \u0642\u0628\u0636\u062a \u0627\u0644\u0639\u062f\u0644 \u062a\u0645\u0631 \u0647\u0646\u062f\u064a \u0648\u0642\u062f \u0631\u0633\u062a\u0647 \u0641\u064a \u0645\u062e\u0632\u0646 \u064a\u0634\u0648\u0639\u0647 \u0648\u0642\u062f \u0630\u0643\u0631 \u0633\u064a\u064a\u062f\u064a \u0627\u0628\u064a \u0632\u0643\u0631\u064a \u0627\u0646 \u0628\u0627\u0639 \u0644\u064a \u0627\u0644\u0640\u05e9\u05d9\u05e9 \u0641\u062d\u0633\u0646 \u0627\u0644\u0644\u0647 \u062c\u0632\u0627\u0647 \u0648\u0644\u0648 \u0643\u0627\u0646 \u0628\u0627\u0644\u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0644\u0643\u0646\u062a \u0627\u0628\u064a\u0639\u0629 \u0628\u0632\u0627\u0626\u062f \u062f\u064a\u0646 \u0643\u0644 \u0631\u0637\u0644 \u0648\u0642\u062f \u0643\u062a\u0628\u062a \u0644\u0643 \u0641\u064a \u0643\u062a\u0628\u064a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0648\u0627\u0639\u0644\u0645\u062a\u0643 \u0628\u0627\u0644\u0634\u064a\u0634 \u0627\u0644\u0630\u064a \u0644\u064a \u0641\u064a \u0627\u0644\u0631\u0632\u0645\u0629 \u0648\u0642\u062f \u0643\u062a\u0628\u062a \u0628\u0647 \u0644\u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0627\u0635\u062d\u0628\u0646\u0627 \u0641\u062a\u0633\u062a\u0642\u0636\u064a \u0627\u0646 \u0642\u0628\u0636\u0647 \u062a\u0642\u0628\u0636\u0647 \u0645\u0646 \u0639\u0646\u062f\u0647 \u0648\u064a\u0643\u0648\u0646 \u0639\u0646\u062f\u0643 \u0648\u0627\u0646 \u0643\u0627\u0646 \u0645\u0648\u0644\u0627\u064a \u0648\u062c\u064a\u0639 \u0644\u0627 \u064a\u062e\u0644\u0641 \u0646\u0641\u0633\u0647 \u0648\u0644\u0627 \u064a\u0634\u063a\u0644 \u0633\u0631\u0649 \u0648\u0641\u064a \u064a\u0648\u0645\u0646\u0627 \u0647\u0630\u0647 \u0628\u0639\u062b \u0627\u0644\u062d\u0631\u