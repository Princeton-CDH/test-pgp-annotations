          "type": "TextualBody",
          "label": "",
          "value": "<p>\u05e4 \u05d0 \u0628\u0646 \u0633\u062e\u064a\u062c \u05de \u0628\u0646 \u0634\u0627\u0647\u062f \u0631\u0637\u0644 \u0648\u0633\u062e \u05d1 \u0627\u0644\u0630\u064a \u0642\u0628\u0636\u062a \u0645\u0646 \u0627\u062f\u0631\u064a\u0633 \u0645\u0646 \u05dc\u05d1 \u0648\u0633\u062e \u0648\u0642\u064a\u0648 \u0631\u0637\u0644 \u0648\u0633\u062e \u05d5\u05db \u0641\u0648\u0627\u0647 \u0639\u0644\u0649 \u062d\u062f\u0647 \u0648\u0632\u0646\u0647 \u05db\u05d4 \u05d0 \u0645\u0646 \u0628\u0646 \u0641\u0635\u0644 \u05e7 \u0627\u0644\u0627 \u0631\u0637\u0644 \u0648\u0633\u062e \u05d5\u05e4\u05d2 \u0631\u0637\u0644 \u0648\u0633\u062e \u0639\u064a\u0627\u0634 \u05d8 \u0627\u0631\u0637\u0627\u0644 \u0628\u0646 \u0645\u0633\u0645\u0627\u0631 \u05d9\u05d5 \u0631\u0637\u0644 \u0627\u0628\u0646 \u0627\u0644\u0635\u0628\u0627\u063a \u0628\u0627\u0642\u064a \u05e0\u05e6 \u062d\u0645\u0644 \u05dc\u05d4 \u0631\u0637\u0644 \u062a\u0631\u0627\u0628 \u0628\u0627\u0642\u064a \u05e7 \u0644\u0647 \u0631\u0637\u0644 \u0628\u0646 \u0645\u0633\u0645\u0627\u0631 \u05d9\u05d5 \u0631\u0637\u0644 \u0648\u0641\u0648\u0647 \u0639\u064a\u0627\u0634 \u05d8 \u0627\u0631\u0637\u0627\u0644 \u0639\u0644\u0649 \u0628\u0646 \u0634\u0627\u0647\u062f \u0642\u062f \u0627\u0628\u0646 \u0641\u0635\u0644 \u05ea\u05e9\u05de\u05d7 \u0648\u062f\u064a\u0646 \u0627\u0631\u0637\u0627\u0644 \u0639\u0644\u0649 \u0628\u0646 \u0634\u0627\u0647\u062f \u0642\u062f \u0627\u0628\u0646 \u0641\u0635\u0644 \u05ea\u05e9\u05de\u05d7 \u05d5\u05d3\u05d9\u05e0 \u0645\u064a\u0645\u0648\u0646 \u0644\u0647 \u05e9\u05e9\u05d6 \u0648\u0628\u0642\u0649 \u0639 \u05db\u05dc\u05d5\u05de\u05e8 \u0639\u0646\u062f\u0649 \u0634\u0635\u062c \u0646\u0642\u0649 \u0627\u062f\u0631\u064a\u0633 \u0646\u0642\u0649 \u05e7\u05e7\u05db\u05d5 \u0648\u0646\u0642\u0627 \u05d3 \u0648\u062d\u0645\u0627\u0644 \u0639\u0628 \u062e\u0631\u062c\u062a \u0627\u0648\u0644 \u062f\u0641\u0639\u0629 \u0634\u0646\u0628 \u0648\u062b\u0644\u062b \u0648\u062d\u0628\u0647 \u063a\u064a\u0631 \u0636\u0631\u0629 \u0627\u0628\u0649 \u0627\u0644\u062e\u064a\u0631 \u0631\u062c\u0639\u062a \u0627\u0644\u064a\u0647 \u0628\u0643\u0644\u0647\u0627 \u0627\u0644\u0648\u0631\u0642 \u0643\u0644\u0647 \u0648\u0631\u0642 \u0627\u0644\u0639\u0627\u0645\u0644 \u05e7\u05e7 \u0648\u0631\u0628 \u0627\u0648\u0644\u0647 \u05d7 \u062f\u0646\u0627 \u0627\u062f\u0631\u064a\u0633 \u0627\u0648\u0644\u0627 \u05d2 \u0627\u0644\u0627 \u0633\u062f\u0633 \u0627\u0644\u0642\u0627\u0635\u064a \u05d2 \u0627\u0644\u0627 \u062b\u0645\u0646 \u0627\u062f\u0631\u064a\u0633 \u062f\u064a\u0646\u0627\u0631 \u0627\u0644\u0627 \u062d\u0628\u0629 \u0642\u0645\u0642\u0645 \u062b\u0644\u062b \u0648\u062d\u0628\u0647 \u062d\u0632\u0627\u0645 \u05d4 \u0642\u0631\u0627 \u0648\u0646\u0635 \u0641\u0648\u0637\u062a\u064a\u0646 \u062f\u064a\u0646 \u0648\u062b\u0645\u0646 \u0632\u0639\u0641\u0631\u0627\u0646 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631\u0627\u0637 \u0627\u0628\u0648 \u062f\u0627\u0648\u062f \u05d8 \u0642\u0631\u0627 \u0627\u0644\u0642\u0627\u0635\u0649 \u062f\u064a\u0646\u0631\u064a\u0646 \u062a\u064a\u0627\u062f\u0631 \u0642\u064a\u0631 \u0627\u0644\u062d\u0645\u0627\u0645\u0649 \u05d2 \u0627\u0644\u0627 \u062b\u0645\u0646 \u062d\u0641\u0627\u0638 \u05d2 \u0627\u0644\u0627 \u062b\u0645\u0646 \u0631\u0636\u0648\u0627\u0646 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631 \u0642\u0627\u0633\u0645 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u062a\u0631\u0627\u0628 \u05e0\u05e6 \u062f\u064a\u0646 \u0628\u0643\u062b\u0631\u0649 \u05e0\u05e6 \u062f\u064a\u0646 \u0642\u0645\u0642\u0645 \u05d2 \u0627\u0644\u0627 \u062b\u0645\u0646 \u0627\u062f\u0631\u064a\u0633 \u0642\u064a\u0631 \u0642\u0627\u0636\u0649 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631 \u0632\u064a\u062f \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631 \u062d\u0627\u0643\u0645 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631 \u0633\u0647\u0644 \u062f\u064a\u0646 \u0627\u0644\u0627 \u0642\u064a\u0631 \u0628\u0647\u0628\u0634\u064a\u0645 \u05d5 \u062f\u0646\u0627 \u0627\u0644\u0627 \u0631\u0628\u0639 \u0641\u0631\u0647\u0627\u0645 \u05d1 \u0627\u0644\u0627 \u0642\u064a\u0631\u0627\u0637\u064a\u0646 \u062e\u0644\u064a\u062f\u0633 \u062f\u064a\u0646 \u0627\u0644\u0627 \u062d\u0628\u0629 \u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u0649 \u05d2 \u0627\u0644\u0627 \u0642\u064a\u0631 \u0627\u0628\u0648 \u062d\u0628\u064a\u0628 \u05d5 \u0627\u0644\u0627 \u0631\u0628 \u0642\u062a\u0648\u0646 \u05d1 \u0627\u0644\u0627 \u0642\u064a\u0631\u0637\u064a\u0646 \u062d\u0648\u0645\u064a\u062f \u0645\u0627 \u0648\u0631\u0628 \u0648\u062b\u0645\u0646 \u0627 \u0628\u0648 \u0627\u0644\u062e\u064a\u0631 \u05d2 \u0648\u0631\u0628 \u0648\u062d\u0628\u0647 \u0630\u0644\u0643 \u0634\u0646\u062f \u0648\u0646\u0635 \u0648\u0642\u064a\u0631 \u0627\u062e\u0631\u0627\u062c \u0636\u0631\u0629 \u062f\u0627\u0648\u062f \u0634\u0627\u0641\u0639 \u0630\u064a\u0646 \u0627\u0628\u0648 \u062c\u0645\u064a\u0644 \u0644\u0633\u0639\u064a\u062f \u05d2 \u062f\u0646\u0627 \u0648\u0632\u0646 \u0648\u0644\u0647 \u0641\u064a \u0639\u0633\u0644 \u05d2 \u0627\u0644\u0627 \u062b\u0645\u0646 \u062d\u0628\u0644 \u062f\u064a\u0646 \u0635\u0631\u0641 \u062f\u064a\u0646 \u0627\u0644\u0627 \u062b\u0645\u0646 \u062e\u0637\u064a\u0628 \u062f\u064a\u0646 \u0627\u0644\u0627 \u062d\u0628\u062a\u064a\u0646 \u0633\u0644\u0627\u0645\u0629 \u05d5 \u0627\u0644\u0627 \u0631\u0628 \u0645\u0636\u0631\u0645 \u05d5 \u062f\u0646\u0627 \u0627\u0644\u0627 \u062f\u064a\u0646 \u0627\u0644\u0627 \u062d\u0628\u062a\u064a\u0646 \u0633\u0644\u0627\u0645\u0629 \u05d5 \u0627\u0644\u0627 \u0631\u0628 \u0645\u0635\u0631\u0645 \u05d5 \u062f\u0646\u0627 \u0627\u0644\u0627 \u062b\u0645\u0646 \u0633\u0644\u0627\u0645\u0629 \u05d1 \u0627\u0644\u0627 \u0642\u064a\u0631\u0637\u064a\u0646 \u0635\u0631\u0641 \u062f\u064a\u0646\u0631\u064a\u0646 \u0627\u0644\u0627 \u0642\u