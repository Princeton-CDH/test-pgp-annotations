        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=pixel:191.4720458984375,208.1327362060547,2164.9044189453125,3771.5386505126953",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
