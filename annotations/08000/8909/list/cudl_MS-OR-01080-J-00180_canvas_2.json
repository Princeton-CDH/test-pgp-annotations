        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso:",
          "value": "\n<ol><li>\u062a\u0642\u0628\u0636 \u0645\u0627 \u064a\u062e\u0635 \u05e9\u05de\u05d5\u05d0\u05dc \u0645\u0646 \u0627\u0644\u0642\u0633\u0637 \u0648\u0644\u0627</li>\n<li>\u062a\u062a\u0648\u0627\u0646\u0627 \u0641\u064a\u0647 \u0648\u0643\u0630\u0644\u0643 \u0627\u064a\u0636\u0627 \u0645\u0627 \u064a\u062e\u0635 \u0632\u0643\u0631\u0649</li>\n<li>\u0627\u0644\u0637\u0631\u0627\u0628\u0644\u0633\u064a \u0648\u0627\u0646 \u0627\u0631\u0627\u062f \u0627\u0644\u0648\u062e\u064a\u0644 \u0643\u062a\u0628 \u062d\u062c\u0629</li>\n<li>\u0639\u0644\u064a\u0643 \u0641\u064a \u0627\u0644\u062f\u0645\u0629 \u0628\u0645\u0627 \u062a\u0642\u0628\u0636\u0647 \u0645\u0646\u0647 \u0627\u0641\u0639\u0644</li>\n<li>\u0648\u0644\u0627 \u062a\u062e\u0627\u0641 \u0641\u064a \u0634\u064a \u0645\u0646 \u0630\u0644\u0643 \u0627\u0630 \u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u062c\u0627\u0631</li>\n<li>\u064a\u0639\u0644\u0645\u0648\u0627 \u0627\u0646 \u0627\u0644\u062f\u0631\u0647\u0645 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0641\u064a \u064a\u062f \u05e9\u05de\u05d5\u05d0\u05dc</li>\n<li>\u0644\u0643 \u0648\u0627\u0646\u062a \u0633\u0641\u0631\u062a\u0647 \u0628\u0647 \u0645\u0646 \u05e2\u05d3\u05df \u0648\u0645\u0627 \u0627\u062d\u062a\u0627\u062c</li>\n<li>\u0627\u0648\u0636\u064a\u0643 \u0641\u064a \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u064a\u0643 \u0645\u0641\u0635\u0644 \u0645\u0648\u0635\u0644</li>\n<li>\u0643\u062a\u0627\u0628\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0643 \u0648\u0627\u0644\u0648\u0642\u0648\u0641 \u0645\u0639\u0647 \u0648\u0645\u0647\u0645\u0627</li>\n<li>\u062a\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0627\u062a \u0627\u0644\u0633\u0641\u0631 \u0648\u0643\u0627\u0646\u062a \u0639\u0646\u062f\u0643</li>\n<li>\u062a\u0642\u0636\u0649 \u062d\u0642\u0647 \u0641\u064a\u0647\u0627 \u0648\u062a\u0643\u062b\u0631\u0649 \u0644\u0647 \u0627\u064a\u0636\u0627 \u0645\u0639</li>\n<li>\u0645\u0646 \u062a\u0639\u0644\u0645 \u0627\u0646\u0647 \u064a\u0631\u0639\u0627\u0647 \u0648\u0627\u0646 \u0643\u062b\u0628\u062a \u0627\u0644\u0649 \u05e2\u05d3\u05df</li>\n<li>\u0643\u062a\u0628 \u0639\u0631\u0641\u0647\u0645 \u0642\u062f\u0631\u0629 \u0648\u0628\u064a\u062a\u0647 \u0648\u0646\u0631\u064a\u062f \u0643\u062a\u0628\u0647</li>\n<li>\u062a\u0635\u0644\u0646\u064a \u0628\u0645\u0627 \u062a\u0641\u0639\u0644\u0647 \u0645\u0639\u0647 \u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0644</li>\n<li>\u0648\u0627\u0642\u0631\u064a \u062c\u0645\u064a\u0639 \u0645\u0646 \u062e\u0631\u062c \u0645\u0646 \u0627\u0635\u062d\u0627\u0628\u0646\u0627 \u0641\u064a \u0627\u0644\u0643\u0627\u0631\u0645 \u0628\u0627\u062a\u0645</li>\n<li>\u0633\u0644\u0627\u0645</li></ol>\n",
          "format": "text/html"
        }
