      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "<ol>\n<li>His honor my lord the most glorious elder Ab\u016b Zikr\u012b</li>\n<li>Ya\u1e25y\u0101 b. Sulaym\u0101n, may his resting place be Eden, b. al-Sh\u0101m\u012b, may God decree his wellbeing.</li>\n<li>(From) the one who is grateful for his benefactions,&nbsp;</li>\n<li>Ab\u016b Zikr\u012b Kohen. Peace.&nbsp;</li>\n</ol>",
          "format": "text/html"
        }
      ],
