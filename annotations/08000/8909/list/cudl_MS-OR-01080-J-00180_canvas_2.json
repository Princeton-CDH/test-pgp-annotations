      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, right margin",
          "value": "<ol>\n<li>I send you best regards.</li>\n<li>Also Sulaym\u0101n, Yi\u1e63\u1e25aq and my children &mdash;\u202f</li>\n<li>send them best regards.</li>\n<li>Send Ab\u016b l-\u1e24usayn and his two sisters</li>\n<li>best regards.</li>\n<li>Send the entire family</li>\n<li>best regards.</li>\n<li>Send anyone to whom you extend your concern</li>\n<li>best regards. Send Musallam</li>\n<li>and Shemu\u02beel best</li>\n<li>regards. Utmost peace.</li>\n<li>\u1e6cevet 1452 (Sel.)</li>\n</ol>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
