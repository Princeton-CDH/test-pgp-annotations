    {
      "etag": "\"fc3e5ffc0ffbc8c0721454b556fa56eb\"",
      "id": "https://test-geniza.cdh.princeton.edu/annotations/ded454ab-5850-4dea-8b61-d90fbfe723bc/",
      "type": "Annotation",
      "created": "2023-12-09T21:36:38.642658+00:00",
