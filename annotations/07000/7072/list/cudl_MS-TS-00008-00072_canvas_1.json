        {
          "type": "TextualBody",
          "label": "Recto:",
          "value": "\n<ol><li>\u0643\u062a\u0627\u0628\u064a \u0627\u0644\u0649 \u062d\u0636\u0631\u0629 \u0645\u0648\u0644\u0626\u064a \u0627\u0644\u0634\u064a\u0643 \u0627\u0628\u0648 \u0627\u0644\u0645\u062e\u0627\u0631\u0645</li>\n<li>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0647 \u0648\u0646\u0639\u0645\u0627\u0647</li>\n<li>\u0648\u0645\u0646 \u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0644\u0627 \u0627\u0643\u0644\u0627\u0647 \u0642\u0631\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644</li>\n<li>\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0647 \u0639\u0644\u0649 \u0627\u0633\u0631 \u062d\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648\u062c\u0648\u062f\u0647</li>\n<li>\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0630\u064a \u0627\u0639\u0644\u0645\u0643 \u0628\u0647 \u064a\u0627 \u0645\u0648\u0644\u0627\u064a</li>\n<li>\u0627\u0646\u0646\u064a \u0643\u0646\u062a \u0642\u062f \u0627\u0634\u062a\u0631\u064a\u062a \u0645\u0646\u0643 \u0639\u0648\u062f \u0631\u0637\u0628</li>\n<li>\u0648\u0627\u062e\u0630\u062a\u0647 \u0648\u062c\u064a\u062a \u0628\u0647 \u0627\u0644\u0649 \u0627\u0633\u062e\u0646\u062f\u0631\u064a\u0629 \u0641\u0645\u0627</li>\n<li>\u0628\u064a\u0639 \u0644\u064a \u0634\u064a \u0648\u0644\u0627 \u0642\u062f\u0631\u062a \u0627\u0646</li></ol>\n",
